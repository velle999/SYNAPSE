# Maintainer: Velle Sinclair <brncomputerhelp@gmail.com>
#
# syn-cal — the SynapseOS calendar and schedule planner.
#
# Two-way sync with CalDAV accounts — Nextcloud, Fastmail, iCloud, Radicale,
# Baikal — with Google through OAuth and Microsoft 365 through Graph. A window
# (syn-cal gui), a terminal view (syn-cal tui) and a command line, all over one
# core. The store is a vdir: one .ics per event in a folder per calendar, the
# layout vdirsyncer and khal already write, so the data is readable by anything
# that can read a folder.
#
# ⛔ MICROSOFT IS READ-ONLY FOR REPEATING EVENTS, on purpose. An RRULE flattened
# on the way out replaces a series on somebody's work calendar with a single
# occurrence and neither side reports anything wrong, so editing one locally is
# REFUSED and the local file is left alone.
#
# ⚠ THE HALF THAT CAN LOSE DATA IS THE HALF WITH THE TESTS. Two-way sync fails
# combinatorially — both sides changed, one deleted while the other edited, a
# precondition landing between the listing and the upload — and the rule the
# engine exists to obey is that an edit is never lost without saying so. When
# both sides changed the same event, BOTH are kept: the server's version keeps
# the UID and the local one is re-filed under a UID derived from it. "Last
# writer wins" is data loss with a reassuring name.
#
# ⛔ NO PASSWORD OR TOKEN IS IN accounts.conf. They go to the keyring through
# libsecret, and every store is READ BACK before it is called a success: on a
# machine with no keyring daemon the whole stack reports success and stores
# nothing. Where there is genuinely no keyring the fallback is a 0600 file and
# the user is told, in those words — a silent fallback is the same lie one step
# later.
pkgname=syn-cal
# pkgver stays 0.1.0 and releases move pkgrel. build-all.sh writes
# "$name-0.1.0.tar.gz" and transforms paths to "$name-0.1.0/" for every
# component, so bumping pkgver leaves makepkg looking for a tarball nothing
# creates.
pkgver=0.1.0
pkgrel=25
pkgdesc="SynapseOS calendar and schedule planner: CalDAV, Google and Microsoft, synced both ways"
arch=('x86_64')
url="https://github.com/velle999/SYNAPSE"
license=('GPL-2.0-or-later')

depends=('glibc')

# curl for the transport. Writing HTTPS by hand is not a thing anyone should do
# and TLS least of all; this is the one dependency that is not a judgement call.
depends+=('curl')

# libxml2 parses the multistatus bodies CalDAV answers with. It looks regular
# enough to tempt a strstr, and then a namespace prefix that is D: on one server
# and d: on the next silently returns the wrong path — after which the client
# writes an event over something else. It is untrusted input off a network, so
# it gets a real parser. Nothing is added by this: libical already needs it.
depends+=('libxml2')

# libsecret keeps the passwords and the OAuth tokens. glib2 comes with it.
depends+=('libsecret' 'glib2')

# json-c reads the token responses. They are untrusted input off a network, and
# hand-rolling JSON string unescaping is where that goes wrong: a token holding
# a backslash is unremarkable, a naive reader truncates it, and the result is an
# authentication failure that looks like a revoked grant.
depends+=('json-c')

# libical expands the recurrence rules and resolves the time zones. This is the
# one dependency that replaces code nobody should write: an RRULE can say "the
# last weekday of every second month, except these four dates", and a weekly
# 09:00 London meeting is 08:00 UTC through the summer and 09:00 through the
# winter — an expander that carries one offset through is wrong for six months
# at a time, and right whenever anybody checks it in July.
depends+=('libical')

makedepends=('meson' 'ninja' 'gcc' 'pkgconf')

# ⚠ radicale IS A TEST DEPENDENCY AND A REAL ONE. The in-memory remote proves
# the sync algorithm and nothing else — it answers exactly what the client
# expects, which is the one thing a real server will not do. Testing against
# Radicale is what found that a percent-encoded UID in an href is refused 403 by
# a real stack while the same event under a plain name is accepted 201. Without
# it those suites skip, and the component still builds.
checkdepends=('radicale')

optdepends=('quickshell: the graphical window (syn-cal gui)'
            'gnome-keyring: somewhere to keep passwords that is not a file'
            'kwallet: the same, on a KDE session'
            'radicale: a CalDAV server of your own to sync against')

# ── Where the source comes from, here and everywhere else ──────────────────
#
# ⛔ ONE source LINE SERVES BOTH, AND THAT IS DELIBERATE. build-all.sh runs
# tools/collect-source.sh, which drops $pkgname-$pkgver.tar.gz beside this file;
# makepkg finds it (`-> Found ...`) and never touches the URL. Anybody WITHOUT
# this checkout has no such file, so makepkg fetches the identical tarball from
# the release that carries this exact pkgver-pkgrel. A second PKGBUILD for
# outside use would be a second set of depends and install rules, free to drift
# from this one — and the person it broke for could not see this file at all.
#
# ⚠ ITS OWN REPOSITORY, NOT THIS ONE. The source release lives at
# github.com/velle999/$pkgname — which is also where the PKGBUILD is published
# as a clonable package repo — because putting them on SYNAPSE's releases page
# buried the ISO downloads under a component tarball per bump, and made the
# newest of those GitHub's "Latest release" for the whole project.
#
# ⚠ THE TAG CARRIES THE pkgrel, so the URL cannot point at the wrong source.
# preflight.sh already refuses a source edit that does not bump pkgrel, which
# means every change to what gets built moves this URL with it.
#
# ⛔ AND sha256sums STAYS 'SKIP'. A real checksum would break every LOCAL build
# the moment somebody edited a source file, because the tarball beside this file
# is regenerated from the working tree and would no longer match. The published
# asset is reproducible instead — collect-source.sh sorts and zeroes the
# timestamps, so `tools/collect-source.sh <name>` at the tagged commit
# re-derives it byte for byte. packaging/README.md has the whole of it.
source=("$pkgname-$pkgver.tar.gz::https://github.com/velle999/$pkgname/releases/download/$pkgver-$pkgrel/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

# ── The OAuth client ids SynapseOS ships ────────────────────────────────────
#
# ⚠ PUBLIC, NOT SECRET. Google and Microsoft both class a desktop application as
# a public client: its id ships in the binary on every machine, and PKCE is what
# keeps an intercepted redirect worthless. Extracting these from the package is
# expected and buys nothing.
#
# ⛔ THEY LIVE HERE, NOT IN meson_options.txt. A build from source with these
# empty refuses `account add-google` and says where to register — which is the
# right answer for a rebuild that is not SynapseOS. Only this package speaks for
# the SynapseOS project, so only this package ships its project's ids.
#
# ⛔ THE PROJECT MUST HAVE THE CalDAV API ENABLED, which is a different product
# in the console from the Calendar API and is off by default. Without it the
# whole flow works — consent, tokens, refresh — and every request then answers
# 403 accessNotConfigured, which reads as a broken sign-in rather than a switch.
#   https://console.cloud.google.com/apis/api/caldav.googleapis.com
#
# Google is the SynapseOS Cloud project 'synapseos-507023'. Microsoft is still
# empty, so `account add-microsoft` continues to ask for --client-id until an
# Azure app registration exists.
_google_client_id='38371099927-5hgfu4tfpk5c1kbcpu48vs48mrf33qqk.apps.googleusercontent.com'
_microsoft_client_id=''
# ⛔ GOOGLE REQUIRES THIS AND DOCUMENTS IT AS NOT CONFIDENTIAL. Desktop-app
# clients are issued a "client secret" that its token endpoint will not do the
# exchange without — sending none fails AFTER the user has already consented,
# with `invalid_request — client_secret is missing`, which is the most
# confusing place available to fail. Public exactly like the id above; PKCE is
# what actually protects the flow. Microsoft refuses one from a public client,
# so there is deliberately no equivalent for it.
#
# The value is on the client's page in the Google Cloud console, under Clients.
#
# ⚠ AND IT CAN BE ROTATED OUT FROM UNDER A RELEASE. The first one shipped here
# was refused by the token endpoint with `invalid_client — The provided client
# secret is invalid`, after consent, and there is nothing in the flow that says
# so until then. The id and the secret are checked separately: a request sent
# with no secret at all answers `client_secret is missing` while a request with
# a wrong one answers `invalid_client`, so the two failures tell you which half
# is stale. `code=bogus` is enough to ask — a secret Google accepts gets as far
# as `invalid_grant — Malformed auth code`.
_google_client_secret='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'

build() {
    cd "$srcdir/syn-cal-0.1.0"
    meson setup build --prefix=/usr --buildtype=release \
        -Dgoogle_client_id="$_google_client_id" \
        -Dmicrosoft_client_id="$_microsoft_client_id" \
        -Dgoogle_client_secret="$_google_client_secret"
    meson compile -C build
}

check() {
    cd "$srcdir/syn-cal-0.1.0"
    # ⚠ Every suite runs against a scratch store under a mktemp -d that the
    # test removes, pointed at by SYNCAL_HOME — a calendar's tests that could
    # reach the real store would be the most dangerous file in this component.
    # The two that talk to a server start their own Radicale on a loopback port
    # with its own storage, and skip rather than fail where radicale is absent:
    # a suite that goes red on a healthy machine is one people learn to ignore.
    # DBUS is pointed at a dead socket so libsecret cannot write into the
    # builder's real login keyring.
    meson test -C build --print-errorlogs
}

package() {
    cd "$srcdir/syn-cal-0.1.0"
    meson install -C build --destdir="$pkgdir"
}
