#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "aucun trousseau ne fonctionne, ce secret est donc allé dans %s (lisible par vous seul).\n         Démarrez un trousseau — gnome-keyring ou kwallet — et redéfinissez-le pour le déplacer."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "il y a %d agendas activés, précisez donc lequel :\n  --in <compte>/<agenda>   juste cette fois\n  syn-cal default <compte>/<agenda>   à partir de maintenant"

#, c-format
msgid "no event here with the id '%s'"
msgstr "aucun événement ici avec l'identifiant « %s »"

#, c-format
msgid "unknown option '%s'"
msgstr "option « %s » inconnue"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "trop de noms pour cet événement : « %s »"

msgid "no default calendar"
msgstr "pas d'agenda par défaut"

msgid "default wants <account>/<calendar>"
msgstr "default attend <compte>/<agenda>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "« %s / %s » n'est pas un agenda activé — syn-cal calendars %s"

msgid "could not save it"
msgstr "impossible de l'enregistrer"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "comment s'appelle-t-il ?  syn-cal new \"Dentiste\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "quand a-t-il lieu ?  --at \"2026-09-21 13:15\", ou --at 2026-09-21 pour toute la journée"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at attend une date et une heure comme \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for attend une durée comme 30m, 1h ou 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind attend une durée comme 15m ou 1h, ou « none »"

msgid "--in wants <account>/<calendar>"
msgstr "--in attend <compte>/<agenda>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "l'événement n'a pas pu être écrit dans %s / %s"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "« %s » ajouté à %s / %s.\n\n  syn-cal sync   (il n'est encore que sur cette machine)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "quel événement ?  syn-cal edit <identifiant> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "« %s » se répète, et syn-cal ne modifiera pas une occurrence d'une série sans perdre le reste. Modifiez-le là où il a été créé."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "« %s » n'a pas de début lisible ici, le modifier le déplacerait"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "rien à changer — passez --title, --at, --for, --remind, --where ou --notes"

msgid "could not write the event back"
msgstr "l'événement n'a pas pu être réécrit"

msgid "which event?  syn-cal delete <id>"
msgstr "quel événement ?  syn-cal delete <identifiant>"

msgid "could not remove the event"
msgstr "l'événement n'a pas pu être supprimé"

#, c-format
msgid "could not read %s in %s / %s"
msgstr "%s n'a pas pu être lu dans %s / %s"

msgid "the refresh token could not be stored"
msgstr "le jeton de rafraîchissement n'a pas pu être enregistré"

msgid "the access token could not be stored"
msgstr "le jeton d'accès n'a pas pu être enregistré"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "« %s » n'a pas d'identifiant client OAuth — voir : syn-cal account add-%s --help"

#, c-format
msgid "'%s' is not signed in — run: syn-cal login %s"
msgstr "« %s » n'est pas connecté — lancez : syn-cal login %s"

#, c-format
msgid "no password for '%s' — run: syn-cal login %s"
msgstr "pas de mot de passe pour « %s » — lancez : syn-cal login %s"

#, c-format
msgid ""
"No accounts yet.\n"
"\n"
"  syn-cal account add work https://caldav.fastmail.com/\n"
msgstr "Aucun compte pour l'instant.\n\n  syn-cal account add work https://caldav.fastmail.com/\n"

msgid "signed in:"
msgstr "connecté :"

#. TRANSLATORS: shown in the accounts list for an account that
#. signs in with a password rather than OAuth. NOT the keyring
#. attribute of the same spelling, which is never translated.
msgid "password"
msgstr "mot de passe"

#, c-format
msgid "               %zu of %zu calendars on, %s %s\n"
msgstr "               %zu agendas activés sur %zu, %s %s\n"

#, c-format
msgid "there is already an account called '%s'"
msgstr "il existe déjà un compte nommé « %s »"

msgid "could not write accounts.conf"
msgstr "accounts.conf n'a pas pu être écrit"

#, c-format
msgid ""
"this build ships no OAuth client id, so it needs one of yours.\n"
"\n"
"  %s: register an application of type 'Desktop app'.\n"
"  Google also issues a client secret for that type and its token endpoint\n"
"  requires it — pass it with --client-secret. Google documents that it is\n"
"  not confidential for an installed application; PKCE is what protects the\n"
"  flow. Microsoft wants no secret from a public client.\n"
"\n"
"  syn-cal account add-%s %s --client-id <the id>"
msgstr "cette version ne contient aucun identifiant client OAuth, il lui en faut donc un à vous.\n\n  %s : enregistrez une application de type « Desktop app ».\n  Google délivre aussi un secret client pour ce type et son point de terminaison\n  de jetons l'exige — passez-le avec --client-secret. Google indique qu'il n'est\n  pas confidentiel pour une application installée ; c'est PKCE qui protège le\n  flux. Microsoft n'attend aucun secret d'un client public.\n\n  syn-cal account add-%s %s --client-id <l'identifiant>"

#, c-format
msgid "no account called '%s'"
msgstr "aucun compte nommé « %s »"

msgid ""
"the provider returned no refresh token, so this will need signing in again "
"when it expires"
msgstr "le fournisseur n'a renvoyé aucun jeton de rafraîchissement, il faudra donc se reconnecter à son expiration"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "« %s » n'a pas de nom d'utilisateur — lancez : syn-cal login %s --user vous@example.org"

#, c-format
msgid "Password for %s at %s: "
msgstr "Mot de passe pour %s sur %s : "

msgid "nothing entered; no change"
msgstr "rien saisi ; aucun changement"

msgid "the password could not be stored"
msgstr "le mot de passe n'a pas pu être enregistré"

#, c-format
msgid "Saved. Where: %s\n"
msgstr "Enregistré. Où : %s\n"

msgid "nothing found"
msgstr "rien trouvé"

#, c-format
msgid ""
"Found %zu calendar on '%s':\n"
"\n"
msgid_plural ""
"Found %zu calendars on '%s':\n"
"\n"
msgstr[0] "%zu agenda trouvé sur « %s » :\n\n"
msgstr[1] "%zu agendas trouvés sur « %s » :\n\n"

#, c-format
msgid ""
"\n"
"All switched on. `syn-cal disable %s \"<name>\"` turns one off.\n"
msgstr "\nTous activés. `syn-cal disable %s \"<nom>\"` en désactive un.\n"

#, c-format
msgid ""
"\n"
"Anything new starts switched off.\n"
"  syn-cal enable %s \"<name>\"\n"
msgstr "\nToute nouveauté démarre désactivée.\n  syn-cal enable %s \"<nom>\"\n"

#, c-format
msgid "'%s' has no calendar called '%s' — run: syn-cal calendars %s"
msgstr "« %s » n'a pas d'agenda nommé « %s » — lancez : syn-cal calendars %s"

msgid "sync failed"
msgstr "échec de la synchronisation"

#, c-format
msgid "  %s / %s: %u down, %u up, %u removed here, %u removed there"
msgstr "  %s / %s : %u descendus, %u montés, %u supprimés ici, %u supprimés là-bas"

#, c-format
msgid ", %u conflict kept"
msgid_plural ", %u conflicts kept"
msgstr[0] ", %u conflit conservé"
msgstr[1] ", %u conflits conservés"

msgid "no accounts yet — run: syn-cal account add ..."
msgstr "aucun compte pour l'instant — lancez : syn-cal account add ..."

#, c-format
msgid "Some calendars did not sync — see the messages above.\n"
msgstr "Certains agendas n'ont pas été synchronisés — voir les messages ci-dessus.\n"

#, c-format
msgid "Already up to date.\n"
msgstr "Déjà à jour.\n"

#, c-format
msgid ""
"%u conflict — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgid_plural ""
"%u conflicts — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgstr[0] "%u conflit — les deux copies ont été conservées. Cherchez les événements se terminant par « -syncal-local- ».\n"
msgstr[1] "%u conflits — les deux copies ont été conservées. Cherchez les événements se terminant par « -syncal-local- ».\n"

