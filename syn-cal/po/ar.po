"move it."
msgstr "لا توجد حلقة مفاتيح تعمل، لذلك ذهب هذا السر إلى %s (يمكنك أنت وحدك قراءته).\n         شغّل حلقة مفاتيح — gnome-keyring أو kwallet — ثم اضبطه من جديد لنقله."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "هناك %d تقاويم مفعّلة، فحدّد أيها:\n  --in <حساب>/<تقويم>   هذه المرة فقط\n  syn-cal default <حساب>/<تقويم>   من الآن فصاعدًا"

#, c-format
msgid "no event here with the id '%s'"
msgstr "لا يوجد هنا حدث بالمعرّف «%s»"

#, c-format
msgid "unknown option '%s'"
msgstr "خيار غير معروف «%s»"

#, c-format
