msgstr "لم يُعِد المزوّد أي رمز تحديث، لذا سيلزم تسجيل الدخول من جديد عند انتهاء صلاحيته"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "ليس لـ «%s» اسم مستخدم — نفّذ: syn-cal login %s --user you@example.org"

#, c-format
msgid "Password for %s at %s: "
msgstr "كلمة مرور %s على %s: "

msgid "nothing entered; no change"
msgstr "لم يُدخل شيء؛ بلا تغيير"

msgid "the password could not be stored"
