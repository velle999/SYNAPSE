msgstr "أسماء كثيرة جدًا لهذا الحدث: «%s»"

msgid "no default calendar"
msgstr "لا يوجد تقويم افتراضي"

msgid "default wants <account>/<calendar>"
msgstr "‏default يحتاج إلى <حساب>/<تقويم>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "«%s / %s» ليس تقويمًا مفعّلًا — syn-cal calendars %s"

msgid "could not save it"
msgstr "تعذّر حفظه"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "ما اسمه؟  syn-cal new \"طبيب الأسنان\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "متى موعده؟  --at \"2026-09-21 13:15\"، أو --at 2026-09-21 ليوم كامل"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "‏--at يحتاج إلى تاريخ ووقت مثل \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "‏--for يحتاج إلى مدة مثل 30m أو 1h أو 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "‏--remind يحتاج إلى مدة مثل 15m أو 1h، أو «none»"

msgid "--in wants <account>/<calendar>"
msgstr "‏--in يحتاج إلى <حساب>/<تقويم>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "تعذّرت كتابة الحدث في %s / %s"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "أُضيف «%s» إلى %s / %s.\n\n  syn-cal sync   (ما زال على هذا الجهاز فقط)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "أي حدث؟  syn-cal edit <معرّف> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "«%s» متكرر، ولن يحرّر syn-cal حدثًا واحدًا من سلسلة دون فقدان بقيتها. غيّره حيث أُنشئ."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "ليس لـ «%s» بداية يمكن قراءتها، لذا فإن تحريره سينقله"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "لا شيء لتغييره — مرّر ‎--title أو ‎--at أو ‎--for أو ‎--remind أو ‎--where أو ‎--notes"

msgid "could not write the event back"
msgstr "تعذّرت إعادة كتابة الحدث"

msgid "which event?  syn-cal delete <id>"
msgstr "أي حدث؟  syn-cal delete <معرّف>"

msgid "could not remove the event"
msgstr "تعذّر حذف الحدث"

#, c-format
msgid "could not read %s in %s / %s"
msgstr "تعذّرت قراءة %s في %s / %s"

