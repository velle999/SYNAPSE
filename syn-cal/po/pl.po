msgstr "--remind wymaga czasu, np. 15m lub 1h, albo „none”"

msgid "--in wants <account>/<calendar>"
msgstr "--in wymaga <konto>/<kalendarz>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "nie udało się zapisać wydarzenia w %s / %s"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "Dodano „%s” do %s / %s.\n\n  syn-cal sync   (na razie jest tylko na tym komputerze)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "które wydarzenie?  syn-cal edit <id> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "„%s” się powtarza, a syn-cal nie zmieni jednego wystąpienia serii bez utraty reszty. Zmień je tam, gdzie zostało utworzone."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "„%s” nie ma czytelnego początku, więc edycja przesunęłaby je"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "nie ma czego zmieniać — podaj --title, --at, --for, --remind, --where lub --notes"

msgid "could not write the event back"
msgstr "nie udało się zapisać wydarzenia z powrotem"

