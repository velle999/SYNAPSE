#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "włączonych jest %d kalendarzy, więc wskaż który:\n  --in <konto>/<kalendarz>   tylko ten raz\n  syn-cal default <konto>/<kalendarz>   od teraz"

#, c-format
msgid "no event here with the id '%s'"
msgstr "nie ma tu wydarzenia o identyfikatorze „%s”"

#, c-format
msgid "unknown option '%s'"
msgstr "nieznana opcja „%s”"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "zbyt wiele nazw dla tego wydarzenia: „%s”"

msgid "no default calendar"
msgstr "brak domyślnego kalendarza"

msgid "default wants <account>/<calendar>"
msgstr "default wymaga <konto>/<kalendarz>"

