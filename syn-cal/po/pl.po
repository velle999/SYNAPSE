msgstr "nie udało się zapisać tokenu odświeżania"

msgid "the access token could not be stored"
msgstr "nie udało się zapisać tokenu dostępu"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "„%s” nie ma identyfikatora klienta OAuth — zobacz: syn-cal account add-%s --help"

