msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "„%s / %s” nie jest włączonym kalendarzem — syn-cal calendars %s"

msgid "could not save it"
msgstr "nie udało się tego zapisać"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "jak się nazywa?  syn-cal new \"Dentysta\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "kiedy się odbywa?  --at \"2026-09-21 13:15\" albo --at 2026-09-21 na cały dzień"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at wymaga daty i godziny w postaci \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for wymaga czasu trwania, np. 30m, 1h lub 1h30m"

