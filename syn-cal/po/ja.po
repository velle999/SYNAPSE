msgstr ""
"サインインするとブラウザーが開きます。パスワードは %1 に入力します。ここには"
"入力しません。"

msgid "Some calendars did not sync."
msgstr "一部のカレンダーは同期できませんでした。"

msgid "Sync now"
msgstr "今すぐ同期"

msgid "Syncing…"
msgstr "同期しています…"

msgid "TIME"
msgstr "時刻"

