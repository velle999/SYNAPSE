msgstr "\nTodos ligados. `syn-cal disable %s \"<nome>\"` desliga um.\n"

#, c-format
msgid ""
"\n"
"Anything new starts switched off.\n"
"  syn-cal enable %s \"<name>\"\n"
msgstr "\nO que for novo começa desligado.\n  syn-cal enable %s \"<nome>\"\n"

