msgstr "não foi possível ler %s em %s / %s"

msgid "the refresh token could not be stored"
msgstr "não foi possível guardar o token de renovação"

msgid "the access token could not be stored"
msgstr "não foi possível guardar o token de acesso"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "«%s» não tem id de cliente OAuth — veja: syn-cal account add-%s --help"

#, c-format
msgid "'%s' is not signed in — run: syn-cal login %s"
msgstr "«%s» não tem sessão iniciada — execute: syn-cal login %s"

#, c-format
