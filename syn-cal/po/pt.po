#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "não há nenhum porta-chaves em execução, por isso este segredo foi para %s (legível apenas por si).\n         Inicie um porta-chaves — gnome-keyring ou kwallet — e defina-o de novo para o mover."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "há %d calendários ligados, por isso indique qual:\n  --in <conta>/<calendário>   só desta vez\n  syn-cal default <conta>/<calendário>   a partir de agora"

#, c-format
msgid "no event here with the id '%s'"
msgstr "não há aqui nenhum evento com o id «%s»"

#, c-format
msgid "unknown option '%s'"
msgstr "opção «%s» desconhecida"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "demasiados nomes para este evento: «%s»"

msgid "no default calendar"
msgstr "não há calendário predefinido"

msgid "default wants <account>/<calendar>"
msgstr "default precisa de <conta>/<calendário>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "«%s / %s» não é um calendário ligado — syn-cal calendars %s"

msgid "could not save it"
msgstr "não foi possível guardá-lo"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "como se chama?  syn-cal new \"Dentista\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "quando é?  --at \"2026-09-21 13:15\", ou --at 2026-09-21 para o dia todo"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at precisa de uma data e uma hora como \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for precisa de uma duração como 30m, 1h ou 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind precisa de uma duração como 15m ou 1h, ou «none»"

msgid "--in wants <account>/<calendar>"
msgstr "--in precisa de <conta>/<calendário>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "não foi possível escrever o evento em %s / %s"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "«%s» adicionado a %s / %s.\n\n  syn-cal sync   (por agora só está nesta máquina)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "que evento?  syn-cal edit <id> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "«%s» repete-se, e o syn-cal não edita uma ocorrência de uma série sem perder o resto. Altere-o onde foi criado."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "«%s» não tem um início legível, por isso editá-lo iria movê-lo"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "nada a alterar — passe --title, --at, --for, --remind, --where ou --notes"

msgid "could not write the event back"
msgstr "não foi possível reescrever o evento"

msgid "which event?  syn-cal delete <id>"
msgstr "que evento?  syn-cal delete <id>"

msgid "could not remove the event"
msgstr "não foi possível remover o evento"

#, c-format
