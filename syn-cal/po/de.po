msgstr "               %zu von %zu Kalendern ein, %s %s\n"

#, c-format
msgid "there is already an account called '%s'"
msgstr "es gibt bereits ein Konto namens „%s“"

msgid "could not write accounts.conf"
msgstr "accounts.conf konnte nicht geschrieben werden"

#, c-format
msgid ""
"this build ships no OAuth client id, so it needs one of yours.\n"
"\n"
"  %s: register an application of type 'Desktop app'.\n"
"  Google also issues a client secret for that type and its token endpoint\n"
"  requires it — pass it with --client-secret. Google documents that it is\n"
"  not confidential for an installed application; PKCE is what protects the\n"
"  flow. Microsoft wants no secret from a public client.\n"
"\n"
"  syn-cal account add-%s %s --client-id <the id>"
msgstr "diese Fassung enthält keine OAuth-Client-ID, sie braucht also eine von Ihnen.\n\n  %s: registrieren Sie eine Anwendung vom Typ „Desktop app“.\n  Google gibt für diesen Typ auch ein Client-Geheimnis aus, und sein\n  Token-Endpunkt verlangt es — übergeben Sie es mit --client-secret. Google\n  hält fest, dass es bei einer installierten Anwendung nicht vertraulich ist;\n  geschützt wird der Ablauf durch PKCE. Microsoft verlangt von einem\n  öffentlichen Client kein Geheimnis.\n\n  syn-cal account add-%s %s --client-id <die ID>"

#, c-format
msgid "no account called '%s'"
msgstr "kein Konto namens „%s“"

msgid ""
"the provider returned no refresh token, so this will need signing in again "
"when it expires"
msgstr "der Anbieter hat kein Erneuerungs-Token zurückgegeben, es ist also eine erneute Anmeldung nötig, wenn es abläuft"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "„%s“ hat keinen Benutzernamen — führen Sie aus: syn-cal login %s --user sie@example.org"

#, c-format
msgid "Password for %s at %s: "
msgstr "Passwort für %s bei %s: "

msgid "nothing entered; no change"
msgstr "nichts eingegeben; keine Änderung"

msgid "the password could not be stored"
msgstr "das Passwort konnte nicht gespeichert werden"

#, c-format
