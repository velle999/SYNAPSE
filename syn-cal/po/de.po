"\n"
"All switched on. `syn-cal disable %s \"<name>\"` turns one off.\n"
msgstr "\nAlle eingeschaltet. `syn-cal disable %s \"<Name>\"` schaltet einen aus.\n"

#, c-format
msgid ""
"\n"
"Anything new starts switched off.\n"
"  syn-cal enable %s \"<name>\"\n"
msgstr "\nNeues beginnt ausgeschaltet.\n  syn-cal enable %s \"<Name>\"\n"

#, c-format
msgid "'%s' has no calendar called '%s' — run: syn-cal calendars %s"
msgstr "„%s“ hat keinen Kalender namens „%s“ — führen Sie aus: syn-cal calendars %s"

msgid "sync failed"
msgstr "Abgleich fehlgeschlagen"

#, c-format
