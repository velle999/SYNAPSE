#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "kein Schlüsselbund läuft, daher ging dieses Geheimnis an %s (nur für Sie lesbar).\n         Starten Sie einen Schlüsselbund — gnome-keyring oder kwallet — und setzen Sie es erneut, um es zu verschieben."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "es sind %d Kalender eingeschaltet, geben Sie also an, welcher:\n  --in <Konto>/<Kalender>   nur dieses eine Mal\n  syn-cal default <Konto>/<Kalender>   ab jetzt"

#, c-format
msgid "no event here with the id '%s'"
msgstr "kein Termin hier mit der Kennung „%s“"

#, c-format
msgid "unknown option '%s'"
msgstr "unbekannte Option „%s“"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "zu viele Namen für diesen Termin: „%s“"

msgid "no default calendar"
msgstr "kein Standardkalender"

msgid "default wants <account>/<calendar>"
msgstr "default erwartet <Konto>/<Kalender>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "„%s / %s“ ist kein eingeschalteter Kalender — syn-cal calendars %s"

msgid "could not save it"
msgstr "konnte nicht gespeichert werden"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "wie heißt er?  syn-cal new \"Zahnarzt\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "wann ist er?  --at \"2026-09-21 13:15\", oder --at 2026-09-21 für den ganzen Tag"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at erwartet Datum und Uhrzeit wie \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for erwartet eine Dauer wie 30m, 1h oder 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind erwartet eine Dauer wie 15m oder 1h, oder „none“"

msgid "--in wants <account>/<calendar>"
msgstr "--in erwartet <Konto>/<Kalender>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "der Termin konnte nicht in %s / %s geschrieben werden"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "„%s“ zu %s / %s hinzugefügt.\n\n  syn-cal sync   (bisher nur auf diesem Rechner)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "welcher Termin?  syn-cal edit <Kennung> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "„%s“ wiederholt sich, und syn-cal bearbeitet keinen einzelnen Termin einer Serie, ohne den Rest zu verlieren. Ändern Sie ihn dort, wo er angelegt wurde."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "„%s“ hat keinen lesbaren Beginn, eine Bearbeitung würde ihn verschieben"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "nichts zu ändern — geben Sie --title, --at, --for, --remind, --where oder --notes an"

msgid "could not write the event back"
msgstr "der Termin konnte nicht zurückgeschrieben werden"

msgid "which event?  syn-cal delete <id>"
msgstr "welcher Termin?  syn-cal delete <Kennung>"

msgid "could not remove the event"
msgstr "der Termin konnte nicht entfernt werden"

#, c-format
msgid "could not read %s in %s / %s"
msgstr "%s in %s / %s konnte nicht gelesen werden"

msgid "the refresh token could not be stored"
msgstr "das Erneuerungs-Token konnte nicht gespeichert werden"

msgid "the access token could not be stored"
msgstr "das Zugriffs-Token konnte nicht gespeichert werden"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "„%s“ hat keine OAuth-Client-ID — siehe: syn-cal account add-%s --help"

#, c-format
msgid "'%s' is not signed in — run: syn-cal login %s"
msgstr "„%s“ ist nicht angemeldet — führen Sie aus: syn-cal login %s"

#, c-format
msgid "no password for '%s' — run: syn-cal login %s"
msgstr "kein Passwort für „%s“ — führen Sie aus: syn-cal login %s"

#, c-format
msgid ""
"No accounts yet.\n"
"\n"
"  syn-cal account add work https://caldav.fastmail.com/\n"
msgstr "Noch keine Konten.\n\n  syn-cal account add work https://caldav.fastmail.com/\n"

msgid "signed in:"
msgstr "angemeldet:"

#. TRANSLATORS: shown in the accounts list for an account that
#. signs in with a password rather than OAuth. NOT the keyring
#. attribute of the same spelling, which is never translated.
msgid "password"
msgstr "Passwort"

#, c-format
