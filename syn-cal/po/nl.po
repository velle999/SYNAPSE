#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "er draait geen sleutelbos, dus dit geheim ging naar %s (alleen door u leesbaar).\n         Start een sleutelbos — gnome-keyring of kwallet — en stel het opnieuw in om het te verplaatsen."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "er staan %d agenda's aan, geef dus aan welke:\n  --in <account>/<agenda>   alleen deze keer\n  syn-cal default <account>/<agenda>   vanaf nu"

#, c-format
msgid "no event here with the id '%s'"
msgstr "hier is geen afspraak met de id '%s'"

#, c-format
msgid "unknown option '%s'"
msgstr "onbekende optie '%s'"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "te veel namen voor deze afspraak: '%s'"

msgid "no default calendar"
msgstr "geen standaardagenda"

msgid "default wants <account>/<calendar>"
msgstr "default verwacht <account>/<agenda>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "'%s / %s' is geen ingeschakelde agenda — syn-cal calendars %s"

msgid "could not save it"
msgstr "kon het niet opslaan"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "hoe heet hij?  syn-cal new \"Tandarts\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "wanneer is hij?  --at \"2026-09-21 13:15\", of --at 2026-09-21 voor de hele dag"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at verwacht een datum en tijd zoals \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for verwacht een duur zoals 30m, 1h of 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind verwacht een duur zoals 15m of 1h, of 'none'"

msgid "--in wants <account>/<calendar>"
msgstr "--in verwacht <account>/<agenda>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "de afspraak kon niet in %s / %s worden geschreven"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "'%s' toegevoegd aan %s / %s.\n\n  syn-cal sync   (hij staat voorlopig alleen op deze machine)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "welke afspraak?  syn-cal edit <id> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "'%s' herhaalt zich, en syn-cal bewerkt geen enkele afspraak uit een reeks zonder de rest kwijt te raken. Wijzig hem waar hij is gemaakt."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "'%s' heeft geen leesbaar begin, hem bewerken zou hem verplaatsen"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "niets te wijzigen — geef --title, --at, --for, --remind, --where of --notes mee"

msgid "could not write the event back"
msgstr "de afspraak kon niet worden teruggeschreven"

msgid "which event?  syn-cal delete <id>"
msgstr "welke afspraak?  syn-cal delete <id>"

msgid "could not remove the event"
msgstr "de afspraak kon niet worden verwijderd"

#, c-format
