msgstr "%s kon niet in %s / %s worden gelezen"

msgid "the refresh token could not be stored"
msgstr "het vernieuwingstoken kon niet worden opgeslagen"

msgid "the access token could not be stored"
msgstr "het toegangstoken kon niet worden opgeslagen"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "'%s' heeft geen OAuth-client-id — zie: syn-cal account add-%s --help"

#, c-format
msgid "'%s' is not signed in — run: syn-cal login %s"
msgstr "'%s' is niet aangemeld — voer uit: syn-cal login %s"

#, c-format
msgid "no password for '%s' — run: syn-cal login %s"
msgstr "geen wachtwoord voor '%s' — voer uit: syn-cal login %s"

#, c-format
msgid ""
"No accounts yet.\n"
"\n"
"  syn-cal account add work https://caldav.fastmail.com/\n"
msgstr "Nog geen accounts.\n\n  syn-cal account add work https://caldav.fastmail.com/\n"

msgid "signed in:"
msgstr "aangemeld:"

#. TRANSLATORS: shown in the accounts list for an account that
#. signs in with a password rather than OAuth. NOT the keyring
#. attribute of the same spelling, which is never translated.
msgid "password"
msgstr "wachtwoord"

#, c-format
msgid "               %zu of %zu calendars on, %s %s\n"
msgstr "               %zu van %zu agenda's aan, %s %s\n"

#, c-format
msgid "there is already an account called '%s'"
msgstr "er bestaat al een account met de naam '%s'"

msgid "could not write accounts.conf"
msgstr "accounts.conf kon niet worden geschreven"

#, c-format
msgid ""
"this build ships no OAuth client id, so it needs one of yours.\n"
"\n"
"  %s: register an application of type 'Desktop app'.\n"
"  Google also issues a client secret for that type and its token endpoint\n"
"  requires it — pass it with --client-secret. Google documents that it is\n"
"  not confidential for an installed application; PKCE is what protects the\n"
"  flow. Microsoft wants no secret from a public client.\n"
"\n"
"  syn-cal account add-%s %s --client-id <the id>"
msgstr "deze versie bevat geen OAuth-client-id, dus is er een van u nodig.\n\n  %s: registreer een toepassing van het type 'Desktop app'.\n  Google geeft voor dat type ook een client secret uit en het token-eindpunt\n  vereist het — geef het mee met --client-secret. Google documenteert dat het\n  voor een geïnstalleerde toepassing niet vertrouwelijk is; PKCE beschermt de\n  stroom. Microsoft verwacht geen geheim van een openbare client.\n\n  syn-cal account add-%s %s --client-id <de id>"

#, c-format
msgid "no account called '%s'"
msgstr "geen account met de naam '%s'"

msgid ""
"the provider returned no refresh token, so this will need signing in again "
"when it expires"
msgstr "de aanbieder gaf geen vernieuwingstoken terug, dus zal opnieuw aanmelden nodig zijn wanneer het verloopt"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "'%s' heeft geen gebruikersnaam — voer uit: syn-cal login %s --user u@example.org"

#, c-format
