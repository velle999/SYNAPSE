msgid ""
"No accounts yet.\n"
"\n"
"  syn-cal account add work https://caldav.fastmail.com/\n"
msgstr "Учётных записей пока нет.\n\n  syn-cal account add work https://caldav.fastmail.com/\n"

msgid "signed in:"
msgstr "выполнен вход:"

