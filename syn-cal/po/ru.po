#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "связка ключей не запущена, поэтому этот секрет попал в %s (доступно для чтения только вам).\n         Запустите связку ключей — gnome-keyring или kwallet — и задайте его снова, чтобы перенести."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "включено календарей: %d, поэтому укажите, какой:\n  --in <учётная запись>/<календарь>   только в этот раз\n  syn-cal default <учётная запись>/<календарь>   с этого момента"

#, c-format
msgid "no event here with the id '%s'"
msgstr "здесь нет события с идентификатором «%s»"

#, c-format
msgid "unknown option '%s'"
msgstr "неизвестный параметр «%s»"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "слишком много названий для этого события: «%s»"

msgid "no default calendar"
msgstr "нет календаря по умолчанию"

msgid "default wants <account>/<calendar>"
msgstr "default требует <учётная запись>/<календарь>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "«%s / %s» — это не включённый календарь — syn-cal calendars %s"

msgid "could not save it"
msgstr "не удалось сохранить это"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "как оно называется?  syn-cal new \"Стоматолог\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "когда оно?  --at \"2026-09-21 13:15\" или --at 2026-09-21 на весь день"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at требует дату и время в виде \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for требует длительность вида 30m, 1h или 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind требует длительность вида 15m или 1h, либо «none»"

msgid "--in wants <account>/<calendar>"
msgstr "--in требует <учётная запись>/<календарь>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "не удалось записать событие в %s / %s"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "«%s» добавлено в %s / %s.\n\n  syn-cal sync   (пока оно только на этой машине)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "какое событие?  syn-cal edit <идентификатор> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "«%s» повторяется, и syn-cal не станет изменять одно событие серии, не потеряв остальные. Измените его там, где оно было создано."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "у «%s» нет читаемого начала, поэтому изменение сдвинуло бы его"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "нечего менять — передайте --title, --at, --for, --remind, --where или --notes"

msgid "could not write the event back"
msgstr "не удалось записать событие обратно"

msgid "which event?  syn-cal delete <id>"
msgstr "какое событие?  syn-cal delete <идентификатор>"

msgid "could not remove the event"
msgstr "не удалось удалить событие"

#, c-format
msgid "could not read %s in %s / %s"
msgstr "не удалось прочитать %s в %s / %s"

