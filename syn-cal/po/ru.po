msgstr "               включено %zu из %zu календарей, %s %s\n"

#, c-format
msgid "there is already an account called '%s'"
msgstr "учётная запись с именем «%s» уже существует"

msgid "could not write accounts.conf"
msgstr "не удалось записать accounts.conf"

#, c-format
msgid ""
"this build ships no OAuth client id, so it needs one of yours.\n"
"\n"
"  %s: register an application of type 'Desktop app'.\n"
"  Google also issues a client secret for that type and its token endpoint\n"
"  requires it — pass it with --client-secret. Google documents that it is\n"
"  not confidential for an installed application; PKCE is what protects the\n"
"  flow. Microsoft wants no secret from a public client.\n"
"\n"
"  syn-cal account add-%s %s --client-id <the id>"
msgstr "в этой сборке нет идентификатора клиента OAuth, поэтому нужен ваш.\n\n  %s: зарегистрируйте приложение типа «Desktop app».\n  Google также выдаёт для этого типа секрет клиента, и его конечная точка\n  токенов требует его — передайте его через --client-secret. Google указывает,\n  что для установленного приложения он не является конфиденциальным; поток\n  защищает PKCE. Microsoft не требует секрета от публичного клиента.\n\n  syn-cal account add-%s %s --client-id <идентификатор>"

#, c-format
msgid "no account called '%s'"
msgstr "нет учётной записи с именем «%s»"

msgid ""
"the provider returned no refresh token, so this will need signing in again "
"when it expires"
msgstr "поставщик не вернул токен обновления, поэтому по истечении срока потребуется войти заново"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "у «%s» нет имени пользователя — выполните: syn-cal login %s --user vy@example.org"

#, c-format
