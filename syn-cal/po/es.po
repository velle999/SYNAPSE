#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "no hay ningún depósito de claves en marcha, así que este secreto fue a %s (solo legible por usted).\n         Inicie un depósito — gnome-keyring o kwallet — y vuelva a establecerlo para moverlo."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "hay %d calendarios activados, así que indique cuál:\n  --in <cuenta>/<calendario>   solo esta vez\n  syn-cal default <cuenta>/<calendario>   a partir de ahora"

#, c-format
msgid "no event here with the id '%s'"
msgstr "no hay ningún evento aquí con el id «%s»"

#, c-format
msgid "unknown option '%s'"
msgstr "opción «%s» desconocida"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "demasiados nombres para este evento: «%s»"

msgid "no default calendar"
msgstr "no hay calendario predeterminado"

msgid "default wants <account>/<calendar>"
msgstr "default necesita <cuenta>/<calendario>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "«%s / %s» no es un calendario activado — syn-cal calendars %s"

msgid "could not save it"
msgstr "no se pudo guardar"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "¿cómo se llama?  syn-cal new \"Dentista\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "¿cuándo es?  --at \"2026-09-21 13:15\", o --at 2026-09-21 para todo el día"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at necesita una fecha y una hora como \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for necesita una duración como 30m, 1h o 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind necesita una duración como 15m o 1h, o «none»"

msgid "--in wants <account>/<calendar>"
msgstr "--in necesita <cuenta>/<calendario>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "no se pudo escribir el evento en %s / %s"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "«%s» añadido a %s / %s.\n\n  syn-cal sync   (por ahora solo está en esta máquina)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "¿qué evento?  syn-cal edit <id> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "«%s» se repite, y syn-cal no editará una repetición de una serie sin perder el resto. Cámbielo donde se creó."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "«%s» no tiene un inicio que se pueda leer, así que editarlo lo movería"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "nada que cambiar — pase --title, --at, --for, --remind, --where o --notes"

msgid "could not write the event back"
msgstr "no se pudo reescribir el evento"

msgid "which event?  syn-cal delete <id>"
msgstr "¿qué evento?  syn-cal delete <id>"

msgid "could not remove the event"
msgstr "no se pudo eliminar el evento"

#, c-format
msgid "could not read %s in %s / %s"
msgstr "no se pudo leer %s en %s / %s"

msgid "the refresh token could not be stored"
msgstr "no se pudo guardar el token de renovación"

msgid "the access token could not be stored"
msgstr "no se pudo guardar el token de acceso"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "«%s» no tiene id de cliente OAuth — vea: syn-cal account add-%s --help"

#, c-format
msgid "'%s' is not signed in — run: syn-cal login %s"
msgstr "«%s» no ha iniciado sesión — ejecute: syn-cal login %s"

#, c-format
msgid "no password for '%s' — run: syn-cal login %s"
msgstr "no hay contraseña para «%s» — ejecute: syn-cal login %s"

#, c-format
msgid ""
"No accounts yet.\n"
"\n"
"  syn-cal account add work https://caldav.fastmail.com/\n"
msgstr "Aún no hay cuentas.\n\n  syn-cal account add work https://caldav.fastmail.com/\n"

msgid "signed in:"
msgstr "sesión iniciada:"

#. TRANSLATORS: shown in the accounts list for an account that
#. signs in with a password rather than OAuth. NOT the keyring
#. attribute of the same spelling, which is never translated.
msgid "password"
msgstr "contraseña"

#, c-format
msgid "               %zu of %zu calendars on, %s %s\n"
msgstr "               %zu de %zu calendarios activados, %s %s\n"

#, c-format
msgid "there is already an account called '%s'"
msgstr "ya existe una cuenta llamada «%s»"

msgid "could not write accounts.conf"
msgstr "no se pudo escribir accounts.conf"

#, c-format
msgid ""
"this build ships no OAuth client id, so it needs one of yours.\n"
"\n"
"  %s: register an application of type 'Desktop app'.\n"
"  Google also issues a client secret for that type and its token endpoint\n"
"  requires it — pass it with --client-secret. Google documents that it is\n"
"  not confidential for an installed application; PKCE is what protects the\n"
"  flow. Microsoft wants no secret from a public client.\n"
"\n"
"  syn-cal account add-%s %s --client-id <the id>"
msgstr "esta compilación no incluye ningún id de cliente OAuth, así que necesita uno suyo.\n\n  %s: registre una aplicación de tipo «Desktop app».\n  Google también emite un secreto de cliente para ese tipo y su extremo de\n  tokens lo exige — pásele --client-secret. Google documenta que no es\n  confidencial para una aplicación instalada; lo que protege el flujo es PKCE.\n  Microsoft no espera ningún secreto de un cliente público.\n\n  syn-cal account add-%s %s --client-id <el id>"

#, c-format
msgid "no account called '%s'"
msgstr "no hay ninguna cuenta llamada «%s»"

msgid ""
"the provider returned no refresh token, so this will need signing in again "
"when it expires"
msgstr "el proveedor no devolvió ningún token de renovación, así que habrá que iniciar sesión de nuevo cuando caduque"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "«%s» no tiene nombre de usuario — ejecute: syn-cal login %s --user usted@example.org"

#, c-format
msgid "Password for %s at %s: "
msgstr "Contraseña para %s en %s: "

msgid "nothing entered; no change"
msgstr "no se introdujo nada; sin cambios"

msgid "the password could not be stored"
msgstr "no se pudo guardar la contraseña"

#, c-format
msgid "Saved. Where: %s\n"
msgstr "Guardado. Dónde: %s\n"

msgid "nothing found"
msgstr "no se encontró nada"

#, c-format
msgid ""
"Found %zu calendar on '%s':\n"
"\n"
msgid_plural ""
"Found %zu calendars on '%s':\n"
"\n"
msgstr[0] "Se encontró %zu calendario en «%s»:\n\n"
msgstr[1] "Se encontraron %zu calendarios en «%s»:\n\n"

#, c-format
msgid ""
"\n"
"All switched on. `syn-cal disable %s \"<name>\"` turns one off.\n"
msgstr "\nTodos activados. `syn-cal disable %s \"<nombre>\"` desactiva uno.\n"

#, c-format
msgid ""
"\n"
"Anything new starts switched off.\n"
"  syn-cal enable %s \"<name>\"\n"
msgstr "\nLo nuevo empieza desactivado.\n  syn-cal enable %s \"<nombre>\"\n"

#, c-format
msgid "'%s' has no calendar called '%s' — run: syn-cal calendars %s"
msgstr "«%s» no tiene ningún calendario llamado «%s» — ejecute: syn-cal calendars %s"

msgid "sync failed"
msgstr "falló la sincronización"

#, c-format
msgid "  %s / %s: %u down, %u up, %u removed here, %u removed there"
msgstr "  %s / %s: %u bajados, %u subidos, %u eliminados aquí, %u eliminados allí"

#, c-format
msgid ", %u conflict kept"
msgid_plural ", %u conflicts kept"
msgstr[0] ", %u conflicto conservado"
msgstr[1] ", %u conflictos conservados"

msgid "no accounts yet — run: syn-cal account add ..."
msgstr "aún no hay cuentas — ejecute: syn-cal account add ..."

#, c-format
msgid "Some calendars did not sync — see the messages above.\n"
msgstr "Algunos calendarios no se sincronizaron — vea los mensajes de arriba.\n"

#, c-format
msgid "Already up to date.\n"
msgstr "Ya está al día.\n"

#, c-format
msgid ""
"%u conflict — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgid_plural ""
"%u conflicts — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgstr[0] "%u conflicto — se conservaron ambas copias. Busque eventos que terminen en «-syncal-local-».\n"
msgstr[1] "%u conflictos — se conservaron ambas copias. Busque eventos que terminen en «-syncal-local-».\n"

msgid "(no summary)"
msgstr "(sin descripción)"

msgid "--from wants a date like 2026-09-01"
msgstr "--from necesita una fecha como 2026-09-01"

