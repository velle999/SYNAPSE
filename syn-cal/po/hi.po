msgstr "उपयोग: syn-cal account add|remove|show ..."

#, c-format
msgid "unknown command '%s'"
msgstr "अज्ञात कमांड '%s'"

msgid "--from wants a month like 2026-09, or a date in it"
msgstr "--from को 2026-09 जैसा महीना चाहिए, या उसमें की कोई तिथि"

#, c-format
msgid "weekstart wants 'sun' or 'mon', not '%s'"
msgstr "weekstart को 'sun' या 'mon' चाहिए, '%s' नहीं"

msgid "could not write the setting"
msgstr "सेटिंग लिखी नहीं जा सकी"

msgid "that is not a month this machine can represent"
msgstr "यह ऐसा महीना नहीं है जिसे यह मशीन दर्शा सके"

#, c-format
msgid "nothing on in %s"
msgstr "%s में कुछ नहीं है"

#, c-format
msgid ""
"  %s%d event — syn-cal agenda --from %04d-%02d-01 --days %d%s\n"
"\n"
msgid_plural ""
"  %s%d events — syn-cal agenda --from %04d-%02d-01 --days %d%s\n"
"\n"
msgstr[0] "  %s%d कार्यक्रम — syn-cal agenda --from %04d-%02d-01 --days %d%s\n\n"
msgstr[1] "  %s%d कार्यक्रम — syn-cal agenda --from %04d-%02d-01 --days %d%s\n\n"

msgid "cannot read /dev/urandom, and a guessable verifier is worse than none"
msgstr "/dev/urandom पढ़ा नहीं जा सकता, और अनुमान लगाने योग्य सत्यापक न होने से भी बुरा है"

#, c-format
msgid "%s has no UID and cannot be synced"
msgstr "%s के पास कोई UID नहीं है और इसे समन्वयित नहीं किया जा सकता"

#, c-format
msgid "cannot fetch %s: %s"
msgstr "%s प्राप्त नहीं किया जा सकता: %s"

#, c-format
msgid "%s has no UID; it cannot be filed and was skipped"
msgstr "%s के पास कोई UID नहीं है; इसे रखा नहीं जा सकता और छोड़ दिया गया"

#, c-format
msgid "cannot upload %s: %s"
msgstr "%s अपलोड नहीं किया जा सकता: %s"

#, c-format
msgid "cannot delete %s on the server: %s"
msgstr "सर्वर पर %s मिटाया नहीं जा सकता: %s"

#, c-format
msgid "could not keep your version of %s — nothing was overwritten"
msgstr "%s का आपका संस्करण रखा नहीं जा सका — कुछ भी अधिलेखित नहीं हुआ"

msgid "nothing on"
msgstr "कुछ नहीं है"

msgid "←→ day · ↑↓ week · [ ] month · t today · q quit"
msgstr "←→ दिन · ↑↓ सप्ताह · [ ] माह · t आज · q बाहर"

msgid "out of memory"
msgstr "स्मृति समाप्त"

msgid "neither $HOME nor $XDG_DATA_HOME is set"
msgstr "न $HOME सेट है और न $XDG_DATA_HOME"
