#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "कोई कीरिंग नहीं चल रही, इसलिए यह गोपनीय जानकारी %s में गई (केवल आप ही पढ़ सकते हैं)।\n         कोई कीरिंग शुरू करें — gnome-keyring या kwallet — और इसे दोबारा सेट करके स्थानांतरित करें।"

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "%d कैलेंडर चालू हैं, इसलिए बताएँ कि कौन-सा:\n  --in <खाता>/<कैलेंडर>   सिर्फ़ इस बार\n  syn-cal default <खाता>/<कैलेंडर>   अब से"

#, c-format
msgid "no event here with the id '%s'"
msgstr "यहाँ '%s' आईडी वाला कोई कार्यक्रम नहीं है"

#, c-format
msgid "unknown option '%s'"
msgstr "अज्ञात विकल्प '%s'"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "इस कार्यक्रम के लिए बहुत सारे नाम: '%s'"

msgid "no default calendar"
msgstr "कोई डिफ़ॉल्ट कैलेंडर नहीं"

msgid "default wants <account>/<calendar>"
msgstr "default को <खाता>/<कैलेंडर> चाहिए"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "'%s / %s' कोई चालू कैलेंडर नहीं है — syn-cal calendars %s"

msgid "could not save it"
msgstr "इसे सहेजा नहीं जा सका"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "इसका नाम क्या है?  syn-cal new \"दंत चिकित्सक\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "यह कब है?  --at \"2026-09-21 13:15\", या पूरे दिन के लिए --at 2026-09-21"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at को \"2026-09-21 13:15\" जैसी तिथि और समय चाहिए"

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for को 30m, 1h या 1h30m जैसी अवधि चाहिए"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind को 15m या 1h जैसी अवधि चाहिए, या 'none'"

msgid "--in wants <account>/<calendar>"
msgstr "--in को <खाता>/<कैलेंडर> चाहिए"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "कार्यक्रम को %s / %s में नहीं लिखा जा सका"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "'%s' को %s / %s में जोड़ा गया।\n\n  syn-cal sync   (अभी यह केवल इसी मशीन पर है)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "कौन-सा कार्यक्रम?  syn-cal edit <आईडी> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "'%s' दोहराया जाता है, और syn-cal शृंखला की एक घटना को बाकी खोए बिना नहीं बदलेगा। जहाँ इसे बनाया गया था वहीं बदलें।"

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "'%s' का कोई पठनीय आरंभ नहीं है, इसलिए इसे बदलने पर यह खिसक जाएगा"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "बदलने के लिए कुछ नहीं — --title, --at, --for, --remind, --where या --notes दें"

msgid "could not write the event back"
msgstr "कार्यक्रम वापस नहीं लिखा जा सका"

msgid "which event?  syn-cal delete <id>"
msgstr "कौन-सा कार्यक्रम?  syn-cal delete <आईडी>"

msgid "could not remove the event"
msgstr "कार्यक्रम हटाया नहीं जा सका"

#, c-format
msgid "could not read %s in %s / %s"
msgstr "%s / %s में %s को पढ़ा नहीं जा सका"

msgid "the refresh token could not be stored"
msgstr "रिफ़्रेश टोकन सहेजा नहीं जा सका"

msgid "the access token could not be stored"
msgstr "एक्सेस टोकन सहेजा नहीं जा सका"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "'%s' के पास कोई OAuth क्लाइंट आईडी नहीं है — देखें: syn-cal account add-%s --help"

#, c-format
msgid "'%s' is not signed in — run: syn-cal login %s"
msgstr "'%s' साइन इन नहीं है — चलाएँ: syn-cal login %s"

#, c-format
msgid "no password for '%s' — run: syn-cal login %s"
msgstr "'%s' के लिए कोई पासवर्ड नहीं — चलाएँ: syn-cal login %s"

#, c-format
msgid ""
"No accounts yet.\n"
"\n"
"  syn-cal account add work https://caldav.fastmail.com/\n"
msgstr "अभी कोई खाता नहीं।\n\n  syn-cal account add work https://caldav.fastmail.com/\n"

msgid "signed in:"
msgstr "साइन इन:"

#. TRANSLATORS: shown in the accounts list for an account that
#. signs in with a password rather than OAuth. NOT the keyring
#. attribute of the same spelling, which is never translated.
msgid "password"
msgstr "पासवर्ड"

#, c-format
msgid "               %zu of %zu calendars on, %s %s\n"
msgstr "               %zu में से %zu कैलेंडर चालू, %s %s\n"

#, c-format
msgid "there is already an account called '%s'"
msgstr "'%s' नाम का खाता पहले से मौजूद है"

msgid "could not write accounts.conf"
msgstr "accounts.conf लिखा नहीं जा सका"

#, c-format
msgid ""
"this build ships no OAuth client id, so it needs one of yours.\n"
"\n"
"  %s: register an application of type 'Desktop app'.\n"
"  Google also issues a client secret for that type and its token endpoint\n"
"  requires it — pass it with --client-secret. Google documents that it is\n"
"  not confidential for an installed application; PKCE is what protects the\n"
"  flow. Microsoft wants no secret from a public client.\n"
"\n"
"  syn-cal account add-%s %s --client-id <the id>"
msgstr "इस बिल्ड में कोई OAuth क्लाइंट आईडी नहीं है, इसलिए आपकी अपनी चाहिए।\n\n  %s: 'Desktop app' प्रकार का एक अनुप्रयोग पंजीकृत करें।\n  Google उस प्रकार के लिए एक क्लाइंट सीक्रेट भी देता है और उसका टोकन एंडपॉइंट\n  उसे माँगता है — उसे --client-secret के साथ दें। Google लिखता है कि स्थापित\n  अनुप्रयोग के लिए वह गोपनीय नहीं है; प्रवाह की रक्षा PKCE करता है। Microsoft\n  सार्वजनिक क्लाइंट से कोई सीक्रेट नहीं माँगता।\n\n  syn-cal account add-%s %s --client-id <वह आईडी>"

#, c-format
msgid "no account called '%s'"
msgstr "'%s' नाम का कोई खाता नहीं"

msgid ""
"the provider returned no refresh token, so this will need signing in again "
"when it expires"
msgstr "प्रदाता ने कोई रिफ़्रेश टोकन नहीं लौटाया, इसलिए समाप्त होने पर फिर से साइन इन करना होगा"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "'%s' का कोई उपयोगकर्ता नाम नहीं है — चलाएँ: syn-cal login %s --user aap@example.org"

#, c-format
msgid "Password for %s at %s: "
msgstr "%s के लिए %s पर पासवर्ड: "

msgid "nothing entered; no change"
msgstr "कुछ दर्ज नहीं किया गया; कोई बदलाव नहीं"

msgid "the password could not be stored"
msgstr "पासवर्ड सहेजा नहीं जा सका"

#, c-format
msgid "Saved. Where: %s\n"
msgstr "सहेजा गया। कहाँ: %s\n"

msgid "nothing found"
msgstr "कुछ नहीं मिला"

#, c-format
msgid ""
"Found %zu calendar on '%s':\n"
"\n"
msgid_plural ""
"Found %zu calendars on '%s':\n"
"\n"
msgstr[0] "'%2$s' पर %1$zu कैलेंडर मिला:\n\n"
msgstr[1] "'%2$s' पर %1$zu कैलेंडर मिले:\n\n"

#, c-format
msgid ""
"\n"
"All switched on. `syn-cal disable %s \"<name>\"` turns one off.\n"
msgstr "\nसभी चालू। `syn-cal disable %s \"<नाम>\"` एक को बंद करता है।\n"

#, c-format
msgid ""
"\n"
"Anything new starts switched off.\n"
"  syn-cal enable %s \"<name>\"\n"
msgstr "\nनया कुछ भी बंद अवस्था में शुरू होता है।\n  syn-cal enable %s \"<नाम>\"\n"

#, c-format
msgid "'%s' has no calendar called '%s' — run: syn-cal calendars %s"
msgstr "'%s' के पास '%s' नाम का कोई कैलेंडर नहीं — चलाएँ: syn-cal calendars %s"

msgid "sync failed"
msgstr "समन्वयन विफल"

#, c-format
msgid "  %s / %s: %u down, %u up, %u removed here, %u removed there"
msgstr "  %s / %s: %u नीचे, %u ऊपर, %u यहाँ हटाए, %u वहाँ हटाए"

#, c-format
msgid ", %u conflict kept"
msgid_plural ", %u conflicts kept"
msgstr[0] ", %u टकराव रखा गया"
msgstr[1] ", %u टकराव रखे गए"

msgid "no accounts yet — run: syn-cal account add ..."
msgstr "अभी कोई खाता नहीं — चलाएँ: syn-cal account add ..."

#, c-format
msgid "Some calendars did not sync — see the messages above.\n"
msgstr "कुछ कैलेंडर समन्वयित नहीं हुए — ऊपर के संदेश देखें।\n"

#, c-format
msgid "Already up to date.\n"
msgstr "पहले से अद्यतन।\n"

#, c-format
msgid ""
"%u conflict — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgid_plural ""
"%u conflicts — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgstr[0] "%u टकराव — दोनों प्रतियाँ रखी गईं। '-syncal-local-' पर समाप्त होने वाले कार्यक्रम देखें।\n"
msgstr[1] "%u टकराव — दोनों प्रतियाँ रखी गईं। '-syncal-local-' पर समाप्त होने वाले कार्यक्रम देखें।\n"

msgid "(no summary)"
msgstr "(कोई विवरण नहीं)"

msgid "--from wants a date like 2026-09-01"
msgstr "--from को 2026-09-01 जैसी तिथि चाहिए"

msgid "--from: that is not a date this machine can represent"
msgstr "--from: यह ऐसी तिथि नहीं है जिसे यह मशीन दर्शा सके"

msgid "could not read the calendars"
msgstr "कैलेंडर पढ़े नहीं जा सके"

#, c-format
msgid "Nothing in the next %d day.\n"
msgid_plural "Nothing in the next %d days.\n"
msgstr[0] "अगले %d दिन में कुछ नहीं।\n"
msgstr[1] "अगले %d दिनों में कुछ नहीं।\n"

#, c-format
msgid "  all day   %s"
msgstr "  पूरे दिन   %s"

#, c-format
