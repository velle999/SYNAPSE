#, c-format
msgid ""
"no keyring is running, so this secret went to %s (readable only by you).\n"
"         Start a keyring — gnome-keyring or kwallet — and set it again to "
"move it."
msgstr "non è in esecuzione alcun portachiavi, quindi questo segreto è finito in %s (leggibile solo da lei).\n         Avvii un portachiavi — gnome-keyring o kwallet — e lo imposti di nuovo per spostarlo."

#, c-format
msgid ""
"there are %d calendars switched on, so say which:\n"
"  --in <account>/<calendar>   just this once\n"
"  syn-cal default <account>/<calendar>   from now on"
msgstr "ci sono %d calendari attivi, quindi indichi quale:\n  --in <account>/<calendario>   solo per questa volta\n  syn-cal default <account>/<calendario>   d'ora in poi"

#, c-format
msgid "no event here with the id '%s'"
msgstr "nessun evento qui con l'id «%s»"

#, c-format
msgid "unknown option '%s'"
msgstr "opzione «%s» sconosciuta"

#, c-format
msgid "too many things to call this event: '%s'"
msgstr "troppi nomi per questo evento: «%s»"

msgid "no default calendar"
msgstr "nessun calendario predefinito"

msgid "default wants <account>/<calendar>"
msgstr "default richiede <account>/<calendario>"

#, c-format
msgid "'%s / %s' is not a calendar that is switched on — syn-cal calendars %s"
msgstr "«%s / %s» non è un calendario attivo — syn-cal calendars %s"

msgid "could not save it"
msgstr "non è stato possibile salvarlo"

msgid "what is it called?  syn-cal new \"Dentist\" --at \"2026-09-21 13:15\""
msgstr "come si chiama?  syn-cal new \"Dentista\" --at \"2026-09-21 13:15\""

msgid "when is it?  --at \"2026-09-21 13:15\", or --at 2026-09-21 for all day"
msgstr "quando è?  --at \"2026-09-21 13:15\", oppure --at 2026-09-21 per tutto il giorno"

msgid "--at wants a date and time like \"2026-09-21 13:15\""
msgstr "--at richiede una data e un'ora come \"2026-09-21 13:15\""

msgid "--for wants a length like 30m, 1h or 1h30m"
msgstr "--for richiede una durata come 30m, 1h o 1h30m"

msgid "--remind wants a length like 15m or 1h, or 'none'"
msgstr "--remind richiede una durata come 15m o 1h, oppure «none»"

msgid "--in wants <account>/<calendar>"
msgstr "--in richiede <account>/<calendario>"

#, c-format
msgid "could not write the event into %s / %s"
msgstr "non è stato possibile scrivere l'evento in %s / %s"

#, c-format
msgid ""
"Added '%s' to %s / %s.\n"
"\n"
"  syn-cal sync   (it is only on this machine so far)\n"
msgstr "«%s» aggiunto a %s / %s.\n\n  syn-cal sync   (per ora è solo su questa macchina)\n"

msgid "which event?  syn-cal edit <id> --title \"...\""
msgstr "quale evento?  syn-cal edit <id> --title \"...\""

#, c-format
msgid ""
"'%s' repeats, and syn-cal will not edit one occurrence of a series without "
"losing the rest of it. Change it where it was made."
msgstr "«%s» si ripete, e syn-cal non modifica una singola occorrenza di una serie senza perdere il resto. Lo modifichi dove è stato creato."

#, c-format
msgid "'%s' has no start this can read, so editing it would move it"
msgstr "«%s» non ha un inizio leggibile, quindi modificarlo lo sposterebbe"

msgid ""
"nothing to change — pass --title, --at, --for, --remind, --where or --notes"
msgstr "niente da cambiare — passi --title, --at, --for, --remind, --where o --notes"

msgid "could not write the event back"
msgstr "non è stato possibile riscrivere l'evento"

msgid "which event?  syn-cal delete <id>"
msgstr "quale evento?  syn-cal delete <id>"

msgid "could not remove the event"
msgstr "non è stato possibile rimuovere l'evento"

#, c-format
msgid "could not read %s in %s / %s"
msgstr "non è stato possibile leggere %s in %s / %s"

msgid "the refresh token could not be stored"
msgstr "non è stato possibile salvare il token di aggiornamento"

msgid "the access token could not be stored"
msgstr "non è stato possibile salvare il token di accesso"

#, c-format
msgid "'%s' has no OAuth client id — see: syn-cal account add-%s --help"
msgstr "«%s» non ha un id client OAuth — vedi: syn-cal account add-%s --help"

#, c-format
msgid "'%s' is not signed in — run: syn-cal login %s"
msgstr "«%s» non ha effettuato l'accesso — esegua: syn-cal login %s"

#, c-format
msgid "no password for '%s' — run: syn-cal login %s"
msgstr "nessuna password per «%s» — esegua: syn-cal login %s"

#, c-format
msgid ""
"No accounts yet.\n"
"\n"
"  syn-cal account add work https://caldav.fastmail.com/\n"
msgstr "Ancora nessun account.\n\n  syn-cal account add work https://caldav.fastmail.com/\n"

msgid "signed in:"
msgstr "accesso effettuato:"

#. TRANSLATORS: shown in the accounts list for an account that
#. signs in with a password rather than OAuth. NOT the keyring
#. attribute of the same spelling, which is never translated.
msgid "password"
msgstr "password"

#, c-format
msgid "               %zu of %zu calendars on, %s %s\n"
msgstr "               %zu di %zu calendari attivi, %s %s\n"

#, c-format
msgid "there is already an account called '%s'"
msgstr "esiste già un account chiamato «%s»"

msgid "could not write accounts.conf"
msgstr "non è stato possibile scrivere accounts.conf"

#, c-format
msgid ""
"this build ships no OAuth client id, so it needs one of yours.\n"
"\n"
"  %s: register an application of type 'Desktop app'.\n"
"  Google also issues a client secret for that type and its token endpoint\n"
"  requires it — pass it with --client-secret. Google documents that it is\n"
"  not confidential for an installed application; PKCE is what protects the\n"
"  flow. Microsoft wants no secret from a public client.\n"
"\n"
"  syn-cal account add-%s %s --client-id <the id>"
msgstr "questa versione non include alcun id client OAuth, quindi ne serve uno suo.\n\n  %s: registri un'applicazione di tipo «Desktop app».\n  Google emette anche un client secret per quel tipo e il suo endpoint dei token\n  lo richiede — lo passi con --client-secret. Google documenta che non è\n  riservato per un'applicazione installata; a proteggere il flusso è PKCE.\n  Microsoft non richiede alcun segreto da un client pubblico.\n\n  syn-cal account add-%s %s --client-id <l'id>"

#, c-format
msgid "no account called '%s'"
msgstr "nessun account chiamato «%s»"

msgid ""
"the provider returned no refresh token, so this will need signing in again "
"when it expires"
msgstr "il fornitore non ha restituito alcun token di aggiornamento, quindi servirà accedere di nuovo alla scadenza"

#, c-format
msgid "'%s' has no username — run: syn-cal login %s --user you@example.org"
msgstr "«%s» non ha un nome utente — esegua: syn-cal login %s --user lei@example.org"

#, c-format
msgid "Password for %s at %s: "
msgstr "Password per %s su %s: "

msgid "nothing entered; no change"
msgstr "non è stato inserito nulla; nessuna modifica"

msgid "the password could not be stored"
msgstr "non è stato possibile salvare la password"

#, c-format
msgid "Saved. Where: %s\n"
msgstr "Salvato. Dove: %s\n"

msgid "nothing found"
msgstr "non è stato trovato nulla"

#, c-format
msgid ""
"Found %zu calendar on '%s':\n"
"\n"
msgid_plural ""
"Found %zu calendars on '%s':\n"
"\n"
msgstr[0] "Trovato %zu calendario su «%s»:\n\n"
msgstr[1] "Trovati %zu calendari su «%s»:\n\n"

#, c-format
msgid ""
"\n"
"All switched on. `syn-cal disable %s \"<name>\"` turns one off.\n"
msgstr "\nTutti attivi. `syn-cal disable %s \"<nome>\"` ne disattiva uno.\n"

#, c-format
msgid ""
"\n"
"Anything new starts switched off.\n"
"  syn-cal enable %s \"<name>\"\n"
msgstr "\nLe novità partono disattivate.\n  syn-cal enable %s \"<nome>\"\n"

#, c-format
msgid "'%s' has no calendar called '%s' — run: syn-cal calendars %s"
msgstr "«%s» non ha un calendario chiamato «%s» — esegua: syn-cal calendars %s"

msgid "sync failed"
msgstr "sincronizzazione non riuscita"

#, c-format
msgid "  %s / %s: %u down, %u up, %u removed here, %u removed there"
msgstr "  %s / %s: %u scaricati, %u caricati, %u rimossi qui, %u rimossi là"

#, c-format
msgid ", %u conflict kept"
msgid_plural ", %u conflicts kept"
msgstr[0] ", %u conflitto conservato"
msgstr[1] ", %u conflitti conservati"

msgid "no accounts yet — run: syn-cal account add ..."
msgstr "ancora nessun account — esegua: syn-cal account add ..."

#, c-format
msgid "Some calendars did not sync — see the messages above.\n"
msgstr "Alcuni calendari non sono stati sincronizzati — veda i messaggi qui sopra.\n"

#, c-format
msgid "Already up to date.\n"
msgstr "Già aggiornato.\n"

#, c-format
msgid ""
"%u conflict — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgid_plural ""
"%u conflicts — both copies were kept. Look for events ending '-syncal-"
"local-'.\n"
msgstr[0] "%u conflitto — sono state conservate entrambe le copie. Cerchi gli eventi che finiscono con «-syncal-local-».\n"
msgstr[1] "%u conflitti — sono state conservate entrambe le copie. Cerchi gli eventi che finiscono con «-syncal-local-».\n"

