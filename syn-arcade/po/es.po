#, c-format
msgid "[%d/%d] %-14s press %s\n"
msgstr "[%d/%d] %-14s pulsa %s\n"

#, c-format
msgid "        %-14s = %s\n"
msgstr "        %-14s = %s\n"

#, c-format
msgid "        %-14s — skipped\n"
msgstr "        %-14s — saltado\n"

#, c-format
msgid "        that is already %s. Try another control.\n"
msgstr "        eso ya es %s. Prueba otro control.\n"

msgid ""
"syn-arcade: no controller. Plug one in — this reads the pad you are\n"
"            holding, so there is nothing to learn without one.\n"
msgstr "syn-arcade: no hay mando. Conecta uno — esto lee el mando que tienes en la\n            mano, así que sin uno no hay nada que aprender.\n"

#, c-format
msgid "syn-arcade: no controller matching '%s'\n"
msgstr "syn-arcade: ningún mando coincide con '%s'\n"

#, c-format
msgid "syn-arcade: SDL would not start: %s\n"
msgstr "syn-arcade: SDL no quiso arrancar: %s\n"

msgid ""
"\n"
"Press each control as it is named. Enter skips one this pad does not\n"
"have, `back` re-does the last, `cancel` stops.\n"
msgstr "\nPulsa cada control cuando se nombre. Intro se salta uno que este mando no\ntiene, `back` repite el anterior, `cancel` para.\n"

msgid "syn-arcade: no Wayland session — `big mouse` moves the compositor's pointer and needs one\n"
msgstr "syn-arcade: no hay sesión Wayland — `big mouse` mueve el puntero del compositor y la necesita\n"

msgid "syn-arcade: cannot connect to the Wayland display\n"
msgstr "syn-arcade: no se puede conectar con la pantalla Wayland\n"

msgid ""
"syn-arcade: this compositor does not offer zwlr_virtual_pointer_manager_v1, so a controller cannot move the pointer.\n"
"On SynapseOS that means synui is older than the feature — update it.\n"
msgstr "syn-arcade: este compositor no ofrece zwlr_virtual_pointer_manager_v1, así que un mando no puede mover el puntero.\nEn SynapseOS eso significa que synui es anterior a la función — actualízalo.\n"

msgid "syn-arcade: could not create a virtual pointer\n"
msgstr "syn-arcade: no se pudo crear un puntero virtual\n"
