msgstr "syn-arcade: pads test <手柄>\n"

msgid "syn-arcade: pads rumble <controller>\n"
msgstr "syn-arcade: pads rumble <手柄>\n"

msgid "syn-arcade: pads calibrate <controller>\n"
msgstr "syn-arcade: pads calibrate <手柄>\n"

