#, c-format
msgid "syn-arcade: unknown map command '%s'\n"
msgstr "syn-arcade: comando map desconhecido '%s'\n"

#, c-format
msgid "syn-arcade: %s has no SDL_%s\n"
msgstr "syn-arcade: %s não tem SDL_%s\n"

#, c-format
msgid ""
"syn-arcade: SDL is not installed, and the mapping this writes\n"
"            is SDL's own format — its numbering has to come\n"
"            from the library that will read it back.\n"
"            synpkg install sdl3\n"
msgstr "syn-arcade: o SDL não está instalado, e a associação que isto escreve está\n            no formato do próprio SDL — a numeração tem de vir da\n            biblioteca que a vai ler.\n            synpkg install sdl3\n"

msgid "the BOTTOM face button (A, or cross)"
msgstr "o botão de BAIXO (A, ou cruz)"

msgid "the RIGHT face button (B, or circle)"
msgstr "o botão da DIREITA (B, ou círculo)"

msgid "the LEFT face button (X, or square)"
msgstr "o botão da ESQUERDA (X, ou quadrado)"

msgid "the TOP face button (Y, or triangle)"
msgstr "o botão de CIMA (Y, ou triângulo)"

msgid "the left shoulder button (LB, or L1)"
msgstr "o botão superior esquerdo (LB, ou L1)"

msgid "the right shoulder button (RB, or R1)"
msgstr "o botão superior direito (RB, ou R1)"

msgid "the left trigger, all the way in (LT, L2)"
msgstr "o gatilho esquerdo, até ao fundo (LT, L2)"

msgid "the right trigger, all the way in (RT, R2)"
msgstr "o gatilho direito, até ao fundo (RT, R2)"

msgid "Back, Select or View"
msgstr "Back, Select ou View"

msgid "Start or Menu"
msgstr "Start ou Menu"

msgid "the Guide or Home button, if it has one"
msgstr "o botão Guide ou Home, se tiver um"

msgid "the left stick pressed IN (L3)"
msgstr "o analógico esquerdo premido PARA DENTRO (L3)"

msgid "the right stick pressed IN (R3)"
msgstr "o analógico direito premido PARA DENTRO (R3)"

msgid "the left stick pushed RIGHT"
msgstr "o analógico esquerdo empurrado para a DIREITA"

msgid "the left stick pushed DOWN"
msgstr "o analógico esquerdo empurrado para BAIXO"

msgid "the right stick pushed RIGHT"
msgstr "o analógico direito empurrado para a DIREITA"

msgid "the right stick pushed DOWN"
msgstr "o analógico direito empurrado para BAIXO"

msgid "the d-pad UP"
msgstr "a cruzeta CIMA"

msgid "the d-pad DOWN"
msgstr "a cruzeta BAIXO"

msgid "the d-pad LEFT"
msgstr "a cruzeta ESQUERDA"

msgid "the d-pad RIGHT"
msgstr "a cruzeta DIREITA"

#, c-format
msgid "[%d/%d] %-14s press %s\n"
msgstr "[%d/%d] %-14s prime %s\n"

#, c-format
msgid "        %-14s = %s\n"
msgstr "        %-14s = %s\n"

#, c-format
msgid "        %-14s — skipped\n"
msgstr "        %-14s — saltado\n"

#, c-format
msgid "        that is already %s. Try another control.\n"
msgstr "        isso já é %s. Tenta outro controlo.\n"

msgid ""
"syn-arcade: no controller. Plug one in — this reads the pad you are\n"
"            holding, so there is nothing to learn without one.\n"
msgstr "syn-arcade: não há comando. Liga um — isto lê o comando que tens na mão,\n            por isso sem um não há nada para aprender.\n"

#, c-format
msgid "syn-arcade: no controller matching '%s'\n"
msgstr "syn-arcade: nenhum comando corresponde a '%s'\n"

#, c-format
msgid "syn-arcade: SDL would not start: %s\n"
msgstr "syn-arcade: o SDL não quis arrancar: %s\n"

msgid ""
"\n"
"Press each control as it is named. Enter skips one this pad does not\n"
"have, `back` re-does the last, `cancel` stops.\n"
msgstr "\nPrime cada controlo quando for nomeado. Enter salta um que este comando não\ntem, `back` repete o anterior, `cancel` pára.\n"

msgid "syn-arcade: no Wayland session — `big mouse` moves the compositor's pointer and needs one\n"
msgstr "syn-arcade: não há sessão Wayland — `big mouse` move o ponteiro do compositor e precisa de uma\n"

msgid "syn-arcade: cannot connect to the Wayland display\n"
msgstr "syn-arcade: não é possível ligar ao ecrã Wayland\n"

msgid ""
"syn-arcade: this compositor does not offer zwlr_virtual_pointer_manager_v1, so a controller cannot move the pointer.\n"
"On SynapseOS that means synui is older than the feature — update it.\n"
msgstr "syn-arcade: este compositor não oferece zwlr_virtual_pointer_manager_v1, por isso um comando não consegue mover o ponteiro.\nNo SynapseOS isso quer dizer que o synui é anterior à funcionalidade — actualiza-o.\n"

msgid "syn-arcade: could not create a virtual pointer\n"
msgstr "syn-arcade: não foi possível criar um ponteiro virtual\n"
