#, c-format
msgid "[%d/%d] %-14s press %s\n"
msgstr "[%d/%d] %-14s druk %s\n"

#, c-format
msgid "        %-14s = %s\n"
msgstr "        %-14s = %s\n"

#, c-format
msgid "        %-14s — skipped\n"
msgstr "        %-14s — overgeslagen\n"

#, c-format
msgid "        that is already %s. Try another control.\n"
msgstr "        dat is al %s. Probeer een andere knop.\n"

msgid ""
"syn-arcade: no controller. Plug one in — this reads the pad you are\n"
"            holding, so there is nothing to learn without one.\n"
msgstr "syn-arcade: geen controller. Sluit er een aan — dit leest de pad die je\n            vasthoudt, dus zonder valt er niets te leren.\n"

#, c-format
msgid "syn-arcade: no controller matching '%s'\n"
msgstr "syn-arcade: geen controller die overeenkomt met '%s'\n"

#, c-format
msgid "syn-arcade: SDL would not start: %s\n"
msgstr "syn-arcade: SDL wilde niet starten: %s\n"

msgid ""
"\n"
"Press each control as it is named. Enter skips one this pad does not\n"
"have, `back` re-does the last, `cancel` stops.\n"
msgstr "\nDruk elke knop als hij genoemd wordt. Enter slaat er een over die deze pad\nniet heeft, `back` doet de vorige opnieuw, `cancel` stopt.\n"

msgid "syn-arcade: no Wayland session — `big mouse` moves the compositor's pointer and needs one\n"
msgstr "syn-arcade: geen Wayland-sessie — `big mouse` verplaatst de aanwijzer van de compositor en heeft er een nodig\n"

msgid "syn-arcade: cannot connect to the Wayland display\n"
msgstr "syn-arcade: kan geen verbinding maken met het Wayland-scherm\n"

msgid ""
"syn-arcade: this compositor does not offer zwlr_virtual_pointer_manager_v1, so a controller cannot move the pointer.\n"
"On SynapseOS that means synui is older than the feature — update it.\n"
msgstr "syn-arcade: deze compositor biedt geen zwlr_virtual_pointer_manager_v1, dus een controller kan de aanwijzer niet verplaatsen.\nOp SynapseOS betekent dat dat synui ouder is dan de functie — werk het bij.\n"

msgid "syn-arcade: could not create a virtual pointer\n"
msgstr "syn-arcade: kon geen virtuele aanwijzer maken\n"
