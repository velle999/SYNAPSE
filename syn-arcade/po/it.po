msgstr "la croce direzionale DESTRA"

#, c-format
msgid "[%d/%d] %-14s press %s\n"
msgstr "[%d/%d] %-14s premi %s\n"

#, c-format
msgid "        %-14s = %s\n"
msgstr "        %-14s = %s\n"

#, c-format
msgid "        %-14s — skipped\n"
msgstr "        %-14s — saltato\n"

#, c-format
msgid "        that is already %s. Try another control.\n"
msgstr "        quello è già %s. Prova un altro comando.\n"

msgid ""
"syn-arcade: no controller. Plug one in — this reads the pad you are\n"
"            holding, so there is nothing to learn without one.\n"
msgstr ""
"syn-arcade: nessun controller. Collegane uno — questo legge il pad che hai\n"
"            in mano, quindi senza non c'è nulla da imparare.\n"

#, c-format
msgid "syn-arcade: no controller matching '%s'\n"
msgstr "syn-arcade: nessun controller corrispondente a '%s'\n"

#, c-format
msgid "syn-arcade: SDL would not start: %s\n"
msgstr "syn-arcade: SDL non è voluto partire: %s\n"

msgid ""
"\n"
"Press each control as it is named. Enter skips one this pad does not\n"
"have, `back` re-does the last, `cancel` stops.\n"
msgstr ""
"\n"
"Premi ogni comando quando viene nominato. Invio ne salta uno che questo pad\n"
"non ha, `back` rifà il precedente, `cancel` ferma.\n"

msgid ""
"syn-arcade: no Wayland session — `big mouse` moves the compositor's pointer "
"and needs one\n"
msgstr ""
"syn-arcade: nessuna sessione Wayland — `big mouse` muove il puntatore del "
"compositor e ne ha bisogno\n"

msgid "syn-arcade: cannot connect to the Wayland display\n"
msgstr "syn-arcade: impossibile connettersi al display Wayland\n"

msgid ""
"syn-arcade: this compositor does not offer zwlr_virtual_pointer_manager_v1, "
"so a controller cannot move the pointer.\n"
"On SynapseOS that means synui is older than the feature — update it.\n"
msgstr ""
"syn-arcade: questo compositor non offre zwlr_virtual_pointer_manager_v1, "
"quindi un controller non può muovere il puntatore.\n"
"Su SynapseOS significa che synui è precedente alla funzione — aggiornalo.\n"

msgid "syn-arcade: could not create a virtual pointer\n"
msgstr "syn-arcade: impossibile creare un puntatore virtuale\n"

