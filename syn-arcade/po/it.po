msgstr "il dorsale sinistro (LB, o L1)"

msgid "the right shoulder button (RB, or R1)"
msgstr "il dorsale destro (RB, o R1)"

msgid "the left trigger, all the way in (LT, L2)"
msgstr "il grilletto sinistro, fino in fondo (LT, L2)"

msgid "the right trigger, all the way in (RT, R2)"
msgstr "il grilletto destro, fino in fondo (RT, R2)"

msgid "Back, Select or View"
msgstr "Back, Select o View"

msgid "Start or Menu"
msgstr "Start o Menu"

msgid "the Guide or Home button, if it has one"
msgstr "il pulsante Guide o Home, se ce l'ha"

msgid "the left stick pressed IN (L3)"
msgstr "la levetta sinistra premuta DENTRO (L3)"

msgid "the right stick pressed IN (R3)"
msgstr "la levetta destra premuta DENTRO (R3)"

msgid "the left stick pushed RIGHT"
msgstr "la levetta sinistra spinta a DESTRA"

msgid "the left stick pushed DOWN"
msgstr "la levetta sinistra spinta in BASSO"

msgid "the right stick pushed RIGHT"
msgstr "la levetta destra spinta a DESTRA"

msgid "the right stick pushed DOWN"
msgstr "la levetta destra spinta in BASSO"

msgid "the d-pad UP"
msgstr "la croce direzionale SU"

msgid "the d-pad DOWN"
msgstr "la croce direzionale GIÙ"

