# Maintainer: Velle Sinclair <brncomputerhelp@gmail.com>
#
# syn-mouse — rebind a mouse's buttons without the vendor's app, per game.
#
# A gaming mouse's extra buttons are programmed by a Windows-only vendor tool;
# on Linux they arrive as BTN_SIDE, BTN_EXTRA and so on, and whatever the game
# makes of those is all they can ever do. This takes them over while a named
# app has focus and turns them into keys: held, repeated while held, an
# auto-press TOGGLE that taps a key every few seconds until clicked again, or a
# hold-down latch.
#
# ── how, in one paragraph ───────────────────────────────────────────────────
#
# A user daemon opens every real mouse under /dev/input, and while a profile is
# in force it GRABS it (EVIOCGRAB) and re-emits everything through a uinput
# twin that carries the same capabilities — so the cursor, the wheel's high-res
# steps and every unbound button behave exactly as before, one read and one
# write per frame. Bound buttons go to a second uinput device, a keyboard. With
# no profile in force nothing is grabbed and the daemon only waits.
#
# ⛔ THE TOGGLES STOP WHEN THE GAME LOSES FOCUS. A key auto-pressed into the
# browser somebody alt-tabbed to is the one failure this must never have, so
# bindings stop the instant synui reports another window in front and resume
# when the game comes back. `syn-mouse stop` turns everything off from anywhere.
#
# ⚠ THE LEFT BUTTON CAN ONLY BE BOUND IN A PROFILE FOR A NAMED APP. A profile
# for "everywhere" that took the left button would take the one button that
# could open this program to undo it.
pkgname=syn-mouse
pkgver=0.1.0
# ── 0.1.0-2: thirteen languages ─────────────────────────────────────────────
#
# All 146 strings in de, fr, es, pt, it, nl, pl, ru, ja, zh, ko, hi and ar, from
# ONE po/ compiled twice: a .mo for the binary and JSON for the window.
#
# ⛔ MODE WORDS, KEY NAMES AND `commands` STAY ENGLISH INSIDE THE SENTENCES.
# "use key, repeat, toggle, latch, off or default" lists what `syn-mouse bind`
# takes, so those words are the same in every language; only the prose around
# them moves. The i18n suite proves no --rec record and no button name changes.
#
# ⚠ THE `status` LABELS ARE PADDED PER LANGUAGE, by display width — a CJK
# character is two columns — so each language's lines align with each other.
#
# ── 0.1.0-3: buttons the mouse sends as keys ─────────────────────────────────
#
# A mouse whose onboard memory was programmed in the vendor's app can send a
# KEY for a button: the Viper V3 Pro's thumb button arrives as the key 2 from
# the mouse's own keyboard interface, not as BTN_SIDE, so binding `back` did
# nothing. Such a button is bound by its key — `key:2`, `key:f13`,
# `key:code:N` — and the window lists it the first time the mouse sends it.
#
# ⛔ ONLY THE MOUSE'S OWN KEYBOARD INTERFACES. A keyboard device counts as the
# mouse's keyboard half only when it hangs off the same USB device AND has the
# same vendor:product as a mouse in use, so a keyboard sharing a receiver is
# never taken; and it is grabbed only while the profile in force binds a key
# it can send.
#
# 4: NOT AT THE LOGIN SCREEN. The unit is linked into default.target.wants
# under /usr/lib/systemd/user, so every user manager started it, the
# greeter's included. greetd's `greeter` (uid 963, HOME=/) ran the daemon for
# the 23 s of the login screen on the desktop: it opened and listened to an
# input device and loaded //.config/syn-mouse/bindings.conf. The unit carries
# ConditionUser=!@system now. preflight's userunits check refuses a
# package-enabled user unit without it (it failed on this one).
#
# 5: A MOUSE UNPLUGGED WHILE NOT GRABBED IS LET GO. Only a grabbed mouse is
# polled, and /dev/input was watched for IN_CREATE and IN_ATTRIB only, so
# nothing told the daemon an ungrabbed mouse had gone. On the desktop the
# Viper V3 Pro dropped off USB at 01:58 and came back at 12:27 as event2
# again: the daemon logged its two keyboard halves lost and found, but kept
# the mouse's dead fd (/proc/<pid>/fd: "event2 (deleted)"), and have_node()
# took the new event2 for that one. A binding would then never grab it:
# EVIOCGKEY on the dead fd fails, buttons_down() says "held", and the grab
# retried every 30 ms for good. IN_DELETE now removes whatever was read from
# that node (node_gone()), so the replug is a new device. daemon_test.sh's
# "unplugged and plugged back in" removes and remakes the test FIFO — the
# seam now watches the FIFO's directory the way the daemon watches
# /dev/input: 4 fail on 4, 54/54 on 5 (5 runs, and under ASan+UBSan).
pkgrel=5
pkgdesc="Rebind mouse buttons per game without the vendor's app — keys, repeat, and auto-press toggles"
arch=('x86_64')
url="https://github.com/velle999/SYNAPSE"
license=('GPL-2.0-or-later')

# ⛔ NOTHING BUT libc. The mouse is read with read() and re-emitted with write()
# to /dev/uinput; a library on that path is latency on every frame of every game.
depends=('glibc')

makedepends=('meson' 'ninja' 'gcc' 'pkgconf')
# check(): the daemon and CLI suites serve a fake synui with python3, and the
# i18n suite builds catalogs with the gettext tools.
checkdepends=('python' 'gettext')

optdepends=('quickshell: the graphical window (syn-mouse gui)'
            'libnotify: a notice when a toggle starts or stops'
            'synui: profiles that follow the focused window')

# ⚠ BUILT FROM THIS CHECKOUT ONLY, for now. tools/publish-sources.sh lists it in
# NOT_EXTERNAL until it has a repository of its own.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    meson setup build --prefix=/usr --buildtype=release
    meson compile -C build
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    # ⛔ NO SUITE TOUCHES A REAL DEVICE. The daemon's mouse is a FIFO and its
    # output a text file; the config and every socket are scratch paths. A suite
    # that made a real uinput keyboard would type into the builder's desktop.
    meson test -C build --print-errorlogs
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    meson install -C build --destdir="$pkgdir"

    # ⚠ ON BY DEFAULT, as a user unit: it does nothing until a binding exists —
    # no grab, no focus polling — and a binding that silently did nothing until
    # somebody found the service would read as a broken program.
    # `syn-mouse disable` masks it, which outranks this link.
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../syn-mouse.service \
        "$pkgdir/usr/lib/systemd/user/default.target.wants/syn-mouse.service"
}
