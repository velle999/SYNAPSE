msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` zet ze allemaal uit."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse draait niet, dus er staat niets aan."

msgid "Everything toggled on is off."
msgstr "Alles wat aanstond, staat nu uit."

msgid "systemctl did not do it — see the message above"
msgstr "systemctl heeft het niet gedaan — zie het bericht hierboven"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse staat aan, nu en bij elke aanmelding."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse staat uit en blijft uit bij het aanmelden."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "geen beeldscherm — syn-mouse gui heeft een grafische sessie nodig"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell is niet geïnstalleerd — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "kan quickshell niet starten"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` opent het venster; `syn-mouse --help` geeft de opdrachten weer."

