msgstr "  actief      niets — de muis werkt zoals altijd"

#, c-format
msgid "  mouse      %s — taken over\n"
msgstr "  muis        %s — overgenomen\n"

#, c-format
msgid "  mouse      %s\n"
msgstr "  muis        %s\n"

msgid "  problem    cannot create input devices — this account needs to be in the input group"
msgstr "  probleem    kan geen invoerapparaten aanmaken — dit account moet in de groep input zitten"

msgid "  problem    no mouse it can read"
msgstr "  probleem    geen leesbare muis"

