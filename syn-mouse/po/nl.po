msgstr "Geen muis gevonden."

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "Dit account kan de muis niet lezen. Voeg het toe aan de groep input en meld je daarna af en weer aan:\n  sudo usermod -aG input $USER"

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "Combineer toetsen met + (shift+1). code:N stuurt toetscode N."

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "kan synui niet vragen welke vensters open zijn — is dit een synui-sessie?"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse draait niet. `syn-mouse enable` start het nu en bij elke aanmelding."

