msgstr "syn-mouse नहीं चल रहा, इसलिए कुछ भी चालू नहीं है।"

msgid "Everything toggled on is off."
msgstr "जो भी चालू था, सब बंद हो गया।"

msgid "systemctl did not do it — see the message above"
msgstr "systemctl ने यह नहीं किया — ऊपर का संदेश देखें"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse चालू है, अभी और हर लॉग इन पर।"

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse बंद है, और लॉग इन पर भी बंद रहेगा।"

msgid "no display — syn-mouse gui needs a graphical session"
