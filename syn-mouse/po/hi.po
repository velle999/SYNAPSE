#, c-format
msgid "  paused     %s in [%s]: pressing %s every %s s, once [%s] is in force again\n"
msgstr "  रुका    %s, [%s] में: %s हर %s सेकंड में — जब [%s] फिर लागू हो\n"

#, c-format
