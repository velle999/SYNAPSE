msgstr "कुंजी"

msgid "Left click"
msgstr "बायाँ क्लिक"

msgid "Middle click"
msgstr "बीच का क्लिक"

msgid "Mouse Buttons"
msgstr "माउस बटन"

msgid "Name"
msgstr "नाम"

msgid "No mouse it can read. If one is plugged in, this account needs to be in the input group: sudo usermod -aG input $USER, then log out and back in."
msgstr "पढ़ने लायक कोई माउस नहीं मिला। अगर माउस लगा है, तो इस खाते को input समूह में होना चाहिए: sudo usermod -aG input $USER, फिर लॉग आउट करके दोबारा लॉग इन करें।"

msgid "Normal"
msgstr "सामान्य"

msgid "Not running — your bindings do nothing until it is on."
msgstr "नहीं चल रहा — इसे चालू करने तक आपकी बाइंडिंग कुछ नहीं करेंगी।"

msgid "On: %1 is holding %2 down"
msgstr "चालू: %1, %2 को दबाए हुए है"

msgid "On: %1 is pressing %2 every %3 s"
msgstr "चालू: %1 हर %3 सेकंड में %2 दबा रहा है"

msgid "One click holds the key down; the next click lets go."
msgstr "एक क्लिक कुंजी को दबाए रखता है; अगला क्लिक उसे छोड़ देता है।"

msgid "One click starts pressing the key every few seconds; the next click stops it. It pauses while you are in another window."
msgstr "एक क्लिक से कुंजी हर कुछ सेकंड में दबनी शुरू होती है; अगला क्लिक उसे रोक देता है। जब आप किसी दूसरी विंडो में हों, यह रुका रहता है।"

msgid "Paused until its app is in front: %1 holding %2 down"
msgstr "इसका ऐप सामने आने तक रुका: %1, %2 को दबाए हुए"

msgid "Paused until its app is in front: %1 pressing %2 every %3 s"
msgstr "इसका ऐप सामने आने तक रुका: %1 हर %3 सेकंड में %2 दबाता है"

msgid "Press a key"
msgstr "कुंजी दबाएँ"

msgid "Press a key or a combination…"
msgstr "कोई कुंजी या संयोजन दबाएँ…"

msgid "Pressed again every few seconds for as long as you hold the button."
msgstr "जब तक आप बटन दबाए रखते हैं, हर कुछ सेकंड में फिर से दबती है।"

msgid "Presses %1"
msgstr "%1 दबाता है"

msgid "Refresh the window list"
msgstr "विंडो सूची ताज़ा करें"

msgid "Repeat while held"
msgstr "दबाए रखने पर दोहराएँ"

msgid "Repeats %1 every %2 s while held"
msgstr "दबाए रखने पर हर %2 सेकंड में %1 दोहराता है"

msgid "Right click"
msgstr "दायाँ क्लिक"

msgid "Running. Nothing in force — the mouse is as it always is."
msgstr "चल रहा है। कुछ भी लागू नहीं — माउस हमेशा की तरह काम करता है।"

msgid "Save"
msgstr "सहेजें"

msgid "Save for %1"
msgstr "%1 के लिए सहेजें"

msgid "Saved."
msgstr "सहेजा गया।"

msgid "Show a notice when a toggle switches on or off"
msgstr "टॉगल चालू या बंद होने पर सूचना दिखाएँ"

msgid "Stop everything that is on"
msgstr "जो भी चालू है, सब रोकें"

msgid "The button does nothing at all."
msgstr "बटन कुछ भी नहीं करता।"

msgid "The button does what it always did."
msgstr "बटन वही करता है जो हमेशा करता था।"

msgid "The key is held down for as long as you hold the button."
msgstr "जब तक आप बटन दबाए रखते हैं, कुंजी दबी रहती है।"

msgid "This account cannot read the mouse. Add it to the input group: sudo usermod -aG input $USER, then log out and back in."
msgstr "यह खाता माउस नहीं पढ़ सकता। इसे input समूह में जोड़ें: sudo usermod -aG input $USER, फिर लॉग आउट करके दोबारा लॉग इन करें।"

msgid "Turn on, now and at every login"
msgstr "अभी और हर लॉग इन पर चालू करें"

msgid "Which mouse:"
msgstr "कौन-सा माउस:"

msgid "or a mouse click:"
msgstr "या कोई माउस क्लिक:"

msgid "say what the button should do: key, repeat, toggle, latch, off or default"
msgstr "बताएँ कि बटन क्या करे: key, repeat, toggle, latch, off या default"

msgid "default takes nothing after it"
msgstr "default के बाद कुछ नहीं आता"

msgid "unknown mode — use key, repeat, toggle, latch, off or default"
msgstr "अज्ञात मोड — key, repeat, toggle, latch, off या default इस्तेमाल करें"

msgid "off takes nothing after it"
msgstr "off के बाद कुछ नहीं आता"

msgid "which key? for example: shift, 1, f5, space, mouse1"
msgstr "कौन-सी कुंजी? उदाहरण: shift, 1, f5, space, mouse1"

#, c-format
msgid "'%.*s' is not a key name — `syn-mouse keys` lists them"
msgstr "'%.*s' कोई कुंजी नाम नहीं है — `syn-mouse keys` इनकी सूची दिखाता है"

msgid "every how many seconds?"
msgstr "हर कितने सेकंड में?"

msgid "not a number of seconds — for example 5, 0.5 or 250ms"
msgstr "यह सेकंड की संख्या नहीं है — उदाहरण: 5, 0.5 या 250ms"

msgid "unexpected words after the binding"
msgstr "बाइंडिंग के बाद अनपेक्षित शब्द"

msgid "the interval has to be between 0.05 and 3600 seconds"
msgstr "अंतराल 0.05 और 3600 सेकंड के बीच होना चाहिए"

msgid "the left button can only be rebound in a profile for an app — in one that applies everywhere you could no longer click to undo it"
msgstr "बायाँ बटन केवल किसी ऐप की प्रोफ़ाइल में फिर से असाइन किया जा सकता है — हर जगह लागू होने वाली प्रोफ़ाइल में आप उसे वापस लेने के लिए क्लिक नहीं कर पाएँगे"

