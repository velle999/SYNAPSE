msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell इंस्टॉल नहीं है — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "quickshell शुरू नहीं हो सका"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` विंडो खोलता है; `syn-mouse --help` कमांड की सूची दिखाता है।"

#, c-format
msgid "unknown command '%s'"
msgstr "अज्ञात कमांड '%s'"
