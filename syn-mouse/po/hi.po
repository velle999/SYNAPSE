msgstr "आगे"

msgid "Give the profile a name."
msgstr "प्रोफ़ाइल को एक नाम दें।"

msgid "Hold-down toggle"
msgstr "दबाए रखें (टॉगल)"

msgid "In force in every app"
msgstr "हर ऐप में लागू"

msgid "In force while %1 is in front"
msgstr "जब %1 सामने हो तब लागू"

msgid "In force: %1"
msgstr "लागू: %1"

msgid "Interval in seconds"
msgstr "अंतराल (सेकंड में)"

