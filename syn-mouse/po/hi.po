msgstr "  चालू    %s, [%s] में: %s दबाए हुए\n"

#, c-format
msgid "  paused     %s in [%s]: holding %s down, once [%s] is in force again\n"
msgstr "  रुका    %s, [%s] में: %s दबाए हुए — जब [%s] फिर लागू हो\n"

