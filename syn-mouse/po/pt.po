msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` desliga-os todos."

msgid "syn-mouse is not running, so nothing is on."
msgstr "O syn-mouse não está em execução, por isso nada está ligado."

msgid "Everything toggled on is off."
msgstr "Tudo o que estava ligado está desligado."

msgid "systemctl did not do it — see the message above"
msgstr "o systemctl não o fez — veja a mensagem acima"

msgid "syn-mouse is on, now and at every login."
msgstr "O syn-mouse está ligado, agora e em cada início de sessão."

msgid "syn-mouse is off, and stays off at login."
msgstr "O syn-mouse está desligado e continua desligado no início de sessão."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "sem ecrã — syn-mouse gui precisa de uma sessão gráfica"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "o quickshell não está instalado — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "não foi possível iniciar o quickshell"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` abre a janela; `syn-mouse --help` mostra os comandos."

