msgstr "(nada asignado)"

msgid "  — cannot be read"
msgstr "  — no se puede leer"

msgid "No mouse found."
msgstr "No se encontró ningún ratón."

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "Esta cuenta no puede leer el ratón. Añádela al grupo input y luego cierra la sesión y vuelve a entrar:\n  sudo usermod -aG input $USER"

msgid "A button the mouse's own memory maps to a key sends that key instead, and is bound as key:<name> — key:2 for the key 2. `syn-mouse status` lists the keys it has seen the mouse send."
msgstr "Un botón que la memoria del propio ratón asigna a una tecla envía esa tecla en su lugar, y se asigna como key:<name>: key:2 para la tecla 2. `syn-mouse status` muestra las teclas que ha visto enviar al ratón."

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "Une teclas con + (shift+1). code:N envía el código de tecla N."

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "no se puede preguntar a synui qué ventanas hay abiertas: ¿es una sesión de synui?"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse no está en marcha. `syn-mouse enable` lo inicia ahora y en cada inicio de sesión."

#, c-format
msgid "syn-mouse is running (pid %s)\n"
msgstr "syn-mouse está en marcha (pid %s)\n"

#, c-format
msgid "  focus      %s (%s)\n"
msgstr "  foco       %s (%s)\n"

msgid "  focus      no window"
msgstr "  foco       ninguna ventana"

#, c-format
msgid "  in force   [%s]\n"
msgstr "  activo     [%s]\n"

msgid "  in force   nothing — the mouse is as it always is"
msgstr "  activo     nada: el ratón funciona como siempre"

#, c-format
msgid "  mouse      %s — taken over\n"
msgstr "  ratón      %s — bajo control\n"

#, c-format
msgid "  mouse      %s\n"
msgstr "  ratón      %s\n"

#, c-format
msgid "  sends      %s — a button sends this key; bind it as %s\n"
msgstr "  envía      %s — un botón envía esta tecla; asígnalo como %s\n"

msgid "  problem    cannot create input devices — this account needs to be in the input group"
msgstr "  problema   no se pueden crear dispositivos de entrada: esta cuenta tiene que estar en el grupo input"

msgid "  problem    no mouse it can read"
msgstr "  problema   ningún ratón que pueda leer"

#, c-format
msgid "  on         %s in [%s]: pressing %s every %s s\n"
msgstr "  en marcha  %s en [%s]: pulsa %s cada %s s\n"

#, c-format
msgid "  paused     %s in [%s]: pressing %s every %s s, once [%s] is in force again\n"
msgstr "  en pausa   %s en [%s]: pulsa %s cada %s s, cuando [%s] vuelva a estar activo\n"

