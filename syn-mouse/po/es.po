msgid "saved, but the service is not running, so the mouse does not know yet — `syn-mouse enable` starts it"
msgstr "guardado, pero el servicio no está en marcha, así que el ratón aún no lo sabe: `syn-mouse enable` lo inicia"

msgid "a profile needs a name"
msgstr "un perfil necesita un nombre"

msgid "that name is too long"
msgstr "ese nombre es demasiado largo"

msgid "a profile name cannot contain brackets, tabs or line breaks"
msgstr "un nombre de perfil no puede contener corchetes, tabuladores ni saltos de línea"

