msgid "[%s] — everywhere\n"
msgstr "[%s] — en todas partes\n"

#, c-format
msgid "[%s] — %s, titled %s\n"
msgstr "[%s] — %s, con título %s\n"

#, c-format
msgid "[%s] — %s\n"
msgstr "[%s] — %s\n"

