msgstr "  en pausa   %s en [%s]: mantiene %s pulsada, cuando [%s] vuelva a estar activo\n"

msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` los desactiva todos."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse no está en marcha, así que no hay nada activo."

msgid "Everything toggled on is off."
msgstr "Todo lo que estaba activado está desactivado."

msgid "systemctl did not do it — see the message above"
msgstr "systemctl no lo hizo: mira el mensaje de arriba"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse está activado, ahora y en cada inicio de sesión."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse está desactivado y seguirá así al iniciar sesión."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "no hay pantalla: syn-mouse gui necesita una sesión gráfica"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell no está instalado: synpkg install quickshell"

msgid "could not start quickshell"
msgstr "no se pudo iniciar quickshell"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` abre la ventana; `syn-mouse --help` muestra los comandos."

#, c-format
