msgstr "[%s] 이(가) 이제 어디서나 적용됩니다\n"

#, c-format
msgid "added [%s], for everywhere\n"
msgstr "[%s] 추가됨, 어디서나 적용\n"

#, c-format
msgid "[%s] now applies to %s\n"
msgstr "[%s] 이(가) 이제 %s 에 적용됩니다\n"

#, c-format
msgid "added [%s], for %s\n"
msgstr "[%s] 추가됨, 대상: %s\n"

#, c-format
msgid "removed [%s]\n"
msgstr "[%s] 삭제됨\n"

#, c-format
msgid "'%s' is not a button — `syn-mouse buttons` lists them"
msgstr "'%s' 은(는) 버튼이 아닙니다 — `syn-mouse buttons` 로 목록을 볼 수 있습니다"

#, c-format
msgid "[%s] %s does what it always did\n"
msgstr "[%s] %s 은(는) 원래 하던 일을 합니다\n"

msgid "notify is on or off"
msgstr "notify 는 on 또는 off 입니다"

msgid "No profiles yet. `syn-mouse add <name> --app <app id>` makes one."
msgstr "아직 프로필이 없습니다. `syn-mouse add <name> --app <app id>` 로 만들 수 있습니다."

#, c-format
msgid "[%s] — everywhere\n"
msgstr "[%s] — 어디서나\n"

#, c-format
msgid "[%s] — %s, titled %s\n"
msgstr "[%s] — %s, 제목 %s\n"

#, c-format
msgid "[%s] — %s\n"
msgstr "[%s] — %s\n"

msgid "(nothing bound)"
msgstr "(할당 없음)"

msgid "  — cannot be read"
msgstr "  — 읽을 수 없음"

msgid "No mouse found."
msgstr "마우스를 찾지 못했습니다."

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "이 계정은 마우스를 읽을 수 없습니다. input 그룹에 추가한 뒤 로그아웃했다가 다시 로그인하세요:\n  sudo usermod -aG input $USER"

msgid "A button the mouse's own memory maps to a key sends that key instead, and is bound as key:<name> — key:2 for the key 2. `syn-mouse status` lists the keys it has seen the mouse send."
msgstr "마우스 자체 메모리가 키에 매핑한 버튼은 대신 그 키를 보내며, key:<name> 으로 지정합니다 — 키 2는 key:2. `syn-mouse status` 에서 마우스가 보낸 키 목록을 볼 수 있습니다."

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "키는 + 로 연결합니다 (shift+1). code:N 은 키 코드 N 을 보냅니다."

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "열린 창을 synui 에 물어볼 수 없습니다 — synui 세션인가요?"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse 가 실행 중이 아닙니다. `syn-mouse enable` 로 지금, 그리고 로그인할 때마다 시작합니다."

#, c-format
msgid "syn-mouse is running (pid %s)\n"
msgstr "syn-mouse 실행 중 (pid %s)\n"

