msgstr "Créer le profil pour %1"

msgid "Create the profile for every app"
msgstr "Créer le profil pour toutes les applications"

msgid "Delete this profile"
msgstr "Supprimer ce profil"

msgid "Disabled"
msgstr "Désactivé"

msgid "Everywhere"
msgstr "Partout"

msgid "For every app"
msgstr "Pour toutes les applications"

msgid "Forward"
msgstr "Avant"

msgid "Give the profile a name."
msgstr "Donnez un nom au profil."

msgid "Hold-down toggle"
msgstr "Maintien (bascule)"

msgid "In force in every app"
msgstr "Actif dans toutes les applications"

msgid "In force while %1 is in front"
msgstr "Actif tant que %1 est au premier plan"

msgid "In force: %1"
msgstr "Actif : %1"

msgid "Interval in seconds"
msgstr "Intervalle en secondes"

msgid "Key"
msgstr "Touche"

