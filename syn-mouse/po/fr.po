msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` les désactive tous."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse n'est pas lancé, donc rien n'est actif."

msgid "Everything toggled on is off."
msgstr "Tout ce qui était activé est désactivé."

msgid "systemctl did not do it — see the message above"
msgstr "systemctl ne l'a pas fait — voir le message ci-dessus"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse est activé, maintenant et à chaque connexion."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse est désactivé et le reste à la connexion."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "pas d'affichage — syn-mouse gui a besoin d'une session graphique"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell n'est pas installé — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "impossible de lancer quickshell"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` ouvre la fenêtre ; `syn-mouse --help` liste les commandes."

