msgid "[%s] now applies everywhere\n"
msgstr "[%s] はどこでも有効になりました\n"

#, c-format
msgid "added [%s], for everywhere\n"
msgstr "[%s] を追加しました（どこでも有効）\n"

#, c-format
msgid "[%s] now applies to %s\n"
msgstr "[%s] は %s で有効になりました\n"

#, c-format
msgid "added [%s], for %s\n"
msgstr "[%s] を追加しました（対象: %s）\n"

#, c-format
msgid "removed [%s]\n"
msgstr "[%s] を削除しました\n"

#, c-format
msgid "'%s' is not a button — `syn-mouse buttons` lists them"
msgstr "'%s' はボタンではありません — 一覧は `syn-mouse buttons` で表示できます"

#, c-format
msgid "[%s] %s does what it always did\n"
msgstr "[%s] %s はいつも通りに動作します\n"

msgid "notify is on or off"
msgstr "notify は on か off です"

msgid "No profiles yet. `syn-mouse add <name> --app <app id>` makes one."
msgstr "プロファイルはまだありません。`syn-mouse add <name> --app <app id>` で作成できます。"

#, c-format
msgid "[%s] — everywhere\n"
msgstr "[%s] — どこでも\n"

#, c-format
msgid "[%s] — %s, titled %s\n"
msgstr "[%s] — %s、タイトル %s\n"

#, c-format
msgid "[%s] — %s\n"
msgstr "[%s] — %s\n"

msgid "(nothing bound)"
msgstr "（割り当てなし）"

msgid "  — cannot be read"
msgstr "  — 読み取れません"

msgid "No mouse found."
msgstr "マウスが見つかりません。"

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "このアカウントはマウスを読み取れません。input グループに追加してから、ログアウトしてログインし直してください:\n  sudo usermod -aG input $USER"

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "キーは + でつなぎます（shift+1）。code:N はキーコード N を送ります。"

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "開いているウィンドウを synui に問い合わせできません — synui のセッションですか?"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse は動いていません。`syn-mouse enable` で今すぐ、そしてログインのたびに起動します。"

#, c-format
msgid "syn-mouse is running (pid %s)\n"
msgstr "syn-mouse は動作中です（pid %s）\n"

#, c-format
msgid "  focus      %s (%s)\n"
msgstr "  フォーカス  %s (%s)\n"

msgid "  focus      no window"
msgstr "  フォーカス  ウィンドウなし"

#, c-format
msgid "  in force   [%s]\n"
msgstr "  有効        [%s]\n"

msgid "  in force   nothing — the mouse is as it always is"
msgstr "  有効        なし — マウスはいつも通りです"

#, c-format
msgid "  mouse      %s — taken over\n"
msgstr "  マウス      %s — 引き継ぎ中\n"

#, c-format
msgid "  mouse      %s\n"
msgstr "  マウス      %s\n"

msgid "  problem    cannot create input devices — this account needs to be in the input group"
msgstr "  問題        入力デバイスを作成できません — このアカウントを input グループに入れる必要があります"

msgid "  problem    no mouse it can read"
msgstr "  問題        読み取れるマウスがありません"

#, c-format
msgid "  on         %s in [%s]: pressing %s every %s s\n"
msgstr "  動作中      %s（[%s]）: %s を %s 秒ごとに押す\n"

#, c-format
msgid "  paused     %s in [%s]: pressing %s every %s s, once [%s] is in force again\n"
msgstr "  一時停止    %s（[%s]）: %s を %s 秒ごとに押す — [%s] が再び有効になったら\n"

#, c-format
msgid "  on         %s in [%s]: holding %s down\n"
msgstr "  動作中      %s（[%s]）: %s を押したまま\n"

#, c-format
msgid "  paused     %s in [%s]: holding %s down, once [%s] is in force again\n"
msgstr "  一時停止    %s（[%s]）: %s を押したまま — [%s] が再び有効になったら\n"

msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` ですべてオフになります。"

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse は動いていないので、オンのものはありません。"

msgid "Everything toggled on is off."
msgstr "オンだったものはすべてオフになりました。"

msgid "systemctl did not do it — see the message above"
msgstr "systemctl は実行しませんでした — 上のメッセージを見てください"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse はオンです。今も、ログインのたびにも起動します。"

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse はオフです。ログイン時も起動しません。"

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "ディスプレイがありません — syn-mouse gui にはグラフィカルセッションが必要です"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell がインストールされていません — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "quickshell を起動できませんでした"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` でウィンドウを開きます。`syn-mouse --help` でコマンド一覧を表示します。"

#, c-format
msgid "unknown command '%s'"
msgstr "不明なコマンド '%s'"
