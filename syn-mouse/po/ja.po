msgstr "左ボタン"

msgid "Right button"
msgstr "右ボタン"

msgid "Middle button (wheel click)"
msgstr "中ボタン（ホイールクリック）"

msgid "Thumb button (back)"
msgstr "親指ボタン（戻る）"

msgid "Thumb button (forward)"
msgstr "親指ボタン（進む）"

msgid "Button 6"
msgstr "ボタン 6"

msgid "Button 7"
msgstr "ボタン 7"

msgid "Button 8"
msgstr "ボタン 8"

msgid "Wheel up"
msgstr "ホイール上"

msgid "Wheel down"
msgstr "ホイール下"

msgid "Wheel tilt left"
msgstr "ホイール左チルト"

msgid "Wheel tilt right"
msgstr "ホイール右チルト"

