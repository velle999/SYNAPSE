msgstr "  الفأرة   %s\n"

msgid "  problem    cannot create input devices — this account needs to be in the input group"
msgstr "  مشكلة    تعذّر إنشاء أجهزة إدخال — يجب أن يكون هذا الحساب في مجموعة input"

