msgstr "  — تتعذّر قراءته"

msgid "No mouse found."
msgstr "لم يُعثر على فأرة."

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "لا يستطيع هذا الحساب قراءة الفأرة. أضفه إلى مجموعة input، ثم سجّل الخروج وسجّل الدخول مجددًا:\n  sudo usermod -aG input $USER"

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "اربط المفاتيح بـ + (shift+1). يرسل code:N رمز المفتاح N."

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "تعذّر سؤال synui عن النوافذ المفتوحة — هل هذه جلسة synui؟"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse لا يعمل. `syn-mouse enable` يشغّله الآن وعند كل تسجيل دخول."

