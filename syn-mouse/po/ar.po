msgid "%1 (taken over)"
msgstr "%1 (تحت السيطرة)"

msgid "+ New profile"
msgstr "+ ملف تعريف جديد"

msgid "A profile for every app is in force wherever you are, so the left button cannot be rebound in it."
msgstr "ملف التعريف الخاص بكل التطبيقات مفعّل في كل مكان، لذا لا يمكن إعادة تعيين الزر الأيسر فيه."

msgid "A profile is a set of bindings for one game. It is in force only while that game's window is in front. Start the game, then pick its window here."
msgstr "ملف التعريف مجموعة تعيينات للعبة واحدة، ولا يكون مفعّلًا إلا ما دامت نافذة تلك اللعبة في المقدمة. شغّل اللعبة ثم اختر نافذتها هنا."

msgid "All of them"
msgstr "جميعها"

msgid "Auto-press toggle"
msgstr "ضغط تلقائي (تبديل)"

msgid "Back"
msgstr "رجوع"

msgid "Cannot create input devices. This account needs to be in the input group: sudo usermod -aG input $USER, then log out and back in."
msgstr "تعذّر إنشاء أجهزة إدخال. يجب أن يكون هذا الحساب في مجموعة input: sudo usermod -aG input $USER، ثم سجّل الخروج وسجّل الدخول مجددًا."

msgid "Choose a key first: click the key box and press it."
msgstr "اختر مفتاحًا أولًا: انقر مربع المفتاح ثم اضغطه."

msgid "Click a button to change what it does."
msgstr "انقر زرًا لتغيير ما يفعله."

msgid "Click again to delete %1"
msgstr "انقر مرة أخرى لحذف %1"

msgid "Click here, then press a key"
msgstr "انقر هنا ثم اضغط مفتاحًا"

msgid "Click: auto-press %1 every %2 s"
msgstr "نقرة: يضغط %1 كل %2 ث"

msgid "Click: hold %1 down"
msgstr "نقرة: يُبقي %1 مضغوطًا"

msgid "Create the profile for %1"
msgstr "إنشاء ملف التعريف لـ %1"

msgid "Create the profile for every app"
msgstr "إنشاء ملف التعريف لكل التطبيقات"

msgid "Delete this profile"
msgstr "حذف ملف التعريف هذا"

msgid "Disabled"
msgstr "معطّل"

msgid "Everywhere"
msgstr "في كل مكان"

msgid "For every app"
msgstr "لكل التطبيقات"

msgid "Forward"
msgstr "تقدّم"

msgid "Give the profile a name."
msgstr "أعطِ ملف التعريف اسمًا."

msgid "Hold-down toggle"
msgstr "إبقاء مضغوطًا (تبديل)"

msgid "In force in every app"
msgstr "مفعّل في كل التطبيقات"

msgid "In force while %1 is in front"
msgstr "مفعّل ما دام %1 في المقدمة"

msgid "In force: %1"
msgstr "المفعّل: %1"

msgid "Interval in seconds"
msgstr "الفاصل بالثواني"

msgid "Key"
msgstr "المفتاح"

msgid "Left click"
msgstr "نقرة يسرى"

msgid "Middle click"
msgstr "نقرة وسطى"

msgid "Mouse Buttons"
msgstr "أزرار الفأرة"

msgid "Name"
msgstr "الاسم"

msgid "No mouse it can read. If one is plugged in, this account needs to be in the input group: sudo usermod -aG input $USER, then log out and back in."
msgstr "لا توجد فأرة يمكن قراءتها. إن كانت هناك فأرة موصولة فيجب أن يكون هذا الحساب في مجموعة input: sudo usermod -aG input $USER، ثم سجّل الخروج وسجّل الدخول مجددًا."

msgid "Normal"
msgstr "عادي"

msgid "Not running — your bindings do nothing until it is on."
msgstr "لا يعمل — لن تفعل تعييناتك شيئًا حتى يُشغَّل."

msgid "On: %1 is holding %2 down"
msgstr "مفعّل: %1 يُبقي %2 مضغوطًا"

msgid "On: %1 is pressing %2 every %3 s"
msgstr "مفعّل: %1 يضغط %2 كل %3 ث"

msgid "One click holds the key down; the next click lets go."
msgstr "نقرة واحدة تُبقي المفتاح مضغوطًا، والنقرة التالية تحرّره."

msgid "One click starts pressing the key every few seconds; the next click stops it. It pauses while you are in another window."
msgstr "نقرة واحدة تبدأ ضغط المفتاح كل بضع ثوانٍ، والنقرة التالية توقفه. ويتوقف مؤقتًا ما دمت في نافذة أخرى."

msgid "Paused until its app is in front: %1 holding %2 down"
msgstr "متوقف مؤقتًا حتى يعود تطبيقه إلى المقدمة: %1 يُبقي %2 مضغوطًا"

msgid "Paused until its app is in front: %1 pressing %2 every %3 s"
msgstr "متوقف مؤقتًا حتى يعود تطبيقه إلى المقدمة: %1 يضغط %2 كل %3 ث"

msgid "Press a key"
msgstr "ضغط مفتاح"

msgid "Press a key or a combination…"
msgstr "اضغط مفتاحًا أو تركيبة…"

msgid "Pressed again every few seconds for as long as you hold the button."
msgstr "يُضغط من جديد كل بضع ثوانٍ ما دمت تضغط الزر."

msgid "Presses %1"
msgstr "يضغط %1"

msgid "Refresh the window list"
msgstr "تحديث قائمة النوافذ"

msgid "Repeat while held"
msgstr "التكرار أثناء الضغط"

msgid "Repeats %1 every %2 s while held"
msgstr "يكرر %1 كل %2 ث أثناء الضغط"

msgid "Right click"
msgstr "نقرة يمنى"

msgid "Running. Nothing in force — the mouse is as it always is."
msgstr "يعمل. لا شيء مفعّل — الفأرة كما هي دائمًا."

msgid "Save"
msgstr "حفظ"

msgid "Save for %1"
msgstr "حفظ لـ %1"

msgid "Saved."
msgstr "تم الحفظ."

msgid "Show a notice when a toggle switches on or off"
msgstr "إظهار إشعار عند تشغيل التبديل أو إيقافه"

msgid "Stop everything that is on"
msgstr "إيقاف كل ما هو مفعّل"

msgid "The button does nothing at all."
msgstr "لا يفعل الزر شيئًا على الإطلاق."

msgid "The button does what it always did."
msgstr "يفعل الزر ما كان يفعله دائمًا."

msgid "The key is held down for as long as you hold the button."
msgstr "يبقى المفتاح مضغوطًا ما دمت تضغط الزر."

msgid "This account cannot read the mouse. Add it to the input group: sudo usermod -aG input $USER, then log out and back in."
msgstr "لا يستطيع هذا الحساب قراءة الفأرة. أضفه إلى مجموعة input: sudo usermod -aG input $USER، ثم سجّل الخروج وسجّل الدخول مجددًا."

msgid "Turn on, now and at every login"
msgstr "التشغيل الآن وعند كل تسجيل دخول"

msgid "Which mouse:"
msgstr "أي فأرة:"

msgid "or a mouse click:"
msgstr "أو نقرة فأرة:"

msgid "say what the button should do: key, repeat, toggle, latch, off or default"
msgstr "حدّد ما يجب أن يفعله الزر: key أو repeat أو toggle أو latch أو off أو default"

msgid "default takes nothing after it"
msgstr "لا يُكتب شيء بعد default"

msgid "unknown mode — use key, repeat, toggle, latch, off or default"
msgstr "وضع غير معروف — استخدم key أو repeat أو toggle أو latch أو off أو default"

msgid "off takes nothing after it"
msgstr "لا يُكتب شيء بعد off"

msgid "which key? for example: shift, 1, f5, space, mouse1"
msgstr "أي مفتاح؟ مثلًا: shift و1 وf5 وspace وmouse1"

#, c-format
msgid "'%.*s' is not a key name — `syn-mouse keys` lists them"
msgstr "'%.*s' ليس اسم مفتاح — يعرضها `syn-mouse keys`"

msgid "every how many seconds?"
msgstr "كل كم ثانية؟"

msgid "not a number of seconds — for example 5, 0.5 or 250ms"
msgstr "ليس عددًا من الثواني — مثلًا 5 أو 0.5 أو 250ms"

msgid "unexpected words after the binding"
msgstr "كلمات غير متوقعة بعد التعيين"

msgid "the interval has to be between 0.05 and 3600 seconds"
msgstr "يجب أن يكون الفاصل بين 0.05 و3600 ثانية"

msgid "the left button can only be rebound in a profile for an app — in one that applies everywhere you could no longer click to undo it"
msgstr "لا يمكن إعادة تعيين الزر الأيسر إلا في ملف تعريف لتطبيق — ففي ملف يسري في كل مكان لن تستطيع النقر للتراجع عنه"

