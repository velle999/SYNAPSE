msgstr "  متوقف    %s في [%s]: يُبقي %s مضغوطًا، متى عاد [%s] مفعّلًا\n"

msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` يوقفها كلها."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse لا يعمل، لذا لا شيء مفعّل."

msgid "Everything toggled on is off."
msgstr "كل ما كان مفعّلًا أصبح متوقفًا."

msgid "systemctl did not do it — see the message above"
msgstr "لم ينفّذ systemctl ذلك — راجع الرسالة أعلاه"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse مفعّل، الآن وعند كل تسجيل دخول."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse متوقف، ويبقى كذلك عند تسجيل الدخول."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "لا توجد شاشة — يحتاج syn-mouse gui إلى جلسة رسومية"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell غير مثبّت — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "تعذّر تشغيل quickshell"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` يفتح النافذة، و`syn-mouse --help` يعرض الأوامر."

