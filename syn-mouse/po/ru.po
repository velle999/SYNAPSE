msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` выключает их все."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse не запущен, поэтому ничего не включено."

msgid "Everything toggled on is off."
msgstr "Всё включённое выключено."

msgid "systemctl did not do it — see the message above"
msgstr "systemctl этого не сделал — см. сообщение выше"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse включён — сейчас и при каждом входе."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse выключен и не запустится при входе."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "нет дисплея — syn-mouse gui нужен графический сеанс"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell не установлен — synpkg install quickshell"

