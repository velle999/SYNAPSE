msgstr "каждые сколько секунд?"

msgid "not a number of seconds — for example 5, 0.5 or 250ms"
msgstr "это не число секунд — например, 5, 0.5 или 250ms"

msgid "unexpected words after the binding"
msgstr "лишние слова после назначения"

msgid "the interval has to be between 0.05 and 3600 seconds"
msgstr "интервал должен быть от 0.05 до 3600 секунд"

msgid "the left button can only be rebound in a profile for an app — in one that applies everywhere you could no longer click to undo it"
msgstr "левую кнопку можно переназначить только в профиле для приложения — в профиле, который действует везде, вы уже не смогли бы щёлкнуть, чтобы это отменить"

