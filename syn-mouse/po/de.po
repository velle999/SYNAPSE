msgstr "%s kann nicht gelesen werden: %s"

#, c-format
msgid "cannot write %s: %s"
msgstr "%s kann nicht geschrieben werden: %s"

msgid "saved, but the service is not running, so the mouse does not know yet — `syn-mouse enable` starts it"
msgstr "gespeichert, aber der Dienst läuft nicht, also weiß die Maus noch nichts davon — `syn-mouse enable` startet ihn"

msgid "a profile needs a name"
msgstr "ein Profil braucht einen Namen"

msgid "that name is too long"
msgstr "dieser Name ist zu lang"

msgid "a profile name cannot contain brackets, tabs or line breaks"
msgstr "ein Profilname darf keine Klammern, Tabulatoren oder Zeilenumbrüche enthalten"

msgid "a profile name cannot start or end with a space"
msgstr "ein Profilname darf nicht mit einem Leerzeichen beginnen oder enden"

#, c-format
msgid "no profile called '%s' — `syn-mouse profiles` lists them"
msgstr "kein Profil namens '%s' — `syn-mouse profiles` listet sie auf"

