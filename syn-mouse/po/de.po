msgstr "[%s] %s tut, was sie immer getan hat\n"

msgid "notify is on or off"
msgstr "notify ist on oder off"

msgid "No profiles yet. `syn-mouse add <name> --app <app id>` makes one."
msgstr "Noch keine Profile. `syn-mouse add <name> --app <app id>` legt eins an."

#, c-format
msgid "[%s] — everywhere\n"
msgstr "[%s] — überall\n"

#, c-format
msgid "[%s] — %s, titled %s\n"
msgstr "[%s] — %s, mit dem Titel %s\n"

#, c-format
msgid "[%s] — %s\n"
msgstr "[%s] — %s\n"

msgid "(nothing bound)"
msgstr "(nichts belegt)"

msgid "  — cannot be read"
msgstr "  — nicht lesbar"

msgid "No mouse found."
msgstr "Keine Maus gefunden."

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "Dieses Konto kann die Maus nicht lesen. Füge es der Gruppe input hinzu und melde dich dann ab und wieder an:\n  sudo usermod -aG input $USER"

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "Tasten mit + verbinden (shift+1). code:N sendet den Tastencode N."

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "synui kann nicht nach den offenen Fenstern gefragt werden — ist das eine synui-Sitzung?"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse läuft nicht. `syn-mouse enable` startet es jetzt und bei jeder Anmeldung."

#, c-format
msgid "syn-mouse is running (pid %s)\n"
msgstr "syn-mouse läuft (PID %s)\n"

#, c-format
msgid "  focus      %s (%s)\n"
msgstr "  Fokus     %s (%s)\n"

msgid "  focus      no window"
msgstr "  Fokus     kein Fenster"

#, c-format
msgid "  in force   [%s]\n"
msgstr "  aktiv     [%s]\n"

msgid "  in force   nothing — the mouse is as it always is"
msgstr "  aktiv     nichts — die Maus verhält sich wie immer"

#, c-format
msgid "  mouse      %s — taken over\n"
msgstr "  Maus      %s — übernommen\n"

#, c-format
msgid "  mouse      %s\n"
msgstr "  Maus      %s\n"

msgid "  problem    cannot create input devices — this account needs to be in the input group"
msgstr "  Problem   Eingabegeräte können nicht angelegt werden — dieses Konto muss in der Gruppe input sein"

msgid "  problem    no mouse it can read"
msgstr "  Problem   keine lesbare Maus"

#, c-format
msgid "  on         %s in [%s]: pressing %s every %s s\n"
msgstr "  an        %s in [%s]: drückt %s alle %s s\n"

#, c-format
msgid "  paused     %s in [%s]: pressing %s every %s s, once [%s] is in force again\n"
msgstr "  pausiert  %s in [%s]: drückt %s alle %s s, sobald [%s] wieder aktiv ist\n"

#, c-format
msgid "  on         %s in [%s]: holding %s down\n"
msgstr "  an        %s in [%s]: hält %s gedrückt\n"

#, c-format
msgid "  paused     %s in [%s]: holding %s down, once [%s] is in force again\n"
msgstr "  pausiert  %s in [%s]: hält %s gedrückt, sobald [%s] wieder aktiv ist\n"

msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` schaltet sie alle aus."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse läuft nicht, also ist nichts eingeschaltet."

msgid "Everything toggled on is off."
msgstr "Alles Eingeschaltete ist jetzt aus."

msgid "systemctl did not do it — see the message above"
msgstr "systemctl hat es nicht getan — siehe die Meldung oben"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse ist eingeschaltet, jetzt und bei jeder Anmeldung."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse ist ausgeschaltet und bleibt es auch bei der Anmeldung."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "kein Display — syn-mouse gui braucht eine grafische Sitzung"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell ist nicht installiert — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "quickshell konnte nicht gestartet werden"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` öffnet das Fenster; `syn-mouse --help` listet die Befehle auf."

#, c-format
msgid "unknown command '%s'"
msgstr "unbekannter Befehl '%s'"
