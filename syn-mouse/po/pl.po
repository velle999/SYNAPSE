msgid "%s:%d: '%s' is not a button name"
msgstr "%s:%d: '%s' to nie nazwa przycisku"

#, c-format
msgid "Pressing %s every %s s"
msgstr "Naciska %s co %s s"

#, c-format
msgid "Stopped pressing %s"
msgstr "Przestano naciskać %s"

#, c-format
msgid "Holding %s down"
msgstr "Przytrzymuje %s"

#, c-format
msgid "Let go of %s"
msgstr "Puszczono %s"

msgid "Left button"
msgstr "Lewy przycisk"

msgid "Right button"
msgstr "Prawy przycisk"

msgid "Middle button (wheel click)"
msgstr "Środkowy przycisk (kliknięcie kółkiem)"

msgid "Thumb button (back)"
msgstr "Przycisk kciuka (wstecz)"

msgid "Thumb button (forward)"
msgstr "Przycisk kciuka (dalej)"

msgid "Button 6"
msgstr "Przycisk 6"

msgid "Button 7"
msgstr "Przycisk 7"

msgid "Button 8"
msgstr "Przycisk 8"

msgid "Wheel up"
msgstr "Kółko w górę"

msgid "Wheel down"
msgstr "Kółko w dół"

msgid "Wheel tilt left"
msgstr "Przechylenie kółka w lewo"

msgid "Wheel tilt right"
msgstr "Przechylenie kółka w prawo"

#, c-format
msgid "cannot read %s: %s"
msgstr "nie można odczytać %s: %s"

#, c-format
msgid "cannot write %s: %s"
msgstr "nie można zapisać %s: %s"

msgid "saved, but the service is not running, so the mouse does not know yet — `syn-mouse enable` starts it"
msgstr "zapisano, ale usługa nie działa, więc mysz jeszcze o tym nie wie — `syn-mouse enable` ją uruchamia"

msgid "a profile needs a name"
msgstr "profil musi mieć nazwę"

msgid "that name is too long"
msgstr "ta nazwa jest za długa"

msgid "a profile name cannot contain brackets, tabs or line breaks"
msgstr "nazwa profilu nie może zawierać nawiasów, tabulatorów ani podziałów wiersza"

msgid "a profile name cannot start or end with a space"
msgstr "nazwa profilu nie może zaczynać się ani kończyć spacją"

#, c-format
msgid "no profile called '%s' — `syn-mouse profiles` lists them"
msgstr "brak profilu o nazwie '%s' — `syn-mouse profiles` je wypisuje"

#, c-format
msgid "unexpected '%s'"
msgstr "nieoczekiwane: '%s'"

msgid "that app id or title is too long"
msgstr "ten identyfikator aplikacji lub tytuł jest za długi"

#, c-format
msgid "[%s] now applies everywhere\n"
msgstr "[%s] działa teraz wszędzie\n"

#, c-format
msgid "added [%s], for everywhere\n"
msgstr "dodano [%s], dla wszystkich miejsc\n"

#, c-format
msgid "[%s] now applies to %s\n"
msgstr "[%s] działa teraz dla %s\n"

#, c-format
msgid "added [%s], for %s\n"
msgstr "dodano [%s], dla %s\n"

#, c-format
msgid "removed [%s]\n"
msgstr "usunięto [%s]\n"

#, c-format
msgid "'%s' is not a button — `syn-mouse buttons` lists them"
msgstr "'%s' to nie przycisk — `syn-mouse buttons` je wypisuje"

#, c-format
msgid "[%s] %s does what it always did\n"
msgstr "[%s] %s robi to, co zawsze\n"

msgid "notify is on or off"
msgstr "notify przyjmuje on lub off"

msgid "No profiles yet. `syn-mouse add <name> --app <app id>` makes one."
msgstr "Brak profili. `syn-mouse add <name> --app <app id>` tworzy nowy."

#, c-format
msgid "[%s] — everywhere\n"
msgstr "[%s] — wszędzie\n"

#, c-format
msgid "[%s] — %s, titled %s\n"
msgstr "[%s] — %s, z tytułem %s\n"

#, c-format
msgid "[%s] — %s\n"
msgstr "[%s] — %s\n"

msgid "(nothing bound)"
msgstr "(brak przypisań)"

msgid "  — cannot be read"
msgstr "  — nie można odczytać"

msgid "No mouse found."
msgstr "Nie znaleziono myszy."

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "To konto nie może odczytać myszy. Dodaj je do grupy input, a potem wyloguj się i zaloguj ponownie:\n  sudo usermod -aG input $USER"

msgid "A button the mouse's own memory maps to a key sends that key instead, and is bound as key:<name> — key:2 for the key 2. `syn-mouse status` lists the keys it has seen the mouse send."
msgstr "Przycisk, który pamięć samej myszy przypisuje do klawisza, wysyła zamiast tego ten klawisz i przypisuje się go jako key:<name> — key:2 dla klawisza 2. `syn-mouse status` pokazuje klawisze, które mysz wysłała."

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "Łącz klawisze znakiem + (shift+1). code:N wysyła kod klawisza N."

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "nie można zapytać synui o otwarte okna — czy to sesja synui?"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse nie działa. `syn-mouse enable` uruchamia go teraz i przy każdym logowaniu."

#, c-format
msgid "syn-mouse is running (pid %s)\n"
msgstr "syn-mouse działa (pid %s)\n"

#, c-format
msgid "  focus      %s (%s)\n"
msgstr "  fokus       %s (%s)\n"

msgid "  focus      no window"
msgstr "  fokus       brak okna"

#, c-format
msgid "  in force   [%s]\n"
msgstr "  aktywny     [%s]\n"

msgid "  in force   nothing — the mouse is as it always is"
msgstr "  aktywny     nic — mysz działa jak zawsze"

#, c-format
msgid "  mouse      %s — taken over\n"
msgstr "  mysz        %s — przejęta\n"

#, c-format
msgid "  mouse      %s\n"
msgstr "  mysz        %s\n"

#, c-format
msgid "  sends      %s — a button sends this key; bind it as %s\n"
msgstr "  wysyła      %s — przycisk wysyła ten klawisz; przypisz go jako %s\n"

msgid "  problem    cannot create input devices — this account needs to be in the input group"
msgstr "  problem     nie można utworzyć urządzeń wejścia — to konto musi należeć do grupy input"

msgid "  problem    no mouse it can read"
msgstr "  problem     brak myszy, którą da się odczytać"

#, c-format
msgid "  on         %s in [%s]: pressing %s every %s s\n"
msgstr "  włączone    %s w [%s]: naciska %s co %s s\n"

#, c-format
msgid "  paused     %s in [%s]: pressing %s every %s s, once [%s] is in force again\n"
msgstr "  wstrzymane  %s w [%s]: naciska %s co %s s, gdy [%s] znów będzie aktywny\n"

#, c-format
msgid "  on         %s in [%s]: holding %s down\n"
msgstr "  włączone    %s w [%s]: przytrzymuje %s\n"

#, c-format
msgid "  paused     %s in [%s]: holding %s down, once [%s] is in force again\n"
msgstr "  wstrzymane  %s w [%s]: przytrzymuje %s, gdy [%s] znów będzie aktywny\n"

msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` wyłącza je wszystkie."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse nie działa, więc nic nie jest włączone."

msgid "Everything toggled on is off."
msgstr "Wszystko, co było włączone, jest wyłączone."

msgid "systemctl did not do it — see the message above"
msgstr "systemctl tego nie zrobił — zobacz komunikat powyżej"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse jest włączony, teraz i przy każdym logowaniu."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse jest wyłączony i pozostanie wyłączony po zalogowaniu."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "brak ekranu — syn-mouse gui wymaga sesji graficznej"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell nie jest zainstalowany — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "nie można uruchomić quickshell"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` otwiera okno; `syn-mouse --help` wypisuje polecenia."

#, c-format
msgid "unknown command '%s'"
msgstr "nieznane polecenie '%s'"
