msgid "  `syn-mouse stop` switches them all off."
msgstr "  `syn-mouse stop` li spegne tutti."

msgid "syn-mouse is not running, so nothing is on."
msgstr "syn-mouse non è in esecuzione, quindi non c'è niente di attivo."

msgid "Everything toggled on is off."
msgstr "Tutto ciò che era attivo è spento."

msgid "systemctl did not do it — see the message above"
msgstr "systemctl non l'ha fatto — vedi il messaggio sopra"

msgid "syn-mouse is on, now and at every login."
msgstr "syn-mouse è attivo, ora e a ogni accesso."

msgid "syn-mouse is off, and stays off at login."
msgstr "syn-mouse è spento e resta spento all'accesso."

msgid "no display — syn-mouse gui needs a graphical session"
msgstr "nessun display — syn-mouse gui richiede una sessione grafica"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell non è installato — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "impossibile avviare quickshell"

msgid "`syn-mouse gui` opens the window; `syn-mouse --help` lists the commands."
msgstr "`syn-mouse gui` apre la finestra; `syn-mouse --help` elenca i comandi."

#, c-format
msgid "unknown command '%s'"
msgstr "comando sconosciuto '%s'"
