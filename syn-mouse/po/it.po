msgstr "  attivo    niente — il mouse funziona come sempre"

#, c-format
msgid "  mouse      %s — taken over\n"
msgstr "  mouse     %s — preso in carico\n"

#, c-format
msgid "  mouse      %s\n"
msgstr "  mouse     %s\n"

#, c-format
msgid "  sends      %s — a button sends this key; bind it as %s\n"
msgstr "  invia     %s — un tasto del mouse invia questo tasto; assegnalo come %s\n"

