msgstr "  — non leggibile"

msgid "No mouse found."
msgstr "Nessun mouse trovato."

msgid ""
"This account cannot read the mouse. Add it to the input group, then log out and back in:\n"
"  sudo usermod -aG input $USER"
msgstr "Questo account non può leggere il mouse. Aggiungilo al gruppo input, poi esci e rientra:\n  sudo usermod -aG input $USER"

msgid "A button the mouse's own memory maps to a key sends that key instead, and is bound as key:<name> — key:2 for the key 2. `syn-mouse status` lists the keys it has seen the mouse send."
msgstr "Un tasto che la memoria del mouse associa a un tasto della tastiera invia quel tasto, e si assegna come key:<name> — key:2 per il tasto 2. `syn-mouse status` elenca i tasti che ha visto inviare dal mouse."

msgid "Join keys with + (shift+1). code:N sends key code N."
msgstr "Unisci i tasti con + (shift+1). code:N invia il codice tasto N."

msgid "cannot ask synui which windows are open — is this a synui session?"
msgstr "impossibile chiedere a synui quali finestre sono aperte — è una sessione synui?"

msgid "syn-mouse is not running. `syn-mouse enable` starts it now and at every login."
msgstr "syn-mouse non è in esecuzione. `syn-mouse enable` lo avvia ora e a ogni accesso."

#, c-format
msgid "syn-mouse is running (pid %s)\n"
msgstr "syn-mouse è in esecuzione (pid %s)\n"

