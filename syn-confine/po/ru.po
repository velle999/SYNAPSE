#, c-format
msgid "too many paths (limit %d)"
msgstr "слишком много путей (предел %d)"

#, c-format
msgid "--isolate-net: open %s: %s"
msgstr "--isolate-net: открытие %s: %s"

#, c-format
msgid "--isolate-net: write %s: %s"
msgstr "--isolate-net: запись %s: %s"

#, c-format
msgid ""
"--isolate-net: unshare: %s\n"
"  This needs unprivileged user namespaces (/proc/sys/user/max_user_namespaces must be > 0)."
msgstr "--isolate-net: unshare: %s\n  Для этого нужны непривилегированные пространства имён пользователя (/proc/sys/user/max_user_namespaces должен быть > 0)."

#, c-format
msgid "%s needs a path"
msgstr "%s нужен путь"

msgid "--tcp needs a port"
msgstr "--tcp нужен порт"

#, c-format
msgid "--tcp: '%s' is not a port"
msgstr "--tcp: «%s» не является портом"

#, c-format
msgid "too many --tcp ports (limit %d)"
msgstr "слишком много портов --tcp (предел %d)"

#, c-format
msgid "unknown option '%s' (use -- before the command)"
msgstr "неизвестный параметр «%s» (поставьте -- перед командой)"

msgid "--net and --tcp contradict each other"
msgstr "--net и --tcp противоречат друг другу"

msgid "--net and --isolate-net contradict each other"
msgstr "--net и --isolate-net противоречат друг другу"

#, c-format
msgid "this kernel has no Landlock support (%s) — refusing to run the command unconfined"
msgstr "в этом ядре нет поддержки Landlock (%s) — отказ выполнять команду без песочницы"

#, c-format
msgid "this kernel's Landlock (ABI %d) cannot restrict the network, and --isolate-net was not given — refusing rather than pretending the network is closed"
msgstr "Landlock этого ядра (ABI %d) не умеет ограничивать сеть, а --isolate-net не задан — отказ вместо того, чтобы делать вид, что сеть закрыта"

#, c-format
msgid "landlock abi   %d\n"
msgstr "ABI Landlock   %d\n"

msgid "network        isolated (namespace: no TCP, UDP, DNS or loopback)\n"
msgstr "сеть           изолирована (пространство имён: ни TCP, ни UDP, ни DNS, ни loopback)\n"

msgid "network        unrestricted TCP\n"
msgstr "сеть           TCP без ограничений\n"

msgid "network        TCP to listed ports only (UDP NOT covered)\n"
msgstr "сеть           TCP только на перечисленные порты (UDP НЕ охвачен)\n"

msgid "network        no TCP (UDP NOT covered)\n"
msgstr "сеть           без TCP (UDP НЕ охвачен)\n"

#, c-format
msgid "  tcp port     %u\n"
msgstr "  порт TCP     %u\n"

#, c-format
msgid "  %-2s %-28s (absent, skipped)\n"
msgstr "  %-2s %-28s (отсутствует, пропущено)\n"

#, c-format
msgid "landlock_create_ruleset: %s"
msgstr "landlock_create_ruleset: %s"

#, c-format
msgid "landlock_add_rule %s: %s"
msgstr "landlock_add_rule %s: %s"

#, c-format
msgid "landlock_add_rule tcp/%u: %s"
msgstr "landlock_add_rule tcp/%u: %s"

#, c-format
msgid "prctl(NO_NEW_PRIVS): %s"
msgstr "prctl(NO_NEW_PRIVS): %s"

#, c-format
msgid "landlock_restrict_self: %s"
msgstr "landlock_restrict_self: %s"
