msgid "%1 — needs sudo"
msgstr "%1 — يحتاج sudo"

msgid "/path/to/the/file"
msgstr "/مسار/إلى/الملف"

msgid "Clean up"
msgstr "تنظيف"

msgid "Destroy a file"
