msgstr "نفدت الذاكرة"

#, c-format
msgid "%s is running — close it first, or its profile is what gets cleaned"
msgstr "%s يعمل — أغلقه أولاً، وإلا فالذي يُنظَّف هو ملفه الشخصي"

