msgstr "بقاياك أنت في /tmp و/var/tmp"

msgid "Orphaned packages"
msgstr "حزم يتيمة"

msgid "installed as dependencies, needed by nothing"
msgstr "مثبَّتة كاعتماديات ولم يعد شيء بحاجة إليها"

msgid "Package cache"
msgstr "ذاكرة الحزم المؤقتة"

msgid "downloaded packages already installed"
msgstr "حزم مُنزَّلة ومثبَّتة بالفعل"

msgid "System logs"
msgstr "سجلات النظام"

