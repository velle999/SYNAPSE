msgid "Thumbnails"
msgstr "المصغّرات"

msgid "image previews, rebuilt on demand"
msgstr "معاينات الصور، وتُبنى من جديد عند الحاجة"

msgid "Application cache"
msgstr "ذاكرة التطبيقات المؤقتة"

