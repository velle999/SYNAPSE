msgid "%1 — needs sudo"
msgstr "%1 — sudo 필요"

msgid "/path/to/the/file"
msgstr "/파일/경로"

msgid "Clean up"
msgstr "정리"

msgid "Destroy a file"
msgstr "파일 파기"

msgid "Disk Cleanup"
msgstr "디스크 정리"

msgid "Gone."
msgstr "사라졌습니다."

msgid "Gone. See the warning above about %1."
msgstr "사라졌습니다. %1에 대한 위의 경고를 보십시오."

msgid "Look again"
msgstr "다시 확인"

msgid "Looking…"
msgstr "확인 중…"

msgid "Nothing is ticked."
msgstr "선택된 것이 없습니다."

msgid ""
"Overwrite a file or folder and delete it. There is no undo and it does not "
"go to the Trash."
msgstr "파일이나 폴더를 덮어쓴 뒤 삭제합니다. 되돌릴 수 없고 휴지통으로도 가지 않습니다."

msgid "Overwrite and delete it"
msgstr "덮어쓰고 삭제"

msgid "Remove"
msgstr "제거"

msgid "Remove %1"
msgstr "%1 제거"

msgid "Snapshots in /.snapshots also hold copies this cannot reach. "
msgstr "/.snapshots의 스냅숏에도 여기서 닿을 수 없는 사본이 남아 있습니다. "

msgid ""
"The file will be gone; its contents may still be recoverable from the raw "
"disk. Full-disk encryption is what actually prevents that."
msgstr "파일은 사라지지만 그 내용은 원시 디스크에서 복구될 수 있습니다. 그것을 실제로 막는 것은 전체 디스크 암호화입니다."

msgid ""
"This is %1, which is copy-on-write: overwriting writes new blocks and leaves "
"the old ones. "
msgstr "이것은 %1이며 copy-on-write입니다. 덮어쓰면 새 블록에 쓰고 옛 블록은 그대로 남습니다. "

msgid "Tick what to remove. Nothing goes until you press the button."
msgstr "제거할 항목을 선택하십시오. 버튼을 누르기 전에는 아무것도 사라지지 않습니다."

msgid "some of that could not be removed"
msgstr "그 일부는 제거하지 못했습니다"

msgid "that could not be destroyed"
msgstr "그것은 파기하지 못했습니다"

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr "파이프에서는 물어볼 상대가 없습니다 — 정말이라면 --yes를 붙이십시오"

#, c-format
msgid "  %-14s %10s  %6llu  %s  (needs root)\n"
msgstr "  %-14s %10s  %6llu  %s  (root 필요)\n"

#, c-format
msgid "  %-14s %10s  %6llu  %s\n"
msgstr "  %-14s %10s  %6llu  %s\n"

#, c-format
msgid ""
"\n"
"  %s could be freed.\n"
msgstr "\n  %s을(를) 확보할 수 있습니다.\n"

msgid "Clean every cache, thumbnail and trashed file?"
msgstr "모든 캐시, 미리보기와 휴지통 파일을 정리할까요?"

#, c-format
msgid "Remove %d category of files?"
msgid_plural "Remove %d categories of files?"
msgstr[0] "%d개 범주의 파일을 제거할까요?"

#, c-format
msgid "Would free %s.\n"
msgstr "%s을(를) 확보하게 됩니다.\n"

#, c-format
msgid "Freed %s.\n"
msgstr "%s을(를) 확보했습니다.\n"

msgid "shred needs a path"
msgstr "shred에는 경로가 필요합니다"

#, c-format
msgid "%s is copy-on-write: overwriting does NOT replace the old blocks."
msgstr "%s은(는) copy-on-write입니다. 덮어써도 옛 블록은 대체되지 않습니다."

msgid "  and /.snapshots holds read-only copies this cannot reach."
msgstr "  게다가 /.snapshots에는 여기서 닿을 수 없는 읽기 전용 사본이 있습니다."

msgid "  The file will be gone. Recovering its contents from the raw disk"
msgstr "  파일은 사라집니다. 원시 디스크에서 그 내용을 되살리는 일은"

msgid "  may still be possible. Full-disk encryption is the real answer."
msgstr "  여전히 가능할 수 있습니다. 진짜 답은 전체 디스크 암호화입니다."

#, c-format
msgid "Destroy %d item? This cannot be undone."
msgid_plural "Destroy %d items? This cannot be undone."
msgstr[0] "%d개 항목을 파기할까요? 되돌릴 수 없습니다."

#, c-format
msgid "Would overwrite and delete %s.\n"
msgstr "%s을(를) 덮어쓰고 삭제하게 됩니다.\n"

#, c-format
msgid "Deleted %s, overwritten %d time — see the warning above.\n"
msgid_plural "Deleted %s, overwritten %d times — see the warning above.\n"
msgstr[0] "%s을(를) 삭제하고 %d회 덮어썼습니다 — 위의 경고를 보십시오.\n"

#, c-format
msgid "Overwritten %d time and deleted: %s.\n"
msgid_plural "Overwritten %d times and deleted: %s.\n"
msgstr[0] "%d회 덮어쓰고 삭제했습니다: %s.\n"

msgid "no display — syn-clean gui needs a graphical session"
msgstr "디스플레이가 없습니다 — syn-clean gui는 그래픽 세션이 필요합니다"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell이 설치되어 있지 않습니다 — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "quickshell을 시작할 수 없습니다"

#, c-format
msgid "unknown option '%s'"
msgstr "알 수 없는 옵션 '%s'"

#, c-format
msgid "unknown command '%s'"
msgstr "알 수 없는 명령 '%s'"

msgid "Thumbnails"
msgstr "미리보기"

msgid "image previews, rebuilt on demand"
msgstr "이미지 미리보기, 필요할 때 다시 만들어집니다"

msgid "Application cache"
msgstr "애플리케이션 캐시"

msgid "~/.cache, minus the rows below"
msgstr "~/.cache에서 아래 행을 뺀 것"

msgid "Trash"
msgstr "휴지통"

msgid "files you already deleted"
msgstr "이미 삭제한 파일"

msgid "Crash reports"
msgstr "충돌 보고서"

msgid "core dumps and crash logs"
msgstr "코어 덤프와 충돌 로그"

msgid "Browser cache"
msgstr "브라우저 캐시"

msgid "pages and images, re-downloaded as needed"
msgstr "페이지와 이미지, 필요할 때 다시 내려받습니다"

msgid "Cookies"
msgstr "쿠키"

msgid "SIGNS YOU OUT of every site"
msgstr "모든 사이트에서 로그아웃됩니다"

msgid "Temporary files"
msgstr "임시 파일"

msgid "your own leftovers in /tmp and /var/tmp"
msgstr "/tmp와 /var/tmp에 남은 자신의 잔여물"

msgid "Orphaned packages"
msgstr "고아 패키지"

msgid "installed as dependencies, needed by nothing"
msgstr "의존성으로 설치되었지만 이제 아무것도 필요로 하지 않습니다"

msgid "Package cache"
msgstr "패키지 캐시"

msgid "downloaded packages already installed"
msgstr "내려받았고 이미 설치된 패키지"

msgid "System logs"
msgstr "시스템 로그"

msgid "the journal, trimmed to the last week"
msgstr "저널을 최근 한 주로 줄입니다"

msgid "out of memory"
msgstr "메모리가 부족합니다"

#, c-format
msgid "%s is running — close it first, or its profile is what gets cleaned"
msgstr "%s이(가) 실행 중입니다 — 먼저 닫으십시오. 그러지 않으면 정리되는 것은 그 프로필입니다"

#, c-format
msgid "'%s' needs root: run `syn-clean clean %s` with sudo"
msgstr "'%s'에는 root가 필요합니다: `syn-clean clean %s`을(를) sudo로 실행하십시오"

#, c-format
msgid "%s is on another filesystem — left alone"
msgstr "%s은(는) 다른 파일 시스템에 있습니다 — 건드리지 않았습니다"
