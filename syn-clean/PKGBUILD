# Maintainer: Velle Sinclair <brncomputerhelp@gmail.com>
#
# syn-clean — free disk space, and destroy files on purpose.
#
# ⛔ THE SECURE-DELETE HALF PROMISES LESS THAN ITS NAME, AND SAYS SO. Overwriting
# a file only destroys the old bytes when they are rewritten in place. On btrfs —
# what SynapseOS installs on — they are not: copy-on-write writes new blocks and
# leaves the originals until something reuses them. Snapshots keep whole copies
# that nothing here can or should touch, and an SSD's controller remaps blocks
# out of reach of any software at all.
#
# So this program reports the ground it is standing on BEFORE it starts, in the
# terminal and in the window, and says what would actually work: full-disk
# encryption. A "securely deleted" message on btrfs would be a lie told to the
# person who most needed the truth.
#
# ⚠ NO DEPENDENCY ON coreutils' shred. Not pride: shred(1) handles one file, and
# a folder needs a walk that must refuse to cross a mount point or follow a
# symlink out of the tree it was given. Spawning a process per file to get the
# overwrite and then doing the dangerous part here anyway would put the risky
# decisions in this code regardless, with the cost of N spawns on top.
pkgname=syn-clean
pkgver=0.1.0
# ── 0.1.0-4: thirteen languages, and a suite that was deleting your /tmp ─────
#
# ⛔ FIRST, THE BUG, because it is the reason to take this release.
#
# tests/clean_test.sh opens by saying every path this program touches is
# composed from SYNCLEAN_HOME, "because a suite that could reach the real $HOME
# is one bad category string away from deleting the caches of whoever ran it".
# That was true of every path EXCEPT two: the `tmp` category sweeps /tmp and
# /var/tmp, which are not under $HOME and were hard-coded. The suite runs
# `clean --all`, `--all` includes `tmp`, and so **`meson test` deleted the real
# /tmp and /var/tmp files of whoever typed it** — anything of theirs older than
# a day, recursing into directories once the top entry qualified.
#
# It ate this session's own scratch files three times before it was noticed,
# which is how it was found: not by reading the code, but by a diff that kept
# coming out different.
#
# $SYNCLEAN_TMPDIRS is the seam now — colon-separated, defaulting to the real
# pair, the same shape and the same purpose as SYNCLEAN_HOME. Both suites point
# it at a fixture, and clean_test.sh plants a month-old file OUTSIDE that
# fixture and asserts `clean --all` leaves it alone. Verified by planting one in
# the real /tmp: it survives now and did not before.
#
# ⚠ AND IT MADE THE i18n GATE FLAKY, which is the thread that led here. `--rec
# scan` reports a byte count and a file count for that row, and both move while
# the test is running — two locale runs seconds apart disagreeing about a number
# that has nothing to do with language. The record diff is only meaningful with
# the seam pinned.
#
# ── and the translation ──────────────────────────────────────────────────────
#
# 66 strings in de, fr, es, pt, it, nl, pl, ru, ja, zh, ko, hi and ar, from ONE
# po/ compiled twice: a .mo for the binary and JSON for the quickshell window.
#
# ⛔ EVERY CATEGORY CARRIES AN id AND A LABEL ONE STRUCT FIELD APART.
# `syn-clean clean browsercache` takes that exact id back and the window sends
# it; "Browser cache" is what a person reads. Only the second is marked, and the
# suite asserts every id in the record is still the English one under a catalog
# that translates everything.
#
# ⚠ AND `conflicts` IS MATCHED AGAINST /proc/<pid>/comm — a list of process
# names, not a list of words.
#
# ⛔ THREE SENTENCES WERE ASSEMBLED FROM PIECES. "categor" plus "y" or "ies" is
# an English plural rule written into a format string, where no translator can
# reach it; "Would free"/"Freed" is a verb in a %s slot; and "  (needs root)"
# and " — needs sudo" are fragments appended to a translated sentence. Whole
# lines and P_() now.
#
# ⚠ ONE SUITE ASSERTION WAS ON A WRAP. tests/qml_test.sh greps for "full-disk
# encryption" — the window has to say what actually works, not only what does
# not — and a rewrap that put a quote in the middle of that phrase reported the
# sentence gone while it was sitting right there. The constraint is stated at
# the sentence itself now.
pkgrel=4
pkgdesc="Free disk space, and destroy files you mean to destroy — caches, thumbnails, trash, secure delete"
arch=('x86_64')
url="https://github.com/velle999/SYNAPSE"
license=('GPL-2.0-or-later')

# ⛔ NOTHING BUT libc, AND THAT IS THE DESIGN. This program walks directories,
# sums block counts and writes zeroes; each of those is a syscall, and a library
# between the user's files and this code would be a bug somebody else wrote
# sitting on the delete path.
depends=('glibc')

makedepends=('meson' 'ninja' 'gcc' 'pkgconf')

optdepends=('quickshell: the graphical window (syn-clean gui)'
            'pacman: counting orphaned packages'
            'synfiles: Destroy Permanently in the file manager right-click menu')

# ── Where the source comes from, here and everywhere else ──────────────────
#
# ⛔ ONE source LINE SERVES BOTH, AND THAT IS DELIBERATE. build-all.sh runs
# tools/collect-source.sh, which drops $pkgname-$pkgver.tar.gz beside this file;
# makepkg finds it (`-> Found ...`) and never touches the URL. Anybody WITHOUT
# this checkout has no such file, so makepkg fetches the identical tarball from
# the release that carries this exact pkgver-pkgrel. A second PKGBUILD for
# outside use would be a second set of depends and install rules, free to drift
# from this one — and the person it broke for could not see this file at all.
#
# ⚠ ITS OWN REPOSITORY, NOT THIS ONE. The source release lives at
# github.com/velle999/$pkgname — which is also where the PKGBUILD is published
# as a clonable package repo — because putting them on SYNAPSE's releases page
# buried the ISO downloads under a component tarball per bump, and made the
# newest of those GitHub's "Latest release" for the whole project.
#
# ⚠ THE TAG CARRIES THE pkgrel, so the URL cannot point at the wrong source.
# preflight.sh already refuses a source edit that does not bump pkgrel, which
# means every change to what gets built moves this URL with it.
#
# ⛔ AND sha256sums STAYS 'SKIP'. A real checksum would break every LOCAL build
# the moment somebody edited a source file, because the tarball beside this file
# is regenerated from the working tree and would no longer match. The published
# asset is reproducible instead — collect-source.sh sorts and zeroes the
# timestamps, so `tools/collect-source.sh <name>` at the tagged commit
# re-derives it byte for byte. packaging/README.md has the whole of it.
source=("$pkgname-$pkgver.tar.gz::https://github.com/velle999/$pkgname/releases/download/$pkgver-$pkgrel/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/syn-clean-0.1.0"
    meson setup build --prefix=/usr --buildtype=release
    meson compile -C build
}

check() {
    cd "$srcdir/syn-clean-0.1.0"
    # ⛔ THE SUITE RUNS INSIDE A SCRATCH SYNCLEAN_HOME, which is the only way
    # every path in this program is composed. A test for something that deletes
    # directory trees must not be able to reach the build user's real home, and
    # this is what makes that structural rather than careful.
    meson test -C build --print-errorlogs
}

package() {
    cd "$srcdir/syn-clean-0.1.0"
    meson install -C build --destdir="$pkgdir"
}
