[Desktop Entry]
Type=Application
Version=1.5
Name=Calculator
GenericName=Calculator
Comment=The SynapseOS calculator — also Super+X
# The calculator is a compositor panel, not a program: synctl asks synui to
# open the same thing the keybind does. That is also why StartupNotify is off —
# no window ever appears, so a startup spinner would hang until it timed out.
Exec=synctl dispatch calc
Icon=accessories-calculator
Terminal=false
StartupNotify=false
Categories=Utility;Calculator;
Keywords=calc;calculator;math;arithmetic;sum;
# ⛔ SYNUI ONLY — same reasoning as the other synctl entries: under KDE or GNOME
# nothing is listening on synui's socket and this was a menu item that did
# nothing at all. Both desktop names, because the identity is inconsistent
# (synui-session exports `synui`, the wayland-session file says `SynapseOS`).
# ⚠ `desktop-file-validate` calls both names "unregistered" and wants an X-
# prefix. IGNORE IT — the prefix would BREAK this. Implementations compare
# OnlyShowIn literally against the entries in XDG_CURRENT_DESKTOP, so
# X-SynapseOS does not match SynapseOS and the entry would vanish everywhere.
# Every wlroots compositor that ships menu entries does the same thing. Nothing
# in this build runs the validator; runtime behaviour is the contract.
OnlyShowIn=synui;SynapseOS;
