# The desktop theme as a KDE colour scheme, system-wide.
#
# synui-apply-theme regenerates this file per-user under
# ~/.local/share/color-schemes/ on every theme switch, and that copy shadows this
# one (XDG_DATA_DIRS puts ~/.local/share first). This is the copy that exists
# BEFORE the first synui session ever runs the helper: without it, the
# ColorScheme name in kdeglobals points at a scheme that is nowhere on disk, so
# System Settings shows none selected and anything re-deriving the palette from
# the name rather than from kdeglobals falls back to Breeze.
#
# The values are the SYNAPSE preset's — the theme a fresh install boots into —
# and are generated by running synui-apply-theme with that preset's arguments
# against an empty config root, so they cannot drift from what a live theme
# switch would write. Keep in step with theme_presets[SYN_THEME_SYNAPSE] in
# src/theme.c and with config/kdeglobals.
[General]
Name=SynapseTheme
ColorScheme=SynapseTheme

[Colors:Window]
BackgroundNormal=30,30,36
ForegroundNormal=235,235,242
DecorationFocus=255,41,109
DecorationHover=255,41,109
BackgroundAlternate=42,42,48
ForegroundInactive=157,157,163
ForegroundActive=255,41,109
ForegroundLink=255,41,109
ForegroundVisited=187,37,87
ForegroundNegative=237,102,109
ForegroundNeutral=246,180,89
ForegroundPositive=119,209,138

