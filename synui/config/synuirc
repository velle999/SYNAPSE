# ~/.config/synui/synuirc
# synui compositor configuration
# Read at startup (restart synui to apply changes).

# ── Terminal emulator ──────────────────────────────────────
terminal = kitty

# ── Startup applications ───────────────────────────────────
# Run on first launch. The terminal comes from synui-foot.service
# (which runs synsh and restarts on failure) — don't also autostart
# one here or every boot opens two.
# autostart = firefox
# autostart = synguard-tray  (future)

# ── Appearance ─────────────────────────────────────────────
border_width    = 2
gap             = 8
master_factor   = 0.60

# The floating desktop's own tiler (see "Layouts" below). Windows you have not
# placed yourself are arranged into a grid that deliberately does NOT fill the
# screen: float_inset is the percentage of the screen kept clear at each edge,
# and float_gap the space between the tiles. Both exist separately from `gap`
# above because a tiler wants a hairline between windows and this wants a margin
# you can see — the wallpaper showing through is the point of the layout, not a
# gap in it.
#
# float_inset is clamped to 40; past that the margin is bigger than the windows.
# Set it to 0 for an ordinary edge-to-edge grid.
float_inset     = 8
float_gap       = 24

# ── Layouts ────────────────────────────────────────────────
# Each virtual desktop has its own layout, cycled with Super+Tab and remembered
# across restarts in ~/.config/synui/layouts.state (so there is no setting for
# it here — the last thing you chose on each desktop IS the setting):
#   tiling    master + stack, dwm-style. master_factor above sets the split.
#   floating  you place the windows — and the ones you haven't placed get
#             arranged for you, into an inset grid that leaves the wallpaper
#             showing (float_inset / float_gap above). Dragging or resizing a
#             window takes it out of that arrangement PERMANENTLY, so floating
#             still means floating; Super+Shift+G forgets every such window and
#             lays the desktop out again.
#   monocle   one window per monitor, filling it; the focused one is the one
#             you see.
#   spiral    fibonacci tiling. Each window takes half of what is left, the cut
#             alternating vertical/horizontal and the side rotating clockwise,
#             so the windows wind inward. Same as tiling at two or three
#             windows; past that it trades area for SHAPE. Master-stack's slots
#             get shorter without getting narrower (2.9:1 at five windows,
#             6.2:1 at nine); the spiral's stay between about 1:1 and 2:1
#             forever, but its smallest window is smaller than master-stack's,
#             not bigger. Pick it when you want windows you can use, not when
#             you want the fifth one to be roomy. No master, so master_factor
#             does not apply — Super+H / Super+Shift+L do nothing here.
#   AI        synapd suggests a layout from what is open and the desktop's
#             intent; falls back to tiling with no synapd.
#   niri      scrollable tiling. An endless horizontal strip of columns per
#             monitor: a new window opens in its own column beside the one you
#             are in and the strip scrolls to follow the focus, instead of
#             every window getting narrower as more of them open. Windows
#             stack vertically inside a column — Super+, pulls the focused
#             window into the column on its left, Super+. pushes it back out.
#             Super+H / Super+Shift+L set the focused COLUMN's width (half the
#             screen by default, so two columns fit side by side); a column
#             that does not fit entirely on the monitor is not drawn, so the
#             strip always shows whole windows once it has settled. It SLIDES
#             to each new scroll position rather than jumping (animation_ms
#             below sets how long, 0 turns it off), and while it is moving the
#             columns are allowed to peek in at the edges the way niri's do —
#             except where the overhang would spill onto the monitor next door,
#             which synui cannot crop.
#   cascade   overlapping cards, each offset down-and-right from the one behind
#             it so every titlebar stays reachable. The cards are SMALL — a
#             third of the screen wide and half of it tall at most — and the
#             piles are dealt into a grid, so six windows are six cards spread
#             over the desk rather than two half-screen slabs. Windows fill the
#             grid before any pile grows deep, and cascade_stack_max above caps
#             how deep one may get before another pile is dealt instead.
#             Super+Shift+Y goes straight there from any layout.

# Theme: one named bundle of chrome colours, app colour scheme and default
# translucency. Also pickable live with Super+T, which persists to theme.state —
# and theme.state WINS over this line on the next start, by design (same as the
# dock and wallpaper). Anything below overrides the theme's colours, because it
# parses after this line.
#   synapse     the neon night-drive default   dark   (stock)
#   dark        flat modern dark               dark
#   winxp       Luna blue, gradient captions   light
#   win95       silver 3D bevels, navy titles  light
#   catppuccin  Mocha, mauve on soft black     dark   glassy
#   gruvbox     retro warm, orange on brown    dark   glassy
#   tokyonight  Storm, blue+purple on navy     dark   glassy
#   nord        arctic frost blue on slate     dark   glassy
#   dracula     purple + pink on charcoal      dark   glassy
#   bubblegum   pastel pink, hot-pink titles   light  glassy
# "glassy" is only the translucency level the theme picks IF transparency is on;
# the master switch stays yours (`transparency` below, or T in the Super+T panel).
# theme = synapse

# Border colors, #rrggbb (defaults shown — the "night drive" palette).
# norm = unfocused, focus = focused, ai = window with AI_CTX intent,
# warn = synguard ALERT/DENY verdict.
# border_color_norm  = #2a2a40
# border_color_focus = #ff296d
# border_color_ai    = #05d9e8
# border_color_warn  = #ff3524

# ── Animations ─────────────────────────────────────────────
# Window fade duration in ms: windows fade in when they open, switching desktop
# cross-fades instead of snapping, and the niri strip slides to its new scroll
# position instead of jumping. 0 disables animations entirely. Capped at 1000.
animation_ms = 140

# ── Titlebar ───────────────────────────────────────────────
# Server-side titlebar: drag it to move the window, double-click it to
# maximize, and the three buttons are minimize / maximize / close.
# Set to 0 to turn titlebars off entirely — windows keep their borders, and
# Super+drag still moves them. Clamped to 14..64 when non-zero.
# Super+Shift+D (the `decorations_toggle` action) flips them off and back on at
# runtime without touching this; setting 0 here is the permanent version.
titlebar_height = 26

# ── Remembered window geometry ─────────────────────────────
# When a window closes, record its size, position and maximized state against
# its app_id, and reopen that app's next window there instead of centring it.
# Written to ~/.config/synui/windows.conf — delete a line to forget one app,
# delete the file to forget all of them.
#
# Only *free* windows are recorded: a tiled window's geometry belongs to the
# layout engine and a fullscreen one's to the monitor, so neither is saved.
# A remembered box is always clamped back onto a monitor that exists now, so
# an entry written on a wider desk can't reopen a window off-screen.
#
# It is also only *replayed* on the desktops where you place windows yourself:
# floating and monocle. A window opening on a tiling, niri or AI desktop ignores
# the table and goes where the layout puts it — otherwise every app that had ever
# been floated or edge-snapped reopened floating, and the tiler had nothing
# left to tile. Super+F still reopens the remembered box on any desktop: that
# is you asking for the window back, not the window merely opening.
# remember_geometry = on

# ── Desktop icons ──────────────────────────────────────────
# Draw the contents of ~/Desktop on the wallpaper. Off by default; the desktop
# right-click menu ("Show Desktop Icons") flips it at runtime without editing
# this, and records the flip in deskicons.state — which then overrides the value
# here, so the tick survives a logout. Single click selects, double click opens — .desktop files run their
# Exec=, anything else goes through xdg-open. There is no file watch, so a file
# added elsewhere shows up the next time the setting is toggled or a monitor
# changes.
#
# Drag an icon to move it: it snaps to the nearest grid cell on release, swaps
# with whatever was already sitting there, and its cell is written to
# ~/.config/synui/deskicons.state so it comes back to the same place next login.
# Icons you have never dragged still flow into the free cells in name order.
# Delete deskicons.state to put everything back on the auto-grid, and to hand
# the on/off choice back to this file.
# desktop_icons = on

# The order icons flow in: name, type (folders first, then by extension), size
# (folders first, then largest first) or date (most recently modified first).
# Ties always fall back to name, so equal files never trade places by
# themselves. The right-click menu's "Arrange by …" rows change this live and
# record it in deskicons.state, which then overrides the value here — so edit
# this for the default and use the menu after that. Picking an order re-flows
# the whole desktop, dragged icons included.
# desktop_icon_arrange = name

# Titlebar colors, #rrggbb (defaults shown). Deliberately muted: the border
# already carries the focus/AI/alert signal.
# titlebar_color       = #12121c
# titlebar_color_focus = #1e1e31
# titlebar_text        = #73738c
# titlebar_text_focus  = #e6e6f2

# ── Window snapping ────────────────────────────────────────
# Drag a window against a screen edge and it fills that region when you let go,
# with a preview while you hold it there:
#
#   top edge          maximize
#   left / right      that half
#   the four corners  that quarter
#
# Dragging a snapped window off its edge restores the size it had before.
# There is no bottom-edge zone on purpose — the dock lives on a screen edge and
# would fight a window drag for the same pixels. Set to off to make a drag only
# ever a move.
# snap = on

# ── Alt+Tab switcher ───────────────────────────────────────
# Alt+Tab walks windows in the order you last used them, and puts a grid of live
# window thumbnails on screen while you hold Alt — the tile it outlines is the
# window you land on when you let go. Alt+Shift+Tab walks back. More than
# eighteen windows pages the grid; the cycle still reaches all of them.
#
# Off keeps the cycle exactly as it is and loses only the picture of it.
# alt_tab_preview = on
#
# The cycle reaches every window you have open, not only the ones on screen:
# windows on your other virtual desktops, and minimized ones. Letting go of Alt
# on one switches to its desktop / restores it — that happens at the end of the
# cycle, not as you tab past, so passing over three minimized windows on the way
# to a fourth does not restore all three.
#
# Turn either off to narrow the list back to what is in front of you.
# alt_tab_all_desktops = on
# alt_tab_minimized = on

# ── Wallpaper ──────────────────────────────────────────────
# Drawn by the compositor itself, so nothing has to be autostarted for it.
#   default          the bundled SYNAPSE image (/usr/share/synui) — the default
#   matrix           animated kanji rain (GLES2 only)
#   none             flat bg_color
#   /path/to/img     any PNG or JPEG; ~ expands to $HOME
# Super+W picks one live and writes wallpaper.state, which then overrides this
# line — delete that file to hand control back here.
# wallpaper      = default
# wallpaper_mode = fill        # fill | fit | stretch | center | tile
#
# Per monitor: name a connector (as `synctl outputs` spells it) and give it the
# same values the two keys above take. A monitor with no line here follows them.
# In the Super+W picker, Tab switches between "All monitors" and one screen —
# picking with a screen scoped writes these same overrides into wallpaper.state,
# and picking with "All monitors" clears them again.
# wallpaper_output      = DP-1 matrix
# wallpaper_output      = HDMI-A-1 ~/Pictures/ultrawide.jpg
# wallpaper_output_mode = HDMI-A-1 fit

# ── GLES post-process effects ──────────────────────────────
# CRT-style pass on real GPUs; automatically off on pixman (VMs).
# OFF by default — it is a look, not a desktop. Turn it on here, or live in
# the Super+E filters panel (which saves to filters.state and overrides this).
# Strengths 0..1, 0 disables the individual effect (values shown are what
# `effects = on` gives you).
# effect_glitch is event-driven: a brief screen glitch on window close,
# a focus change pulses aberration, and a synguard ALERT/DENY verdict
# on any window glitches the screen for as long as it stands.
# effects           = off
# effect_scanline   = 0.35
# effect_curvature  = 0.25
# effect_aberration = 0.40
# effect_glitch     = 0.60

# ── Window effects (scenefx) ───────────────────────────────
# Rounded corners, drop shadow and backdrop blur, per window. These are the
# SECOND page of the Super+E panel — press Tab there to turn any of them while
# watching the window, which is the only honest way to judge a shadow. That page
# saves to uifx.state and overrides these lines, exactly as the CRT page does.
# Values shown are the defaults.
# corner_radius     = 12       # px, 0 = square. Retro chrome (XP/95) forces 0.
# shadow            = on
# shadow_blur_sigma = 9        # how far the shadow reaches, in px
# shadow_spread     = 0        # solid band outside the window before the tail
# shadow_offset_y   = 3        # how far it is dropped downward
# shadow_opacity    = 0.45
# blur              = on       # only paints behind translucent windows
# blur_radius       = 5
# blur_passes       = 3
# glass_halo        = 0        # px of blur reaching PAST the window; 0 = off

# ── AI features ────────────────────────────────────────────
# AI layout suggestions (requires synapd)
ai_layout       = on

# Show AI_CTX intent in window title bar
ai_ctx_decor    = on

# Startup overlay
start_overlay   = off

# ── Workspace intents (natural language) ───────────────────
# Used by AI layout engine to suggest arrangements
workspace_1_intent = main workspace
workspace_2_intent = web browsing and research
workspace_3_intent = writing code and running tests
workspace_4_intent = terminal and system administration
workspace_5_intent = media and entertainment

# ── Keyboard (XKB) ─────────────────────────────────────────
# Empty = system default (or XKB_DEFAULT_* environment).
# xkb_layout   = us
# xkb_variant  = colemak
# xkb_options  = ctrl:nocaps
# xkb_model    =
# xkb_rules    =
repeat_rate  = 25
repeat_delay = 600
# Lock NumLock on as each keyboard is attached, so the numpad types digits
# from login onwards — including on the lock screen, where swaylock is the
# only thing on screen. Off leaves it to whoever presses the key.
numlock      = on

# ── The bar (synui-bar) ────────────────────────────────────
# TWO shells ship. `synapse` (the default) is SynapseOS's own bar; `antiquity`
# is a port of diinki's linux-antiquity — a radial taskbar, a sidebar and a
# different visual language entirely. See
# /usr/share/synui/quickshell-antiquity/FONTS.md for what it bundles and why
# three of upstream's fonts and its icon theme are not redistributable.
#
# Read by synui-bar at startup, NOT by the compositor: switching this takes
# effect when the bar next starts, i.e. at the next login. Control panel ▸
# Desktop ▸ Bar shell writes the same key.
#
# Note the Antiquity shell has no IpcHandler, so the Super tap does not open a
# start menu on it — upstream had Hyprland to talk to and never needed one.
# bar_shell = antiquity
#
# Pin the bar's icon theme. Empty (the default) means "follow the system icon
# theme", so a theme switch carries the bar along with GTK and Qt — which is
# almost always what you want. Set it only to pin something else; it is exported
# to quickshell as QS_ICON_THEME and applies to whichever shell is running.
# The Antiquity shell is the reason it exists: upstream hard-pinned
# `buuf-nestort` with a static pragma, which SYNAPSE does not redistribute (no
# licence in upstream's tree) and which would have overridden the theme anyway.
# Install it yourself and name it here to get the upstream look.
# bar_icon_theme = buuf-nestort

# ── Desktop cat (Super+Shift+C) ────────────────────────────
# A small cat that wanders across the monitors on top of everything, sits, and
# occasionally naps. `cat` is only the LOGIN state; Super+Shift+C toggles it any
# time either way.
#
# `cat_breed` is the coat. It changes colours and markings only — every breed
# shares one drawing, one gait and one set of poses, so picking a different one
# can never make the cat behave differently. Unknown names log and fall back to
# `neon`, which is the original slate-and-cyan cat.
#   neon          slate coat, cyan rim, glowing eyes   (stock)
#   tabby         brown mackerel, green eyes
#   ginger        marmalade, same stripes, amber eyes
#   tuxedo        black with a white bib, gold eyes
#   siamese       cream with seal points, blue eyes
#   calico        white with ginger and black patches
#   tortie        dark coat, ginger patches
#   russian-blue  blue-grey, unmarked, green eyes
#   black         near-black, gold eyes
# cat       = off
# cat_breed = neon

# ── Welcome menu (Super+Escape) ────────────────────────────
# Whether the menu greets you on login. Super+Escape opens it either way, so
# turning this off never strands it. The menu's own "Show At Startup" row
# toggles this and writes ~/.config/synui/welcome.state, which from then on
# overrides this line — delete that file to hand control back here.
welcome_at_startup = on

# ── Lock screen (Super+L) ──────────────────────────────────
# Offer the fingerprint reader beside the password. On, the lock starts asking
# for a finger the moment it appears; both ways in are live at once, so you can
# type your password over a reader that is still waiting, and whichever answers
# first unlocks.
#
# Leaving this on costs a machine WITHOUT a reader nothing: the helper asks
# fprintd for a device, is told there is none, and the lock stops asking and
# draws nothing. So it is not a "do I have one" switch — that is detected — it
# is for turning a reader that works OFF.
#
# Needs the fprintd package (an optdepend) and at least one ENROLLED finger.
# Run the enroll as yourself, not root — prints are stored per account, so one
# enrolled as root will never unlock your session:
#   sudo pacman -S fprintd
#   fprintd-enroll        # swipe until it says enroll-completed
#   fprintd-list "$USER"  # confirm it took
# Your password always works regardless — five rejected swipes retire the
# reader for that lock rather than locking you out.
lock_fingerprint = on

# ── Screen recording (Super+Shift+R) ───────────────────────
# Whether a recording captures sound as well. On means the default sink's
# MONITOR — the game, the video, the call: what you can hear, never the
# microphone. (`synui-record --audio=mic` is the explicit way to the other one.)
# Off by default, like every other capture here. The control panel's
# Sound ▸ Record audio row toggles it and writes ~/.config/synui/record.state,
# which from then on overrides this line — delete that file to hand control
# back here.
record_audio = off

# ── Pointer / touchpad (libinput) ──────────────────────────
# Unset options leave the device at its default.
# tap            = on          # touchpad tap-to-click
# natural_scroll = on
# left_handed    = on
# accel_speed    = 0.0         # -1.0 (slow) .. 1.0 (fast)

# ── Keybindings ────────────────────────────────────────────
# bind = <mod>+<key> <action> [arg]
# Mods: super/logo/mod4, shift, ctrl, alt. Keys are XKB keysym names
# (q, return, space, tab, backspace, f1, ...).
# Actions: spawn <cmd>, term, cmdbar, overlay, displays, menu, close, quit,
#          layout_cycle, retile, focus_next/prev, alt_tab, alt_tab_prev,
#          stack_next/prev,
#          master_shrink/grow, column_consume, column_expel,
#          float_toggle, maximize_toggle, ai_ask, keys,
#          ws <1-9>, movews <1-9>
# keys = the shortcut palette (default super+slash, and super+shift+question so
# Super+? works too — on a US layout that is the same physical key, and xkb
# hands the compositor the shifted keysym, so the two need separate binds).
# It lists every bind below, filtered as you type, and Enter runs the one you
# land on. Generated from the live bind table, so anything you add here appears
# in it with no second edit.
# alt_tab = focus the last-used window (most-recently-used order); hold alt and
# press tab again to keep going back. Bound to alt+tab / alt+shift+tab.
# retile = put every window on this desktop back in the layout — un-maximize,
# un-snap, un-float — and tile it. Default super+shift+t ("t for tile"). It
# switches to the tiling layout from WHEREVER you are: the key is called tile,
# so a press on a cascade or monocle desktop leaves you tiled, not on the same
# arrangement being told the windows were already fine. Dialogs and fullscreen
# windows are left alone. Selecting a tiling, niri or AI layout now reclaims the
# same way, so choosing the layout means "place these windows".
#   Why you want it: dragging a window to move it, snapping it to an edge and
#   maximizing all set the window "floating", every layout SKIPS floating
#   windows, and until now only super+f could clear that, one window at a time.
#   A tiling desktop could end up with nothing left to tile.
# crop = the image cropper (default super+shift+x, "x for cut"). With a path —
# `bind = super+shift+x crop /path/to/pic.png`, or Dolphin's right-click ▸ Crop
# Image — it opens that file. WITHOUT one it opens a list of your recent images
# from ~/Pictures, its Screenshots and Wallpapers subdirectories, ~/Downloads
# and ~/.local/share/wallpapers, newest first. Only directories you can WRITE to
# are listed: the crop is always written beside the original as <name>-crop.png
# and never in place, so a row in a read-only directory could only ever fail.
#   In the cropper: drag to select, drag a corner handle to adjust that corner,
#   Tab picks which corner the arrows move, Ctrl+Arrows slide the whole
#   selection, Shift makes any of those step 25px, and Enter writes the copy.
# displays = built-in display settings (rotate/arrange monitors, and p to set
# the primary monitor — where X11/SDL games open; default super+d);
# menu = the SYNAPSE OS welcome menu (default super+escape).
# cmdbar = the AI command bar. Default super+equal, which sits next to
# super+backspace (ai_ask) so the two AI popups are physical neighbours. It was
# super+space until rofi took that key as the application launcher.
#   Note the spelling: the combo is split on '+', so the key after the last '+'
#   must be an XKB keysym NAME. `=` is `equal`. `bind = super+= cmdbar` does not
#   work — it parses as an empty key and is dropped with a "bad key" log line.
# The launcher itself is not an action, it is a spawn: `super+space spawn rofi
# -show drun`. Rebind it to any launcher you like, or to `cmdbar` to put the
# command bar back where it was.
#
# super_space = launcher|cmdbar  (default launcher)
#   Which of the two answers Super+Space; the other one gets Super+=. Control
#   panel ▸ Desktop ▸ "Super+Space opens" flips it live and writes it here (well,
#   to settings.state). It only ever swaps the two actions IT put on those keys:
#   if you rebind either combo with a `bind =` line above, the setting stops
#   touching them and says so in the log. Your bind wins.
#
# A bind on the same combo as a default replaces the default.
# bind = super+w spawn rofi -show run
# bind = super+shift+s spawn swaylock
# bind = super+e term
