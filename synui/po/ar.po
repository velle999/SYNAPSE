msgid "NumLock on at login"
msgstr "تشغيل NumLock عند الدخول"

#: src/ctlpanel.c:1061
msgid "A fresh xkb state has it off, which leaves the numpad on arrows"
msgstr "حالة xkb الجديدة تتركه مطفأً، فتبقى لوحة الأرقام على الأسهم"

#: src/ctlpanel.c:1063
msgid "Tap to click"
msgstr "النقر باللمس"

#: src/ctlpanel.c:1064
msgid "Pointer"
msgstr "المؤشر"

#: src/ctlpanel.c:1067
msgid "Natural scrolling"
msgstr "تمرير طبيعي"

#: src/ctlpanel.c:1070
msgid "Left-handed buttons"
msgstr "أزرار لليد اليسرى"

#: src/ctlpanel.c:1073
msgid "Pointer speed"
msgstr "سرعة المؤشر"

#: src/ctlpanel.c:1079
msgid "Pointer acceleration"
msgstr "تسارع المؤشر"

