msgstr "سرعة تكرار المفاتيح"

#: src/ctlpanel.c:1044
msgid "Keyboard"
msgstr "لوحة المفاتيح"

#: src/ctlpanel.c:1048
msgid "Key repeat delay"
msgstr "تأخير تكرار المفاتيح"

#: src/ctlpanel.c:1056
msgid "Keyboard shortcuts"
msgstr "اختصارات لوحة المفاتيح"

#: src/ctlpanel.c:1057
msgid "Searchable. F2 moves a shortcut to another key, F3 onto the tap"
msgstr "قابلة للبحث. F2 ينقل اختصارًا إلى مفتاح آخر، وF3 إلى النقرة"

