msgid "Open games on"
msgstr "Apri i giochi su"

#: src/ctlpanel.c:1239
msgid "Primary = the monitor marked PRIMARY in Super+D; Ask obeys the game"
msgstr "Principale = lo schermo segnato PRIMARY in Super+D; Chiedi obbedisce al gioco"

