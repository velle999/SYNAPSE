msgid "DNxHR .mov that video editors read directly. About 1.1 GB/min"
msgstr "Un .mov DNxHR che i programmi di montaggio leggono direttamente. Circa 1,1 GB/min"

#: src/ctlpanel.c:1188
msgid "Network / Wi-Fi"
msgstr "Rete / Wi-Fi"

#: src/ctlpanel.c:1189
msgid "Network"
msgstr "Rete"

#: src/ctlpanel.c:1190
msgid "Bluetooth"
msgstr "Bluetooth"

