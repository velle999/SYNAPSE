msgid "Screens"
msgstr "Schermi"

#: src/ctlpanel.c:1104
msgid "Extend, Duplicate, or built-in off (closed lid). Also m in Super+D"
msgstr "Estendi, Duplica, o quello integrato spento (coperchio chiuso). Anche m in Super+D"

#: src/ctlpanel.c:1114
msgid "Scale everything"
msgstr "Scala tutto"

#: src/ctlpanel.c:1115
msgid ""
"Every screen, every app, the cursor. Super+Ctrl+= / - , Super+Ctrl+0 resets"
msgstr "Ogni schermo, ogni applicazione, il cursore. Super+Ctrl+= / -, Super+Ctrl+0 ripristina"

