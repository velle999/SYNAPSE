msgid "Bar opacity"
msgstr "Opacità della barra"

#: src/ctlpanel.c:1009
msgid "0.00 is a clear bar, inked off the wallpaper; 1.00 hides it completely"
msgstr "0,00 è una barra chiara, colorata a partire dallo sfondo; 1,00 lo nasconde del tutto"

#: src/ctlpanel.c:1017
msgid "Bar shape"
msgstr "Forma della barra"

#: src/ctlpanel.c:1020
