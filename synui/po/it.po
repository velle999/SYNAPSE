msgid "Move sound to a TV or monitor when you plug it in. Auto = laptops"
msgstr "Manda il suono a un televisore o a un monitor quando lo colleghi. Auto = portatili"

#: src/ctlpanel.c:1157
msgid "Equalizer"
msgstr "Equalizzatore"

