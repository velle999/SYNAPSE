msgstr "Cosa mostra lo schermo a riposo, e come appare la schermata di blocco"

#: src/ctlpanel.c:1209
msgid "Lock screen"
msgstr "Schermata di blocco"

#: src/ctlpanel.c:1213
msgid "Unlock with fingerprint"
msgstr "Sblocca con l'impronta"

#: src/ctlpanel.c:1222
msgid "Install fprintd, run fprintd-enroll; your password always works too"
msgstr "Installa fprintd, esegui fprintd-enroll; la tua password funziona sempre lo stesso"

#: src/ctlpanel.c:1230 src/ctlpanel.c:1231
msgid "Game mode"
msgstr "Modalità gioco"

#: src/ctlpanel.c:1232
msgid "Enter cycles auto / always on / always off — same as Super+G"
msgstr "Invio scorre automatico / sempre attivo / sempre spento — come Super+G"

