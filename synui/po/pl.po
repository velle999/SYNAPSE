msgstr "Domyślne dla urządzenia"

#: src/ctlpanel.c:1896
#, c-format
msgid "glass off · bar, dock and widgets solid · windows opaque"
msgstr "Szkło wyłączone · pasek, dok i widżety kryjące · okna nieprzezroczyste"

#: src/ctlpanel.c:1952
#, c-format
msgid "glass full · bar and dock clear · ink off the wallpaper"
msgstr "Szkło pełne · pasek i dok przezroczyste · barwa z tapety"

#: src/ctlpanel.c:2293
#, c-format
msgid "RGB lights: off"
msgstr "Podświetlenie RGB: wyłączone"

#: src/ctlpanel.c:2294
#, c-format
msgid "RGB lights: following the accent"
msgstr "Podświetlenie RGB: zgodne z kolorem akcentu"

#: src/ctlpanel.c:2355
#, c-format
msgid "Screen reader: off"
msgstr "Czytnik ekranu: wyłączony"

