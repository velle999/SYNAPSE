msgstr "Pozwala układowi SI decydować, gdzie trafi nowe okno"

#: src/ctlpanel.c:1272
msgid "AI context in borders"
msgstr "Kontekst SI w obramowaniu"

#: src/ctlpanel.c:1274
msgid "Tint a window's border when the AI is holding context for it"
msgstr "Barwi obramowanie okna, gdy SI trzyma dla niego kontekst"

#: src/ctlpanel.c:1277
msgid "Tools"
msgstr "Narzędzia"

#: src/ctlpanel.c:1278 src/ctlpanel.c:2746
msgid "Clipboard history"
msgstr "Historia schowka"

#: src/ctlpanel.c:1279
msgid "News"
msgstr "Wiadomości"

#: src/ctlpanel.c:1280
msgid "News refresh"
msgstr "Odświeżanie wiadomości"

#: src/ctlpanel.c:1283
msgid "How often a feed may be re-fetched at most"
msgstr "Jak często najwyżej można pobrać źródło ponownie"

#: src/ctlpanel.c:1295
msgid "System settings"
msgstr "Ustawienia systemu"

#: src/ctlpanel.c:1296
msgid "Clock, locale, kernel, default apps — what the SYSTEM is set to"
msgstr "Zegar, język, jądro, domyślne programy — na co ustawiony jest SYSTEM"

#: src/ctlpanel.c:1298 src/ctlpanel.c:2738
msgid "About OS"
msgstr "O systemie"

#: src/ctlpanel.c:1299
msgid "About"
msgstr "O programie"

#: src/ctlpanel.c:1300
msgid "The mark, the machine, and what this desktop is currently set to"
msgstr "Znak, maszyna i to, na co ten pulpit jest teraz ustawiony"

#: src/ctlpanel.c:1398
