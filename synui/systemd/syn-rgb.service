[Unit]
# The desktop's accent, pushed to whatever OpenRGB can see.
#
# A ONESHOT, not a daemon: there is nothing to keep in memory between wallpaper
# changes, and a process that sleeps for a colour is a process that can leak,
# wedge or hold a device open. syn-rgb.path is what watches; this is what runs.
Description=SynapseOS accent on the RGB hardware
Documentation=man:openrgb(1)
# The SDK server, which turns an 8.8-second bus probe into a 1.0-second push.
#
# ⚠ ORDERING ONLY — no Wants, and deliberately not. syn-rgb.path is what pulls
# the server in (it is WantedBy that unit), because the path unit is what
# `syn-rgb on` enables and the server must exist exactly when the bridge does.
# A Wants here would also start it for a bare `syn-rgb apply` typed in a
# terminal, and leave it running afterwards with nothing to stop it.
#
# openrgb probes the bus itself when nothing is serving, so a server that is
# absent, masked or still starting leaves this SLOW rather than broken.
After=syn-rgb-server.service

# ⛔ NO RATE LIMIT. A BURST OF WALLPAPERS MUST NOT KILL THE WATCH.
#
# systemd's default is 5 starts per 10s, and when a PATH-TRIGGERED service
# trips it the failure does not stop at the service: the path unit fails too,
# with `unit-start-limit-hit`, and STAYS failed. Nothing re-arms it. The lights
# freeze on whichever colour the burst happened to end on and never move again
# until someone runs `systemctl --user start syn-rgb.path` by hand — which
# reads as "syn-rgb broke", not as "a rate limit did exactly what it says".
#
# ⚠ Unreachable until 434 made the push FAST. At 8.8s a bus probe, five pushes
# spanned ~44s and the window never filled; with the SDK server at ~1.0s, five
# wallpapers in ten seconds is just a person clicking through a folder. The
# optimisation is what put the limit in range.
#
# Nothing here needs the limit's protection: a oneshot that cannot fail the
# session (SuccessExitStatus below) has no crash loop to arrest, and the cost
# of an extra run is one 1-second push to a device that is idle anyway.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/syn-rgb apply
# ⚠ Never fail the session over lights. A device that has gone away, an
# openrgb that is not installed and a wallpaper with no hue in it are all
# ordinary, and none of them is a reason for a red unit in `systemctl --user`.
SuccessExitStatus=0 1 3
