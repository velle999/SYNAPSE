[Unit]
# Keep an unanswered password prompt from counting as a failed login — before
# greetd reads the stack, on every boot. See /usr/lib/synui/synui-pam-faillock.
#
# ⚠ Pulled in by a drop-in on greetd (greetd.service.d/synui-pam-faillock.conf),
# so nothing has to be enabled: synui's scriptlet cannot run `systemctl enable`
# on a machine that is not booted. The scriptlet runs the same script on every
# upgrade; this is what catches a pambase upgrade that wrote a fresh stack.
Description=Stop unanswered password prompts counting as failed logins
Before=greetd.service
ConditionPathExists=/etc/pam.d/system-auth
DefaultDependencies=no
After=local-fs.target
RequiresMountsFor=/etc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/synui/synui-pam-faillock
# Nothing here is fatal to booting: an unconverged stack still lets people log
# in, and a boot that failed over it would not.
SuccessExitStatus=0 1
