[Unit]
# The unit FILE is still named synui-foot.service after the switch to kitty.
# That is deliberate, not an oversight: synui.service refers to it by name in
# Wants=, syn-install names it in three places, and renaming a unit that anyone
# may have enabled leaves a dangling symlink for no functional gain. What it
# runs is what matters, and that is now the default terminal.
Description=SynapseOS terminal autostart (synsh)
After=synui.service
PartOf=synui.service

[Service]
Type=simple
User=root
Environment=XDG_RUNTIME_DIR=/run/user/0
# Wait for synui to publish its display name, then run the terminal on it.
#
# The path is $XDG_RUNTIME_DIR/synui-display (0700, root-owned here), NOT the
# old /tmp/synui-display: this runs the terminal+synsh as ROOT and takes WAYLAND_DISPLAY
# from that file, and WAYLAND_DISPLAY may be an absolute path — so a
# world-writable /tmp source let any local user aim a root shell at a Wayland
# socket of their choosing and inject keystrokes into it. There is deliberately
# no /tmp fallback; if the file is missing we time out rather than reopen that.
ExecStartPre=/bin/sh -c 'n=0; while [ ! -f "$XDG_RUNTIME_DIR/synui-display" ]; do sleep 0.5; n=$((n+1)); if [ $n -ge 30 ]; then echo "Timed out waiting for synui" >&2; exit 1; fi; done; sleep 1'
ExecStart=/bin/sh -c 'export WAYLAND_DISPLAY=$(tr -d "[:space:]" < "$XDG_RUNTIME_DIR/synui-display"); command -v kitty >/dev/null && exec kitty synsh; exec foot synsh'
# always: this is the only terminal — respawn it even after a clean exit,
# or closing synsh leaves the compositor with no way to open anything
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
