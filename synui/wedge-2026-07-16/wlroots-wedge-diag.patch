+		 * unpaired_surfaces, the new wl_surface associates with nothing, and
+		 * the window can never map again — IsViewable in X, absent from the
+		 * compositor, empty _NET_CLIENT_LIST. Only an X unmap/map recovers it.
+		 *
+		 * Diagnostic build only — do not ship. */
+		wlr_log(WLR_ERROR, "WEDGE-DIAG: DROPPING WL_SURFACE_SERIAL for X11 window "
+			"%u (stale serial=%llu still set) -- this window can now never "
+			"associate or map again",
+			ev->window, (unsigned long long)xsurface->serial);
 		return;
 	}
 
