<?xml version="1.0" encoding="UTF-8"?>
<protocol name="blur">
  <copyright><![CDATA[
    SPDX-FileCopyrightText: 2015 Martin Gräßlin
    SPDX-License-Identifier: LGPL-2.1-or-later
  ]]></copyright>

  <!--
    org_kde_kwin_blur — KWin's "blur behind" protocol, as shipped by
    plasma-wayland-protocols. A client (Qt/Breeze, latte-dock, …) uses it to ask
    the compositor to blur whatever is behind a translucent region of its
    surface. Many KDE clients only make their background translucent *if* this
    global is advertised; otherwise they fall back to an opaque background so
    text stays readable. So merely binding this manager flips those clients into
    their glass look, and synui then frosts them via scenefx backdrop blur.
  -->

  <interface name="org_kde_kwin_blur_manager" version="1">
    <request name="create">
      <arg name="id" type="new_id" interface="org_kde_kwin_blur"/>
      <arg name="surface" type="object" interface="wl_surface"/>
    </request>
    <request name="unset">
      <arg name="surface" type="object" interface="wl_surface"/>
    </request>
  </interface>

  <interface name="org_kde_kwin_blur" version="1">
    <request name="commit"/>
    <request name="set_region">
      <arg name="region" type="object" interface="wl_region" allow-null="true"/>
    </request>
    <request name="release" type="destructor">
      <description summary="release the blur object"/>
    </request>
  </interface>
</protocol>
