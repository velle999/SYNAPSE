#!/bin/bash
# syn-rgb — the desktop's accent, on the hardware that has lights in it.
#
# SynapseOS already decides one colour per wallpaper: synui measures the
# picture and writes `accent` to ~/.config/synui/palette.state, and the bar,
# the dock and the icons wear it. Everything else in the room that lights up —
# the RAM, the board, the keyboard — was still whatever it was set to in
# somebody else's software.
#
# So this is a bridge and nothing more: read the colour the desktop already
# chose, hand it to OpenRGB, and get out of the way.
#
# ⛔ OFF BY DEFAULT, and enabled per user. It writes to hardware, and hardware
# that is currently doing what its owner asked is not a thing to take over on
# an update.
#
# ⚠ THE WATCHING IS SYSTEMD'S. A path unit fires when palette.state changes,
# so there is no daemon here, nothing to poll and nothing to leak — the
# wallpaper changes, the file is rewritten, the colour follows.
#
# SynapseOS Project
# SPDX-License-Identifier: GPL-2.0-or-later
set -u

CFG=${XDG_CONFIG_HOME:-$HOME/.config}/synui
PAL=$CFG/palette.state
THEME=$CFG/theme.json
STATE=$CFG/rgb.state
# The binary is looked up by NAME on PATH, and asked for by `command -v`.
# ⚠ `openrgb ... || echo missing` cannot tell "not installed" from "ran and
# failed", and those want opposite answers.
RGB=${SYN_RGB_BIN:-openrgb}

say()  { printf '%s\n' "$*"; }
warn() { printf 'syn-rgb: %s\n' "$*" >&2; }

have_openrgb() { command -v "$RGB" >/dev/null 2>&1; }

# ---- the state file ------------------------------------------------------
#
# key=value, the same shape every other synui state file uses, so it greps and
# a human can fix it with an editor.
getval() {   # getval FILE KEY DEFAULT
    local f=$1 k=$2 d=$3 v=
    [ -r "$f" ] || { printf '%s' "$d"; return; }
    v=$(sed -n "s/^[[:space:]]*$k[[:space:]]*=[[:space:]]*//p" "$f" | tail -1)
    # ⛔ No comment stripping. `accent=#9B610F` IS the value, and a `%%#*` here
    # turned every colour in the file into an empty string — which read as
    # "this wallpaper has no accent" and left the lights alone for ever. A
    # whole-line comment never reaches this: the key anchor does not match one.
    v=${v%"${v##*[![:space:]]}"}
    [ -n "$v" ] || v=$d
    printf '%s' "$v"
}

setval() {   # setval KEY VALUE — in the rgb state only
    local k=$1 v=$2 tmp
    mkdir -p "$CFG"
    [ -f "$STATE" ] || {
        printf '# syn-rgb — the desktop accent on the lights.\n' > "$STATE"
    }
    tmp=$STATE.tmp.$$
    if grep -q "^[[:space:]]*$k[[:space:]]*=" "$STATE" 2>/dev/null; then
        sed "s|^[[:space:]]*$k[[:space:]]*=.*|$k=$v|" "$STATE" > "$tmp"
    else
        cat "$STATE" > "$tmp"
        printf '%s=%s\n' "$k" "$v" >> "$tmp"
    fi
    mv "$tmp" "$STATE"
}

# ---- the colour ----------------------------------------------------------

# The wallpaper's accent, as six hex digits, or nothing.
#
# ⚠ `ok` is the PICTURE's own answer: a greyscale wallpaper offers no hue and
# says so. `use` is not consulted — that setting is about whether the DESKTOP
# draws with the colour, and somebody who turned the bar's tint off has not
# said anything about their keyboard.
accent_colour() {
    local ok acc
    ok=$(getval "$PAL" ok no)
    acc=$(getval "$PAL" accent "")
    [ "$ok" = "yes" ] || return 1
    acc=${acc#\#}
    case $acc in
        [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
        *) return 1 ;;
    esac
    printf '%s' "$acc"
}

# The THEME's accent, for somebody whose desktop is not wearing the wallpaper.
# theme.json is generated, one key per line, `"accent": [r, g, b]`.
theme_colour() {
    local line r g b
    [ -r "$THEME" ] || return 1
    line=$(sed -n 's/.*"accent"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' "$THEME" | head -1)
    [ -n "$line" ] || return 1
    r=$(printf '%s' "$line" | cut -d, -f1 | tr -dc '0-9')
    g=$(printf '%s' "$line" | cut -d, -f2 | tr -dc '0-9')
    b=$(printf '%s' "$line" | cut -d, -f3 | tr -dc '0-9')
    [ -n "$r" ] && [ -n "$g" ] && [ -n "$b" ] || return 1
    printf '%02X%02X%02X' "$r" "$g" "$b"
}

# What the lights should be, after the source and the brightness are applied.
wanted_colour() {
    local follow hex bright r g b
    follow=$(getval "$STATE" follow accent)
    case $follow in
        theme)  hex=$(theme_colour) || return 1 ;;
        fixed)  hex=$(getval "$STATE" colour "")
                hex=${hex#\#}
                [ -n "$hex" ] || return 1 ;;
        *)      hex=$(accent_colour) || return 1 ;;
    esac

    # ⚠ Brightness is applied HERE and not by OpenRGB, which has no such
    # control: a wallpaper accent at full value is a room-filling glow off a
    # pair of RAM sticks, and the answer to that is a darker colour rather
    # than a different one. Scaled in RGB, so the hue does not move.
    bright=$(getval "$STATE" brightness 1.0)
    r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
    r=$(awk -v v="$r" -v s="$bright" 'BEGIN{printf "%d", (v*s > 255 ? 255 : (v*s < 0 ? 0 : v*s))}')
    g=$(awk -v v="$g" -v s="$bright" 'BEGIN{printf "%d", (v*s > 255 ? 255 : (v*s < 0 ? 0 : v*s))}')
    b=$(awk -v v="$b" -v s="$bright" 'BEGIN{printf "%d", (v*s > 255 ? 255 : (v*s < 0 ? 0 : v*s))}')
    printf '%02X%02X%02X' "$r" "$g" "$b"
}

# ---- pushing it ----------------------------------------------------------

# ⛔ A MODE THE HARDWARE FORGETS IS A LIGHT THAT GOES OUT.
#
# `direct` means "show exactly what the host is streaming", and an ASUS Aura
# USB mainboard drops back to dark the moment the process that set it exits —
# which here is every single time, because this is a oneshot with nothing left
# running behind it. On velle's box that read as the board and its addressable
# strip lighting up at login and then going out seconds later, while the
# Corsair DIMMs and the G512 stayed on: those two latch their last direct
# frame, the Aura board does not. It was not the bridge failing to push. It
# pushed, the board took it, and then forgot it.
#
# `static` is the same colour handed to the controller's OWN effect engine, so
# it holds with nothing running at all — which is the only thing that can be
# true for a program that exits.
#
# ⚠ So the mode is per DEVICE and not per push. It cannot be one mode for
# everything: the Corsair Vengeance DIMMs offer Direct and nothing else, and
# asking a device for a mode it does not have fails the WHOLE call rather than
# that one device.
MAP=$CFG/rgb.devices

# ⚠ The SDK server's port. It is only an OPTIMISATION for the push — see
# syn-rgb-server.service — but it is a correctness question for the listing:
# with a server up, `--list-devices` is a socket round-trip (0.03s measured
# here) rather than the 8.6s bus probe the cache below exists to avoid. Cheap
# enough that a cached answer stops being worth what it can hide.
SDK_PORT=${SYN_RGB_SDK_PORT:-6742}

# yes|no|auto. Asking is pure bash, so it costs nothing, and a refused
# connection is an answer rather than an error.
SDK=${SYN_RGB_SDK:-auto}
sdk_server_up() {
    case $SDK in
        yes) return 0 ;;
        no)  return 1 ;;
    esac
    (exec 3<>"/dev/tcp/127.0.0.1/$SDK_PORT") 2>/dev/null
}

# The map: `index<TAB>mode<TAB>name`, one line per device, and a plain file so
# somebody who wants their keyboard on a different mode can say so with an
# editor.
#
# ⚠ CACHED, because `--list-devices` is a full bus probe with no server up —
# 8.6 seconds measured here — and a push that had to enumerate first would pay
# it twice.
map_parse() {   # map_parse — a listing on stdin, map lines on stdout
    awk '
        /^[0-9]+:[ ]/ {
            idx = $0; sub(/:.*/, "", idx)
            name = $0; sub(/^[0-9]+:[ ]*/, "", name)
            seen = 0
            next
        }
        # ⚠ The ACTIVE mode is the bracketed one, and `[Static]` and `Static`
        # are the same answer to the only question being asked here: can this
        # device hold a colour by itself once we are gone?
        /^[ \t]*Modes:/ {
            if (idx == "" || seen) next
            printf "%s\t%s\t%s\n", idx,
                   ($0 ~ /(^|[ \t])\[?Static\]?([ \t]|$)/ ? "static" : "direct"),
                   name
            seen = 1
        }
    ' 2>/dev/null
}

map_count() {   # map_count FILE — how many devices it names
    [ -s "$1" ] || { printf 0; return; }
    awk 'BEGIN { n = 0 } /^[[:space:]]*(#|$)/ { next } { n++ } END { print n }' "$1"
}

# ⚠ The mode is the one thing in this file a HUMAN may have set, so a rebuild
# keeps it: a device still at the same index under the same name keeps whatever
# mode the map already gave it, and only devices that came or went change.
map_merge() {   # map_merge NEWFILE — the merged map on stdout
    awk -F'\t' -v old="$MAP" '
        BEGIN {
            while ((getline line < old) > 0) {
                if (line ~ /^[[:space:]]*(#|$)/) continue
                if (split(line, f, "\t") >= 3) keep[f[1] "\t" f[3]] = f[2]
            }
        }
        { k = $1 "\t" $3; print $1 "\t" (k in keep ? keep[k] : $2) "\t" $3 }
    ' "$1"
}

# ⛔ A LISTING TAKEN WHILE OPENRGB IS STILL ENUMERATING IS A SHORT LISTING, AND
# IT LOOKS EXACTLY LIKE A COMPLETE ONE.
#
# Measured on velle's box, from the SDK server's start: nothing at 0.3s, the two
# i2c DIMMs at 0.6s, and the USB mainboard and the keyboard only at 7.8s. The
# count then sits perfectly still at two for those seven seconds, so "wait until
# it stops changing" answers the wrong question. syn-rgb.service runs about a
# second after the server at login, so the map it cached named the RAM and
# nothing else — and every push after that pushed the RAM and nothing else, and
# SUCCEEDED, so nothing ever rebuilt it. The board and the keyboard held
# whatever colour they happened to have for the rest of the session. That is the
# "only the RAM follows the wallpaper and the rest are stuck".
#
# The only thing on this machine that knows how many devices it has is the map
# from the last time they were all counted, so a listing shorter than the map is
# not believed until it has been asked again. With nothing to compare against —
# the first run ever — the wait is for a long quiet instead, which is the one
# case where paying ten seconds once is the right trade.
MAP_SETTLE_MAX=${SYN_RGB_SETTLE_MAX:-20}      # seconds, the whole wait
MAP_SETTLE_QUIET=${SYN_RGB_SETTLE_QUIET:-9}   # ...of no new device, with no map

map_settle() {   # map_settle FILE — grow FILE until the bus has all of it
    local best=$1 ref n try=0 quiet=0 said=0 tmp
    # ⚠ ONLY A SERVER CAN HAND OUT A SHORT LISTING. With no server, openrgb
    # enumerates the bus itself before it prints a word — that IS the 8.6
    # seconds — so what it says is everything there is, and there is nothing
    # here to wait for. The partial answer is the SDK server's alone: it serves
    # the controllers it has registered SO FAR, and says nothing about the ones
    # it is still looking for.
    sdk_server_up || return 0
    ref=$(map_count "$MAP")
    n=$(map_count "$best")
    tmp=$best.probe
    while [ "$try" -lt "$MAP_SETTLE_MAX" ]; do
        if [ "$ref" -gt 0 ]; then
            [ "$n" -lt "$ref" ] || break
        else
            [ "$quiet" -lt "$MAP_SETTLE_QUIET" ] || break
        fi
        [ "$said" -eq 1 ] || {
            warn "the bus is still enumerating; waiting for the rest of the devices"
            said=1
        }
        sleep 1
        try=$((try + 1))
        "$RGB" --list-devices 2>/dev/null | map_parse > "$tmp"
        if [ "$(map_count "$tmp")" -gt "$n" ]; then
            mv "$tmp" "$best"
            n=$(map_count "$best")
            quiet=0
        else
            quiet=$((quiet + 1))
        fi
    done
    rm -f "$tmp"
}

map_build() {   # map_build [LISTING] — parse a listing, or fetch and settle one
    local out=${1:-} given=1 tmp rc=1
    have_openrgb || return 1
    mkdir -p "$CFG"
    tmp=$MAP.tmp.$$
    if [ -z "$out" ]; then
        given=0
        out=$("$RGB" --list-devices 2>/dev/null) || return 1
    fi
    printf '%s\n' "$out" | map_parse > "$tmp"
    # ⚠ A listing somebody ASKED for is not second-guessed. `syn-rgb devices` is
    # a person looking at their hardware and being shown the same answer this
    # parses; the wait above is for the machine deciding on its own at login.
    [ "$given" -eq 1 ] || map_settle "$tmp"
    if [ -s "$tmp" ]; then
        map_merge "$tmp" > "$tmp.m" && mv "$tmp.m" "$MAP" && rc=0
    fi
    rm -f "$tmp" "$tmp.m"
    return "$rc"
}

# ⛔ THE CACHE CAN ONLY EVER BE SMALLER THAN THE TRUTH, AND ONLY THE SMALL SIDE
# IS SILENT. A device that has GONE fails the whole openrgb call, and that
# failure is what rebuilds the map. A device that has ARRIVED fails nothing at
# all: the push still succeeds on every device the map does know about, so
# nothing ever asks again. That was the half of "the hardware changed under us"
# this program could not see, and at login it is the half that always happens.
#
# So when a listing is cheap, take one. Every push, and never mind the cache.
map_refresh() {
    sdk_server_up || return 0
    map_build || true
}

# One invocation, one bus probe, every device in it — `--device` can be given
# repeatedly with its own mode and colour, so this stays exactly as expensive
# as the single blanket push it replaces.
#
# ⚠ A STALE MAP CANNOT PAINT THE WRONG COLOUR. Every device is being handed the
# same one; an index that has shifted under us can only hand a device the wrong
# MODE, and an index that has gone away fails the call, which is what triggers
# the rebuild below.
push_mapped() {   # push_mapped RRGGBB
    local hex=$1 idx mode name
    local -a args=()
    [ -s "$MAP" ] || return 1
    while IFS=$'\t' read -r idx mode name; do
        case $idx in ''|\#*) continue ;; esac
        [ -n "$mode" ] || continue
        args+=(-d "$idx" -m "$mode" -c "$hex")
    done < "$MAP"
    [ "${#args[@]}" -gt 0 ] || return 1
    "$RGB" "${args[@]}" >/dev/null 2>&1
}

push_all() {   # push_all MODE RRGGBB — every device, one mode, the old way
    "$RGB" --mode "$1" --color "$2" >/dev/null 2>&1
}

push() {   # push RRGGBB
    local hex=$1 mode rc
    have_openrgb || { warn "openrgb is not installed"; return 3; }

    # An explicit `mode=` in rgb.state is somebody overriding all of this by
    # hand, and it stays one mode for everything, as it always did. `auto` —
    # the default, and what an absent key means — is the per-device map.
    mode=$(getval "$STATE" mode auto)
    if [ "$mode" != auto ]; then
        push_all "$mode" "$hex"
        rc=$?
        if [ "$rc" -ne 0 ] && [ "$mode" != static ]; then
            push_all static "$hex"
            rc=$?
        fi
        return "$rc"
    fi

    map_refresh
    push_mapped "$hex" && return 0
    # No map yet, or a device came or went since it was built.
    map_build && push_mapped "$hex" && return 0
    # ⚠ The blanket push is still the last word. A machine whose listing this
    # cannot parse gets its colour — just not, on the hardware that needs it,
    # the mode that would have held it.
    push_all direct "$hex" && return 0
    push_all static "$hex"
}

# How many times one run will chase a colour that moved under it. See the
# re-check in cmd_apply. Four is a bound rather than a target: it exists so a
# wallpaper slideshow cannot pin this process open, not because a fifth change
# would be wrong to follow.
APPLY_MAX=4

cmd_apply() {
    local hex prev n=0
    [ "$(getval "$STATE" on no)" = "yes" ] || { say "off"; return 0; }

    while :; do
        hex=$(wanted_colour) || {
            # A greyscale wallpaper is an ANSWER, not a failure: there is no hue
            # to follow, so the lights keep the last colour they were given
            # rather than snapping to something invented.
            say "no colour to follow"
            return 0
        }
        push "$hex"
        case $? in
            0) ;;
            # ⚠ "not installed" already said so, once. Saying it twice reads as
            # two different faults, and the unit treats this as the ordinary
            # answer it is rather than a failed session service.
            3) return 3 ;;
            *) warn "openrgb refused the colour"; return 1 ;;
        esac
        say "$hex"

        # ⛔ RE-READ BEFORE EXITING, and this is not belt-and-braces.
        #
        # syn-rgb.path cannot re-trigger while syn-rgb.service is still running,
        # and systemd does NOT queue what it misses — measured with a scratch
        # unit: three writes two seconds apart during one nine-second run fired
        # the service ONCE, on the FIRST value, and dropped the other two. So a
        # wallpaper changed while openrgb was busy left the lights on the colour
        # from the START of the burst, for ever, until something touched the file
        # again. That is the "it misses changes until I flip it off and on" this
        # loop is here to end — `on` re-runs cmd_apply directly, which is why
        # that worked around it.
        #
        # The push itself is the window, so the check has to be AFTER it and
        # inside the same process. Nothing else can do it: by the time this
        # exits, the event that would have re-triggered the unit is already gone.
        prev=$hex
        n=$((n + 1))
        [ "$n" -lt "$APPLY_MAX" ] || return 0
        hex=$(wanted_colour) || return 0
        [ "$hex" != "$prev" ] || return 0
    done
}

unit_do() {   # unit_do enable|disable
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl --user "$1" --now syn-rgb.path >/dev/null 2>&1 || true
    # ⚠ The SDK server comes and goes with the bridge, and it is deliberately
    # NOT left running by `off`: it holds the i2c devices open for the life of
    # the session, and somebody who has said "stop following my wallpaper" has
    # not agreed to a process sitting on their RAM's lighting controller.
    #
    # An optimisation and never a dependency — openrgb probes the bus when there
    # is no server — so a systemctl that refuses this is not an error worth
    # reporting. See syn-rgb-server.service.
    systemctl --user "$1" --now syn-rgb-server.service >/dev/null 2>&1 || true
}

case ${1:-status} in
    apply)  cmd_apply ;;
    # ⚠ The map is KEPT rather than dropped, and the apply below refreshes it.
    # It is the only record of how many devices this machine has, and `on` is
    # the worst possible moment to throw that away: it STARTS the SDK server,
    # and a listing taken in the seconds after that names the fast half of the
    # bus and nothing else. See map_settle.
    on)     setval on yes;  unit_do enable;  cmd_apply ;;
    off)    setval on no;   unit_do disable
            # Left as they are rather than blanked: turning the bridge off is
            # saying "stop following", not "turn my lights off". `syn-rgb dark`
            # is the other thing, and it is its own word.
            say "off" ;;
    dark)   push 000000 && say "000000" ;;
    colour|color)
            [ $# -ge 2 ] || { warn "colour wants RRGGBB"; exit 2; }
            setval follow fixed
            setval colour "${2#\#}"
            setval on yes
            cmd_apply ;;
    follow) [ $# -ge 2 ] || { warn "follow wants accent, theme or fixed"; exit 2; }
            case $2 in accent|theme|fixed) ;; *) warn "no such source: $2"; exit 2 ;; esac
            setval follow "$2"
            cmd_apply ;;
    brightness)
            [ $# -ge 2 ] || { warn "brightness wants 0.0 to 1.0"; exit 2; }
            setval brightness "$2"
            cmd_apply ;;
    devices)
            have_openrgb || { warn "openrgb is not installed"; exit 3; }
            # ⚠ ONE PROBE, BOTH JOBS: the listing a human asked to see is the
            # same listing the map is built from, so this doubles as the repair
            # for a map that has gone stale.
            listing=$("$RGB" --list-devices) || exit 1
            printf '%s\n' "$listing"
            map_build "$listing" || true ;;
    status)
            printf 'on\t%s\n'         "$(getval "$STATE" on no)"
            printf 'follow\t%s\n'     "$(getval "$STATE" follow accent)"
            printf 'brightness\t%s\n' "$(getval "$STATE" brightness 1.0)"
            printf 'mode\t%s\n'       "$(getval "$STATE" mode auto)"
            # ⚠ The redirect is what fails when there is no map, and its
            # complaint is the SHELL'S, printed before a `2>/dev/null` on the
            # command has been applied. Ask whether the file is there instead.
            printf 'devices\t%s\n'    "$([ -s "$MAP" ] && wc -l < "$MAP" || printf 0)"
            printf 'accent\t%s\n'     "$(accent_colour || printf 'none')"
            printf 'colour\t%s\n'     "$(wanted_colour || printf 'none')"
            printf 'openrgb\t%s\n'    "$(have_openrgb && printf yes || printf no)" ;;
    -h|--help|help)
            say "syn-rgb — the desktop accent, on the lights"
            say ""
            say "  syn-rgb on | off          follow the accent, or stop"
            say "  syn-rgb apply             push it once, now"
            say "  syn-rgb follow accent|theme|fixed"
            say "  syn-rgb colour RRGGBB     one colour, and stay on it"
            say "  syn-rgb brightness 0..1   how bright the lights run"
            say "  syn-rgb dark              all off, without turning this off"
            say "  syn-rgb devices           what OpenRGB can see, and re-read it"
            say "  syn-rgb status            what it would do" ;;
    *)      warn "unknown command: $1  (try syn-rgb help)"; exit 2 ;;
esac
