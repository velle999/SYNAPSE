# The scheduled sweep.
#
# ⚠ THIS IS NOT WHAT LYNIS LOOKS FOR. MALW-3284 and MALW-3286 want clamd and
# freshclam RUNNING, and those are ClamAV's own units.
#
# ⛔ AND clamd IS OPT-IN ON SynapseOS — 0.95 GB resident for a daemon this scan
# does not use. So MALW-3284 does not fire by default, and MALW-3286 cannot
# either: its prerequisite is CLAMD_RUNNING, which makes freshclam's 2 points
# unreachable however faithfully freshclam runs. That is a decision, not an
# oversight — see syn-scan.install.
#
# The After= below therefore orders against a unit that is usually not in the
# transaction at all, which is a no-op. It is correct for the machine that DID
# opt in, and costs nothing on the ones that did not.
[Unit]
Description=SynapseOS scheduled malware scan
# Signatures that are a week stale are worth saying out loud, but a scan is
# still worth running without the network.
After=clamav-daemon.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/syn-scan scan --system --quiet
ExecStart=/usr/bin/syn-scan scan --quiet /home /srv /tmp /var/tmp
# ⛔ 1 IS "IT FOUND SOMETHING", NOT "IT FAILED". A oneshot stops at the first
# ExecStart that fails, so while 1 counted as failure a single finding from the
# system checks meant the files were never scanned at all — which is what every
# weekly run did for as long as rkhunter reported its own log problem. What the
# scan found is in /var/lib/syn-scan (`syn-scan status --weekly`, Settings);
# 2 — an engine that could not run at all — is still a failed unit.
SuccessExitStatus=1

# ⚠ Nice/IOSchedulingClass are not politeness — this walks every game install
# on the disk, and a sweep that makes the desktop stutter is a sweep the user
# disables.
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

# The scan reads everything and writes only its own state — and its engines'
# scratch, which has to be somewhere writable too:
#   - clamscan unpacks archives into $TMPDIR, and /tmp is read-only here (it
#     is scanned, so it cannot be a private one). Without this, every archive
#     came back unreadable — a mod pack is exactly what this is for.
#   - rkhunter keeps temporary files in /var/lib/rkhunter; its log goes to
#     /var/lib/syn-scan (syn-scan passes --logfile).
ProtectSystem=strict
ReadWritePaths=/var/lib/syn-scan -/var/lib/rkhunter
Environment=TMPDIR=/var/lib/syn-scan/tmp
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/syn-scan/tmp
PrivateTmp=no
NoNewPrivileges=yes
ProtectKernelTunables=yes
# ⛔ NOT ProtectKernelModules=yes. It also makes /usr/lib/modules inaccessible,
# and rkhunter looks there for rootkit modules: every sweep reported "The kernel
# modules directory '/lib/modules' is missing or empty" as a finding, and that
# check never ran. These are the other two things it does, which is what keeps
# the scan from loading a module. EPERM, as ProtectKernelModules= returns,
# rather than the default SIGSYS.
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallFilter=~@module
SystemCallErrorNumber=EPERM
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
