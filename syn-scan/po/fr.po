msgstr "Analyser le dossier personnel"

msgid "Scanning..."
msgstr "Analyse en cours…"

msgid "The scan did not run (exit %1)."
msgstr "L'analyse n'a pas eu lieu (code de sortie %1)."

msgid "The weekly scan has not run yet."
msgstr "L'analyse hebdomadaire n'a pas encore eu lieu."

msgid "The weekly scan on %1 found nothing."
msgstr "L'analyse hebdomadaire du %1 n'a rien trouvé."

msgid "The weekly scan on %1: %2 thing needs a look."
