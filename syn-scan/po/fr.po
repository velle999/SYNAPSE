msgid "Unreadable"
msgstr "Illisible"

msgid "did not finish"
msgstr "inachevé"

#, c-format
msgid "ClamAV has no signature database at %s (%s)"
msgstr "ClamAV n'a pas de base de signatures dans %s (%s)"

#, c-format
msgid "could not read %s (%s), so this scan ran without the signatures in it"
msgstr ""
"impossible de lire %s (%s) : cette analyse s'est donc faite sans les "
"signatures qu'il contient"

#, c-format
msgid "ClamAV's signature database at %s cannot be read by this account"
msgstr ""
"la base de signatures de ClamAV dans %s n'est pas lisible par ce compte"

#, c-format
msgid ""
"ClamAV has no signature database at %s yet — freshclam may still be "
"downloading it"
msgstr ""
"ClamAV n'a pas encore de base de signatures dans %s — freshclam est peut-"
"être encore en train de la télécharger"

msgid "ClamAV"
msgstr "ClamAV"

msgid "Rootkit Hunter"
msgstr "Rootkit Hunter"

msgid "chkrootkit"
msgstr "chkrootkit"

msgid "Infected"
msgstr "Infecté"

msgid "Suspicious"
msgstr "Suspect"

msgid "Did not finish"
msgstr "Inachevé"

msgid "Clean"
msgstr "Sain"

