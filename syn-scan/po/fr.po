msgid ""
"%lu finding needs a look, but this record does not say what — run the scan "
"again to see it.\n"
msgid_plural ""
"%lu findings need a look, but this record does not say what — run the scan "
"again to see them.\n"
msgstr[0] ""
"%lu résultat est à examiner, mais cet enregistrement ne dit pas lequel — "
"relancez l'analyse pour le voir.\n"
msgstr[1] ""
"%lu résultats sont à examiner, mais cet enregistrement ne dit pas lesquels — "
"relancez l'analyse pour les voir.\n"

