msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr ""
"Mise à l'écart en cours ; `syn-scan quarantine restore` remet n'importe "
"lequel en place."

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr ""
"Rien n'a été déplacé. `syn-scan quarantine take <path>` met un fichier à "
"l'écart ; il peut toujours être restauré."

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr ""
"personne à qui demander sur un tube — passez --yes si c'est bien ce que vous "
"voulez"

msgid "not installed"
msgstr "non installé"

msgid "installed — needs root"
msgstr "installé — nécessite root"

msgid "quickshell is not installed — the window needs it"
msgstr "quickshell n'est pas installé — la fenêtre en a besoin"

msgid "--only needs an engine name"
msgstr "--only attend un nom de moteur"

#, c-format
msgid "no engine called '%s'"
msgstr "aucun moteur nommé '%s'"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` attend un élément sur lequel agir"

msgid "Permanently delete this quarantined file?"
msgstr "Supprimer définitivement ce fichier en quarantaine ?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "commande de quarantaine inconnue : %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr ""
"rien à analyser — indiquez un chemin, ou --system pour les contrôles de "
"rootkits"

#, c-format
msgid "%s does not exist — nothing was scanned"
msgstr "%s n'existe pas — rien n'a été analysé"

#, c-format
msgid "%s: %s — nothing was scanned"
msgstr "%s : %s — rien n'a été analysé"

msgid "--system without root: the checks will be partial"
msgstr "--system sans root : les contrôles seront partiels"

#, c-format
msgid "%s: not a regular file"
msgstr "%s : n'est pas un fichier ordinaire"

#, c-format
msgid "would quarantine %s"
msgstr "mettrait %s en quarantaine"

#, c-format
msgid "%s: copied to quarantine but could not be removed: %s"
msgstr "%s : copié en quarantaine mais impossible à supprimer : %s"

#, c-format
msgid "quarantined %s"
msgstr "%s mis en quarantaine"

msgid "Quarantine is empty."
msgstr "La quarantaine est vide."

#, c-format
msgid "%s: no such quarantined file"
msgstr "%s : aucun fichier de ce nom en quarantaine"

#, c-format
msgid "would restore %s to %s"
msgstr "remettrait %s vers %s"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "%s : impossible de rétablir les permissions d'origine : %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "%s existe déjà — pas d'écrasement"

#, c-format
msgid "%s: %s"
msgstr "%s : %s"

#, c-format
msgid "restored %s"
msgstr "%s restauré"

#, c-format
msgid "would purge %s"
msgstr "supprimerait définitivement %s"

#, c-format
msgid "purged %s"
msgstr "%s supprimé définitivement"

#, c-format
msgid "%s is not installed"
msgstr "%s n'est pas installé"

#, c-format
msgid "  %-12s not installed, skipped"
msgstr "  %-12s non installé, ignoré"

#, c-format
msgid "%s needs root — try: sudo syn-scan ..."
msgstr "%s nécessite root — essayez : sudo syn-scan ..."

#, c-format
msgid "  %-12s installed, but needs root — skipped"
msgstr "  %-12s installé, mais nécessite root — ignoré"

#, c-format
msgid "  %-12s running..."
msgstr "  %-12s en cours…"

#, c-format
msgid "%s could not be run"
msgstr "%s n'a pas pu être lancé"

msgid "no engine ran — install clamav, or pass --only for the one you meant"
msgstr ""
"aucun moteur n'a tourné — installez clamav, ou passez --only avec celui que "
"vous vouliez"

msgid "No scan has run yet."
msgstr "Aucune analyse n'a encore eu lieu."

#, c-format
msgid "Weekly scan: %s"
msgstr "Analyse hebdomadaire : %s"

#, c-format
msgid "Last scan: %s"
msgstr "Dernière analyse : %s"

msgid "Nothing outstanding."
msgstr "Rien en attente."

