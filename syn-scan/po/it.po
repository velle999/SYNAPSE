msgid "Check For Rootkits"
msgstr "Cerca rootkit"

msgid "Findings"
msgstr "Rilevamenti"

msgid "Malware Scan"
msgstr "Analisi malware"

msgid "No findings."
msgstr "Nessun rilevamento."

msgid "Nothing found."
msgstr "Non è stato trovato nulla."

msgid "Nothing in quarantine."
msgstr "Niente in quarantena."

msgid "Quarantine"
msgstr "Quarantena"

msgid "Running the system checks..."
msgstr "Controlli di sistema in corso…"

msgid "Scan Downloads"
msgstr "Analizza Scaricati"

msgid "Scan Home Folder"
msgstr "Analizza cartella personale"

msgid "Scanning..."
msgstr "Analisi in corso…"

msgid "The scan did not run (exit %1)."
msgstr "L'analisi non è stata eseguita (codice di uscita %1)."

msgid "The weekly scan has not run yet."
msgstr "L'analisi settimanale non è ancora stata eseguita."

msgid "The weekly scan on %1 found nothing."
msgstr "L'analisi settimanale del %1 non ha trovato nulla."

msgid "The weekly scan on %1: %2 thing needs a look."
msgid_plural "The weekly scan on %1: %2 things need a look."
msgstr[0] "Analisi settimanale del %1: %2 elemento da guardare."
