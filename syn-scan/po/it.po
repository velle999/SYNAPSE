msgid "Unreadable"
msgstr "Illeggibile"

msgid "did not finish"
msgstr "non completato"

#, c-format
msgid "ClamAV has no signature database at %s (%s)"
msgstr "ClamAV non ha un database delle firme in %s (%s)"

#, c-format
msgid "could not read %s (%s), so this scan ran without the signatures in it"
msgstr ""
"impossibile leggere %s (%s), quindi questa analisi è stata eseguita senza le "
"firme che contiene"

#, c-format
msgid "ClamAV's signature database at %s cannot be read by this account"
msgstr "questo account non può leggere il database delle firme di ClamAV in %s"

#, c-format
msgid ""
"ClamAV has no signature database at %s yet — freshclam may still be "
"downloading it"
msgstr ""
"ClamAV non ha ancora un database delle firme in %s — freshclam potrebbe "
"starlo ancora scaricando"

msgid "ClamAV"
msgstr "ClamAV"

msgid "Rootkit Hunter"
msgstr "Rootkit Hunter"

msgid "chkrootkit"
msgstr "chkrootkit"

msgid "Infected"
msgstr "Infetto"

msgid "Suspicious"
msgstr "Sospetto"

msgid "Did not finish"
msgstr "Non completato"

msgid "Clean"
msgstr "Pulito"

