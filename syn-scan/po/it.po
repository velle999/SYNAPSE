msgid ""
"\n"
"%zu file could not be scanned:\n"
msgid_plural ""
"\n"
"%zu files could not be scanned:\n"
msgstr[0] ""
"\n"
"Impossibile analizzare %zu file:\n"
msgstr[1] ""
"\n"
"Impossibile analizzare %zu file:\n"

