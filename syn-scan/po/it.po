"\n"
"%zu elementi da guardare.\n"

msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr ""
"Li metto da parte ora; `syn-scan quarantine restore` rimette al suo posto "
"uno qualsiasi di essi."

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr ""
"Non è stato spostato nulla. `syn-scan quarantine take <path>` mette da parte "
"un file; si può sempre ripristinare."

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr ""
"su una pipe non c'è nessuno a cui chiedere — passa --yes se fai sul serio"

msgid "not installed"
msgstr "non installato"

msgid "installed — needs root"
msgstr "installato — richiede root"

msgid "quickshell is not installed — the window needs it"
msgstr "quickshell non è installato — la finestra ne ha bisogno"

msgid "--only needs an engine name"
msgstr "--only richiede il nome di un motore"

#, c-format
msgid "no engine called '%s'"
msgstr "nessun motore chiamato '%s'"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` richiede qualcosa su cui agire"

msgid "Permanently delete this quarantined file?"
msgstr "Eliminare definitivamente questo file in quarantena?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "comando di quarantena inesistente: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr ""
"niente da analizzare — indica un percorso, o --system per i controlli sui "
"rootkit"

#, c-format
msgid "%s does not exist — nothing was scanned"
msgstr "%s non esiste — non è stato analizzato nulla"

#, c-format
msgid "%s: %s — nothing was scanned"
msgstr "%s: %s — non è stato analizzato nulla"

msgid "--system without root: the checks will be partial"
msgstr "--system senza root: i controlli saranno parziali"

#, c-format
msgid "%s: not a regular file"
msgstr "%s: non è un file regolare"

#, c-format
msgid "would quarantine %s"
msgstr "metterebbe %s in quarantena"

#, c-format
msgid "%s: copied to quarantine but could not be removed: %s"
msgstr "%s: copiato in quarantena ma impossibile da rimuovere: %s"

#, c-format
msgid "quarantined %s"
msgstr "%s messo in quarantena"

msgid "Quarantine is empty."
msgstr "La quarantena è vuota."

#, c-format
msgid "%s: no such quarantined file"
msgstr "%s: nessun file con questo nome in quarantena"

#, c-format
msgid "would restore %s to %s"
msgstr "rimetterebbe %s in %s"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "%s: impossibile ripristinare i permessi originali: %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "%s esiste già — non viene sovrascritto"

#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#, c-format
msgid "restored %s"
msgstr "%s ripristinato"

#, c-format
msgid "would purge %s"
msgstr "eliminerebbe definitivamente %s"

#, c-format
msgid "purged %s"
msgstr "%s eliminato definitivamente"

#, c-format
msgid "%s is not installed"
msgstr "%s non è installato"

#, c-format
msgid "  %-12s not installed, skipped"
msgstr "  %-12s non installato, saltato"

#, c-format
msgid "%s needs root — try: sudo syn-scan ..."
msgstr "%s richiede root — prova: sudo syn-scan ..."

#, c-format
msgid "  %-12s installed, but needs root — skipped"
msgstr "  %-12s installato, ma richiede root — saltato"

#, c-format
msgid "  %-12s running..."
msgstr "  %-12s in esecuzione…"

#, c-format
msgid "%s could not be run"
msgstr "impossibile eseguire %s"

msgid "no engine ran — install clamav, or pass --only for the one you meant"
msgstr ""
"nessun motore è stato eseguito — installa clamav, o passa --only con quello "
"che intendevi"

msgid "No scan has run yet."
msgstr "Non è ancora stata eseguita nessuna analisi."

#, c-format
msgid "Weekly scan: %s"
msgstr "Analisi settimanale: %s"

#, c-format
msgid "Last scan: %s"
msgstr "Ultima analisi: %s"

msgid "Nothing outstanding."
msgstr "Niente in sospeso."

