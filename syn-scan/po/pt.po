msgstr "%s: copiado para a quarentena, mas não foi possível removê-lo: %s"

#, c-format
msgid "quarantined %s"
msgstr "%s posto em quarentena"

msgid "Quarantine is empty."
msgstr "A quarentena está vazia."

#, c-format
msgid "%s: no such quarantined file"
msgstr "%s: não existe nenhum ficheiro em quarentena com esse nome"

#, c-format
msgid "would restore %s to %s"
msgstr "reporia %s em %s"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "%s: não foi possível repor as permissões originais: %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "%s já existe — não será substituído"

#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#, c-format
msgid "restored %s"
msgstr "%s reposto"

#, c-format
msgid "would purge %s"
msgstr "eliminaria definitivamente %s"

#, c-format
msgid "purged %s"
msgstr "%s eliminado definitivamente"

#, c-format
msgid "%s is not installed"
msgstr "o %s não está instalado"

#, c-format
msgid "  %-12s not installed, skipped"
msgstr "  %-12s não instalado, ignorado"

#, c-format
msgid "%s needs root — try: sudo syn-scan ..."
msgstr "o %s precisa de root — experimente: sudo syn-scan ..."

#, c-format
msgid "  %-12s installed, but needs root — skipped"
msgstr "  %-12s instalado, mas precisa de root — ignorado"

#, c-format
msgid "  %-12s running..."
msgstr "  %-12s em execução…"

#, c-format
msgid "%s could not be run"
msgstr "não foi possível executar o %s"

msgid "no engine ran — install clamav, or pass --only for the one you meant"
msgstr ""
"nenhum motor foi executado — instale o clamav, ou passe --only com o que "
"pretendia"

msgid "No scan has run yet."
msgstr "Ainda não foi executada nenhuma análise."

#, c-format
msgid "Weekly scan: %s"
msgstr "Análise semanal: %s"

#, c-format
msgid "Last scan: %s"
msgstr "Última análise: %s"

msgid "Nothing outstanding."
msgstr "Nada pendente."

