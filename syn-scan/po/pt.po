msgstr "não terminou"

#, c-format
msgid "ClamAV has no signature database at %s (%s)"
msgstr "O ClamAV não tem base de dados de assinaturas em %s (%s)"

#, c-format
msgid "could not read %s (%s), so this scan ran without the signatures in it"
msgstr ""
"não foi possível ler %s (%s), por isso esta análise correu sem as "
"assinaturas que contém"

#, c-format
msgid "ClamAV's signature database at %s cannot be read by this account"
msgstr ""
"esta conta não consegue ler a base de dados de assinaturas do ClamAV em %s"

#, c-format
msgid ""
"ClamAV has no signature database at %s yet — freshclam may still be "
"downloading it"
msgstr ""
"O ClamAV ainda não tem base de dados de assinaturas em %s — o freshclam pode "
"ainda estar a descarregá-la"

