msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr ""
"A pôr estes de parte agora; `syn-scan quarantine restore` devolve qualquer "
"um deles ao seu lugar."

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr ""
"Nada foi movido. `syn-scan quarantine take <path>` põe um ficheiro de parte; "
"pode sempre ser reposto."

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr ""
"numa pipe não há a quem perguntar — passe --yes se é mesmo isso que quer"

msgid "not installed"
msgstr "não instalado"

msgid "installed — needs root"
msgstr "instalado — precisa de root"

msgid "quickshell is not installed — the window needs it"
msgstr "o quickshell não está instalado — a janela precisa dele"

msgid "--only needs an engine name"
msgstr "--only precisa do nome de um motor"

#, c-format
msgid "no engine called '%s'"
msgstr "não há nenhum motor chamado '%s'"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` precisa de algo sobre o qual agir"

msgid "Permanently delete this quarantined file?"
msgstr "Eliminar definitivamente este ficheiro em quarentena?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "não existe esse comando de quarentena: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr ""
"nada para analisar — indique um caminho, ou --system para as verificações de "
"rootkits"

#, c-format
msgid "%s does not exist — nothing was scanned"
msgstr "%s não existe — nada foi analisado"

#, c-format
msgid "%s: %s — nothing was scanned"
msgstr "%s: %s — nada foi analisado"

msgid "--system without root: the checks will be partial"
msgstr "--system sem root: as verificações serão parciais"

#, c-format
msgid "%s: not a regular file"
msgstr "%s: não é um ficheiro normal"

#, c-format
msgid "would quarantine %s"
msgstr "poria %s em quarentena"

