msgid "%1 thing needs a look."
msgid_plural "%1 things need a look."
msgstr[0] "%1 件の確認が必要です。"

msgid "Check For Rootkits"
msgstr "ルートキットを検査"

msgid "Findings"
msgstr "検出結果"

msgid "Malware Scan"
msgstr "マルウェアスキャン"

msgid "No findings."
msgstr "検出はありません。"

msgid "Nothing found."
msgstr "何も見つかりませんでした。"

msgid "Nothing in quarantine."
msgstr "隔離中のものはありません。"

msgid "Quarantine"
msgstr "隔離"

msgid "Running the system checks..."
msgstr "システム検査を実行中…"

msgid "Scan Downloads"
msgstr "ダウンロードをスキャン"

msgid "Scan Home Folder"
msgstr "ホームフォルダーをスキャン"

msgid "Scanning..."
msgstr "スキャン中…"

msgid "The weekly scan has not run yet."
msgstr "週次スキャンはまだ実行されていません。"

msgid "The weekly scan on %1 found nothing."
msgstr "%1 の週次スキャンでは何も見つかりませんでした。"

msgid "The weekly scan on %1: %2 thing needs a look."
msgid_plural "The weekly scan on %1: %2 things need a look."
msgstr[0] "%1 の週次スキャン: %2 件の確認が必要です。"

msgid "Unreadable"
msgstr "読み取れない"

msgid "did not finish"
msgstr "完了せず"

#, c-format
msgid "ClamAV has no signature database at %s (%s)"
msgstr "%s に ClamAV のシグネチャデータベースがありません (%s)"

#, c-format
msgid "could not read %s (%s), so this scan ran without the signatures in it"
msgstr "%s を読み取れませんでした (%s)。このスキャンはそこに含まれるシグネチャなしで実行されました"

#, c-format
msgid "ClamAV's signature database at %s cannot be read by this account"
msgstr "%s にある ClamAV のシグネチャデータベースは、このアカウントでは読み取れません"

#, c-format
msgid ""
"ClamAV has no signature database at %s yet — freshclam may still be "
"downloading it"
msgstr "%s にはまだ ClamAV のシグネチャデータベースがありません — freshclam がまだダウンロード中かもしれません"

msgid "ClamAV"
msgstr "ClamAV"

msgid "Rootkit Hunter"
msgstr "Rootkit Hunter"

msgid "chkrootkit"
msgstr "chkrootkit"

msgid "Infected"
msgstr "感染"

msgid "Suspicious"
msgstr "疑わしい"

msgid "Did not finish"
msgstr "完了せず"

msgid "Clean"
msgstr "問題なし"

#, c-format
msgid ""
"\n"
"%zu file could not be scanned:\n"
msgid_plural ""
"\n"
"%zu files could not be scanned:\n"
msgstr[0] "\n%zu 個のファイルをスキャンできませんでした:\n"

#, c-format
msgid "%s did not finish: %s"
msgstr "%s は完了しませんでした: %s"

#, c-format
msgid ""
"\n"
"%zu thing needs a look.\n"
msgid_plural ""
"\n"
"%zu things need a look.\n"
msgstr[0] "\n%zu 件の確認が必要です。\n"

msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr "これらを今から隔離します。`syn-scan quarantine restore` でどれでも元に戻せます。"

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr "何も移動していません。`syn-scan quarantine take <path>` でファイルを隔離できます。いつでも元に戻せます。"

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr "パイプでは尋ねる相手がいません — 本気なら --yes を付けてください"

msgid "not installed"
msgstr "未インストール"

msgid "installed — needs root"
msgstr "インストール済み — root が必要"

msgid "quickshell is not installed — the window needs it"
msgstr "quickshell がインストールされていません — ウィンドウに必要です"

msgid "--only needs an engine name"
msgstr "--only にはエンジン名が必要です"

#, c-format
msgid "no engine called '%s'"
msgstr "'%s' という名前のエンジンはありません"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` には対象の指定が必要です"

msgid "Permanently delete this quarantined file?"
msgstr "この隔離ファイルを完全に削除しますか?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "そのような quarantine コマンドはありません: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr "スキャンする対象がありません — パスを指定するか、ルートキット検査には --system を付けてください"

msgid "--system without root: the checks will be partial"
msgstr "root なしの --system: 検査は部分的になります"

#, c-format
msgid "%s: not a regular file"
msgstr "%s: 通常のファイルではありません"

#, c-format
msgid "would quarantine %s"
msgstr "隔離対象: %s"

#, c-format
msgid "%s: copied to quarantine but could not be removed: %s"
msgstr "%s: 隔離領域にコピーしましたが、元のファイルを削除できませんでした: %s"

#, c-format
msgid "quarantined %s"
msgstr "%s を隔離しました"

msgid "Quarantine is empty."
msgstr "隔離領域は空です。"

#, c-format
msgid "%s: no such quarantined file"
msgstr "%s: そのような隔離ファイルはありません"

#, c-format
msgid "would restore %s to %s"
msgstr "復元対象: %s → %s"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "%s: 元のアクセス権を復元できませんでした: %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "%s は既に存在します — 上書きしません"

#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#, c-format
msgid "restored %s"
msgstr "%s を復元しました"

#, c-format
msgid "would purge %s"
msgstr "完全削除の対象: %s"

#, c-format
msgid "purged %s"
msgstr "%s を完全に削除しました"

#, c-format
msgid "%s is not installed"
msgstr "%s が入っていません"

#, c-format
msgid "  %-12s not installed, skipped"
msgstr "  %-12s 未インストールのためスキップ"

#, c-format
msgid "%s needs root — try: sudo syn-scan ..."
msgstr "%s には root が必要です — 次を試してください: sudo syn-scan ..."

#, c-format
msgid "  %-12s installed, but needs root — skipped"
msgstr "  %-12s インストール済みですが root が必要なためスキップ"

#, c-format
msgid "  %-12s running..."
msgstr "  %-12s 実行中…"

#, c-format
msgid "%s could not be run"
msgstr "%s を実行できませんでした"

msgid "no engine ran — install clamav, or pass --only for the one you meant"
msgstr "どのエンジンも実行されませんでした — clamav をインストールするか、目的のエンジンを --only で指定してください"

msgid "No scan has run yet."
msgstr "まだスキャンは実行されていません。"

#, c-format
msgid "Weekly scan: %s"
msgstr "週次スキャン: %s"

#, c-format
msgid "Last scan: %s"
msgstr "前回のスキャン: %s"

msgid "Nothing outstanding."
msgstr "未対応のものはありません。"

#, c-format
msgid ""
"%lu finding needs a look, but this record does not say what — run the scan "
"again to see it.\n"
msgid_plural ""
"%lu findings need a look, but this record does not say what — run the scan "
"again to see them.\n"
msgstr[0] "%lu 件の確認が必要ですが、この記録には内容が残っていません — もう一度スキャンすると表示されます。\n"

