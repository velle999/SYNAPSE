msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr "इन्हें अभी अलग रखा जा रहा है; `syn-scan quarantine restore` इनमें से किसी को भी वापस रख देता है।"

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr "कुछ भी नहीं हटाया गया। `syn-scan quarantine take <path>` किसी फ़ाइल को अलग रख देता है; उसे हमेशा वापस लाया जा सकता है।"

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr "पाइप में पूछने को कोई नहीं — अगर सच में चाहते हैं तो --yes दें"

msgid "not installed"
msgstr "संस्थापित नहीं"

msgid "installed — needs root"
msgstr "इंस्टॉल है — root चाहिए"

msgid "quickshell is not installed — the window needs it"
msgstr "quickshell इंस्टॉल नहीं है — विंडो को इसकी ज़रूरत है"

msgid "--only needs an engine name"
msgstr "--only को किसी इंजन का नाम चाहिए"

#, c-format
msgid "no engine called '%s'"
msgstr "'%s' नाम का कोई इंजन नहीं है"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` को बताना होगा कि किस पर काम करना है"

msgid "Permanently delete this quarantined file?"
msgstr "इस क्वारंटीन की गई फ़ाइल को स्थायी रूप से हटाएँ?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "ऐसा कोई क्वारंटीन कमांड नहीं: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr "स्कैन करने को कुछ नहीं — कोई पथ दें, या रूटकिट जाँच के लिए --system दें"

msgid "--system without root: the checks will be partial"
msgstr "root के बिना --system: जाँच अधूरी रहेगी"

#, c-format
msgid "%s: not a regular file"
msgstr "%s: सामान्य फ़ाइल नहीं है"

#, c-format
