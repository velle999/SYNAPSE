msgstr "Skanowanie…"

msgid "The weekly scan has not run yet."
msgstr "Cotygodniowe skanowanie jeszcze się nie odbyło."

msgid "The weekly scan on %1 found nothing."
msgstr "Cotygodniowe skanowanie z %1 niczego nie znalazło."

msgid "The weekly scan on %1: %2 thing needs a look."
msgid_plural "The weekly scan on %1: %2 things need a look."
msgstr[0] "Cotygodniowe skanowanie z %1 — do sprawdzenia: %2 element."
