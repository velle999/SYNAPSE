msgid "Unreadable"
msgstr "Nieczytelny"

msgid "did not finish"
msgstr "nie ukończono"

#, c-format
msgid "ClamAV has no signature database at %s (%s)"
msgstr "ClamAV nie ma bazy sygnatur w %s (%s)"

#, c-format
msgid "could not read %s (%s), so this scan ran without the signatures in it"
msgstr "nie udało się odczytać %s (%s), więc to skanowanie odbyło się bez zawartych w nim sygnatur"

#, c-format
msgid "ClamAV's signature database at %s cannot be read by this account"
msgstr "to konto nie może odczytać bazy sygnatur ClamAV w %s"

#, c-format
msgid ""
"ClamAV has no signature database at %s yet — freshclam may still be "
"downloading it"
msgstr "ClamAV nie ma jeszcze bazy sygnatur w %s — freshclam może ją wciąż pobierać"

msgid "ClamAV"
msgstr "ClamAV"

msgid "Rootkit Hunter"
msgstr "Rootkit Hunter"

msgid "chkrootkit"
msgstr "chkrootkit"

msgid "Infected"
msgstr "Zainfekowany"

msgid "Suspicious"
msgstr "Podejrzany"

msgid "Did not finish"
msgstr "Nie ukończono"

msgid "Clean"
msgstr "Czysty"

#, c-format
msgid ""
"\n"
"%zu file could not be scanned:\n"
msgid_plural ""
"\n"
"%zu files could not be scanned:\n"
msgstr[0] "\n%zu plik nie mógł zostać przeskanowany:\n"
msgstr[1] "\n%zu pliki nie mogły zostać przeskanowane:\n"
msgstr[2] "\n%zu plików nie mogło zostać przeskanowanych:\n"

#, c-format
msgid "%s did not finish: %s"
msgstr "%s nie ukończył pracy: %s"

#, c-format
msgid ""
"\n"
"%zu thing needs a look.\n"
msgid_plural ""
"\n"
"%zu things need a look.\n"
msgstr[0] "\nDo sprawdzenia: %zu element.\n"
msgstr[1] "\nDo sprawdzenia: %zu elementy.\n"
msgstr[2] "\nDo sprawdzenia: %zu elementów.\n"

msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr "Odkładam je teraz na bok; `syn-scan quarantine restore` przywraca każdy z nich."

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr "Nic nie zostało przeniesione. `syn-scan quarantine take <path>` odkłada plik na bok; zawsze można go przywrócić."

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr "w potoku nie ma kogo pytać — podaj --yes, jeśli na pewno"

msgid "not installed"
msgstr "nie zainstalowano"

msgid "installed — needs root"
msgstr "zainstalowany — wymaga roota"

msgid "quickshell is not installed — the window needs it"
msgstr "quickshell nie jest zainstalowany — okno go potrzebuje"

msgid "--only needs an engine name"
msgstr "--only wymaga nazwy silnika"

#, c-format
msgid "no engine called '%s'"
msgstr "nie ma silnika o nazwie '%s'"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` wymaga wskazania, na czym działać"

msgid "Permanently delete this quarantined file?"
msgstr "Trwale usunąć ten plik z kwarantanny?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "nie ma takiego polecenia kwarantanny: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr "nie ma czego skanować — podaj ścieżkę albo --system dla kontroli rootkitów"

msgid "--system without root: the checks will be partial"
msgstr "--system bez roota: kontrole będą niepełne"

#, c-format
msgid "%s: not a regular file"
msgstr "%s: to nie jest zwykły plik"

#, c-format
msgid "would quarantine %s"
msgstr "%s zostałby przeniesiony do kwarantanny"

#, c-format
msgid "%s: copied to quarantine but could not be removed: %s"
msgstr "%s: skopiowano do kwarantanny, ale nie udało się usunąć: %s"

#, c-format
msgid "quarantined %s"
msgstr "przeniesiono %s do kwarantanny"

msgid "Quarantine is empty."
msgstr "Kwarantanna jest pusta."

#, c-format
msgid "%s: no such quarantined file"
msgstr "%s: nie ma takiego pliku w kwarantannie"

#, c-format
msgid "would restore %s to %s"
msgstr "%s zostałby przywrócony do %s"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "%s: nie udało się przywrócić pierwotnych uprawnień: %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "%s już istnieje — nie zostanie nadpisany"

#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#, c-format
msgid "restored %s"
msgstr "przywrócono %s"

#, c-format
msgid "would purge %s"
msgstr "%s zostałby trwale usunięty"

#, c-format
msgid "purged %s"
msgstr "trwale usunięto %s"

#, c-format
msgid "%s is not installed"
msgstr "%s nie jest zainstalowany"

#, c-format
msgid "  %-12s not installed, skipped"
msgstr "  %-12s nie zainstalowano, pominięto"

#, c-format
msgid "%s needs root — try: sudo syn-scan ..."
msgstr "%s wymaga roota — spróbuj: sudo syn-scan ..."

#, c-format
msgid "  %-12s installed, but needs root — skipped"
msgstr "  %-12s zainstalowany, ale wymaga roota — pominięto"

#, c-format
msgid "  %-12s running..."
msgstr "  %-12s działa…"

#, c-format
msgid "%s could not be run"
msgstr "nie udało się uruchomić %s"

msgid "no engine ran — install clamav, or pass --only for the one you meant"
msgstr "żaden silnik nie zadziałał — zainstaluj clamav albo podaj --only z tym, o który chodziło"

msgid "No scan has run yet."
msgstr "Nie przeprowadzono jeszcze żadnego skanowania."

#, c-format
msgid "Weekly scan: %s"
msgstr "Cotygodniowe skanowanie: %s"

#, c-format
msgid "Last scan: %s"
msgstr "Ostatnie skanowanie: %s"

msgid "Nothing outstanding."
msgstr "Nic nie czeka na sprawdzenie."

#, c-format
msgid ""
"%lu finding needs a look, but this record does not say what — run the scan "
"again to see it.\n"
msgid_plural ""
"%lu findings need a look, but this record does not say what — run the scan "
"again to see them.\n"
msgstr[0] "%lu wykrycie wymaga sprawdzenia, ale ten zapis nie mówi, jakie — uruchom skanowanie ponownie, aby je zobaczyć.\n"
msgstr[1] "%lu wykrycia wymagają sprawdzenia, ale ten zapis nie mówi, jakie — uruchom skanowanie ponownie, aby je zobaczyć.\n"
msgstr[2] "%lu wykryć wymaga sprawdzenia, ale ten zapis nie mówi, jakie — uruchom skanowanie ponownie, aby je zobaczyć.\n"

