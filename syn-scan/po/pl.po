msgstr[2] "Do sprawdzenia: %1 elementów."

msgid "Check For Rootkits"
msgstr "Szukaj rootkitów"

msgid "Findings"
msgstr "Wykrycia"

msgid "Malware Scan"
msgstr "Skaner złośliwego oprogramowania"

