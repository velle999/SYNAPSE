msgstr "Schadsoftware-Prüfung"

msgid "No findings."
msgstr "Keine Funde."

msgid "Nothing found."
msgstr "Nichts gefunden."

msgid "Nothing in quarantine."
msgstr "Nichts in Quarantäne."

