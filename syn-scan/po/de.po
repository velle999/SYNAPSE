msgid "could not read %s (%s), so this scan ran without the signatures in it"
msgstr "%s konnte nicht gelesen werden (%s), daher lief diese Prüfung ohne die Signaturen darin"

#, c-format
msgid "ClamAV's signature database at %s cannot be read by this account"
msgstr "ClamAVs Signaturdatenbank unter %s ist für dieses Konto nicht lesbar"

#, c-format
msgid ""
"ClamAV has no signature database at %s yet — freshclam may still be "
"downloading it"
msgstr "ClamAV hat noch keine Signaturdatenbank unter %s — freshclam lädt sie womöglich noch herunter"

msgid "ClamAV"
msgstr "ClamAV"

msgid "Rootkit Hunter"
msgstr "Rootkit Hunter"

msgid "chkrootkit"
msgstr "chkrootkit"

msgid "Infected"
msgstr "Infiziert"

msgid "Suspicious"
msgstr "Verdächtig"

msgid "Did not finish"
msgstr "Nicht abgeschlossen"

msgid "Clean"
msgstr "Sauber"

#, c-format
msgid ""
"\n"
"%zu file could not be scanned:\n"
msgid_plural ""
"\n"
"%zu files could not be scanned:\n"
msgstr[0] "\n%zu Datei konnte nicht geprüft werden:\n"
msgstr[1] "\n%zu Dateien konnten nicht geprüft werden:\n"

#, c-format
msgid "%s did not finish: %s"
msgstr "%s wurde nicht abgeschlossen: %s"

#, c-format
msgid ""
"\n"
"%zu thing needs a look.\n"
msgid_plural ""
"\n"
"%zu things need a look.\n"
msgstr[0] "\n%zu Fund muss angesehen werden.\n"
msgstr[1] "\n%zu Funde müssen angesehen werden.\n"

msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr "Diese werden jetzt beiseitegelegt; `syn-scan quarantine restore` legt jeden davon zurück."

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr "Es wurde nichts verschoben. `syn-scan quarantine take <path>` legt eine Datei beiseite; sie lässt sich jederzeit wiederherstellen."

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr "auf einer Pipe gibt es niemanden zu fragen — gib --yes an, wenn du es ernst meinst"

msgid "not installed"
msgstr "nicht installiert"

msgid "installed — needs root"
msgstr "installiert — braucht root"

msgid "quickshell is not installed — the window needs it"
msgstr "quickshell ist nicht installiert — das Fenster braucht es"

msgid "--only needs an engine name"
msgstr "--only braucht den Namen einer Engine"

#, c-format
msgid "no engine called '%s'"
msgstr "keine Engine namens '%s'"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` braucht etwas, worauf es wirken soll"

msgid "Permanently delete this quarantined file?"
msgstr "Diese Datei aus der Quarantäne endgültig löschen?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "kein solcher Quarantäne-Befehl: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr "nichts zu prüfen — gib einen Pfad an, oder --system für die Rootkit-Prüfungen"

msgid "--system without root: the checks will be partial"
msgstr "--system ohne root: die Prüfungen bleiben unvollständig"

#, c-format
msgid "%s: not a regular file"
msgstr "%s: keine reguläre Datei"

#, c-format
msgid "would quarantine %s"
msgstr "würde %s in Quarantäne verschieben"

#, c-format
msgid "%s: copied to quarantine but could not be removed: %s"
msgstr "%s: in die Quarantäne kopiert, konnte aber nicht entfernt werden: %s"

#, c-format
msgid "quarantined %s"
msgstr "%s in Quarantäne verschoben"

msgid "Quarantine is empty."
msgstr "Die Quarantäne ist leer."

#, c-format
msgid "%s: no such quarantined file"
msgstr "%s: keine solche Datei in Quarantäne"

#, c-format
msgid "would restore %s to %s"
msgstr "würde %s nach %s zurücklegen"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "%s: die ursprünglichen Zugriffsrechte ließen sich nicht wiederherstellen: %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "%s existiert bereits — wird nicht überschrieben"

#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#, c-format
msgid "restored %s"
msgstr "%s wiederhergestellt"

#, c-format
msgid "would purge %s"
msgstr "würde %s endgültig löschen"

#, c-format
msgid "purged %s"
msgstr "%s endgültig gelöscht"

#, c-format
msgid "%s is not installed"
msgstr "%s ist nicht installiert"

#, c-format
msgid "  %-12s not installed, skipped"
msgstr "  %-12s nicht installiert, übersprungen"

#, c-format
msgid "%s needs root — try: sudo syn-scan ..."
msgstr "%s braucht root — versuch: sudo syn-scan ..."

#, c-format
msgid "  %-12s installed, but needs root — skipped"
msgstr "  %-12s installiert, braucht aber root — übersprungen"

#, c-format
msgid "  %-12s running..."
msgstr "  %-12s läuft …"

#, c-format
msgid "%s could not be run"
msgstr "%s konnte nicht ausgeführt werden"

msgid "no engine ran — install clamav, or pass --only for the one you meant"
msgstr "keine Engine ist gelaufen — installiere clamav, oder gib mit --only die gemeinte an"

msgid "No scan has run yet."
msgstr "Es ist noch keine Prüfung gelaufen."

#, c-format
msgid "Weekly scan: %s"
msgstr "Wöchentliche Prüfung: %s"

#, c-format
msgid "Last scan: %s"
msgstr "Letzte Prüfung: %s"

msgid "Nothing outstanding."
msgstr "Nichts offen."

#, c-format
msgid ""
"%lu finding needs a look, but this record does not say what — run the scan "
"again to see it.\n"
msgid_plural ""
"%lu findings need a look, but this record does not say what — run the scan "
"again to see them.\n"
msgstr[0] "%lu Fund muss angesehen werden, aber dieser Eintrag sagt nicht, welcher — führe die Prüfung erneut aus, um ihn zu sehen.\n"
msgstr[1] "%lu Funde müssen angesehen werden, aber dieser Eintrag sagt nicht, welche — führe die Prüfung erneut aus, um sie zu sehen.\n"

