msgid "Unreadable"
msgstr "Nicht lesbar"

msgid "did not finish"
msgstr "nicht abgeschlossen"

#, c-format
msgid "ClamAV has no signature database at %s (%s)"
msgstr "ClamAV hat keine Signaturdatenbank unter %s (%s)"

