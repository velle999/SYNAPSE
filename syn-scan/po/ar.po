msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr "تُنقل هذه جانبًا الآن؛ والأمر `syn-scan quarantine restore` يعيد أيًّا منها إلى مكانه."

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr "لم يُنقل شيء. الأمر `syn-scan quarantine take <path>` يضع ملفًا جانبًا، ويمكن استعادته دائمًا."

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr "لا أحد لنسأله عبر أنبوب — مرّر --yes إن كنت جاداً"

msgid "not installed"
msgstr "غير مثبّت"

msgid "installed — needs root"
msgstr "مثبّت — يحتاج إلى root"

msgid "quickshell is not installed — the window needs it"
msgstr "لم يُثبَّت quickshell — النافذة تحتاج إليه"

msgid "--only needs an engine name"
msgstr "يحتاج --only إلى اسم محرّك"

#, c-format
msgid "no engine called '%s'"
msgstr "لا يوجد محرّك باسم '%s'"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "يحتاج `quarantine %s` إلى شيء يعمل عليه"

msgid "Permanently delete this quarantined file?"
msgstr "هل تحذف هذا الملف المحجور نهائيًا؟"

#, c-format
msgid "no such quarantine command: %s"
msgstr "لا يوجد أمر حجر كهذا: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr "لا شيء لفحصه — أعطِ مسارًا، أو --system لفحوص الجذور الخفية"

msgid "--system without root: the checks will be partial"
msgstr "استخدام --system دون root: ستكون الفحوص جزئية"

#, c-format
msgid "%s: not a regular file"
msgstr "‏%s: ليس ملفًا عاديًا"

#, c-format
msgid "would quarantine %s"
msgstr "سيُحجر %s"

#, c-format
msgid "%s: copied to quarantine but could not be removed: %s"
msgstr "‏%s: نُسخ إلى الحجر لكن تعذّرت إزالته: %s"

#, c-format
msgid "quarantined %s"
msgstr "حُجر %s"

msgid "Quarantine is empty."
msgstr "الحجر فارغ."

#, c-format
msgid "%s: no such quarantined file"
msgstr "‏%s: لا يوجد ملف محجور بهذا الاسم"

#, c-format
msgid "would restore %s to %s"
msgstr "سيُعاد %s إلى %s"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "‏%s: تعذّرت استعادة الأذونات الأصلية: %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "‏%s موجود بالفعل — لن يُستبدل"

#, c-format
msgid "%s: %s"
msgstr "‏%s: %s"

#, c-format
msgid "restored %s"
msgstr "استُعيد %s"

#, c-format
msgid "would purge %s"
msgstr "سيُحذف %s نهائيًا"

#, c-format
msgid "purged %s"
msgstr "حُذف %s نهائيًا"

#, c-format
msgid "%s is not installed"
msgstr "‏%s غير مثبَّت"

#, c-format
msgid "  %-12s not installed, skipped"
msgstr "  %-12s غير مثبّت، تُخطّي"

#, c-format
msgid "%s needs root — try: sudo syn-scan ..."
msgstr "‏%s يحتاج إلى root — جرّب: sudo syn-scan ..."

#, c-format
msgid "  %-12s installed, but needs root — skipped"
msgstr "  %-12s مثبّت لكنه يحتاج إلى root — تُخطّي"

#, c-format
msgid "  %-12s running..."
msgstr "  %-12s قيد التشغيل…"

#, c-format
msgid "%s could not be run"
msgstr "تعذّر تشغيل %s"

msgid "no engine ran — install clamav, or pass --only for the one you meant"
msgstr "لم يعمل أي محرّك — ثبّت clamav، أو مرّر --only للمحرّك الذي تقصده"

msgid "No scan has run yet."
msgstr "لم يُشغَّل أي فحص بعد."

#, c-format
msgid "Weekly scan: %s"
msgstr "الفحص الأسبوعي: %s"

#, c-format
msgid "Last scan: %s"
msgstr "آخر فحص: %s"

msgid "Nothing outstanding."
msgstr "لا شيء معلّق."

#, c-format
msgid ""
"%lu finding needs a look, but this record does not say what — run the scan "
"again to see it.\n"
