msgstr "%s: copiado a la cuarentena, pero no se pudo eliminar: %s"

#, c-format
msgid "quarantined %s"
msgstr "%s puesto en cuarentena"

msgid "Quarantine is empty."
msgstr "La cuarentena está vacía."

#, c-format
msgid "%s: no such quarantined file"
msgstr "%s: no hay ningún archivo en cuarentena con ese nombre"

#, c-format
msgid "would restore %s to %s"
msgstr "devolvería %s a %s"

#, c-format
msgid "%s: could not restore the original mode: %s"
msgstr "%s: no se pudieron restaurar los permisos originales: %s"

#, c-format
msgid "%s already exists — not overwriting it"
msgstr "%s ya existe — no se sobrescribe"

#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#, c-format
msgid "restored %s"
msgstr "%s restaurado"

#, c-format
