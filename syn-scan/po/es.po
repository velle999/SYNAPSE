msgid ""
"Moving these aside now; `syn-scan quarantine restore` puts any of them back."
msgstr ""
"Apartándolos ahora; `syn-scan quarantine restore` devuelve cualquiera de "
"ellos a su sitio."

msgid ""
"Nothing has been moved. `syn-scan quarantine take <path>` puts a file aside; "
"it can always be restored."
msgstr ""
"No se ha movido nada. `syn-scan quarantine take <path>` aparta un archivo; "
"siempre se puede restaurar."

msgid "nothing to ask on a pipe — pass --yes if you mean it"
msgstr ""
"no hay a quién preguntar en una tubería — pasa --yes si lo dices en serio"

msgid "not installed"
msgstr "no instalado"

msgid "installed — needs root"
msgstr "instalado — necesita root"

msgid "quickshell is not installed — the window needs it"
msgstr "quickshell no está instalado — la ventana lo necesita"

msgid "--only needs an engine name"
msgstr "--only necesita el nombre de un motor"

#, c-format
msgid "no engine called '%s'"
msgstr "no hay ningún motor llamado '%s'"

#, c-format
msgid "`quarantine %s` needs something to act on"
msgstr "`quarantine %s` necesita algo sobre lo que actuar"

msgid "Permanently delete this quarantined file?"
msgstr "¿Eliminar definitivamente este archivo en cuarentena?"

#, c-format
msgid "no such quarantine command: %s"
msgstr "no existe ese comando de cuarentena: %s"

msgid "nothing to scan — give a path, or --system for the rootkit checks"
msgstr ""
"nada que analizar — indica una ruta, o --system para las comprobaciones de "
"rootkits"

#, c-format
msgid "%s does not exist — nothing was scanned"
msgstr "%s no existe — no se analizó nada"

