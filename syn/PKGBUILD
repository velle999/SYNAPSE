pkgname=syn
pkgver=0.1.0
# 18: profile-example.nix documents the installer's new vocabulary — every
#   SynapseOS package is a `comp = { … }` key and every shelf program an
#   `sw = { … }` one, replacing the want.chibi/core.synapd pairs. A profile
#   written against the old keys still installs; its app keys land in the
#   unused-key report at the end, which is where a stale profile is supposed
#   to surface.
# 19: DAVINCI DOCTOR — `syn resolve` gets a window. Getting Resolve running on
#   Arch is four jobs in a fixed order and the order is what catches people:
#   download the .zip (a registration form, the one step nothing can automate),
#   build the AUR package from it, install an OpenCL runtime FOR THE GPU YOU
#   HAVE, then shadow the packaged .desktop. `syn resolve` has done all of that
#   for a while; what it lacked was anywhere to start if you did not know it
#   existed. Drop the installer anywhere on the window, or Locate it, and it
#   walks the rest, ticking each step off as the doctor confirms it.
#   ⚠ The window reads `doctor --porcelain` — <key>TAB<state>TAB<text> from the
#   SAME emitter as the terminal report (chk()), not a second copy of the
#   checks and not a parse of the pretty output, which carries ANSI and wrapped
#   prose. The KEY is the contract; resolve_test.sh cross-checks the vocabulary
#   in BOTH directions.
#   ⚠ The privileged half opens syntty --hold: makepkg and pacman need a
#   terminal for sudo to prompt in, and --hold keeps a failed four-gigabyte
#   build's log on screen. ⚠ FloatingWindow, never PanelWindow — mutter has no
#   zwlr_layer_shell_v1, so a PanelWindow maps NOTHING under GNOME, and Resolve
#   users are not all on synui (hence no OnlyShowIn either).
#   ⚠ QS_APP_ID, the .desktop basename and StartupWMClass are one name, or the
#   dock's "<app_id>.desktop" lookup finds nothing and the pinned icon is a
#   themed fallback that does nothing when clicked.
# 22: the nix profile documents comp_synstudio. syn-install's config_test.sh
#   checks that vocabulary for drift in BOTH directions — a key the installer
#   asks about and the example never mentions is a key nobody can discover.
# 25: a comment in resolve.qml said kitty is "an optdepend a Minimal box does
#   not have". It is an optdepend NO box has now — it came off the base set and
#   the ISO in syn-install 100 — and the sentence was the reason syntty is the
#   terminal this window spawns, so it had to say something true.
# 30: `lsb_release` answered "Arch Linux" on a machine whose os-release has said
#   SynapseOS since it was installed. It does not read os-release at all — it
#   scans /etc for a *-release file with `find -type f`, which skips the
#   /etc/os-release SYMLINK, and everything it prints comes from sourcing
#   /etc/lsb-release, which Arch ships hardcoded. That file is owned by the
#   `lsb-release` package with NO backup array, so pacman puts "Arch Linux" back
#   on every upgrade of it, silently — hence a hook, not a one-time edit. It is
#   a dependency of steam and proton-cachyos-slr, so it is on any gaming box.
# 31: a `remote` row in the Nix profile example, for syn-remote — the ISO
#   carries it now, so a profile that names every other component and not this
#   one is a profile that quietly leaves it out.
# 32: `syn net open` / `syn net close`, following synnet 12. ⛔ These are NOT
#   `allow`/`block`: allow is an UNBLOCK, and until synnet grew these verbs
#   nothing could let a source outside the private ranges reach a port at all.
# 33: a `synscan` row in the Nix profile example. syn-install 118 made the
#   malware scanner a checkbox and the example never learned it, so a profile
#   written from the example could not say whether it wanted one.
# 34: a `voice` row in the Nix profile example, for synapse-voice — the speech
#   engine that left chibi's package in chibi 27, and its own checkbox from
#   syn-install 123.
# ── 0.1.0-35: `syn downloads` — the ISO download count on the bar ──────────
#
# GitHub keeps a download counter on every release asset. This reads them and
# leaves the answer where synui's bar can draw it (synui 620,
# modules/IsoDownloads.qml) — a row beside the update badge showing how many
# people have downloaded the ISO.
#
# ⛔ THERE IS NO SINGLE "DOWNLOAD COUNT", and getting that wrong is the whole
# feature. The ISO is five gigabytes, GitHub refuses an asset over two, so
# publish-release.sh splits it — and the parts do not agree: 0.3.1 sits at 6, 6,
# 4. Somebody started three parts and kept two. So the report is a FLOOR (the
# least-downloaded part of the set, the most people who could have assembled an
# ISO) and a CEILING (the most-downloaded part, how many began). Summing the
# assets — the obvious implementation — reports a three-part release three times
# over, and the part count has been 2, 3, 4 and 5 across the releases to date, so
# the number would also jump whenever THAT changed.
#
# ⛔ AND `.parts.sha256` IS NOT A PART. Every release also carries .sha256,
# .b2sum, .asc and that one, which matches a naive *part* glob and is a 300-byte
# file verifiers fetch far more often than the media — counting it pins the floor
# to something unrelated. The match is anchored: `.iso`, or `.iso.part<digits>`
# at the END of the name.
#
# ⛔ per_page=100 AND A PAGING LOOP. GitHub's default page is 30 and this
# repository already has 28 releases: on the default, release 31 would push the
# oldest off page one and the LIFETIME TOTAL WOULD DROP on the day a release was
# published. A counter that goes backwards when the project ships, with nothing
# saying why.
#
# ⚠ THE BAR NEVER FETCHES. Same arrangement as `syn-update ping` and weather.c:
# the module is instantiated once per MONITOR inside the compositor's shell
# process, so a request there is one per screen and a stalled connect is a
# stalled bar. A systemd USER timer runs this and writes ~/.cache/syn/downloads;
# the module watches that file. Renamed into place, because a FileView on a path
# written in place sees it empty for a frame and the badge blinks to nothing on
# every tick.
#
# ⚠ OFF BY DEFAULT, which is the difference from the update notifier's timer —
# that one ships a timers.target.wants symlink to be on everywhere. An update
# check is something every machine needs; counting our own downloads is one
# person's curiosity, and it is not worth a background request to GitHub from
# every installed SynapseOS. `syn downloads --watch 12h` is the opt-in, and the
# interval lives in a drop-in under ~/.config (this package owns the unit and
# every upgrade replaces it), which RESETS OnUnitActiveSec= before setting it
# because systemd's list settings accumulate across drop-ins.
#
# ⛔ THE REASON FOR A FAILURE TRAVELLED OUT OF A SUBSHELL AND ARRIVED EMPTY.
# `json=$(fetch_json)` runs in one, so the FAIL_REASON set on the way out died
# with it and the state file got `reason=` — the bar then says "could not count
# downloads" with nothing after it, which is the one thing the whole
# write-the-refusal arrangement exists to prevent. Found by pulling the network
# out from under it. A redirection into a file is not a subshell.
#
# ⚠ NO PRIVILEGE ANYWHERE IN IT, and that is asserted rather than assumed. This
# runs from a timer, where there is no terminal, and a bare sudo there does not
# fail — it opens a PAM conversation pam_faillock counts as a wrong password
# against a user who never typed one, and greetd shares that stack (syn-update
# 58). The way not to have the problem is to need nothing: a public HTTP endpoint
# and one file under ~/.cache.
#
# ⛔ NO jq AND NO PYTHON in the parser. This package depends on bash and systemd;
# synui's tree deliberately has no jq either. It is a token stream and an awk
# state machine, and what makes that safe is the order GitHub writes plus a name
# filter: `name` precedes `download_count` inside an asset, the `uploader` object
# between them has a login and no name, and a name is CONSUMED by the counter
# that uses it — so the release BODY, the one field a human writes, cannot lend a
# name to a stray "download_count" further down. Nothing whose name fails the
# .iso test is counted, so a misparse reports zero ISO assets, which the script
# refuses to write, rather than a plausible wrong number.
#
# tests/downloads_test.sh is the guard: 25 checks against a fixture, no network
# ever. RED-verified against four deliberate regressions — summing the parts,
# matching *part* loosely, the command substitution above, and dropping
# per_page — each of which it names.
pkgrel=35
pkgdesc="SynapseOS unified CLI"
arch=('any')
license=('GPL-2.0-or-later')
depends=('bash' 'systemd')
# nix is NOT a depend and not an optdepend that pulls anything: `syn nix` is a
# front end for a package manager the user opted into at install time, and on a
# box that declined it the subcommand says so and exits. Making it a dependency
# would put a second package manager on every SynapseOS install.
# Same rule for the two below: `syn resolve` names the command to install when
# one is missing rather than dragging ffmpeg onto a box that will never edit
# video. DaVinci Resolve itself is not listed at all — it is not in any repo,
# and the whole point of `syn resolve install` is that you fetch it yourself.
optdepends=('nix: declarative user environment via `syn nix` (Home Manager)'
            'ffmpeg: DNxHR transcoding via `syn resolve transcode`'
            'clinfo: OpenCL device listing in `syn resolve doctor`'
            # The DaVinci Doctor window is optional on purpose. Every SynapseOS
            # install has quickshell already (synui's bar is built on it), so in
            # practice it is always there — but a headless or minimal box should
            # not be made to pull Qt in to get a command-line `syn`.
            'quickshell: DaVinci Doctor, the setup window (`syn resolve gui`)'
            'qt6-declarative: QtQuick runtime for that window'
            # ⚠ syntty is where the window hands the privileged half: makepkg
            # and pacman need a terminal for sudo to prompt in. --hold is what
            # keeps the build log on screen after a failure, and syntty has had
            # it since 0.1.0-27; an optdepend cannot express a version, which is
            # why it is written here.
            'syntty>=0.1.0-27: terminal the setup window hands the build to'
            'zenity: file chooser and error dialogs for that window')
# Flat, and it has to be: makepkg resolves a local source to its BASENAME in
# $srcdir, so a "nix/flake.nix" entry is looked up as "flake.nix" beside the
# PKGBUILD and the build dies with "not found in the build directory and is
# not a URL". The nix- prefix is what a subdirectory would otherwise carry;
# package() installs them under their real names.
source=("syn.sh"
        "syn-nix-facts.sh"
        "syn-downloads.sh"
        "syn-downloads.service"
        "syn-downloads.timer"
        "syn-resolve.sh"
        "syn-printer.sh"
        "syn-resolve.hook"
        "syn-lsb-release.sh"
        "syn-lsb-release.hook"
        "syn-resolve-gui.sh"
        "resolve.qml"
        "syn-resolve-gui.desktop"
        "syn-resolve-gui.svg"
        "nix-flake.nix"
        "nix-home.nix"
        "nix-render.nix"
        "nix-profile-example.nix")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "$srcdir/syn.sh" "$pkgdir/usr/bin/syn"

    # Not in /usr/bin: it takes a ROOT argument and writes a Nix expression to
    # stdout, which is a thing `syn nix` and syn-install call, not a thing to
    # find by tab-completing.
    install -Dm755 "$srcdir/syn-nix-facts.sh" "$pkgdir/usr/lib/syn/syn-nix-facts"

    # Same reasoning, and one more: the pacman hook execs this path directly.
    # A hook that went through `syn` would depend on PATH inside a pacman
    # transaction, which is not somewhere to have opinions about PATH.
    install -Dm755 "$srcdir/syn-resolve.sh" "$pkgdir/usr/lib/syn/syn-resolve"
    install -Dm755 "$srcdir/syn-printer.sh" "$pkgdir/usr/lib/syn/syn-printer"

    # The ISO download counter. Not in /usr/bin for the same reason as the two
    # above — `syn downloads` is the spelling, and the unit below execs this
    # path directly rather than going through PATH.
    install -Dm755 "$srcdir/syn-downloads.sh" "$pkgdir/usr/lib/syn/syn-downloads"

    # The background check, and the timer that runs it. USER units: it writes
    # into the user's cache and reads a public endpoint, so there is nothing for
    # a system unit to do except run as root against somebody's ~/.cache.
    #
    # ⚠ AND NO timers.target.wants SYMLINK, unlike syn-update-ping.timer. That
    # symlink is how a package enables a user unit for everybody, and this is
    # deliberately not enabled: `syn downloads --watch on` is the opt-in. Every
    # installed SynapseOS asking GitHub how our own ISO is doing, twice a day,
    # unasked, is not a default worth having.
    install -Dm644 "$srcdir/syn-downloads.service" \
        "$pkgdir/usr/lib/systemd/user/syn-downloads.service"
    install -Dm644 "$srcdir/syn-downloads.timer" \
        "$pkgdir/usr/lib/systemd/user/syn-downloads.timer"

    # Same again, and this one is ONLY ever run by its hook — it takes no
    # arguments and rewrites a file in /etc, which is not a thing to leave
    # sitting in PATH for somebody to run by accident.
    install -Dm755 "$srcdir/syn-lsb-release.sh" "$pkgdir/usr/lib/syn/syn-lsb-release"

    # Flat in the source array because makepkg resolves a local source to its
    # BASENAME (see the note above); it gets its real, ordered name here.
    install -Dm644 "$srcdir/syn-resolve.hook" \
                   "$pkgdir/usr/share/libalpm/hooks/74-syn-resolve.hook"
    install -Dm644 "$srcdir/syn-lsb-release.hook" \
                   "$pkgdir/usr/share/libalpm/hooks/75-syn-lsb-release.hook"

    # ── DaVinci Doctor ──────────────────────────────────────────────────
    #
    # The window around `syn resolve`. In /usr/bin, unlike syn-resolve above,
    # because this one IS meant to be found: it is a menu entry and a command
    # somebody types.
    install -Dm755 "$srcdir/syn-resolve-gui.sh" "$pkgdir/usr/bin/syn-resolve-gui"
    install -Dm644 "$srcdir/resolve.qml" "$pkgdir/usr/share/syn/resolve.qml"

    # ⚠ THE BASENAME MUST EQUAL THE WINDOW'S app_id (syn-resolve-gui), or
    # synui's dock resolves the pinned window to nothing: the icon falls back to
    # the theme and the click does nothing, which looks completely normal. Same
    # trap syn-update.desktop documents.
    install -Dm644 "$srcdir/syn-resolve-gui.desktop" \
        "$pkgdir/usr/share/applications/syn-resolve-gui.desktop"

    # Scalable only, in hicolor — the theme every icon theme inherits from, so
    # the mark survives a theme switch.
    install -Dm644 "$srcdir/syn-resolve-gui.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/syn-resolve-gui.svg"

    # Templates, not config. `syn nix init` copies these into
    # /etc/synapseos/nix once and never overwrites them again — home.nix
    # belongs to the user the moment they edit it.
    install -Dm644 "$srcdir/nix-flake.nix" "$pkgdir/usr/share/syn/nix/flake.nix"
    install -Dm644 "$srcdir/nix-home.nix"  "$pkgdir/usr/share/syn/nix/home.nix"

    # The install-profile half: render.nix turns a profile into the key=value
    # lines `syn-install --config` reads, and syn-install looks for it at this
    # exact path. Not templates — these are never copied anywhere.
    install -Dm644 "$srcdir/nix-render.nix" "$pkgdir/usr/share/syn/nix/render.nix"
    install -Dm644 "$srcdir/nix-profile-example.nix" \
                   "$pkgdir/usr/share/syn/nix/profile-example.nix"
}
