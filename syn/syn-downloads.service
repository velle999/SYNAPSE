[Unit]
Description=SynapseOS — count ISO downloads
# One HTTPS request. Without this the timer fires at login before the network is
# up, writes status=error, and the bar's row says "could not count" for however
# long the interval is.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/syn/syn-downloads --refresh
# A request that hangs on a half-open network is how a timer wedges: systemd
# skips a trigger whose service is still running, so the row would silently stop
# updating with nothing saying why.
TimeoutStartSec=180

# ⚠ NO SUDO_ASKPASS= HERE, unlike syn-update-ping.service, and that is not an
# omission — syn-downloads has no privileged path at all. It reads a public HTTP
# endpoint and writes one file under ~/.cache. The unit that needs to be told
# not to prompt is the one that could.

# It fetches JSON and writes one small file in the cache. Nothing else.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
