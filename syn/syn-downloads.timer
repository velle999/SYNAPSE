[Unit]
Description=SynapseOS — count ISO downloads periodically

[Timer]
# Not at the login stampede, and not before the session has settled.
OnStartupSec=5min
# ⚠ THE SHIPPED DEFAULT, AND ONLY THE DEFAULT. `syn downloads --watch 1d` writes
# a drop-in under ~/.config/systemd/user that overrides this — which is where a
# user's interval has to live, because this file belongs to the package and every
# upgrade of `syn` replaces it. An interval written here would silently revert.
OnUnitActiveSec=12h
# A machine that was asleep at the appointed hour still checks when it wakes.
Persistent=true
# Half an hour of jitter. These numbers do not move fast enough for the exact
# minute to matter, and a fixed interval from a fixed OnStartupSec means every
# machine that turns this on asks at the same moment.
RandomizedDelaySec=30min

# ⚠ NOT ENABLED BY DEFAULT — deliberately, and this is the difference from
# syn-update's ping timer, which ships a symlink in
# /usr/lib/systemd/user/timers.target.wants/ to be on everywhere. An update
# check is something every machine needs; counting our own downloads is
# something one person is curious about, and it is not worth a background
# request to GitHub from every installed SynapseOS. `syn downloads --watch on`
# is the opt-in.
[Install]
WantedBy=timers.target
