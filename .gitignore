archiso/airootfs/local-repo/synapseos.db*
archiso/airootfs/local-repo/synapseos.files*
archiso/airootfs/local-repo/*.pkg.tar.zst
# ISO checksums (regenerated by build.sh)
archiso/out/*.sha256
archiso/out/*.b2sum

