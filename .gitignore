*.o
*.ko
*.mod
*.mod.c
*.cmd
.*.cmd
*.symvers
modules.order
.tmp_versions/
*.order

# ── ISO output (released as split parts on GitHub Releases) ─
SynapseOS-0.1.0-x86_64.iso
archiso/out/*.iso
archiso/out/*.iso.part*
archiso/out/test-disk.qcow2
# OVMF's per-VM variable store, written by qemu-test.sh alongside the qcow2.
archiso/out/*OVMF_VARS*.fd

# ── archiso work dir (12G of scratch) ───────────────────────
/archiso/work
/archiso/work/x86_64

# ── archiso: build-generated content ────────────────────────
# llama.cpp libs/binaries staged into the ISO root by build.sh
archiso/airootfs/usr/lib/libggml*
archiso/airootfs/usr/lib/libllama*
archiso/airootfs/usr/lib/libmtmd*
archiso/airootfs/usr/bin/llama-*
# local pacman repo (regenerated by repo-add; lives in airootfs so it ships in the ISO)
archiso/airootfs/local-repo/synapseos.db*
archiso/airootfs/local-repo/synapseos.files*
archiso/airootfs/local-repo/*.pkg.tar.zst
# ISO checksums (regenerated by build.sh)
archiso/out/*.sha256
archiso/out/*.b2sum

# ── editor / OS noise ───────────────────────────────────────
*.swp
*~
.DS_Store

# ── linux-wallpaperengine ───────────────────────────────────
# The dev clone is ~7 GB once cmake has fetched CEF, and makepkg's src/ and
# pkg/ under the package dir are another ~2.7 GB. All of it is reproducible:
# the PKGBUILD pins the upstream commit. Only PKGBUILD + synui-wpengine are
# sources.
/linux-wallpaperengine/
/linux-wallpaperengine-pkg/src/
# makepkg's bare git cache for the VCS source
/linux-wallpaperengine-pkg/linux-wallpaperengine/
/linux-wallpaperengine-pkg/pkg/
/linux-wallpaperengine-pkg/*.pkg.tar.zst

# Claude Code per-machine state. settings.local.json is a personal tool
# allowlist carrying absolute paths from whoever's checkout wrote it — it was
# tracked until 2026-07-29 and had gone stale pointing at ~/Documents/GitHub.
# A shared .claude/settings.json is still fine to commit.
.claude/settings.local.json
**/.claude/settings.local.json

# chibi's makepkg scratch. Its PKGBUILD pip-installs pydeps and clones
# chibi-llm into $srcdir, and SRCDEST drops the voice/whisper payloads in the
# package root — 7100+ generated files that buried `git status`, which is where
# a genuinely-untracked source file (synui/src/ctlpanel.c, once) has to be
# visible. Anchored per-package on purpose: synui, synguard, synapd, synsh,
# synnet and synapse_kmod all have a REAL tracked src/.
/chibi/src/
/chibi/chibi-llm/
/chibi/whisper-model.bin
/chibi/whisper-config.json
/chibi/whisper-tokenizer.json
/chibi/whisper-vocabulary.txt
/chibi/*.onnx
/chibi/*.onnx.json

# Debug leavings from bugs that are already fixed. The xwayland-abort dir is
# 365 MB of core dumps and strace logs from the SIGCHLD/wait4 abort (fixed);
# it is forensics, not source, and must never enter a release tarball.
synui/crash-*/
synui/*-capture-*.log
synui/cat.png
