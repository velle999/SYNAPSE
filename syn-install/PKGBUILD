pkgname=syn-install
pkgver=0.1.0
# 79: every package is a checkbox, and there is a shelf of ordinary software.
#   Eleven of our own — synpkg, synfiles, syn-settings, syn-disks, syn-edit,
#   syntty, syn, syn-model, syn-firstboot, syn-confine, fetch — were installed
#   whatever the answer, and Custom could not decline any of them. All of them
#   are rows on a page now; what stays forced is only what pacman would force
#   anyway, and sel_resolve_deps() re-ticks that and says which and why.
#   Also 47 programs from core/extra across five pages, because an installed
#   SynapseOS shipped with NO WEB BROWSER unless the Full preset happened to
#   pull one in as nexus-chat's dependency.
# 78: cliamp in SEL_APPS, beside syn-arcade. Big screen mode's Music tile plays
#   without a window ONLY with that player — every other one opens a window
#   somebody then has to get out of with a gamepad — so a fresh install without
#   it had half of big screen mode described and absent.
# 80: a fresh install boots into SYNAPSE Prism — `theme = prism` and
#   `glass_level = 55` in the synuirc this writes. NOT synui's compiled default,
#   which stays `synapse`: an existing machine that never picked a theme must
#   keep the desktop it has, and an upgrade that silently restyles one is not
#   something this project does. A fresh install has no desktop to preserve.
pkgrel=80
pkgdesc="SynapseOS disk installer"
arch=('any')
license=('GPL-2.0-or-later')
# cryptsetup: the optional LUKS2 install path, and syn-crypt afterwards.
depends=('bash' 'parted' 'e2fsprogs' 'dosfstools' 'arch-install-scripts' 'grub'
         'cryptsetup' 'util-linux')
# The graphical installer is quickshell rendering one QML file. It is an
# optdepend rather than a depend because the TEXT installer is the one that
# must work everywhere — on a headless box, over SSH, and on a machine whose
# GPU cannot start a compositor, which is exactly when someone is installing.
optdepends=('quickshell: the graphical installer (syn-install-gui)')

# FLAT, next to the PKGBUILD. makepkg resolves a local source entry to its
# BASENAME and looks for it beside the PKGBUILD, so `data/syn-install-gui.qml`
# fails with "not found in the build directory and is not a URL" — which is
# exactly how syn-update's first build of this package died. The name::url
# rename syntax is URL-only, so there is no way to keep the subdirectory.
# syn/ carries the same scar (nix-flake.nix, nix-home.nix).
#
# The tarball-based components (synui, synpkg, syn-disks) are unaffected and do
# use data/ — their paths live inside the tarball. This one builds in place
# from local files.
source=("syn-install.sh"
        "syn-crypt.sh"
        "syn-install-gui.sh"
        "syn-install-gui.qml")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "$srcdir/syn-install.sh" "$pkgdir/usr/bin/syn-install"
    install -Dm755 "$srcdir/syn-crypt.sh"   "$pkgdir/usr/bin/syn-crypt"

    # The window and its launcher. The QML is data, not a program: it is
    # rendered by quickshell and has no execute bit for the same reason
    # syn-disks' and synpkg's do not.
    install -Dm755 "$srcdir/syn-install-gui.sh" "$pkgdir/usr/bin/syn-install-gui"
    install -Dm644 "$srcdir/syn-install-gui.qml" \
        "$pkgdir/usr/share/syn-install/syn-install-gui.qml"
}
