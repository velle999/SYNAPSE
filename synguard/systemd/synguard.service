# /etc/systemd/system/synguard.service
# SynapseOS Security Monitor

[Unit]
Description=SynapseOS AI Security Monitor (synguard)
Documentation=https://github.com/velle999/SYNAPSE
After=synapd.service local-fs.target
Wants=synapd.service

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root

ExecStartPre=/bin/mkdir -p /var/log/synguard /var/lib/synguard
ExecStart=/usr/bin/synguard \
    --foreground \
    --mode enforce \
    --rules /etc/synguard/rules.d/

ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=3s
TimeoutStartSec=30s

# Journal output with priority tags
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synguard

# ── Hardening ────────────────────────────────────────────
# NoNewPrivileges was false here. Nothing synguard does needs to gain
# privileges — it forks no setuid helper — and it is root already, so the flag
# only ever gave away a free escalation path from a compromised monitor.
#
# ProtectHome is read-only rather than true: synguard classifies flagged
# processes by resolving /proc/<pid>/exe, which for a user-run binary points
# into /home. ProtectHome=true would make that path vanish and quietly weaken
# detection instead of failing loudly.
ProtectProc=invisible
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ProtectHostname=true
RestrictSUIDSGID=true

# Capabilities. synguard ran as root with the FULL bounding set — every
# capability the kernel has, including CAP_SYS_MODULE, CAP_SYS_BOOT and
# CAP_SYS_RAWIO. A monitor that watches for compromise should not itself be
# the most useful thing on the box to compromise. What it actually needs:
#
#   CAP_KILL             SIGSTOP/SIGKILL on processes it does not own
#                        (isolation.c: terminate and freeze)
#   CAP_SYS_PTRACE       readlink /proc/<pid>/exe for another user's process,
#                        which is how a flagged pid gets classified at all
#   CAP_DAC_READ_SEARCH  read /proc and /sys/kernel/synapse regardless of mode
#   CAP_DAC_OVERRIDE     write /sys/fs/cgroup/... for the quarantine freeze
#   CAP_CHOWN            hand /run/synguard.sock to the `synapse` group
#
# Notably NOT CAP_SYS_ADMIN: cgroup v2 mkdir, cgroup.procs and cgroup.freeze
# are all plain file writes that DAC_OVERRIDE covers.
#
# CAP_CHOWN was missing, and its absence disabled the verdict feed entirely.
# secfeed_init() gates the socket on the `synapse` group deliberately — a
# world-readable feed would hand any local process a live commentary on what
# this daemon detects, and let it occupy all SECFEED_MAX_CLIENTS slots and
# starve the real subscriber. Without CAP_CHOWN that chown() returns EPERM, the
# socket stays 0660 root:root, and synui — which runs as the session user — got
# EPERM connecting. The feed fails closed, which is the right direction, and
# then has no consumer at all: the compositor never receives a verdict, so the
# only symptom is an absence nobody notices.
#
# This is the third time hardening here has silently switched off the thing it
# was protecting (see ProtectControlGroups vs quarantine containment, and
# ProtectKernelTunables). When adding a restriction to this unit, check what
# the daemon does at STARTUP and not only in its steady state.
CapabilityBoundingSet=CAP_KILL CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=

# Cheap and non-negotiable: nothing here changes personality, needs realtime,
# creates namespaces, or speaks anything but AF_UNIX (the secfeed socket).
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
ProtectClock=true
ProtectKernelLogs=true
UMask=0077

# ── Deliberately NOT set ─────────────────────────────────
# ProtectControlGroups=true and ProtectKernelTunables=true both remount /sys
# (or /sys/fs/cgroup) read-only. synguard WRITES there — cgroup.procs and
# cgroup.freeze are how quarantine actually holds a process — so either one
# would leave the daemon running, logging, and silently unable to contain
# anything. That is a worse outcome than not hardening: the failure is
# invisible until the day it matters.
#
# ProtectKernelModules=true is likewise off: it is meaningless without
# CAP_SYS_MODULE, which the bounding set above already removes.
#
# MemoryDenyWriteExecute is off because the AI classifier path links against
# the same inference stack synapd uses, and W^X breaks JIT'd kernels there.

[Install]
WantedBy=multi-user.target
