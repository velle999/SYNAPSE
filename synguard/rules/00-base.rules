# /etc/synguard/rules.d/00-base.rules
# SynapseOS synguard — base security rules
#
# Priority ordering: lower = checked first
# Safe to edit — SIGHUP or 'systemctl reload synguard' hot-reloads rules

# ── Self-exemption ────────────────────────────────────────────
# synguard and synapd must never be blocked by their own rules

rule allow-synguard {
    comm    synguard
    verdict allow
    priority 1
}

rule allow-synapd {
    comm    synapd
    verdict allow
    priority 1
}

rule allow-root-exec {
    event   exec
    uid     0
    verdict log
    priority 5
}

# ── Kernel module loads ───────────────────────────────────────
# Always alert on module loads — legitimate ones are expected at boot
# AI classifies whether this is anomalous for the context

rule alert-module-load {
    event   module
    verdict alert
    priority 10
}

# ── Privilege escalation ──────────────────────────────────────
# The kmod only reports setuid(0) — privilege drops (root→user at login)
# never generate events. escalate is an alert the AI annotates: its answer
# can never make the event quieter than an alert, and can make it a deny only
# when synguard runs with --ai-enforce, so this can never kill the login
# chain on a hallucinated "deny".

rule escalate-setuid-to-root {
    event   setuid
    verdict escalate
    priority 15
}

# ── Somebody stopping the security daemons ────────────────────
# synapse_kmod 30 reports a terminating or stopping signal (INT, QUIT, ABRT,
# KILL, TERM, STOP, TSTP) sent to pid 1, synguard, synnet or synapd — or to
# every process at once — by anything but systemd, which starts and stops
# units itself and logs it. The event is in the ring before the signal lands,
# so a restarted synguard still reads the record of whoever stopped it.
rule alert-signal-to-security-daemon {
    event   signal
    verdict alert
    priority 11
}

# ── Sensitive file access ─────────────────────────────────────
# alert, not deny: every PAM authentication (greetd, login, sudo, su)
# opens /etc/shadow to verify the password, and sudo reads /etc/sudoers
# on every invocation. The kmod reports opens without read/write flags,
# so a deny here SIGKILLs the login chain and locks the user out.

rule alert-shadow-access {
    event   open
    path    /etc/shadow
    verdict alert
    priority 20
}

rule alert-sudoers-access {
    event   open
    path    /etc/sudoers
    verdict alert
    priority 20
}

rule alert-ssh-key-access {
    event   open
    path    /root/.ssh/*
    verdict alert
    priority 25
}

# The SSH tools reading your own keys is what the keys are for. Until synguard
# 47 nothing reported an open under /home/<user>/.ssh at all, so the rule below
# never fired; the BPF-LSM hooks now report it, and without this every `ssh`
# and `git push` over SSH would alert. ⚠ Matched on the process NAME, which a
# process can set for itself — this is for the ordinary case, and anything else
# reading a private key still alerts.
rule allow-ssh-tools-own-keys {
    event   open
    path    /home/*/.ssh/id_*
    comm    ssh*
    verdict allow
    priority 24
}

rule alert-ssh-key-user {
    event   open
    path    /home/*/.ssh/id_*
    verdict alert
    priority 25
}

rule alert-passwd-access {
    event   open
    path    /etc/passwd
    verdict log
    priority 30
}

# ── Execution from suspicious paths ──────────────────────────

rule escalate-exec-from-tmp {
    event   exec
    path    /tmp/*
    verdict escalate
    priority 35
}

# Re-executing /proc/self/exe (and /proc/<pid>/exe) is how systemd, runc/
# podman, Go programs, and every Chromium/Electron sandbox helper legitimately
# start. Must be allowed before the /proc/* catch below, or enforce mode
# SIGKILLs Firefox/vesktop/systemd on launch.
rule allow-reexec-self {
    event   exec
    path    /proc/self/exe
    verdict log
    priority 33
}

rule allow-reexec-pid {
    event   exec
    path    /proc/*/exe
    verdict log
    priority 33
}

# escalate (an alert; a deny only if the AI says so under --ai-enforce), not
# deny: a static deny here is an instant SIGKILL. Executing directly out of
# /dev or /proc is unusual enough to review, but promote to 'deny' only after
# baselining.
rule escalate-exec-from-dev {
    event   exec
    path    /dev/*
    verdict escalate
    priority 35
}

rule escalate-exec-from-proc {
    event   exec
    path    /proc/*
    verdict escalate
    priority 35
}

rule escalate-exec-from-var {
    event   exec
    path    /var/tmp/*
    verdict escalate
    priority 36
}

# ── ptrace ───────────────────────────────────────────────────
# ptrace-attach to a foreign process is worth AI review

rule escalate-ptrace {
    event   ptrace
    verdict escalate
    priority 40
}

# ── Network from unusual processes ───────────────────────────
# Socket creation alone is not suspicious; we log it for baseline

rule log-socket-creation {
    event   socket
    verdict log
    priority 50
}

# ── Package manager exec ──────────────────────────────────────
# pacman, yay, npm etc are expected to exec things — log it

rule log-package-managers {
    comm    pacman
    verdict log
    priority 55
}

rule log-package-managers-yay {
    comm    yay
    verdict log
    priority 55
}

# ── Default catch-all ─────────────────────────────────────────
# Everything else: log it, let the baseline engine catch anomalies

rule default-log {
    verdict log
    priority 100
}

# — Trusted system processes — allow without logging
rule allow-udev {
    event   module
    comm    udevd
    verdict allow
    priority 1
}

rule allow-udev-worker {
    comm    (udev-worker)
    verdict allow
    priority 1
}

rule allow-modprobe {
    comm    modprobe
    verdict allow
    priority 1
}

rule allow-kmod {
    comm    kmod
    verdict allow
    priority 1
}
