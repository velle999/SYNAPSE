# /etc/synguard/rules.d/30-network-persistence.rules
# SynapseOS synguard — worm/trojan: reverse-shell tools + persistence writes
#
# Worm scan / C2 fan-out is detected in code (netwatch, per-process connection
# fan-out over a sliding window) — it needs no rule. These rules cover the
# complementary static signals now that the kmod reports connect destinations,
# system persistence paths, and write-gated user persistence files.

# ── Reverse-shell / raw-socket tools ─────────────────────────
# nc/ncat/netcat/socat opening sockets is rarely legitimate on a desktop and
# is the classic reverse-shell primitive. EVT_SOCKET covers socket()+connect().
rule alert-netcat {
    event   socket
    comm    nc
    verdict alert
    priority 46
}

rule alert-ncat {
    event   socket
    comm    ncat
    verdict alert
    priority 46
}

rule alert-netcat-full {
    event   socket
    comm    netcat
    verdict alert
    priority 46
}

rule alert-socat {
    event   socket
    comm    socat
    verdict alert
    priority 46
}

# ── User-level persistence (write-gated twice) ───────────────
# The kmod only reports these on a write/create, so a match already means
# something is installing autostart/login persistence in a home directory.
# `access write` restates that in the policy rather than relying on the kmod:
# if that gate is ever relaxed, these rules do not silently become a flood.
rule alert-user-autostart {
    event   open
    path    /home/*/.config/autostart/*
    access  write
    verdict alert
    priority 26
}

rule alert-user-systemd {
    event   open
    path    /home/*/.config/systemd/*
    access  write
    verdict alert
    priority 26
}

rule alert-user-bashrc {
    event   open
    path    /home/*/.bashrc
    access  write
    verdict alert
    priority 26
}

rule alert-user-profile {
    event   open
    path    /home/*/.profile
    access  write
    verdict alert
    priority 26
}

rule alert-user-zshrc {
    event   open
    path    /home/*/.zshrc
    access  write
    verdict alert
    priority 26
}

# ── System persistence now reported by the kmod ──────────────
# (These paths were referenced by rules before but the kmod never emitted
#  them; it does now.)
# Unlike the user paths above, the kmod reports these on ANY access -- they
# live in its sensitive-path list -- and the system reads them constantly
# (every login shell sources all of /etc/profile.d). `access write` is what
# keeps these from drowning the alert log; do not drop it.
rule alert-profiled-write {
    event   open
    path    /etc/profile.d/*
    access  write
    verdict alert
    priority 27
}

rule alert-xdg-autostart-write {
    event   open
    path    /etc/xdg/autostart/*
    access  write
    verdict alert
    priority 27
}

rule alert-rc-local-write {
    event   open
    path    /etc/rc.local
    access  write
    verdict alert
    priority 27
}
