{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": [
        "custom/synapse"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "network"
    ],
    "custom/synapse": {
        "format": "\u25e2 SYNAPSE",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/velle/.config/waybar/synapse-menu.xml",
        "menu-actions": {
            "terminal": "foot",
            "aishell": "foot synsh",
            "status": "foot --hold syn status",
            "network": "foot -e nmtui",
            "monitor": "foot -e top",
            "app_0": "/usr/bin/bssh",
            "app_1": "/usr/bin/bvnc",
            "app_2": "/usr/bin/avahi-discover",
            "app_3": "/usr/lib/firefox/firefox",
            "app_4": "foot",
            "app_5": "footclient",
            "app_6": "foot --server",
            "app_7": "lstopo",
            "app_8": "kitty",
            "app_9": "qv4l2",
            "app_10": "qvidcap",
            "app_11": "steam steam://rungameid/413150",
            "app_12": "/usr/bin/steam",
            "app_13": "steam steam://rungameid/391540",
            "app_14": "xgps",
            "app_15": "xgpsspeed",
            "app_16": "foot -e yazi",
            "logout": "pkill -x synui",
            "reboot": "sudo systemctl reboot",
            "poweroff": "sudo systemctl poweroff"
        }
    },
    "clock": {
        "format": "{:%I:%M:%S %p  %Y-%m-%d}",
        "interval": 1
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "MEM {percentage}%",
        "interval": 5
    },
    "network": {
        "format-wifi": "NET {essid}",
        "format-ethernet": "NET {ipaddr}",
        "format-disconnected": "NET offline",
        "interval": 5
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    }
}
