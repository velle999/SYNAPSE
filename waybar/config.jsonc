{
    "layer": "top",
    "position": "top",
    "height": 28,
    "modules-left": [
        "custom/synapse"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/gamemode",
        "pulseaudio",
        "cpu",
        "memory",
        "network"
    ],
    // System tray (StatusNotifierItem). Nothing else on SYNAPSE runs an SNI
    // watcher, so without this module org.kde.StatusNotifierWatcher is simply
    // absent from the bus — and an app that "closes to tray" (Steam does it by
    // default) unmaps its window and hands the icon to nobody. The window is
    // then unreachable: no tray, no taskbar, and Steam will not raise it again.
    //
    // show-passive-items is on deliberately. Steam registers its item and only
    // later marks it Active; waybar hides Passive items by default, so with the
    // default the icon can be missing exactly when you need it — which is
    // indistinguishable from the tray not working at all.
    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true
    },
    "custom/synapse": {
        "format": "◢ SYNAPSE",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/velle/.config/waybar/synapse-menu.xml",
        // menu-actions is *generated*: synapse-menu-gen.py rewrites this key
        // and synapse-menu.xml together from the installed .desktop files,
        // before waybar starts. Only the fixed entries are seeded here. Do not
        // hand-write app_N entries — the generator owns those ids, and a stale
        // hand-written set is worse than none: waybar maps a clicked item's id
        // to a command positionally, so a stale list launches the wrong app.
        "menu-actions": {
            "terminal": "foot",
            "aishell": "foot synsh",
            "status": "foot --hold syn status",
            "network": "foot -e nmtui",
            "monitor": "foot -e top",
            "logout": "pkill -x synui",
            "reboot": "sudo systemctl reboot",
            "poweroff": "sudo systemctl poweroff"
        }
    },
    // Game mode (synui). synui writes its state to $XDG_RUNTIME_DIR/synui/game
    // on every enter/leave; synui-game-status turns that into waybar JSON. The
    // module only ever reports — Super+G is what toggles it.
    "custom/gamemode": {
        "exec": "/usr/bin/synui-game-status",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "clock": {
        "format": "{:%I:%M:%S %p  %Y-%m-%d}",
        "interval": 1
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "MEM {percentage}%",
        "interval": 5
    },
    "network": {
        "format-wifi": "NET {essid} {signalStrength}%",
        "format-ethernet": "NET {ipaddr}",
        "format-disconnected": "NET offline",
        // rfkill'd wlan reads as plain "offline" otherwise, which is what sent
        // us hunting for a driver bug when the radio was only switched off.
        "format-disabled": "NET wifi off",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) - {ipaddr}\nClick for network options",
        "tooltip-format-ethernet": "{ifname} - {ipaddr}\nClick for network options",
        "tooltip-format-disconnected": "Disconnected - click for network options",
        "tooltip-format-disabled": "Wi-Fi is switched off - click to turn it back on",
        "menu": "on-click",
        "menu-file": "/home/velle/.config/waybar/network-menu.xml",
        // "nmcli radio wifi on" also clears an rfkill soft block, and needs no
        // root (polkit lets the active local session do network-control), so
        // the bar alone is enough to dig out of a switched-off radio.
        "menu-actions": {
            "wifi_on": "nmcli radio wifi on",
            "wifi_off": "nmcli radio wifi off",
            "wifi_pick": "foot -e nmtui-connect",
            "wifi_rescan": "nmcli device wifi rescan",
            "settings": "foot -e nmtui",
            "info": "foot --hold nmcli device show"
        },
        "interval": 5
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    }
}
