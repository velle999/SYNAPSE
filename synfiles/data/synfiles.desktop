[Desktop Entry]
Type=Application
Name=Files
GenericName=File Browser
Comment=Browse files and folders
Exec=synfiles gui %f
# Its own icon, not the theme's generic system-file-manager — which on a
# Breeze desktop is Dolphin's, so two file managers sat in the dock wearing one
# face. The mark is a folder with two panes in it; see data/synfiles.svg.
Icon=synfiles
Terminal=false
# The window's app_id, so a taskbar that maps windows to launchers finds THIS
# entry. synfiles sets it on the quickshell process (QS_APP_ID); without both
# halves the window belongs to "org.quickshell" and wears its icon.
StartupWMClass=synfiles
Categories=System;FileTools;FileManager;Utility;
Keywords=files;folders;browser;manager;
# THE folder handler, as of 2026-08-10 — velle: "have it replace dolphin and
# drop that from being default." Declaring the type is only half of it: a
# MimeType= line makes synfiles a CANDIDATE, and which candidate wins is
# decided by mimeapps.list. See data/mimeapps.list, which ships the
# distribution default beside this file.
#
# inode/directory alone, which is exactly what Dolphin declares. The extra
# folder-ish types (inode/mount-point, x-directory/normal) are aliases and
# subclasses of it in shared-mime-info, so claiming them separately adds
# nothing but rows that can fall out of step.
MimeType=inode/directory;
