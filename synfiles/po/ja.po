msgid "netscan: unknown option '%s'"
msgstr "netscan: 不明なオプション「%s」"

msgid ""
"netscan: install avahi (mDNS) or smbclient (Windows shares) to discover "
"network places"
msgstr "netscan: 機器を見つけるには avahi (mDNS) か smbclient (Windows 共有) をインストールしてください"

msgid "netmount: need a URI (see: synfiles netscan)"
msgstr "netmount: URI が必要です (参照: synfiles netscan)"

#, c-format
msgid "netmount: '%s' is not a URI"
msgstr "netmount: 「%s」は URI ではありません"

msgid "netmount: gio is not installed — install gvfs to mount network shares"
msgstr "netmount: gio がインストールされていません — ネットワーク共有をマウントするには gvfs をインストールしてください"

