msgid "nothing called '%s' is in the trash"
msgstr "「%s」という名前のものはごみ箱にありません"

msgid ""
"emptying the trash is PERMANENT and cannot be undone.\n"
"  to see what would go:  synfiles trash list\n"
"  to empty it anyway:    synfiles trash empty --yes"
msgstr "ごみ箱を空にする操作は取り消せません。\n  何が消えるかを見るには: synfiles trash list\n  本当にそうしたい場合は: --force"

msgid "trash restore: need the trashed name (see: synfiles trash list)"
msgstr "trash restore: ごみ箱内の名前が必要です (参照: synfiles trash list)"

#, c-format
msgid "trash: unknown option '%s'"
msgstr "trash: 不明なオプション「%s」"

#, c-format
msgid "<num> open · u up · h home · c <path> cd · / <text> filter"
msgstr "<番号> 開く · u 上へ · h ホーム · c <パス> 移動 · / <文字> 絞り込み"

#, c-format
msgid "i <num> info · z <num> size · t <num> trash · e <num> actions"
msgstr "i <番号> 情報 · z <番号> サイズ · t <番号> ごみ箱 · e <番号> 操作"

#, c-format
msgid "m <num> <path> move · y <num> <path> copy"
msgstr "m <番号> <パス> 移動 · y <番号> <パス> コピー"

#, c-format
msgid "n/p page · a hidden · s sort · r reverse · g gui · q quit"
msgstr "n/p ページ · a 隠しファイル · s 並べ替え · r 逆順 · g GUI · q 終了"

