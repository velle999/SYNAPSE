pkgname=synapse_kmod
pkgver=0.1.0
pkgrel=13
pkgdesc="SynapseOS kernel module — AI_CTX syscalls, kprobes, AI scheduler bridge"
arch=('x86_64')
license=('GPL2')
depends=('dkms' 'linux-headers')
options=('!strip')
install=synapse_kmod.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"

    # The kernel module itself is built by DKMS at install time, not here.
    # This is just the userspace status tool.
    gcc $CFLAGS $LDFLAGS -Iinclude -o syn-kmod-status tools/syn-kmod-status.c
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Install source tree for DKMS (builds against any kernel at install time).
    # --exclude keeps stray .o/.ko from a local in-tree build out of the package;
    # DKMS would reuse them and silently ship a module with the wrong vermagic.
    install -dm755 "$pkgdir/usr/src/$pkgname-$pkgver"
    cp -r --no-preserve=mode,ownership src include Makefile dkms.conf \
        "$pkgdir/usr/src/$pkgname-$pkgver/"
    find "$pkgdir/usr/src/$pkgname-$pkgver" \
        \( -name '*.o' -o -name '*.ko*' -o -name '*.mod' -o -name '*.mod.c' \
           -o -name '*.cmd' -o -name 'modules.order' -o -name 'Module.symvers' \) \
        -delete

    # DKMS configuration
    install -Dm644 dkms.conf \
        "$pkgdir/usr/src/$pkgname-$pkgver/dkms.conf"

    # Pacman hook — rebuilds module automatically on kernel upgrades
    install -Dm644 hooks/71-synapse-kmod.hook \
        "$pkgdir/usr/share/libalpm/hooks/71-synapse-kmod.hook"

    # Rebuild script called by the pacman hook
    install -Dm755 hooks/synapse-kmod-rebuild \
        "$pkgdir/usr/bin/synapse-kmod-rebuild"

    # No `|| true` here: if the status tool didn't build, that is a packaging
    # bug and the build should fail loudly rather than silently ship nothing.
    install -Dm755 syn-kmod-status "$pkgdir/usr/bin/syn-kmod-status"

    # Auto-load module at boot
    install -Dm644 /dev/null \
        "$pkgdir/usr/lib/modules-load.d/synapse.conf"
    echo "synapse_kmod" > "$pkgdir/usr/lib/modules-load.d/synapse.conf"

    # Default module parameters
    install -Dm644 /dev/null \
        "$pkgdir/usr/lib/modprobe.d/synapse.conf"
    echo "options synapse_kmod synapse_events=1 synapse_sched=1 synapse_daemon_timeout=30 synapse_ring_size=4096" \
        > "$pkgdir/usr/lib/modprobe.d/synapse.conf"

    # Kernel hardening sysctls (kptr_restrict, dmesg_restrict, kexec latch)
    install -Dm644 config/90-synapse-hardening.conf \
        "$pkgdir/usr/lib/sysctl.d/90-synapse-hardening.conf"

    # Opt-in "seal module loading" unit — installed DISABLED (see HARDENING.md)
    install -Dm644 systemd/synapse-lock-modules.service \
        "$pkgdir/usr/lib/systemd/system/synapse-lock-modules.service"

    # Module-signature policy tool + its boot unit ("assume SB on, fall back")
    install -Dm755 tools/syn-secureboot \
        "$pkgdir/usr/bin/syn-secureboot"
    install -Dm644 systemd/synapse-secureboot.service \
        "$pkgdir/usr/lib/systemd/system/synapse-secureboot.service"

    # Hardening documentation
    install -Dm644 HARDENING.md \
        "$pkgdir/usr/share/doc/synapse_kmod/HARDENING.md"
}
