pkgname=synapse_kmod
pkgver=0.1.0
# ── 0.1.0-27: the kernel removed strncpy(), and only CI could tell ─────────
#
# ⛔ THIS BUILT CLEANLY ON THE DEVELOPMENT MACHINE AND FAILED IN CI, and the
# difference was the kernel: 7.1 here, 7.2.2 on the runner. Linux 7.2 REMOVED
# strncpy() from <linux/string.h>. For a module build that is not a
# deprecation warning, it is `error: implicit declaration of function
# 'strncpy'` and the build stops.
#
# Two call sites, both replaced with strscpy(). They are NOT interchangeable in
# general — strncpy() zero-PADS the tail and can leave the result
# unterminated, strscpy() always terminates and never pads — so each was
# checked rather than swapped:
#
#   synapse_sysfs.c  status_buf is a file-scope static, so it starts as zeros,
#                    and its only reader is a scnprintf("%s").
#   synapse_probe.c  the event is declared `= {0}` and goes to USERSPACE, so
#                    the tail past the filename must be zeros. It already is.
#
# ⚠ AND THE MODULE NOW SAYS WHAT IT NEEDS FROM THE KERNEL. `make
# check-symbols` reads `nm -u` on the built .ko against the list of string
# APIs the kernel has removed — a question with an answer on ANY kernel, so
# the next removal is caught on a development box instead of in CI. It is
# wired into the build workflow, and it was verified to FAIL: putting the
# strncpy() back makes `U strncpy` reappear and the target reports it.
#
# ── ...and seventeen warnings that were describing a real hazard ────────────
#
# Every build printed seventeen `no previous prototype` warnings. Each named a
# function defined in synapse_main.c and called from another translation unit,
# and each caller carried its OWN `extern` line — synapse_sysfs.c eight,
# synapse_sched.c six, synapse_probe.c three. Nothing checked any of them
# against the definition, so a signature that changed on one side would link
# and go wrong at run time, in ring 0. They are declared once in
# include/synapse_kmod.h now, inside `#ifdef __KERNEL__` because synapd and the
# syn tools include that header too.
pkgrel=27
pkgdesc="SynapseOS kernel module — AI_CTX syscalls, kprobes, AI scheduler bridge"
arch=('x86_64')
license=('GPL-2.0-only')
depends=('dkms' 'linux-headers')
options=('!strip')
backup=('etc/lynis/custom.prf')
optdepends=('lynis: audit the hardening baseline with the shipped custom.prf'
            'arch-audit: package vulnerability check (Lynis PKGS-7398)')
install=synapse_kmod.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"

    # The kernel module itself is built by DKMS at install time, not here.
    # This is just the userspace status tool.
    gcc $CFLAGS $LDFLAGS -Iinclude -o syn-kmod-status tools/syn-kmod-status.c
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Install source tree for DKMS (builds against any kernel at install time).
    # --exclude keeps stray .o/.ko from a local in-tree build out of the package;
    # DKMS would reuse them and silently ship a module with the wrong vermagic.
    install -dm755 "$pkgdir/usr/src/$pkgname-$pkgver"
    cp -r --no-preserve=mode,ownership src include Makefile dkms.conf \
        "$pkgdir/usr/src/$pkgname-$pkgver/"
    find "$pkgdir/usr/src/$pkgname-$pkgver" \
        \( -name '*.o' -o -name '*.ko*' -o -name '*.mod' -o -name '*.mod.c' \
           -o -name '*.cmd' -o -name 'modules.order' -o -name 'Module.symvers' \) \
        -delete

    # DKMS configuration
    install -Dm644 dkms.conf \
        "$pkgdir/usr/src/$pkgname-$pkgver/dkms.conf"

    # Pacman hook — rebuilds module automatically on kernel upgrades
    install -Dm644 hooks/71-synapse-kmod.hook \
        "$pkgdir/usr/share/libalpm/hooks/71-synapse-kmod.hook"

    # Rebuild script called by the pacman hook
    install -Dm755 hooks/synapse-kmod-rebuild \
        "$pkgdir/usr/bin/synapse-kmod-rebuild"

    # No `|| true` here: if the status tool didn't build, that is a packaging
    # bug and the build should fail loudly rather than silently ship nothing.
    install -Dm755 syn-kmod-status "$pkgdir/usr/bin/syn-kmod-status"

    # Auto-load module at boot
    install -Dm644 /dev/null \
        "$pkgdir/usr/lib/modules-load.d/synapse.conf"
    echo "synapse_kmod" > "$pkgdir/usr/lib/modules-load.d/synapse.conf"

    # Default module parameters.
    #
    # This file, not the C default, is what every real system loads with --
    # so raising synapse_ring_size in synapse_main.c alone changed nothing and
    # the ring stayed at 4096 through a full rebuild and reload. If you change
    # a module parameter default, change it in BOTH places and then check
    # /sys/module/synapse_kmod/parameters/ rather than the source.
    install -Dm644 /dev/null \
        "$pkgdir/usr/lib/modprobe.d/synapse.conf"
    echo "options synapse_kmod synapse_events=1 synapse_sched=1 synapse_daemon_timeout=30 synapse_ring_size=32768" \
        > "$pkgdir/usr/lib/modprobe.d/synapse.conf"

    # Kernel hardening sysctls (kptr_restrict, dmesg_restrict, kexec latch)
    install -Dm644 config/90-synapse-hardening.conf \
        "$pkgdir/usr/lib/sysctl.d/90-synapse-hardening.conf"

    # Attack-surface blacklist (exotic net protocols, FireWire/DMA).
    # NOT merged into the generated synapse.conf above: that one pins module
    # parameters, and the two need to be revertible separately.
    install -Dm644 config/90-synapse-blacklist.conf \
        "$pkgdir/usr/lib/modprobe.d/90-synapse-blacklist.conf"

    # Lynis audit profile. Lynis merges every .prf in /etc/lynis, so this adds
    # to the stock default.prf rather than replacing it. It is in backup=, so
    # local edits survive an upgrade as a .pacnew. Harmless if lynis is absent.
    install -Dm644 config/lynis-custom.prf \
        "$pkgdir/etc/lynis/custom.prf"

    # Opt-in "seal module loading" unit — installed DISABLED (see HARDENING.md)
    install -Dm644 systemd/synapse-lock-modules.service \
        "$pkgdir/usr/lib/systemd/system/synapse-lock-modules.service"

    # Module-signature policy tool + its boot unit ("assume SB on, fall back")
    install -Dm755 tools/syn-secureboot \
        "$pkgdir/usr/bin/syn-secureboot"
    install -Dm644 systemd/synapse-secureboot.service \
        "$pkgdir/usr/lib/systemd/system/synapse-secureboot.service"

    # Hardening documentation
    install -Dm644 HARDENING.md \
        "$pkgdir/usr/share/doc/synapse_kmod/HARDENING.md"
}
