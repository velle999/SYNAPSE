# Build/verify logic lives in /usr/bin/synapse-kmod-rebuild, which is also what
# the pacman kernel-upgrade hook runs. Keeping one code path means the install
# path gets the same vermagic verification the upgrade path does.

_rebuild() {
    if [ -x /usr/bin/synapse-kmod-rebuild ]; then
        /usr/bin/synapse-kmod-rebuild || {
            echo ""
            echo ">>> synapse_kmod did not build for every installed kernel."
            echo ">>> synapd/synguard will run DEGRADED (no AI scheduler bridge)."
            echo ">>> Check: syn status"
            echo ""
        }
    fi
}

post_install() {
    dkms add synapse_kmod/0.1.0 2>/dev/null || true
    _rebuild
}

post_upgrade() {
    dkms remove synapse_kmod/0.1.0 --all 2>/dev/null || true
    dkms add synapse_kmod/0.1.0 2>/dev/null || true
    _rebuild
}

pre_remove() {
    dkms remove synapse_kmod/0.1.0 --all 2>/dev/null || true
}
