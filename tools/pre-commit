#!/usr/bin/env bash
#
# pre-commit — run tools/preflight.sh over what this commit would actually
# contain, and refuse the commit if it cannot ship. Since alert #14, it also
# runs tools/check-toctou.sh over the C files being committed: CodeQL reports
# only after a push, so this is the last point where a check-then-use costs a
# minute instead of a release.
#
# Install:
#     ln -sf ../../tools/pre-commit .git/hooks/pre-commit
#
# A symlink, so the hook follows the repo instead of going stale as a copy in
# .git/hooks that nobody remembers editing. .git/hooks is not tracked, so this
# has to be installed once per clone; that is git's design, not an oversight.
#
# Bypass, when you know why:
#     git commit --no-verify
#
# --staged is the mode that matches what git is about to do. The default
# working-tree mode would gate a component on edits that are not being
# committed, which reads as a false positive and is how a hook earns itself a
# permanent --no-verify.
#
# SynapseOS Project — GPL-2.0-or-later
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

root=$(git rev-parse --show-toplevel)

# Nothing staged is NOT nothing to check. `git commit -- <paths>` commits the
# named paths straight from the working tree without touching the index, which
# is how this repo commits safely while several sessions share one — and it
# would sail past a hook that read only the index and called that clean.
#
# It cannot be gated fully either: the working tree holds other sessions' edits,
# and blocking somebody's commit over a file they did not touch is how a hook
# earns itself a permanent --no-verify. So the at-rest half runs (the lists, the
# installer, every version field) and the pkgrel gate says out loud that it was
# skipped.
if git diff --cached --quiet; then
    "$root/tools/preflight.sh" --at-rest || {
        echo
        echo "pre-commit: refusing the commit above." >&2
        exit 1
    }
    exit 0
fi

"$root/tools/preflight.sh" --staged || {
    echo
    echo "pre-commit: refusing the commit above." >&2
    echo "Fix the findings, or run 'git commit --no-verify' if you have a reason." >&2
    exit 1
}

# ── check-then-use on a path name, on the C being committed ─────────────────
#
# ⚠ CODE SCANNING ONLY SPEAKS AFTER A PUSH, on code that has already shipped —
# both CodeQL TOCTOU alerts on this repo arrived that way. The sanity job runs
# the same scanner, and that too is after the push. This is the one place the
# question gets asked while the answer is still cheap.
#
# ⚠ Only the STAGED C files. Scanning the whole tree here would gate somebody's
# commit on a finding in a file they did not touch — which is how a hook earns
# itself a permanent --no-verify — and the tree is covered by CI anyway. The
# `git commit -- <path>` case above exits before this for the same reason: it
# stages nothing, so there is nothing this can honestly call the commit's own.
mapfile -t toctou_files < <(git diff --cached --name-only --diff-filter=ACM \
                            -- '*.c' '*.h' | grep -Ev '/src/[A-Za-z0-9_-]+-[0-9]+\.[0-9]+\.[0-9]+/' || true)
if [ "${#toctou_files[@]}" -gt 0 ]; then
    "$root/tools/check-toctou.sh" "${toctou_files[@]}" || {
        echo
        echo "pre-commit: refusing the commit above." >&2
        echo "Resolve the name once and use the descriptor, or mark it:" >&2
        echo "  toctou-ok: <why nothing re-resolves this name>" >&2
        exit 1
    }
fi
