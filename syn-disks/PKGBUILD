# Maintainer: Velle Sinclair <brncomputerhelp@gmail.com>
#
# syn-disks — the SynapseOS disk utility.
#
# The suite's answer to GNOME Disks: what drives are in the machine, what is on
# them, how healthy they are, and the four things a desktop user actually does
# to one — mount, unmount, safely remove, and reformat a stick.
#
# It reads the storage tree out of /sys/class/block, which is the kernel's own
# account of it, so the shape of the machine is described with no daemon and no
# library. Everything that CHANGES something is delegated to whoever already
# owns it: udisks2 for mounting (it has the polkit rules), smartmontools for
# health, polkit for the one operation that needs root.
#
# ⚠ Formatting anything that shares a physical disk with "/" is refused, with
# no override. The check walks the whole stack — on an encrypted install "/" is
# /dev/mapper/cryptroot over dm-N over a partition over the disk — so the
# encrypted container holding a running system is refused even though nothing
# reports that partition itself as mounted.
#
# ⚠ Partitioning (mkpart, rmpart, resize, copypart, mktable) is guarded by the
# same file and a deliberately NARROWER rule, because refusing the whole drive
# would mean the feature could never do anything on a machine with one disk. It
# refuses the partitions that matter — anything "/" rests on, anything mounted,
# anything holding live swap, anything with a volume unlocked on top of it,
# anything /etc/fstab expects at the next boot — and allows the free space
# around them. There is no --force for any of it, and resize will grow a
# partition but never shrink one.
#
# ⚠ copypart writes one existing partition over another, byte for byte. It does
# not create the destination: creating and copying under one confirmation means
# a copy that fails halfway leaves a new partition holding half a filesystem,
# which is a worse state than either of the two the user chose between. Its
# SOURCE is guarded too, though nothing is written to it — a filesystem copied
# while something writes to it is copied in a state it was never in.
pkgname=syn-disks
# pkgver stays 0.1.0 and releases move pkgrel. build-all.sh writes
# "$name-0.1.0.tar.gz" and transforms paths to "$name-0.1.0/" for every
# component, so bumping pkgver leaves makepkg looking for a tarball nothing
# creates.
pkgver=0.1.0
pkgrel=12
pkgdesc="SynapseOS disk utility: drives, partitions, health, mounting and formatting"
arch=('x86_64')
url="https://github.com/velle999/SYNAPSE"
license=('GPL-2.0-or-later')

# Nothing but libc for the storage tree itself.
depends=('glibc')

# util-linux supplies two things. lsblk is where filesystem types, labels and
# UUIDs come from — they live in the udev database rather than in sysfs — and
# that half is soft: without it every drive still lists with its size, kind,
# bus and mounts, and only the type and label columns read "unknown".
#
# sfdisk is not soft. It is the only thing that writes a partition table here,
# because reimplementing GPT would mean writing a CRC32 over a structure that,
# if it is wrong, makes a drive look blank. It is on every Arch system anyway.
depends+=('util-linux')

# One per filesystem the Format menu offers. These were optdepends, on the
# reasoning that syn-disks reports a type it cannot create as unavailable
# rather than failing at the last step — which it still does, and which is
# still the right behaviour for a machine somebody has stripped.
#
# But that only ever degraded gracefully; it never made formatting WORK. In
# practice exFAT and NTFS were unavailable on every SynapseOS system, installed
# and live alike, and XFS on every installed one — the ISO carries xfsprogs for
# the installer's own use, so nothing pulled it onto the target. A disk utility
# whose Format menu is half greyed out on a default install is not offering
# those filesystems, it is listing them.
#
# The cost is small and bounded: exfatprogs and ntfsprogs are about a megabyte
# between them, and the other four are on any Arch system already.
#
# ntfsprogs, NOT ntfs-3g. ntfs-3g is the mount helper and ships no mkfs at all;
# mkfs.ntfs and mkntfs live in ntfsprogs, which Arch splits out. Naming the
# wrong one is worse than naming none: the optdepend told anyone who looked to
# install a package that was ALREADY INSTALLED here, and NTFS stayed
# unavailable with nothing further to try.
depends+=('e2fsprogs'    # mkfs.ext4
          'btrfs-progs'  # mkfs.btrfs
          'xfsprogs'     # mkfs.xfs
          'dosfstools'   # mkfs.vfat
          'exfatprogs'   # mkfs.exfat
          'ntfsprogs')   # mkfs.ntfs / mkntfs

makedepends=('meson' 'ninja' 'gcc')

optdepends=('quickshell: the graphical window (syn-disks gui)'
            'udisks2: mount, unmount and safely remove drives without root'
            'smartmontools: drive health (syn-disks smart)'
            'polkit: authorisation for formatting'
            'ntfs-3g: mount NTFS volumes on a kernel without the ntfs3 driver')

source=("syn-disks-0.1.0.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/syn-disks-0.1.0"
    meson setup build --prefix=/usr --buildtype=release
    meson compile -C build
}

check() {
    cd "$srcdir/syn-disks-0.1.0"
    # ⚠ The suite drives the binary entirely through SYN_DISKS_SYSFS and
    # SYN_DISKS_MOUNTS, which point it at a described machine inside a
    # mktemp -d that the EXIT trap removes. Nothing in it can reach a real
    # block device: format is only ever exercised through --dry-run, and mount
    # and eject run against a fake udisksctl on PATH that records its argv
    # instead of doing anything. A disk utility whose tests could touch real
    # hardware would be the most dangerous file in this repository.
    meson test -C build --print-errorlogs
}

package() {
    cd "$srcdir/syn-disks-0.1.0"
    meson install -C build --destdir="$pkgdir"
}
