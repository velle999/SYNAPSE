msgid "mkpart: '%s' is not a size — try 20G, 512MiB or a plain number of bytes"
msgstr "mkpart : « %s » n'est pas une taille — essayez 20G, 512MiB ou un simple nombre d'octets"

#, c-format
msgid ""
"mkpart: '%s' is not an offset — it is a number of bytes, as `syn-disks "
"table` prints it"
msgstr "mkpart : « %s » n'est pas un décalage — c'est un nombre d'octets, tel que `syn-disks table` l'affiche"

#, c-format
msgid "there is no free space at byte %llu of %s"
msgstr "il n'y a pas d'espace libre à l'octet %llu de %s"

#, c-format
msgid "%s has no free space"
msgstr "%s n'a pas d'espace libre"

#, c-format
