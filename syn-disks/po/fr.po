msgstr "resize : il faut --size=TAILLE (la nouvelle taille, qui doit être plus grande)"

#, c-format
msgid "resize: '%s' is not a size — try 20G, 512MiB or a plain number of bytes"
msgstr "resize : « %s » n'est pas une taille — essayez 20G, 512MiB ou un simple nombre d'octets"

msgid "resize"
msgstr "redimensionner"

#, c-format
msgid "%ssyn-disks: refusing to shrink %s from %s to %s.%s\n"
msgstr "%ssyn-disks : refus de réduire %s de %s à %s.%s\n"

#, c-format
msgid ""
"  The filesystem inside would still believe it owns the blocks past the new "
"end,\n"
"  and would destroy itself the next time it wrote to one. Shrink the "
"filesystem\n"
"  first, with the tool that belongs to it.\n"
msgstr "  Le système de fichiers à l'intérieur croirait toujours posséder les blocs\n  au-delà de la nouvelle fin, et se détruirait à la prochaine écriture sur l'un\n  d'eux. Réduisez d'abord le système de fichiers, avec son propre outil.\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but %s can only grow to %s — the free space after "
"it ends there%s\n"
msgstr "%ssyn-disks : %s demandé, mais %s ne peut grandir que jusqu'à %s — l'espace libre qui suit s'arrête là%s\n"

#, c-format
msgid "grows %s from %s to %s; the filesystem inside still ends where it did"
msgstr "agrandit %s de %s à %s ; le système de fichiers à l'intérieur se termine toujours là où il se terminait"

#, c-format
msgid ""
"%sthe partition is bigger; the filesystem is not. Grow it with resize2fs, "
"btrfs filesystem resize or xfs_growfs.%s\n"
msgstr "%sla partition est plus grande ; le système de fichiers ne l'est pas. Agrandissez-le avec resize2fs, btrfs filesystem resize ou xfs_growfs.%s\n"

