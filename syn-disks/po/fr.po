#, c-format
msgid ""
"  A copy that stopped short would be a filesystem describing blocks that are "
"not there.\n"
"  Grow it first: syn-disks resize %s --size=%llu --yes\n"
msgstr "  Une copie tronquée serait un système de fichiers décrivant des blocs qui n'existent pas.\n  Agrandissez-le d'abord : syn-disks resize %s --size=%llu --yes\n"

#, c-format
msgid ""
"the copy carries %s's filesystem UUID and label; with both attached, "
