msgstr "mkpart : il faut un disque (voir : syn-disks list)"

#, c-format
msgid "mkpart: '%s' is not a filesystem this offers"
msgstr "mkpart : « %s » n'est pas un système de fichiers proposé ici"

#, c-format
msgid ""
"mkpart: a label may hold up to 32 letters, digits, spaces, '-', '_' and '.' "
"— '%s' does not"
msgstr "mkpart : une étiquette peut contenir jusqu'à 32 lettres, chiffres, espaces, « - », « _ » et « . » — ce n'est pas le cas de « %s »"

