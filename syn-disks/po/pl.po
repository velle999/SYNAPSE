msgstr "%ssyn-disks: %s to cały dysk, a %s musi być partycją%s\n"

#, c-format
msgid ""
"  Copying a drive means copying its partition table too, which would give "
"two disks\n"
"  the same identity. Copy the partitions one at a time: syn-disks table %s\n"
msgstr "  Skopiowanie dysku oznacza skopiowanie też jego tablicy partycji, co dałoby dwóm dyskom\n  tę samą tożsamość. Kopiuj partycje po jednej: syn-disks table %s\n"

#, c-format
msgid "copypart: unknown option '%s'"
msgstr "copypart: nieznana opcja '%s'"

#, c-format
msgid ""
"copypart: two partitions — the source and the destination (got '%s' as well)"
msgstr "copypart: dwie partycje — źródło i cel (otrzymano także '%s')"

msgid ""
"copypart: need a source and a destination partition (see: syn-disks table "
"<disk>)"
msgstr "copypart: potrzeba partycji źródłowej i docelowej (zobacz: syn-disks table <disk>)"

