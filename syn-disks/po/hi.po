msgstr "%1 बंद किया जा रहा है…"

msgid "reading…"
msgstr "पढ़ा जा रहा है…"

msgid "select a partition"
msgstr "एक पार्टीशन चुनें"

msgid "still working — this window will close when the drive is finished with"
msgstr "अभी काम चल रहा है — ड्राइव के पूरा होने पर यह विंडो बंद हो जाएगी"

msgid "the modern one — any size, up to 128 partitions"
msgstr "आधुनिक वाली — कोई भी आकार, 128 पार्टीशन तक"

msgid "the partition was made on %1"
msgstr "%1 पर पार्टीशन बना"

msgid "this is the partition being copied"
msgstr "यही वह पार्टीशन है जिसे कॉपी किया जा रहा है"

msgid "too small — needs %1"
msgstr "बहुत छोटा — %1 चाहिए"

msgid "unallocated"
msgstr "अनआवंटित"

