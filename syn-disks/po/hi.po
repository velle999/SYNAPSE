msgstr "resize: '%s' कोई आकार नहीं है — 20G, 512MiB या केवल बाइट्स की संख्या आज़माएँ"

msgid "resize"
msgstr "आकार बदलना"

#, c-format
msgid "%ssyn-disks: refusing to shrink %s from %s to %s.%s\n"
msgstr "%ssyn-disks: %s को %s से %s तक छोटा करने से इनकार।%s\n"

#, c-format
msgid ""
"  The filesystem inside would still believe it owns the blocks past the new "
"end,\n"
"  and would destroy itself the next time it wrote to one. Shrink the "
"filesystem\n"
"  first, with the tool that belongs to it.\n"
msgstr "  भीतर का फ़ाइल सिस्टम अब भी मानेगा कि नए अंत के आगे के ब्लॉक उसी के हैं,\n  और अगली बार उनमें लिखते ही खुद को नष्ट कर देगा। पहले उसी के अपने औज़ार से\n  फ़ाइल सिस्टम को छोटा करें।\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but %s can only grow to %s — the free space after "
