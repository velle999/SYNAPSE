msgstr "पुरानी BIOS मशीनों और उन डिवाइसों के लिए जो इसकी अपेक्षा करते हैं; 2TB से आगे कुछ नहीं"

msgid "formatting %1…"
msgstr "%1 फ़ॉर्मैट हो रहा है…"

msgid "free space · %1"
msgstr "खाली स्थान · %1"

msgid "growing %1…"
msgstr "%1 बढ़ाया जा रहा है…"

msgid "making a partition on %1…"
msgstr "%1 पर पार्टीशन बनाया जा रहा है…"

msgid "mounting %1…"
msgstr "%1 माउंट हो रहा है…"

msgid "no drives reported"
msgstr "कोई ड्राइव नहीं बताई गई"

msgid "not mounted"
