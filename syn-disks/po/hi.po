"btrfs filesystem resize or xfs_growfs.%s\n"
msgstr "%sविभाजन बड़ा हो गया है; फ़ाइल सिस्टम नहीं। इसे resize2fs, btrfs filesystem resize या xfs_growfs से बढ़ाएँ।%s\n"

msgid "mktable: need a disk (see: syn-disks list)"
msgstr "mktable: एक डिस्क चाहिए (देखें: syn-disks list)"

#, c-format
msgid "mktable: --type must be gpt or dos, not '%s'"
msgstr "mktable: --type gpt या dos होना चाहिए, '%s' नहीं"

