msgid "  with: %s"
msgstr "  इससे: %s"

#, c-format
msgid "syn-disks: %s is not installed\n"
msgstr "syn-disks: %s संस्थापित नहीं है\n"

#, c-format
msgid "%ssyn-disks: %s — %s.%s\n"
msgstr "%ssyn-disks: %s — %s.%s\n"

#, c-format
msgid "  Install util-linux to partition from here.\n"
msgstr "  यहाँ से विभाजन करने के लिए util-linux संस्थापित करें।\n"

