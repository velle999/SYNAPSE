msgid "%s is not installed — install udisks2 to mount from here"
msgstr "%s इंस्टॉल नहीं है — यहाँ से माउंट करने के लिए udisks2 इंस्टॉल करें"

#, c-format
msgid "%s: need a %s"
msgstr "%s: एक %s चाहिए"

msgid "eject: need a disk (see: syn-disks list)"
msgstr "eject: एक डिस्क चाहिए (देखें: syn-disks list)"

#, c-format
msgid ""
"this kernel can no longer load modules — its module tree is gone, which is "
"what a kernel upgrade with no reboot leaves behind. %s will be created "
"correctly but will not mount here until you reboot"
msgstr "यह कर्नेल अब मॉड्यूल लोड नहीं कर सकता — इसका मॉड्यूल ट्री चला गया है, जो बिना रीबूट किए कर्नेल अपग्रेड के बाद बचता है। %s सही बनेगा पर रीबूट तक यहाँ माउंट नहीं होगा"

#, c-format
msgid ""
"this kernel cannot mount %s — it will be created correctly, but nothing here "
"will read it"
msgstr "यह कर्नेल %s माउंट नहीं कर सकता — यह सही बनेगा, पर यहाँ इसे कुछ नहीं पढ़ेगा"

#, c-format
msgid ""
"syn-disks: cannot make %s fresh (%s) — the new filesystem may be owned by "
"root, and anything left in that directory will be copied onto the device\n"
msgstr "syn-disks: %s को नया नहीं बनाया जा सका (%s) — नया फ़ाइल सिस्टम root का हो सकता है, और उस फ़ोल्डर में बचा सब कुछ डिवाइस पर कॉपी हो जाएगा\n"

#, c-format
msgid "syn-disks: cannot write %s — the new filesystem will be owned by root\n"
msgstr "syn-disks: %s नहीं लिखा जा सका — नया फ़ाइल सिस्टम root का होगा\n"

#, c-format
msgid "format: unknown option '%s'"
msgstr "format: अज्ञात विकल्प '%s'"

#, c-format
msgid "format: one device at a time (got '%s' as well)"
msgstr "format: एक बार में एक ही डिवाइस ('%s' भी मिला)"

msgid "format: need a device (see: syn-disks parts <disk>)"
msgstr "format: एक डिवाइस चाहिए (देखें: syn-disks parts <disk>)"

msgid "format: need --fs=TYPE (one of: ext4 btrfs xfs vfat exfat ntfs)"
msgstr "format: --fs=TYPE चाहिए (इनमें से एक: ext4 btrfs xfs vfat exfat ntfs)"

#, c-format
