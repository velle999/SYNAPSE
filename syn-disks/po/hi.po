"— '%s' does not"
msgstr "format: लेबल में 32 तक अक्षर, अंक, स्पेस, '-', '_' और '.' हो सकते हैं — '%s' में नहीं"

#, c-format
msgid "it is on /dev/%s, the disk holding this running system"
msgstr "यह /dev/%s पर है, वही डिस्क जिस पर यह चल रहा सिस्टम है"

#, c-format
msgid "%ssyn-disks: refusing to format %s — %s.%s\n"
msgstr "%ssyn-disks: %s को फ़ॉर्मैट करने से इनकार — %s.%s\n"

#, c-format
msgid ""
"  There is no flag that overrides this. If you truly mean to, use mkfs.%s "
"directly.\n"
msgstr "  ऐसा कोई फ़्लैग नहीं जो इसे टाले। अगर सचमुच यही चाहते हैं, तो सीधे mkfs.%s उपयोग करें।\n"

msgid "format"
msgstr "फ़ॉर्मैट करना"

