msgstr "%s (circa %.1f anni)"

msgid "powered on (hours)"
msgstr "accesa (ore)"

msgid "power cycles"
msgstr "cicli di accensione"

msgid "wear used"
msgstr "usura consumata"

msgid "data written"
msgstr "dati scritti"

msgid "reallocated sectors"
msgstr "settori riallocati"

msgid "pending sectors"
msgstr "settori in sospeso"

msgid "uncorrectable sectors"
msgstr "settori non correggibili"

msgid "rotation rate"
msgstr "velocità di rotazione"

