msgid ""
"  A copy that stopped short would be a filesystem describing blocks that are "
"not there.\n"
"  Grow it first: syn-disks resize %s --size=%llu --yes\n"
msgstr "  Una copia que se quedara corta sería un sistema de archivos que describe bloques que no están.\n  Amplíalo primero: syn-disks resize %s --size=%llu --yes\n"

#, c-format
msgid ""
"the copy carries %s's filesystem UUID and label; with both attached, "
