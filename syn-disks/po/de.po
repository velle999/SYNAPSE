msgid ""
"  A copy that stopped short would be a filesystem describing blocks that are "
"not there.\n"
"  Grow it first: syn-disks resize %s --size=%llu --yes\n"
msgstr "  Eine Kopie, die zu früh endet, wäre ein Dateisystem, das Blöcke beschreibt, die es nicht gibt.\n  Vergrößere es zuerst: syn-disks resize %s --size=%llu --yes\n"

#, c-format
msgid ""
"the copy carries %s's filesystem UUID and label; with both attached, "
"anything that finds a filesystem by UUID may pick either"
msgstr "die Kopie trägt die Dateisystem-UUID und -Bezeichnung von %s; wenn beide angeschlossen sind, kann alles, was ein Dateisystem per UUID sucht, jedes von beiden erwischen"

