#, c-format
msgid "%s is in use as swap"
msgstr "%s используется как своп"

#, c-format
msgid "%s is unlocked on top of it"
msgstr "%s разблокирован поверх него"

#, c-format
msgid "/etc/fstab expects it at %s"
msgstr "/etc/fstab ждёт его в %s"

msgid "the kernel has it marked read-only"
msgstr "ядро пометило его только для чтения"

msgid "the device refused every write; the kernel has now marked it read-only"
msgstr "устройство отказало каждой записи; ядро теперь пометило его только для чтения"

#, c-format
msgid "%ssyn-disks: refusing — %s.%s\n"
msgstr "%ssyn-disks: отказ — %s.%s\n"

#, c-format
msgid "  Unmount it first: syn-disks unmount %s\n"
msgstr "  Сначала отмонтируй его: syn-disks unmount %s\n"

#, c-format
msgid "  Turn it off first: swapoff %s\n"
msgstr "  Сначала выключи его: swapoff %s\n"

#, c-format
msgid "  Lock it first: udisksctl lock -b %s\n"
msgstr "  Сначала заблокируйте его: udisksctl lock -b %s\n"

#, c-format
msgid ""
"  Remove its line from /etc/fstab first, or this machine will not boot.\n"
msgstr "  Сначала удалите его строку из /etc/fstab, иначе эта машина не загрузится.\n"

#, c-format
msgid ""
"  Many sticks and SD cards have a write-protect switch on the body; if this "
"one does, check it. If it does not, the drive has marked ITSELF read-only "
"and nothing here will clear it: blockdev --getro %s\n"
msgstr "  У многих флешек и SD-карт на корпусе есть переключатель защиты от записи; если он здесь есть, проверьте его. Если нет, накопитель пометил САМ СЕБЯ только для чтения, и ничто здесь этого не снимет: blockdev --getro %s\n"

#, c-format
msgid ""
"  It accepted the request and then refused every sector, so the drive's "
"controller has switched itself read-only — the usual end of a worn or over-"
"reported flash chip. Nothing in software undoes that. Check the kernel's "
"account of it: journalctl -k | grep -i 'sense\\|write protect'\n"
msgstr "  Он принял запрос, а затем отверг каждый сектор — значит, контроллер накопителя сам перешёл в режим только для чтения, обычный конец изношенной или завышенной флеш-памяти. Программами это не отменить. Посмотрите, что об этом говорит ядро: journalctl -k | grep -i 'sense\\|write protect'\n"

#, c-format
msgid "  The layout may have changed since it was read: syn-disks table %s\n"
msgstr "  Разметка могла измениться с момента чтения: syn-disks table %s\n"

#, c-format
msgid "  Make one first: syn-disks mktable %s --type=gpt --yes\n"
msgstr "  Сначала создайте её: syn-disks mktable %s --type=gpt --yes\n"

#, c-format
msgid "  There is no flag that overrides this.\n"
msgstr "  Нет ключа, который бы это обошёл.\n"

#, c-format
msgid "%ssyn-disks: refusing to %s %s — %s.%s\n"
msgstr "%ssyn-disks: отказ: %s %s — %s.%s\n"

msgid "gui --format: need a device to format"
msgstr "gui --format: нужно устройство для форматирования"

msgid "no display — syn-disks gui needs a graphical session"
msgstr "нет дисплея — syn-disks gui нужен графический сеанс"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell не установлен — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "не удалось запустить quickshell"

#, c-format
msgid ""
"syn-disks: unknown command '%s'\n"
"\n"
msgstr "syn-disks: неизвестная команда «%s»\n\n"

#, c-format
msgid "%s: unknown option '%s'"
msgstr "%s: неизвестный параметр «%s»"

#, c-format
msgid "%s: one device at a time (got '%s' as well)"
msgstr "%s: только одно устройство за раз (получено также «%s»)"

#, c-format
msgid "  with: %s"
msgstr "  с помощью: %s"

#, c-format
msgid "syn-disks: %s is not installed\n"
msgstr "syn-disks: %s не установлен\n"

#, c-format
msgid "%ssyn-disks: %s — %s.%s\n"
msgstr "%ssyn-disks: %s — %s.%s\n"

#, c-format
msgid "  Install util-linux to partition from here.\n"
msgstr "  Установите util-linux, чтобы разбивать диски отсюда.\n"

#, c-format
msgid "%s: %s is not a block device"
msgstr "%s: %s не является блочным устройством"

msgid "mkpart: need a disk (see: syn-disks list)"
msgstr "mkpart: нужен диск (см.: syn-disks list)"

#, c-format
msgid "mkpart: '%s' is not a filesystem this offers"
msgstr "mkpart: «%s» не входит в число предлагаемых файловых систем"

#, c-format
msgid ""
"mkpart: a label may hold up to 32 letters, digits, spaces, '-', '_' and '.' "
"— '%s' does not"
msgstr "mkpart: метка может содержать до 32 букв, цифр, пробелов, «-», «_» и «.» — «%s» этому не отвечает"

msgid "partition"
msgstr "разбить на разделы"

#, c-format
msgid "%s has no partition table"
msgstr "на %s нет таблицы разделов"

#, c-format
msgid "mkpart: '%s' is not a size — try 20G, 512MiB or a plain number of bytes"
msgstr "mkpart: «%s» не является размером — попробуйте 20G, 512MiB или просто число байт"

#, c-format
msgid ""
"mkpart: '%s' is not an offset — it is a number of bytes, as `syn-disks "
"table` prints it"
msgstr "mkpart: «%s» не является смещением — это число байт в том виде, в каком его печатает `syn-disks table`"

#, c-format
msgid "there is no free space at byte %llu of %s"
msgstr "по смещению %llu байт на %s нет свободного места"

#, c-format
msgid "%s has no free space"
msgstr "на %s нет свободного места"

#, c-format
msgid "%ssyn-disks: the free space on /dev/%s is too small for a partition%s\n"
msgstr "%ssyn-disks: свободного места на /dev/%s слишком мало для раздела%s\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but the chosen free space on /dev/%s is %s%s\n"
msgstr "%ssyn-disks: запрошено %s, но выбранное свободное место на /dev/%s — %s%s\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but the largest free space on /dev/%s is %s%s\n"
msgstr "%ssyn-disks: запрошено %s, но наибольшее свободное место на /dev/%s — %s%s\n"

#, c-format
msgid "mkpart: /dev/%s already has 128 partitions"
msgstr "mkpart: на /dev/%s уже 128 разделов"

#, c-format
msgid "adds a %s partition to %s"
msgstr "добавляет раздел %s на %s"

#, c-format
msgid ""
"%ssyn-disks: partition written, but the kernel has not shown it yet — run "
"`partprobe %s`%s\n"
msgstr "%ssyn-disks: раздел записан, но ядро его ещё не показало — выполните `partprobe %s`%s\n"

#, c-format
msgid "/dev/%s\n"
msgstr "/dev/%s\n"

msgid "rmpart: need a partition (see: syn-disks table <disk>)"
msgstr "rmpart: нужен раздел (см.: syn-disks table <disk>)"

#, c-format
msgid "%ssyn-disks: %s is a whole drive, not a partition%s\n"
msgstr "%ssyn-disks: %s — это накопитель целиком, а не раздел%s\n"

#, c-format
msgid "  To erase its table: syn-disks mktable %s --type=gpt --yes\n"
msgstr "  Чтобы стереть его таблицу: syn-disks mktable %s --type=gpt --yes\n"

msgid "delete"
msgstr "удалить"

#, c-format
msgid "destroys %s and the %s on it"
msgstr "уничтожает %s и находящийся на нём %s"

msgid "resize: need a partition (see: syn-disks table <disk>)"
msgstr "resize: нужен раздел (см.: syn-disks table <disk>)"

msgid "resize: need --size=SIZE (the new size, which must be larger)"
msgstr "resize: нужен --size=РАЗМЕР (новый размер, который должен быть больше)"

#, c-format
msgid "resize: '%s' is not a size — try 20G, 512MiB or a plain number of bytes"
msgstr "resize: «%s» не является размером — попробуйте 20G, 512MiB или просто число байт"

msgid "resize"
msgstr "изменить размер"

#, c-format
msgid "%ssyn-disks: refusing to shrink %s from %s to %s.%s\n"
msgstr "%ssyn-disks: отказ уменьшить %s с %s до %s.%s\n"

#, c-format
msgid ""
"  The filesystem inside would still believe it owns the blocks past the new "
"end,\n"
"  and would destroy itself the next time it wrote to one. Shrink the "
"filesystem\n"
"  first, with the tool that belongs to it.\n"
msgstr "  Файловая система внутри по-прежнему считала бы своими блоки за новым концом\n  и уничтожила бы себя при первой же записи в один из них. Сначала уменьшите\n  файловую систему её собственным инструментом.\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but %s can only grow to %s — the free space after "
"it ends there%s\n"
msgstr "%ssyn-disks: запрошено %s, но %s может вырасти лишь до %s — свободное место за ним там и заканчивается%s\n"

#, c-format
msgid "grows %s from %s to %s; the filesystem inside still ends where it did"
msgstr "увеличивает %s с %s до %s; файловая система внутри по-прежнему заканчивается там же, где и раньше"

#, c-format
msgid ""
"%sthe partition is bigger; the filesystem is not. Grow it with resize2fs, "
"btrfs filesystem resize or xfs_growfs.%s\n"
msgstr "%sраздел стал больше; файловая система — нет. Увеличьте её командой resize2fs, btrfs filesystem resize или xfs_growfs.%s\n"

msgid "mktable: need a disk (see: syn-disks list)"
msgstr "mktable: нужен диск (см.: syn-disks list)"

#, c-format
msgid "mktable: --type must be gpt or dos, not '%s'"
msgstr "mktable: --type должен быть gpt или dos, а не «%s»"

#, c-format
msgid "mktable: %s is not a block device"
msgstr "mktable: %s не является блочным устройством"

#, c-format
msgid "mktable: %s is a partition — a table belongs to a whole drive"
msgstr "mktable: %s — это раздел, а таблица принадлежит накопителю целиком"

msgid "erase the partition table of"
msgstr "стереть таблицу разделов"

#, c-format
msgid "destroys the %d partition on %s and everything on it"
msgid_plural "destroys the %d partitions on %s and everything on them"
msgstr[0] "уничтожает %d раздел на %s и всё, что на нём"
msgstr[1] "уничтожает %d раздела на %s и всё, что на них"
msgstr[2] "уничтожает %d разделов на %s и всё, что на них"

#, c-format
msgid "writes a new %s table on %s"
msgstr "записывает новую таблицу %s на %s"

