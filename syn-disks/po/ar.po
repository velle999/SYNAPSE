msgstr "syn-disks: %s غير مثبَّت\n"

#, c-format
msgid "%ssyn-disks: %s — %s.%s\n"
msgstr "%ssyn-disks: %s — %s.%s\n"

#, c-format
msgid "  Install util-linux to partition from here.\n"
msgstr "  ثبِّت util-linux للتقسيم من هنا.\n"

#, c-format
msgid "%s: %s is not a block device"
msgstr "%s: %s ليس جهاز كتل"

msgid "mkpart: need a disk (see: syn-disks list)"
msgstr "mkpart: يلزم قرص (انظر: syn-disks list)"

#, c-format
msgid "mkpart: '%s' is not a filesystem this offers"
msgstr "mkpart: '%s' ليس من أنظمة الملفات المتاحة هنا"

#, c-format
msgid ""
"mkpart: a label may hold up to 32 letters, digits, spaces, '-', '_' and '.' "
"— '%s' does not"
msgstr "mkpart: يمكن أن تحوي التسمية حتى 32 حرفاً ورقماً ومسافة و'-' و'_' و'.' — و'%s' لا يفي بذلك"

msgid "partition"
msgstr "تقسيم"

#, c-format
msgid "%s has no partition table"
msgstr "لا يوجد جدول أقسام على %s"

#, c-format
msgid "mkpart: '%s' is not a size — try 20G, 512MiB or a plain number of bytes"
msgstr "mkpart: '%s' ليس حجماً — جرّب 20G أو 512MiB أو عدد بايتات مجرّداً"

#, c-format
msgid ""
"mkpart: '%s' is not an offset — it is a number of bytes, as `syn-disks "
"table` prints it"
msgstr "mkpart: '%s' ليس إزاحة — بل عدد بايتات كما يطبعه `syn-disks table`"

#, c-format
msgid "there is no free space at byte %llu of %s"
msgstr "لا توجد مساحة حرة عند البايت %llu من %s"

#, c-format
msgid "%s has no free space"
msgstr "لا توجد مساحة حرة على %s"

#, c-format
msgid "%ssyn-disks: the free space on /dev/%s is too small for a partition%s\n"
msgstr "%ssyn-disks: المساحة الحرة على /dev/%s أصغر من أن تسع قسماً%s\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but the chosen free space on /dev/%s is %s%s\n"
msgstr "%ssyn-disks: طُلب %s، لكن المساحة الحرة المختارة على /dev/%s هي %s%s\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but the largest free space on /dev/%s is %s%s\n"
msgstr "%ssyn-disks: طُلب %s، لكن المساحة الحرة الأكبر على /dev/%s هي %s%s\n"

#, c-format
msgid "mkpart: /dev/%s already has 128 partitions"
msgstr "mkpart: يحوي /dev/%s 128 قسماً بالفعل"

#, c-format
msgid "adds a %s partition to %s"
msgstr "يضيف قسم %s إلى %s"

#, c-format
msgid ""
"%ssyn-disks: partition written, but the kernel has not shown it yet — run "
