msgstr "‏eject: يلزم قرص (انظر: syn-disks list)"

#, c-format
msgid ""
"this kernel can no longer load modules — its module tree is gone, which is "
"what a kernel upgrade with no reboot leaves behind. %s will be created "
"correctly but will not mount here until you reboot"
msgstr "‏لم تعد هذه النواة تستطيع تحميل الوحدات — فقد زالت شجرة وحداتها، وهو ما يخلّفه ترقية النواة دون إعادة تشغيل. سيُنشأ %s بشكل صحيح لكنه لن يُركَّب هنا حتى تعيد التشغيل"

#, c-format
msgid ""
"this kernel cannot mount %s — it will be created correctly, but nothing here "
"will read it"
msgstr "‏لا تستطيع هذه النواة تركيب %s — سيُنشأ بشكل صحيح لكن لن يقرأه شيء هنا"

#, c-format
msgid ""
"syn-disks: cannot make %s fresh (%s) — the new filesystem may be owned by "
"root, and anything left in that directory will be copied onto the device\n"
msgstr "‏syn-disks: تعذّر تجديد %s (%s) — قد يملك root نظام الملفات الجديد، وكل ما يبقى في ذلك المجلد سيُنسخ إلى الجهاز\n"

#, c-format
msgid "syn-disks: cannot write %s — the new filesystem will be owned by root\n"
msgstr "‏syn-disks: تعذّرت كتابة %s — سيملك root نظام الملفات الجديد\n"

#, c-format
msgid "format: unknown option '%s'"
msgstr "‏format: خيار مجهول '%s'"

#, c-format
msgid "format: one device at a time (got '%s' as well)"
msgstr "‏format: جهاز واحد في كل مرة (ورد '%s' أيضًا)"

msgid "format: need a device (see: syn-disks parts <disk>)"
msgstr "‏format: يلزم جهاز (انظر: syn-disks parts <disk>)"

msgid "format: need --fs=TYPE (one of: ext4 btrfs xfs vfat exfat ntfs)"
msgstr "‏format: يلزم --fs=TYPE (أحد: ext4 btrfs xfs vfat exfat ntfs)"

#, c-format
msgid "format: '%s' is not a filesystem this offers"
msgstr "‏format: '%s' ليس نظام ملفات يوفّره هذا"

#, c-format
msgid ""
"format: a label may hold up to 32 letters, digits, spaces, '-', '_' and '.' "
"— '%s' does not"
msgstr "‏format: يمكن أن يحوي العنوان حتى 32 حرفًا ورقمًا ومسافة و'-' و'_' و'.' — و'%s' ليس كذلك"

#, c-format
msgid "it is on /dev/%s, the disk holding this running system"
msgstr "‏هو على /dev/%s، القرص الذي يحمل هذا النظام العامل"

#, c-format
msgid "%ssyn-disks: refusing to format %s — %s.%s\n"
msgstr "‏%ssyn-disks: رفض تهيئة %s — %s.%s\n"

#, c-format
msgid ""
"  There is no flag that overrides this. If you truly mean to, use mkfs.%s "
"directly.\n"
msgstr "‏  لا راية تتجاوز هذا. وإن كنت تعنيه حقًا فاستخدم mkfs.%s مباشرة.\n"

msgid "format"
msgstr "تهيئة"

#, c-format
msgid "syn-disks: %s is not installed — cannot make an %s filesystem\n"
msgstr "‏syn-disks: %s غير مثبَّت — تعذّر إنشاء نظام ملفات %s\n"

#, c-format
msgid "%s is not installed"
msgstr "‏%s غير مثبَّت"

#, c-format
msgid "would run: %s\n"
msgstr "‏سيُنفَّذ: %s\n"

#, c-format
msgid "%sthis erases everything on %s%s\n"
msgstr "‏%sهذا يمحو كل ما على %s%s\n"

#, c-format
msgid "%swarning: %s%s\n"
msgstr "‏%sتحذير: %s%s\n"

#, c-format
msgid "%s is now %s — labelled\n"
msgstr "%s صار الآن %s — مُسمّى\n"

#, c-format
msgid "%s is now %s\n"
msgstr "%s صار الآن %s\n"

#, c-format
msgid "%ssyn-disks: could not format %s — %s.%s\n"
msgstr "‏%ssyn-disks: تعذّرت تهيئة %s — %s.%s\n"

#, c-format
msgid "copypart: %s is not a block device"
msgstr "‏copypart: %s ليس جهاز كتل"

#, c-format
msgid "%ssyn-disks: %s is a whole drive, and %s must be a partition%s\n"
msgstr "‏%ssyn-disks: %s محرك كامل، و%s يجب أن يكون قسمًا%s\n"

#, c-format
msgid ""
"  Copying a drive means copying its partition table too, which would give "
"two disks\n"
"  the same identity. Copy the partitions one at a time: syn-disks table %s\n"
msgstr "‏  نسخ محرك يعني نسخ جدول أقسامه أيضًا، وهو ما يمنح قرصين\n  الهوية نفسها. انسخ الأقسام واحدًا واحدًا: syn-disks table %s\n"

#, c-format
msgid "copypart: unknown option '%s'"
msgstr "‏copypart: خيار مجهول '%s'"

#, c-format
msgid ""
"copypart: two partitions — the source and the destination (got '%s' as well)"
msgstr "‏copypart: قسمان — المصدر والوجهة (ورد '%s' أيضًا)"

msgid ""
"copypart: need a source and a destination partition (see: syn-disks table "
"<disk>)"
msgstr "‏copypart: يلزم قسم مصدر وقسم وجهة (انظر: syn-disks table <disk>)"

#, c-format
msgid "%ssyn-disks: %s and %s are the same partition%s\n"
msgstr "‏%ssyn-disks: %s و%s القسم نفسه%s\n"

msgid "copy"
msgstr "نسخ"

msgid "overwrite"
msgstr "الكتابة فوق"

#, c-format
msgid "%ssyn-disks: %s reports no size%s\n"
msgstr "‏%ssyn-disks: لا يبلّغ %s عن حجم%s\n"

#, c-format
msgid "%s holds %s and %s is only %s"
msgstr "‏يحوي %s مقدار %s بينما %s ليس إلا %s"

#, c-format
msgid "%ssyn-disks: refusing to copy %s onto %s — %s.%s\n"
msgstr "‏%ssyn-disks: رفض نسخ %s إلى %s — %s.%s\n"

#, c-format
msgid ""
"  A copy that stopped short would be a filesystem describing blocks that are "
"not there.\n"
"  Grow it first: syn-disks resize %s --size=%llu --yes\n"
msgstr "‏  النسخة التي تتوقف قبل الأوان ستكون نظام ملفات يصف كتلًا غير موجودة.\n  كبّره أولًا: syn-disks resize %s --size=%llu --yes\n"

#, c-format
msgid ""
"the copy carries %s's filesystem UUID and label; with both attached, "
"anything that finds a filesystem by UUID may pick either"
msgstr "‏تحمل النسخة معرّف UUID وعنوان نظام ملفات %s؛ وبتوصيل الاثنين قد يختار أي شيء يبحث عن نظام ملفات بالـUUID أيًّا منهما"

#, c-format
msgid ""
"%s · %s is %s and the copy is %s, so the filesystem inside it will still end "
"where %s's does — grow it with the tool that belongs to it"
msgstr "‏%s · %s حجمه %s والنسخة %s، فسيظل نظام الملفات بداخلها ينتهي حيث ينتهي في %s — كبّره بالأداة التي تخصه"

#, c-format
msgid "destroys everything on %s and replaces it with the %s on %s"
msgstr "‏يدمّر كل ما على %s ويستبدله بـ %s من %s"

