msgstr "%ssyn-disks: كُتب القسم، لكن النواة لم تُظهره بعد — نفِّذ `partprobe %s`%s\n"

#, c-format
msgid "/dev/%s\n"
msgstr "/dev/%s\n"

msgid "rmpart: need a partition (see: syn-disks table <disk>)"
msgstr "rmpart: يلزم قسم (انظر: syn-disks table <disk>)"

#, c-format
msgid "%ssyn-disks: %s is a whole drive, not a partition%s\n"
msgstr "%ssyn-disks: %s قرص كامل وليس قسماً%s\n"

#, c-format
msgid "  To erase its table: syn-disks mktable %s --type=gpt --yes\n"
msgstr "  لمحو جدوله: syn-disks mktable %s --type=gpt --yes\n"

msgid "delete"
msgstr "حذف"

#, c-format
msgid "destroys %s and the %s on it"
msgstr "يُتلف %s وما عليه من %s"

msgid "resize: need a partition (see: syn-disks table <disk>)"
msgstr "resize: يلزم قسم (انظر: syn-disks table <disk>)"

msgid "resize: need --size=SIZE (the new size, which must be larger)"
msgstr "resize: يلزم --size=الحجم (الحجم الجديد، ويجب أن يكون أكبر)"

#, c-format
msgid "resize: '%s' is not a size — try 20G, 512MiB or a plain number of bytes"
msgstr "resize: '%s' ليس حجماً — جرّب 20G أو 512MiB أو عدد بايتات مجرّداً"

msgid "resize"
msgstr "تغيير حجم"

#, c-format
msgid "%ssyn-disks: refusing to shrink %s from %s to %s.%s\n"
msgstr "%ssyn-disks: رفض تقليص %s من %s إلى %s.%s\n"

#, c-format
msgid ""
"  The filesystem inside would still believe it owns the blocks past the new "
"end,\n"
"  and would destroy itself the next time it wrote to one. Shrink the "
"filesystem\n"
"  first, with the tool that belongs to it.\n"
msgstr "  سيظل نظام الملفات بداخله يظن أن الكتل بعد النهاية الجديدة ملك له،\n  وسيُتلف نفسه في أول كتابة إلى إحداها. قلّص نظام الملفات أولاً\n  بالأداة الخاصة به.\n"

#, c-format
msgid ""
"%ssyn-disks: %s asked for, but %s can only grow to %s — the free space after "
"it ends there%s\n"
msgstr "%ssyn-disks: طُلب %s، لكن %s لا يمكن أن ينمو إلا حتى %s — فالمساحة الحرة بعده تنتهي هناك%s\n"

#, c-format
msgid "grows %s from %s to %s; the filesystem inside still ends where it did"
msgstr "يوسّع %s من %s إلى %s؛ ونظام الملفات بداخله ما زال ينتهي حيث كان ينتهي"

#, c-format
msgid ""
"%sthe partition is bigger; the filesystem is not. Grow it with resize2fs, "
"btrfs filesystem resize or xfs_growfs.%s\n"
msgstr "%sالقسم صار أكبر، أما نظام الملفات فلا. وسّعه بـ resize2fs أو btrfs filesystem resize أو xfs_growfs.%s\n"

msgid "mktable: need a disk (see: syn-disks list)"
msgstr "mktable: يلزم قرص (انظر: syn-disks list)"

#, c-format
msgid "mktable: --type must be gpt or dos, not '%s'"
msgstr "mktable: يجب أن يكون --type إما gpt أو dos، لا '%s'"

#, c-format
msgid "mktable: %s is not a block device"
msgstr "mktable: %s ليس جهاز كتل"

#, c-format
msgid "mktable: %s is a partition — a table belongs to a whole drive"
msgstr "mktable: %s قسم — والجدول يخص القرص بأكمله"

msgid "erase the partition table of"
msgstr "محو جدول أقسام"

#, c-format
msgid "destroys the %d partition on %s and everything on it"
msgid_plural "destroys the %d partitions on %s and everything on them"
msgstr[0] "يُتلف %d قسماً على %s وكل ما عليه"
msgstr[1] "يُتلف %d أقساماً على %s وكل ما عليها"

#, c-format
msgid "writes a new %s table on %s"
msgstr "يكتب جدول %s جديداً على %s"

