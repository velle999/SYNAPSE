msgid ""
"  A copy that stopped short would be a filesystem describing blocks that are "
"not there.\n"
"  Grow it first: syn-disks resize %s --size=%llu --yes\n"
msgstr "  Uma cópia que ficasse a meio seria um sistema de ficheiros a descrever blocos que não existem.\n  Aumenta-o primeiro: syn-disks resize %s --size=%llu --yes\n"

#, c-format
