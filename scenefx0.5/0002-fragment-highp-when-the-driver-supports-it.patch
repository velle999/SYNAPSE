+/*
+ * Does this driver give fragment shaders highp?
+ *
+ * GLSL ES 1.00 advertises that through the GL_FRAGMENT_PRECISION_HIGH macro,
+ * which is what every shader here guards on — but the macro being absent means
+ * "not advertised", not "not supported". NVIDIA's GLES2 leaves it undefined
+ * while glGetShaderPrecisionFormat() reports a full 23-bit fragment highp, so
+ * the guards fell through to mediump on the one driver SynapseOS actually runs
+ * on. Ask the driver instead, and hand the answer to the preprocessor.
+ *
+ * Cached: this is a driver property, and link_program() runs once per shader.
+ */
+static bool fragment_has_highp(void) {
+	static int cached = -1;
+	if (cached < 0) {
+		GLint range[2] = {0, 0}, precision = 0;
+		glGetShaderPrecisionFormat(GL_FRAGMENT_SHADER, GL_HIGH_FLOAT,
+			range, &precision);
+		/* Per spec, an unsupported precision answers 0,0,0. */
+		cached = (precision > 0 && range[0] > 0 && range[1] > 0);
+		wlr_log(WLR_DEBUG, "fx_renderer: fragment highp %s (macro %s, "
+			"glGetShaderPrecisionFormat %d bits)",
+			cached ? "available" : "unavailable",
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+			"defined",
+#else
+			"NOT defined",
+#endif
+			precision);
+	}
+	return cached == 1;
+}
+
 GLuint link_program(const GLchar *frag_src) {
 	GLuint vert = compile_shader(GL_VERTEX_SHADER, common_vert_src);
 	if (!vert) {
 		goto error;
 	}
 
-	GLuint frag = compile_shader(GL_FRAGMENT_SHADER, frag_src);
+	/* Prepended, not appended: a precision statement only governs declarations
+	 * that come after it, and the guard it feeds is the first thing in every
+	 * fragment source. */
+	const char *prelude = fragment_has_highp() ? "#define FX_HAS_HIGHP 1\n" : "";
+	size_t frag_len = strlen(prelude) + strlen(frag_src) + 1;
+	GLchar *frag_full = malloc(frag_len);
+	if (!frag_full) {
+		glDeleteShader(vert);
+		goto error;
+	}
+	snprintf(frag_full, frag_len, "%s%s", prelude, frag_src);
+
+	GLuint frag = compile_shader(GL_FRAGMENT_SHADER, frag_full);
+	free(frag_full);
