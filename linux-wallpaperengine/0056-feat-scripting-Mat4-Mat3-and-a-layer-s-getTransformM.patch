+JSValue layer_get_transform_matrix (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    auto* container = layer_opaque (this_val);
+
+    if (container == nullptr) {
+	return JS_ThrowTypeError (ctx, "getTransformMatrix called on something that is not a layer");
+    }
+
+    // the layer's world transform, its parents folded in: translation, then its angle, then its scale
+    const auto transform = WallpaperEngine::Render::Objects::CImage::resolveTransform (
+	container->adapter.getEngine ().getScene (), container->object.getObject ()
+    );
+    glm::mat4 world = glm::translate (glm::mat4 (1.0f), transform.origin);
+    world = glm::rotate (world, transform.angle, glm::vec3 (0.0f, 0.0f, 1.0f));
+    world = glm::scale (world, transform.scale);
+
+    // a Mat4 of the builtins, whose m is column-major as glm's is
+    JSValue global = JS_GetGlobalObject (ctx);
+    JSValue constructor = JS_GetPropertyStr (ctx, global, "Mat4");
+    JSValue matrix = JS_CallConstructor (ctx, constructor, 0, nullptr);
+    JS_FreeValue (ctx, constructor);
+    JS_FreeValue (ctx, global);
+
+    if (JS_IsException (matrix)) {
+	return matrix;
+    }
+
+    JSValue elements = JS_GetPropertyStr (ctx, matrix, "m");
+    const float* values = glm::value_ptr (world);
+
+    for (uint32_t i = 0; i < 16; i++) {
+	JS_SetPropertyUint32 (ctx, elements, i, JS_NewFloat64 (ctx, values[i]));
+    }
+
+    JS_FreeValue (ctx, elements);
+    return matrix;
+}
