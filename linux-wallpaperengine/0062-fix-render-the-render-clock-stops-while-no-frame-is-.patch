diff --git a/src/WallpaperEngine/Render/FrameClock.cpp b/src/WallpaperEngine/Render/FrameClock.cpp
new file mode 100644
index 00000000..2eebfb64
--- /dev/null
+++ b/src/WallpaperEngine/Render/FrameClock.cpp
@@ -0,0 +1,31 @@
+#include "FrameClock.h"
+
+using namespace WallpaperEngine::Render;
+
+FrameClock::FrameClock (double frameStep, double longestStep) :
+    m_frameStep (frameStep),
+    m_longestStep (longestStep) { }
+
+void FrameClock::tick (double wall) {
+    double now = wall - this->m_stopped;
+
+    if (!this->m_started) {
+	this->m_started = true;
+	this->m_lastTime = this->m_time = now;
+	return;
+    }
+
+    const double step = now - this->m_time;
+
+    if (step > this->m_longestStep || step < 0.0) {
+	this->m_stopped += step - this->m_frameStep;
+	now = this->m_time + this->m_frameStep;
+    }
+
+    this->m_lastTime = this->m_time;
+    this->m_time = now;
+}
+
+double FrameClock::getTime () const { return this->m_time; }
+
+double FrameClock::getLastTime () const { return this->m_lastTime; }
diff --git a/src/WallpaperEngine/Render/FrameClock.h b/src/WallpaperEngine/Render/FrameClock.h
new file mode 100644
index 00000000..165d2039
--- /dev/null
+++ b/src/WallpaperEngine/Render/FrameClock.h
@@ -0,0 +1,39 @@
+#pragma once
+
+namespace WallpaperEngine::Render {
+/**
+ * The render clock (g_Time) and the previous frame's time (g_TimeLast), from the wall clock.
+ *
+ * The clock stops while no frame is drawn. A frame is drawn when the compositor sends a frame
+ * callback, and none come while the wallpaper is covered or while the engine pauses for a
+ * fullscreen window. On the wall clock alone, the next frame then stepped every script timer,
+ * timeline animation and particle system by the whole wait at once. A step longer than
+ * `longestStep`, or one backwards (the wall clock is the system clock and can be set back),
+ * counts as one frame of `frameStep` instead, as if the clock had been paused.
+ *
+ * The first frame has no previous one: the time spent loading is no frame, so its step is 0.
+ */
+class FrameClock {
+public:
+    /**
+     * @param frameStep how far the clock moves for a frame after a wait, in seconds
+     * @param longestStep the longest step a drawn frame takes, in seconds
+     */
+    FrameClock (double frameStep, double longestStep);
+
+    /** Moves the clock to wall-clock time `wall`, in seconds */
+    void tick (double wall);
+
+    [[nodiscard]] double getTime () const;
+    [[nodiscard]] double getLastTime () const;
+
+private:
+    double m_frameStep;
+    double m_longestStep;
+    /** wall-clock time the clock has spent stopped */
+    double m_stopped = 0.0;
+    double m_time = 0.0;
+    double m_lastTime = 0.0;
+    bool m_started = false;
+};
+} // namespace WallpaperEngine::Render
diff --git a/src/WallpaperEngine/Testing/Cases/FrameClock.cpp b/src/WallpaperEngine/Testing/Cases/FrameClock.cpp
new file mode 100644
index 00000000..4ba941af
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/FrameClock.cpp
@@ -0,0 +1,67 @@
+#include <catch2/catch_approx.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include "WallpaperEngine/Render/FrameClock.h"
+
+using Catch::Approx;
+using WallpaperEngine::Render::FrameClock;
+
+namespace {
+constexpr double FRAME = 1.0 / 30.0;
+FrameClock clock30 () { return FrameClock (FRAME, 0.5); }
+} // namespace
+
+TEST_CASE ("The first frame takes no step, whatever loading took") {
+    auto clock = clock30 ();
+
+    clock.tick (1.48);
+    CHECK (clock.getTime () == Approx (1.48));
+    CHECK (clock.getLastTime () == Approx (1.48));
+}
+
+TEST_CASE ("Drawn frames follow the wall clock") {
+    auto clock = clock30 ();
+
+    clock.tick (1.0);
+    clock.tick (1.0 + FRAME);
+    CHECK (clock.getTime () - clock.getLastTime () == Approx (FRAME));
+
+    // a slow frame, still a frame
+    clock.tick (1.0 + FRAME + 0.4);
+    CHECK (clock.getTime () - clock.getLastTime () == Approx (0.4));
+    CHECK (clock.getTime () == Approx (1.0 + FRAME + 0.4));
+}
+
+TEST_CASE ("A wait without frames does not pass on the clock") {
+    auto clock = clock30 ();
+
+    clock.tick (2.0);
+    clock.tick (2.0 + FRAME);
+    // covered, or paused for a fullscreen window, for ten minutes
+    clock.tick (602.0);
+    CHECK (clock.getTime () - clock.getLastTime () == Approx (FRAME));
+    CHECK (clock.getTime () == Approx (2.0 + 2 * FRAME));
+
+    // and frames after it follow the wall clock again, from where it stopped
+    clock.tick (602.0 + FRAME);
+    CHECK (clock.getTime () - clock.getLastTime () == Approx (FRAME));
+    CHECK (clock.getTime () == Approx (2.0 + 3 * FRAME));
+
+    // a second wait adds to the first
+    clock.tick (700.0);
+    clock.tick (700.0 + FRAME);
+    CHECK (clock.getTime () == Approx (2.0 + 5 * FRAME));
+}
+
+TEST_CASE ("A wall clock set back is one frame, not a step backwards") {
+    auto clock = clock30 ();
+
+    clock.tick (5000.0);
+    clock.tick (5000.0 + FRAME);
+    clock.tick (1000.0);
+    CHECK (clock.getTime () - clock.getLastTime () == Approx (FRAME));
+    CHECK (clock.getTime () == Approx (5000.0 + 2 * FRAME));
+
+    clock.tick (1000.0 + FRAME);
+    CHECK (clock.getTime () - clock.getLastTime () == Approx (FRAME));
+}
