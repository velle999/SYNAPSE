 ) {
-    if (argc != 1) {
-	return JS_EXCEPTION;
-    }
-
     const auto it = engineInstances.find (magic);
 
     if (it == engineInstances.end ()) {
-	return JS_EXCEPTION;
+	return JS_UNDEFINED;
     }
 
     int id = 0;
 
-    JS_ToInt32 (ctx, &id, argv[0]);
+    // the id this function was made to cancel. Scripts call it bare (`stop ()`), and it read
+    // an argument instead, so every cancel failed and the timer ran anyway
+    JS_ToInt32 (ctx, &id, func_data[0]);
 
     it->second.clearInterval (id);
 
@@ -102,19 +100,17 @@ JSValue engine_stop_interval (
 JSValue engine_stop_timeout (
     JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv, int magic, JSValueConst* func_data
 ) {
-    if (argc != 1) {
-	return JS_EXCEPTION;
-    }
-
     const auto it = engineInstances.find (magic);
 
     if (it == engineInstances.end ()) {
-	return JS_EXCEPTION;
+	return JS_UNDEFINED;
     }
 
     int id = 0;
 
-    JS_ToInt32 (ctx, &id, argv[0]);
+    // the id this function was made to cancel. Scripts call it bare (`stop ()`), and it read
+    // an argument instead, so every cancel failed and the timer ran anyway
+    JS_ToInt32 (ctx, &id, func_data[0]);
 
     it->second.clearTimeout (id);
 
@@ -122,8 +118,8 @@ JSValue engine_stop_timeout (
 }
 
 JSValue engine_set_interval (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv, int magic) {
-    if (argc < 1) {
-	return JS_EXCEPTION;
+    if (argc < 1 || !JS_IsFunction (ctx, argv[0])) {
+	return JS_ThrowTypeError (ctx, "setInterval takes a function");
     }
 
     int delay = 0;
@@ -133,18 +129,14 @@ JSValue engine_set_interval (JSContext* ctx, JSValueConst this_val, int argc, JS
     }
 
     JSValue function = argv[0];
-
-    if (!JS_IsFunction (ctx, function)) {
-	return JS_EXCEPTION;
-    }
-
     const auto it = engineInstances.find (magic);
 
     if (it == engineInstances.end ()) {
-	return JS_EXCEPTION;
+	return JS_ThrowInternalError (ctx, "engine object not found");
     }
 
-    int id = it->second.reserveNextIntervalId (function, delay);
+    // kept until it fires or is cancelled, both of which free it
+    int id = it->second.reserveNextIntervalId (JS_DupValue (ctx, function), delay);
 
     JSValue args[] = { JS_NewInt32 (ctx, id) };
 
@@ -152,8 +144,8 @@ JSValue engine_set_interval (JSContext* ctx, JSValueConst this_val, int argc, JS
 }
 
 JSValue engine_set_timeout (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv, int magic) {
-    if (argc < 1) {
-	return JS_EXCEPTION;
+    if (argc < 1 || !JS_IsFunction (ctx, argv[0])) {
+	return JS_ThrowTypeError (ctx, "setTimeout takes a function");
     }
 
     int delay = 0;
@@ -163,18 +155,14 @@ JSValue engine_set_timeout (JSContext* ctx, JSValueConst this_val, int argc, JSV
     }
 
     JSValue function = argv[0];
-
-    if (!JS_IsFunction (ctx, function)) {
-	return JS_EXCEPTION;
-    }
-
     const auto it = engineInstances.find (magic);
 
     if (it == engineInstances.end ()) {
-	return JS_EXCEPTION;
+	return JS_ThrowInternalError (ctx, "engine object not found");
     }
 
-    int id = it->second.reserveNextTimeoutId (function, delay);
+    // kept until it fires or is cancelled, both of which free it
+    int id = it->second.reserveNextTimeoutId (JS_DupValue (ctx, function), delay);
 
     JSValue args[] = { JS_NewInt32 (ctx, id) };
 
@@ -187,6 +175,9 @@ EngineObject::EngineObject (ScriptEngine& engine, Render::Wallpapers::CScene& sc
     JS_NewClassID (this->m_engine.getRuntime (), &this->m_classId);
     JS_NewClass (this->m_engine.getRuntime (), this->m_classId, &this->m_definition);
     this->m_instance = JS_NewObjectClass (this->m_engine.getContext (), this->m_classId);
+    // setTimeout and setInterval find this object by its id; only the destructor ever touched
+    // the map, so every timer a script started threw (and returned nothing to cancel it with)
+    engineInstances.emplace (this->m_instanceId, *this);
 
     JS_DupValue (this->m_engine.getContext (), this->m_instance);
 
@@ -401,33 +392,72 @@ void EngineObject::tick () {
 	this->fillAudioBuffers (buffers);
     }
 
-    // check any interval and run them if needed
-    for (auto& timeout : this->m_intervals | std::views::values) {
-	if (timeout.next > now) {
+    JSContext* ctx = this->m_engine.getContext ();
+    // what is due, run by id afterwards: a callback can cancel a timer (its own too) or start
+    // one, which changes the map under a loop over it
+    std::vector<uint32_t> due;
+
+    for (const auto& [id, interval] : this->m_intervals) {
+	if (interval.next <= now) {
+	    due.push_back (id);
+	}
+    }
+
+    for (const auto id : due) {
+	const auto it = this->m_intervals.find (id);
+
+	// cancelled by a callback that ran before it
+	if (it == this->m_intervals.end ()) {
 	    continue;
 	}
 
-	timeout.next = now + timeout.duration;
+	it->second.next = now + it->second.duration;
 
-	JS_Call (this->m_engine.getContext (), timeout.callback, JS_NULL, 0, nullptr);
+	// held, as the callback may cancel its own interval and free it
+	JSValue callback = JS_DupValue (ctx, it->second.callback);
+	this->runCallback (callback);
+	JS_FreeValue (ctx, callback);
     }
 
-    std::vector<uint32_t> removeTimeouts;
+    due.clear ();
 
-    // check any timeout and run them if needed
-    for (auto& [id, timeout] : this->m_timeouts) {
-	if (timeout.next > now) {
-	    continue;
+    for (const auto& [id, timeout] : this->m_timeouts) {
+	if (timeout.next <= now) {
+	    due.push_back (id);
 	}
+    }
 
-	JS_Call (this->m_engine.getContext (), timeout.callback, JS_NULL, 0, nullptr);
+    for (const auto id : due) {
+	const auto it = this->m_timeouts.find (id);
 
-	JS_FreeValue (this->m_engine.getContext (), timeout.callback);
+	if (it == this->m_timeouts.end ()) {
+	    continue;
+	}
 
-	removeTimeouts.push_back (id);
+	// gone before it runs, so cancelling it from inside its own callback is a no-op
+	JSValue callback = it->second.callback;
+	this->m_timeouts.erase (it);
+	this->runCallback (callback);
+	JS_FreeValue (ctx, callback);
     }
+}
+
+void EngineObject::runCallback (JSValue callback) {
+    JSContext* ctx = this->m_engine.getContext ();
+    JSValue result = JS_Call (ctx, callback, JS_NULL, 0, nullptr);
+
+    if (JS_IsException (result)) {
+	JSValue exception = JS_GetException (ctx);
 
-    for (auto id : removeTimeouts) {
-	this->m_timeouts.erase (id);
+	if (!this->m_callbackErrorLogged) {
+	    this->m_callbackErrorLogged = true;
+	    const char* str = JS_ToCString (ctx, exception);
+	    sLog.error ("ScriptEngine [timer]: ", str ? str : "<unknown error>");
+	    JS_FreeCString (ctx, str);
+	}
+
+	JS_FreeValue (ctx, exception);
     }
+
+    JS_FreeValue (ctx, result);
 }
