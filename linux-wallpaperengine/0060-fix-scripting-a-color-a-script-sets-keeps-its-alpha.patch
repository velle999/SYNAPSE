From ac4bde1a957e3349f105798a9ff6371107e3f03c Mon Sep 17 00:00:00 2001
From: Velle Sinclair <brncomputerhelp@gmail.com>
Date: Tue, 27 Oct 2026 09:07:37 -0500
Subject: [PATCH 60/61] fix(scripting): a color a script sets keeps its alpha

A layer's color is a Vec3 to a script (lib.sceneScript.d.ts) and a
Vec4 here, parsed with the alpha it draws with. A script returning a
Vec3 for it replaced the Vec4 with the Vec3, whose fourth component
reads 0. A text draws its color's alpha, and a script-colored text
drew nothing: a music widget colors its title, artist, clock and
buttons from the album art, and showed none of them. Images whose
material multiplies by g_Color4 lost their alpha the same way.

A three-component vector a script returns for a four-component value
now sets the first three and keeps the fourth.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TrYdVZ7ULsVD9WKX2Az4Mw
---
 src/WallpaperEngine/Scripting/ScriptEngine.cpp     |  7 +++++++
 src/WallpaperEngine/Testing/Cases/ScriptValues.cpp | 14 ++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/src/WallpaperEngine/Scripting/ScriptEngine.cpp b/src/WallpaperEngine/Scripting/ScriptEngine.cpp
index b7c9018c..957da252 100644
--- a/src/WallpaperEngine/Scripting/ScriptEngine.cpp
+++ b/src/WallpaperEngine/Scripting/ScriptEngine.cpp
@@ -205,6 +205,13 @@ void ScriptEngine::jsToDynamicValue (JSContext* ctx, JSValue val, DynamicValue&
 	JS_ToFloat64 (ctx, &zVal, z);
 
 	if (!JS_IsNumber (w)) {
+	    // a color is a Vec3 to a script and a Vec4 here, its alpha last: the alpha stays, where
+	    // a 0 hid every text a script colored
+	    if (source.getType () == DynamicValue::UnderlyingType::Vec4) {
+		source.update (glm::vec4 (xVal, yVal, zVal, source.getVec4 ().w), DynamicValue::UpdateSource::Script);
+		return;
+	    }
+
 	    source.update (glm::vec3 (xVal, yVal, zVal), DynamicValue::UpdateSource::Script);
 	    return;
 	}
diff --git a/src/WallpaperEngine/Testing/Cases/ScriptValues.cpp b/src/WallpaperEngine/Testing/Cases/ScriptValues.cpp
index 319cec9e..8d4305d7 100644
--- a/src/WallpaperEngine/Testing/Cases/ScriptValues.cpp
+++ b/src/WallpaperEngine/Testing/Cases/ScriptValues.cpp
@@ -80,3 +80,17 @@ TEST_CASE ("A number a script returns for a number stays a number") {
     js.store ("undefined", alpha);
     CHECK (alpha.getFloat () == 0.25f);
 }
+
+TEST_CASE ("A color a script sets as a Vec3 keeps its alpha") {
+    const Context js;
+    // a layer's color as the scene saved it, "1.00000 1.00000 1.00000" with the alpha it is drawn with
+    DynamicValue color (glm::vec4 (1.0f, 1.0f, 1.0f, 1.0f));
+
+    js.store ("({ x: 0.5, y: 0.25, z: 0.125 })", color);
+    CHECK (color.getVec3 () == glm::vec3 (0.5f, 0.25f, 0.125f));
+    CHECK (color.getVec4 () == glm::vec4 (0.5f, 0.25f, 0.125f, 1.0f));
+
+    // a script that sets all four sets the alpha too
+    js.store ("({ x: 1, y: 1, z: 1, w: 0.5 })", color);
+    CHECK (color.getVec4 () == glm::vec4 (1.0f, 1.0f, 1.0f, 0.5f));
+}
