 using namespace WallpaperEngine::Data::Parsers;
 
+namespace {
+/** Whether every space-separated part of str is a number, as in a vector's "0.5 0.25 1" */
+bool isNumberList (const std::string& str) {
+    std::istringstream parts (str);
+    std::string part;
+    bool any = false;
+
+    while (parts >> part) {
+	char* end = nullptr;
+	std::strtof (part.c_str (), &end);
+
+	if (end != part.c_str () + part.size ()) {
+	    return false;
+	}
+
+	any = true;
+    }
+
+    return any;
+}
+} // namespace
