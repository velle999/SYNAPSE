diff --git a/src/WallpaperEngine/Testing/Cases/DynamicValueParser.cpp b/src/WallpaperEngine/Testing/Cases/DynamicValueParser.cpp
new file mode 100644
index 00000000..723eb284
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/DynamicValueParser.cpp
@@ -0,0 +1,38 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <glm/glm.hpp>
+
+#include "WallpaperEngine/Data/Model/DynamicValue.h"
+#include "WallpaperEngine/Data/Parsers/DynamicValueParser.h"
+
+using WallpaperEngine::Data::JSON::JSON;
+using WallpaperEngine::Data::Model::DynamicValue;
+using WallpaperEngine::Data::Model::Properties;
+using WallpaperEngine::Data::Parsers::DynamicValueParser;
+
+namespace {
+WallpaperEngine::Data::Model::DynamicValueUniquePtr parse (const JSON& value) {
+    const Properties none;
+
+    return DynamicValueParser::parse (value, none, false);
+}
+} // namespace
+
+TEST_CASE ("A value with spaces in it is text unless every part is a number") {
+    // a text layer's own text, and the date format a script reads from its properties
+    CHECK (parse ("Hello World")->getType () == DynamicValue::String);
+    CHECK (parse ("Hello World")->getString () == "Hello World");
+    CHECK (parse ("{day}, {month} {date}, {year}")->getString () == "{day}, {month} {date}, {year}");
+    CHECK (parse ("1 hour")->getString () == "1 hour");
+    CHECK (parse ({ { "value", "Merry Christmas" } })->getString () == "Merry Christmas");
+}
+
+TEST_CASE ("A value of numbers separated by spaces is still a vector") {
+    CHECK (parse ("0.5 0.25")->getType () == DynamicValue::Vec2);
+    CHECK (parse ("0.5 0.25")->getVec2 () == glm::vec2 (0.5f, 0.25f));
+    CHECK (parse ("1 2 3")->getType () == DynamicValue::Vec3);
+    CHECK (parse ("1 2 3")->getVec3 () == glm::vec3 (1.0f, 2.0f, 3.0f));
+    CHECK (parse ("-1 0.5 1e-3 4")->getType () == DynamicValue::Vec4);
+    CHECK (parse ("12")->getType () == DynamicValue::Float);
+    CHECK (parse ("12:34")->getType () == DynamicValue::String);
+}
