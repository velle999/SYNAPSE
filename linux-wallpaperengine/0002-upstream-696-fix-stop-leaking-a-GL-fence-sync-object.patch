From 5ea16e1b6e2dfbd85b87f41bd45f598318dac86e Mon Sep 17 00:00:00 2001
From: K-Laron <K-Laron@users.noreply.github.com>
Date: Sun, 25 Oct 2026 10:53:51 -0500
Subject: [PATCH 02/28] upstream #696: fix: stop leaking a GL fence sync object
 per rendered video frame (~8-9 MiB/min RSS)

Carried from https://github.com/Almamu/linux-wallpaperengine/pull/696 (by K-Laron) until it is merged upstream.
---
 .../VideoPlayback/MPV/GLPlayer.cpp            | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/src/WallpaperEngine/VideoPlayback/MPV/GLPlayer.cpp b/src/WallpaperEngine/VideoPlayback/MPV/GLPlayer.cpp
index 39f1ff8c..f0871e17 100644
--- a/src/WallpaperEngine/VideoPlayback/MPV/GLPlayer.cpp
+++ b/src/WallpaperEngine/VideoPlayback/MPV/GLPlayer.cpp
@@ -5,9 +5,41 @@
 #include <mpv/render_gl.h>
 #include <mpv/stream_cb.h>
 
+#include <cstring>
+
 using namespace WallpaperEngine::VideoPlayback::MPV;
 
+// The video player renders every frame into an external FBO and presents the
+// result on its own, so libmpv never sees a GL swapchain. Before libmpv 0.42.0
+// (mpv PR #17303, "only use fences when swap_buffers is present"),
+// ra_gl_ctx_submit_frame creates a GL fence sync object for every rendered
+// frame; without a swapchain those fences are never deleted and each one
+// retains ~5 KiB of driver-side state, leaking per rendered frame (with video
+// wallpapers: several GiB per day). See mpv issues #17217 and #8516, and
+// linux-wallpaperengine issue #416.
+//
+// Returning a FenceSync stub that never creates a sync object disables the
+// per-frame fence bookkeeping. Every use of the returned GLsync inside libmpv
+// is guarded by an if (fence) check, so this is equivalent to the behaviour
+// libmpv 0.42.0 ships.
+/**
+ * glFenceSync replacement used under libmpv < 0.42.0: never creates a sync
+ * object, so per-frame fence bookkeeping becomes a no-op. Returns a null
+ * GLsync, which every fence use in libmpv already handles as "no fence".
+ */
+static GLsync GLAPIENTRY fenceSyncStub (GLenum, GLbitfield) { return nullptr; }
+
+/**
+ * mpv_get_proc_address callback for the render context.
+ *
+ * Returns the fenceSyncStub for the exact name "glFenceSync" and delegates
+ * all other procedures to the active render context's driver.
+ */
 void* get_proc_address (void* ctx, const char* name) {
+    if (strcmp (name, "glFenceSync") == 0) {
+	return (void*)fenceSyncStub;
+    }
+
     return static_cast<GLPlayer*> (ctx)->getContext ().getDriver ().getProcAddress (name);
 }
 
