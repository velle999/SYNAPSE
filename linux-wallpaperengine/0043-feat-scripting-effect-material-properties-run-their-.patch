+void ScriptableObject::registerEffect (const ImageEffect& effect) {
+    auto& entry = *this->m_effects.emplace_back (std::make_unique<ScriptableEffect> (ScriptableEffect {
+	.name = effect.name.empty () && effect.effect != nullptr ? effect.effect->name : effect.name,
+	.visible = *effect.visible->value,
+    }));
+
+    // every property is in place before the first script loads: a module's top level runs
+    // as it is queued, and may read the effect
+    for (const auto& pass : effect.passOverrides) {
+	for (const auto& [name, setting] : pass->constants) {
+	    if (setting != nullptr && setting->value != nullptr) {
+		entry.properties [name].push_back (setting->value.get ());
+	    }
+	}
+    }
+
+    for (size_t pass = 0; pass < effect.passOverrides.size (); pass++) {
+	for (const auto& [name, setting] : effect.passOverrides [pass]->constants) {
+	    if (setting == nullptr || setting->value == nullptr) {
+		continue;
+	    }
+
+	    this->registerDrivenValue (
+		"effect" + std::to_string (effect.id) + "." + std::to_string (pass) + "." + name, *setting->value,
+		&entry
+	    );
+	}
+    }
+}
+
+void ScriptableObject::registerDrivenValue (
+    const std::string& key, DynamicValue& value, const ScriptableEffect* effect
+) {
+    if (const auto& timeline = value.getAnimation (); timeline != nullptr) {
+	this->m_animations.emplace_back (key, std::make_unique<PropertyAnimation> (timeline, value));
+    }
+
+    this->getScene ().getScriptEngine ().queueScript (
+	key + "_" + std::to_string (this->getId ()), value, *this, effect
+    );
+}
