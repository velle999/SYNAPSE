-	vector_get<components> (ctx, argv[0]) + vector_get<components> (container->value),
+	vector_get<components> (container->value) + *argument,
 	DynamicValue::UpdateSource::Initialization
     );
 
@@ -522,13 +547,19 @@ JSValue vector_subtract (JSContext* ctx, JSValueConst this_val, int argc, JSValu
 
