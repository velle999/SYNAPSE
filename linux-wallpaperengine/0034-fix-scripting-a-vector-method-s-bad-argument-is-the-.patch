From 3f77b61cfd771354601a6565c379fde533c59365 Mon Sep 17 00:00:00 2001
From: Velle Sinclair <brncomputerhelp@gmail.com>
Date: Mon, 26 Oct 2026 16:07:19 -0500
Subject: [PATCH 34/42] fix(scripting): a vector method's bad argument is the
 script's error

The vector methods converted their argument with vector_get, which
throws a C++ exception for anything that is not a number or a vector
of that size. Thrown from inside a QuickJS C function, it unwound
through the interpreter and ended the wallpaper. Swimming Kirby
(workshop 3441873795) mixes toward a colour its media script has not
set yet, `shared.miPrimaryColor.mix (shared.miTextBgColor, t)`, and
died on its first frame once vector methods became reachable. The
argument is now converted first, and a bad one is a TypeError for
that script alone, as it is in Wallpaper Engine.

The methods also ran with their operands swapped: a.subtract (b) was
b - a, a.divide (b) was b / a, a.mix (b, t) went from b to a, and
a.cross (b) was b x a. Nothing noticed, because nothing could reach
them. They now run this-first. dot () answers a number rather than a
vector with the product in every component, mix () with the wrong
arguments throws instead of failing without an error, and equals ()
answers false for anything that is not a vector of its size.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TrYdVZ7ULsVD9WKX2Az4Mw
---
 .../Scripting/Adapters/VectorAdapter.cpp      | 108 ++++++++++++++----
 1 file changed, 84 insertions(+), 24 deletions(-)

diff --git a/src/WallpaperEngine/Scripting/Adapters/VectorAdapter.cpp b/src/WallpaperEngine/Scripting/Adapters/VectorAdapter.cpp
index 7fc1fe19..ced0fe31 100644
--- a/src/WallpaperEngine/Scripting/Adapters/VectorAdapter.cpp
+++ b/src/WallpaperEngine/Scripting/Adapters/VectorAdapter.cpp
@@ -5,6 +5,7 @@
 #include "WallpaperEngine/Data/Utils/ScopeGuard.h"
 
 #include <algorithm>
+#include <optional>
 #include <ranges>
 #include <variant>
 
@@ -157,6 +158,21 @@ template auto vector_get<2> (DynamicValue& value) -> decltype (auto);
 template auto vector_get<3> (DynamicValue& value) -> decltype (auto);
 template auto vector_get<4> (DynamicValue& value) -> decltype (auto);
 
+/**
+ * A vector method's argument as a vector of this size, or nothing with a TypeError thrown for the
+ * script. vector_get's C++ exception, thrown on through QuickJS's C frames, ended the whole
+ * wallpaper instead of the one script, as `color.mix (shared.notSetYet, t)` did.
+ */
+template <int components>
+auto vector_argument (JSContext* ctx, JSValueConst source) -> std::optional<decltype (vector_new<components> ())> {
+    try {
+	return vector_get<components> (ctx, source);
+    } catch (const std::exception& e) {
+	JS_ThrowTypeError (ctx, "Vec%d: %s", components, e.what ());
+	return std::nullopt;
+    }
+}
+
 template <int components>
