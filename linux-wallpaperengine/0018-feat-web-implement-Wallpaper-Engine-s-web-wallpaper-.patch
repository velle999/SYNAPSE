@@ -0,0 +1,43 @@
+#pragma once
+
+#include <filesystem>
+#include <functional>
+#include <map>
+#include <string>
+
+#include "WallpaperEngine/Data/JSON.h"
+
+namespace WallpaperEngine::WebBrowser::CEF::WebProperties {
+using WallpaperEngine::Data::JSON::JSON;
+
+/** What a web wallpaper is handed once it has loaded */
+struct Payload {
+    /** The argument to applyGeneralProperties */
+    JSON general = JSON::object ();
+    /** The argument to applyUserProperties: { name: { value } } for every property that carries one */
+    JSON user = JSON::object ();
+    /** The files of each directory property, for wallpaperRequestRandomFileForProperty */
+    JSON files = JSON::object ();
+};
+
+/** Turns a path inside the project into one on disk; throws when the project has no such file */
+using Resolver = std::function<std::filesystem::path (const std::filesystem::path&)>;
+
+/**
+ * Builds the payload from the project's project.json the way Wallpaper Engine hands it
+ * to a page: every value typed as project.json types it, --set-property overrides
+ * applied, unset values given the defaults the page expects, and file and directory
+ * values made absolute so a page's "file:///" + value finds them.
+ *
+ * @param project The parsed project.json
+ * @param overrides The --set-property values, by property name
+ * @param fps The frame rate the page is rendered at
+ * @param resolve Locates project files on disk
+ */
+[[nodiscard]] Payload build (
+    const JSON& project, const std::map<std::string, std::string>& overrides, int fps, const Resolver& resolve
+);
+
+/** The script that delivers a payload, to run in the page's global scope after it loads */
+[[nodiscard]] std::string script (const Payload& payload);
+} // namespace WallpaperEngine::WebBrowser::CEF::WebProperties
