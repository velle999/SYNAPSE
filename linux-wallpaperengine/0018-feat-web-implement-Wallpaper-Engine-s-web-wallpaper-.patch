+std::string CWeb::buildPropertiesScript () const {
+    const auto& project = this->getWeb ().project;
+    const auto& settings = this->getContext ().getApp ().getContext ().settings;
+    WebProperties::JSON raw = WebProperties::JSON::object ();
+
+    try {
+	raw = WebProperties::JSON::parse (project.assetLocator->readString ("project.json"));
+    } catch (const std::exception& e) {
+	// the page still gets its general properties
+	sLog.error ("Cannot read the web wallpaper's properties: ", e.what ());
+    }
+
+    const auto payload = WebProperties::build (
+	raw, settings.general.properties, settings.render.maximumFPS,
+	[&project] (const std::filesystem::path& path) { return project.assetLocator->physicalPath (path); }
+    );
+
+    return WebProperties::script (payload);
+}
+
+void CWeb::pushAudio () {
+    if (!this->getWeb ().project.supportsAudioProcessing || !this->m_client->isLoaded ()) {
+	return;
+    }
+
+    // the engine's audio refreshes once per frame; this keeps it there if several
+    // viewports render the same page
+    const auto now = std::chrono::steady_clock::now ();
+
+    if (now - this->m_lastAudioPush < std::chrono::milliseconds (30)) {
+	return;
+    }
+
+    this->m_lastAudioPush = now;
+
+    const auto& recorder = this->getAudioContext ().getRecorder ();
+    // 64 bands per channel, left then right; the capture is mono, so both halves match.
+    // to_chars and not printf: a locale with a decimal comma would break the script.
+    std::string script = "window.__wpeHost&&window.__wpeHost.audio([";
+    char buffer [16];
+
+    for (int i = 0; i < 128; i++) {
+	float band = recorder.audio64 [i % 64];
+	band = std::isfinite (band) ? std::clamp (band, 0.0f, 1.0f) : 0.0f;
+
+	const auto [end, error] = std::to_chars (buffer, buffer + sizeof (buffer), band, std::chars_format::fixed, 3);
+
+	if (i > 0) {
+	    script += ',';
+	}
+
+	if (error == std::errc ()) {
+	    script.append (buffer, end);
+	} else {
+	    script += '0';
+	}
+    }
+
+    script += "])";
+
+    this->m_browser->GetMainFrame ()->ExecuteJavaScript (script, CefString (), 0);
+}
+
 CWeb::~CWeb () {
     CefDoMessageLoopWork ();
     this->m_browser->GetHost ()->CloseBrowser (true);
