diff --git a/src/WallpaperEngine/WebBrowser/CEF/WebApi.h b/src/WallpaperEngine/WebBrowser/CEF/WebApi.h
new file mode 100644
index 00000000..6e91431c
--- /dev/null
+++ b/src/WallpaperEngine/WebBrowser/CEF/WebApi.h
@@ -0,0 +1,126 @@
+#pragma once
+
+namespace WallpaperEngine::WebBrowser::CEF::WebApi {
+/**
+ * The part of Wallpaper Engine's web API that a page calls into, installed into the main
+ * frame's V8 context before any of the page's own scripts run (OnContextCreated in the
+ * renderer). Pages register with these at load time and most of them build nothing
+ * until they are called back, so without it they sit black on their loading screen.
+ *
+ * The host side (BrowserClient / CWeb) drives it through window.__wpeHost:
+ *  - deliver (general, user, files, listener) once the page has loaded, and again on
+ *    reload; the listener is looked up by the CALLER, in global scope, so a page that
+ *    declares it with let/const is found too (WebProperties builds the call);
+ *  - audio (array) with 128 values, 64 bands for each channel, at the frame rate.
+ *
+ * A page that assigns wallpaperPropertyListener after delivery still gets its
+ * properties: the setter replays them, as Wallpaper Engine does for a late listener.
+ */
+inline constexpr const char* shim = R"JS(
+(function () {
+    if (window.__wpeHost) {
+        return;
+    }
+
+    var host = { general: null, user: null, delivered: false, listener: undefined, audioListeners: [], files: {} };
+
+    function call (target, name, argument) {
+        if (target && typeof target[name] === 'function') {
+            try {
+                target[name] (argument);
+            } catch (e) {
+                console.error (e);
+            }
+        }
+    }
+
+    host.apply = function (listener) {
+        if (host.general) {
+            call (listener, 'applyGeneralProperties', host.general);
+        }
+        if (host.user) {
+            call (listener, 'applyUserProperties', host.user);
+        }
+    };
+
+    host.deliver = function (general, user, files, listener) {
+        host.general = general;
+        host.user = user;
+        host.files = files || {};
+        host.delivered = true;
+        host.apply (listener !== undefined ? listener : host.listener);
+    };
+
+    host.audio = function (values) {
+        for (var i = 0; i < host.audioListeners.length; i++) {
+            try {
+                host.audioListeners[i] (values);
+            } catch (e) {
+                console.error (e);
+            }
+        }
+    };
+
+    Object.defineProperty (window, '__wpeHost', { value: host });
+
+    Object.defineProperty (window, 'wallpaperPropertyListener', {
+        configurable: true,
+        enumerable: true,
+        get: function () {
+            return host.listener;
+        },
+        set: function (listener) {
+            host.listener = listener;
+            if (host.delivered) {
+                setTimeout (function () { host.apply (listener); }, 0);
+            }
+        }
+    });
+
+    window.wallpaperRegisterAudioListener = function (callback) {
+        if (typeof callback === 'function') {
+            host.audioListeners.push (callback);
+        }
+    };
+
+    // ondemand directory properties: hand back one of the folder's files at random
+    window.wallpaperRequestRandomFileForProperty = function (name, callback) {
+        var list = host.files[name];
+        if (typeof callback !== 'function' || !list || list.length === 0) {
+            return;
+        }
+        var pick = list[Math.floor (Math.random () * list.length)];
+        setTimeout (function () { callback (name, pick); }, 0);
+    };
+
+    // there is no media integration: say so once, and accept the rest silently
+    window.wallpaperRegisterMediaStatusListener = function (callback) {
+        if (typeof callback === 'function') {
+            setTimeout (function () { callback ({ enabled: false }); }, 0);
+        }
+    };
+    ['Properties', 'Thumbnail', 'Playback', 'Timeline'].forEach (function (kind) {
+        window['wallpaperRegisterMedia' + kind + 'Listener'] = function () {};
+    });
+}) ();
+)JS";
+
+/**
+ * Hands the page its properties. Evaluated as a script of its own in the page's global
+ * scope, which is the only place a let/const-declared listener is visible from.
+ */
+inline constexpr const char* deliverPrefix = R"JS(
+(function (general, user, files) {
+    var host = window.__wpeHost;
+    if (!host) {
+        return;
+    }
+    var listener;
+    try {
+        listener = wallpaperPropertyListener;
+    } catch (e) {
+        listener = undefined;
+    }
+    host.deliver (general, user, files, listener);
+}) ()JS";
+} // namespace WallpaperEngine::WebBrowser::CEF::WebApi
diff --git a/src/WallpaperEngine/WebBrowser/CEF/WebProperties.cpp b/src/WallpaperEngine/WebBrowser/CEF/WebProperties.cpp
new file mode 100644
index 00000000..f18838cb
--- /dev/null
+++ b/src/WallpaperEngine/WebBrowser/CEF/WebProperties.cpp
@@ -0,0 +1,128 @@
+#include "WebProperties.h"
+#include "WebApi.h"
+
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <system_error>
+
+using namespace WallpaperEngine::WebBrowser::CEF;
+
+namespace {
+using WallpaperEngine::Data::JSON::JSON;
+
+/**
+ * --set-property values are always strings; hand the page the type project.json gives
+ * the property. A combo keeps a number when the project wrote one, since pages compare
+ * them with === and switch.
+ */
+JSON overrideValue (const std::string& type, const JSON& original, const std::string& value) {
+    if (type == "bool") {
+	return value == "1" || value == "true";
+    }
+
+    if (type == "slider" || (type == "combo" && original.is_number ())) {
+	double number = 0.0;
+	const auto [end, error] = std::from_chars (value.data (), value.data () + value.size (), number);
+
+	if (error == std::errc () && end == value.data () + value.size ()) {
+	    if (original.is_number_integer () && number == std::floor (number)) {
+		return static_cast<int64_t> (number);
+	    }
+
+	    return number;
+	}
+    }
+
+    return value;
+}
+} // namespace
+
+WebProperties::Payload WebProperties::build (
+    const JSON& project, const std::map<std::string, std::string>& overrides, const int fps, const Resolver& resolve
+) {
+    Payload payload;
+    const JSON* properties = nullptr;
+
+    payload.general = { { "fps", fps } };
+
+    if (const auto general = project.find ("general"); general != project.end () && general->is_object ()) {
+	if (const auto it = general->find ("properties"); it != general->end ()) {
+	    properties = &*it;
+	}
+    }
+
+    if (properties == nullptr || !properties->is_object ()) {
+	return payload;
+    }
+
+    for (const auto& [name, property] : properties->items ()) {
+	if (!property.is_object ()) {
+	    continue;
+	}
+
+	const auto typeIt = property.find ("type");
+	std::string type = typeIt != property.end () && typeIt->is_string () ? typeIt->get<std::string> () : "";
+	std::ranges::transform (type, type.begin (), [] (const unsigned char c) { return std::tolower (c); });
+
+	const auto valueIt = property.find ("value");
+	JSON value = valueIt != property.end () ? *valueIt : JSON ();
+
+	if (const auto override = overrides.find (name); override != overrides.end ()) {
+	    value = overrideValue (type, value, override->second);
+	}
+
+	// what Wallpaper Engine hands a page for a value the user never set
+	if (value.is_null ()) {
+	    if (type == "bool") {
+		value = false;
+	    } else if (type == "textinput" || type == "file" || type == "directory") {
+		value = "";
+	    } else {
+		// labels and groups carry nothing to apply
+		continue;
+	    }
+	}
+
+	// pages build "file:///" + value, so a path inside the project goes out absolute
+	if ((type == "file" || type == "directory") && value.is_string () && !value.get<std::string> ().empty ()) {
+	    std::filesystem::path path = value.get<std::string> ();
+
+	    if (path.is_relative ()) {
+		try {
+		    path = resolve (path);
+		} catch (const std::exception&) {
+		    // not part of the project: leave it as the page was given it
+		}
+	    }
+
+	    value = path.string ();
+
+	    if (type == "directory") {
+		std::error_code ec;
+		JSON list = JSON::array ();
+
+		for (const auto& entry : std::filesystem::directory_iterator (path, ec)) {
+		    if (entry.is_regular_file (ec)) {
+			list.push_back (entry.path ().string ());
+		    }
+		}
+
+		payload.files [name] = list;
+	    }
+	}
+
+	payload.user [name] = JSON { { "value", value } };
+    }
+
+    return payload;
+}
+
+std::string WebProperties::script (const Payload& payload) {
+    // replace, not throw: a project.json string that is not valid UTF-8 must not cost
+    // the page every other property
+    constexpr auto replace = JSON::error_handler_t::replace;
+
+    return std::string (WebApi::deliverPrefix) + payload.general.dump (-1, ' ', true, replace) + ","
+	+ payload.user.dump (-1, ' ', true, replace) + "," + payload.files.dump (-1, ' ', true, replace) + ");";
+}
