diff --git a/src/WallpaperEngine/Testing/Cases/WebProperties.cpp b/src/WallpaperEngine/Testing/Cases/WebProperties.cpp
new file mode 100644
index 00000000..20df6d93
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/WebProperties.cpp
@@ -0,0 +1,168 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+#include "WallpaperEngine/WebBrowser/CEF/WebApi.h"
+#include "WallpaperEngine/WebBrowser/CEF/WebProperties.h"
+
+using WallpaperEngine::Data::JSON::JSON;
+namespace WebApi = WallpaperEngine::WebBrowser::CEF::WebApi;
+namespace WebProperties = WallpaperEngine::WebBrowser::CEF::WebProperties;
+
+namespace {
+const WebProperties::Resolver noFiles = [] (const std::filesystem::path& path) -> std::filesystem::path {
+    throw std::runtime_error ("not in the project: " + path.string ());
+};
+
+JSON project (JSON properties) { return { { "general", { { "properties", std::move (properties) } } } }; }
+} // namespace
+
+TEST_CASE ("Web properties are typed as project.json types them") {
+    const auto payload = WebProperties::build (
+	project ({
+	    { "enabled", { { "type", "bool" }, { "value", true } } },
+	    { "speed", { { "type", "slider" }, { "value", 0.25 } } },
+	    { "tint", { { "type", "color" }, { "value", "0.5 0.25 1" } } },
+	}),
+	{}, 30, noFiles
+    );
+
+    CHECK (payload.general == JSON { { "fps", 30 } });
+    CHECK (payload.user ["enabled"] == JSON { { "value", true } });
+    CHECK (payload.user ["speed"] == JSON { { "value", 0.25 } });
+    CHECK (payload.user ["tint"] == JSON { { "value", "0.5 0.25 1" } });
+    CHECK (payload.files.empty ());
+}
+
+TEST_CASE ("Web properties the user never set get the defaults pages expect") {
+    const auto payload = WebProperties::build (
+	project ({
+	    { "clock", { { "type", "Bool" } } },
+	    { "city", { { "type", "textinput" }, { "value", nullptr } } },
+	    { "image", { { "type", "file" } } },
+	    { "heading", { { "type", "text" } } },
+	    { "section", { { "type", "group" }, { "value", nullptr } } },
+	}),
+	{}, 30, noFiles
+    );
+
+    // the type is matched case-insensitively, as Wallpaper Engine does
+    CHECK (payload.user ["clock"] == JSON { { "value", false } });
+    CHECK (payload.user ["city"] == JSON { { "value", "" } });
+    CHECK (payload.user ["image"] == JSON { { "value", "" } });
+    CHECK_FALSE (payload.user.contains ("heading"));
+    CHECK_FALSE (payload.user.contains ("section"));
+}
+
+TEST_CASE ("Web property overrides keep the property's type") {
+    const auto payload = WebProperties::build (
+	project ({
+	    { "enabled", { { "type", "bool" }, { "value", false } } },
+	    { "disabled", { { "type", "bool" }, { "value", true } } },
+	    { "speed", { { "type", "slider" }, { "value", 0.25 } } },
+	    { "count", { { "type", "slider" }, { "value", 3 } } },
+	    { "mode", { { "type", "combo" }, { "value", 1 } } },
+	    { "theme", { { "type", "combo" }, { "value", "dark" } } },
+	    { "city", { { "type", "textinput" } } },
+	    { "broken", { { "type", "slider" }, { "value", 1 } } },
+	}),
+	{
+	    { "enabled", "1" },
+	    { "disabled", "0" },
+	    { "speed", "0.75" },
+	    { "count", "7" },
+	    { "mode", "2" },
+	    { "theme", "light" },
+	    { "city", "Paris" },
+	    { "broken", "fast" },
+	},
+	30, noFiles
+    );
+
+    CHECK (payload.user ["enabled"]["value"] == true);
+    CHECK (payload.user ["disabled"]["value"] == false);
+    CHECK (payload.user ["speed"]["value"] == 0.75);
+    // pages compare these with === and switch, so an integer stays one
+    CHECK (payload.user ["count"]["value"].is_number_integer ());
+    CHECK (payload.user ["count"]["value"] == 7);
+    CHECK (payload.user ["mode"]["value"].is_number_integer ());
+    CHECK (payload.user ["mode"]["value"] == 2);
+    CHECK (payload.user ["theme"]["value"] == "light");
+    CHECK (payload.user ["city"]["value"] == "Paris");
+    CHECK (payload.user ["broken"]["value"] == "fast");
+}
+
+TEST_CASE ("Web file and directory properties are handed out absolute") {
+    const auto root = std::filesystem::temp_directory_path () / ("lwe-webproperties-" + std::to_string (getpid ()));
+    std::filesystem::remove_all (root);
+    std::filesystem::create_directories (root / "images" / "nested");
+    std::ofstream (root / "images" / "a.png") << "a";
+    std::ofstream (root / "images" / "b.png") << "b";
+    std::ofstream (root / "poster.png") << "p";
+
+    const WebProperties::Resolver resolve = [&root] (const std::filesystem::path& path) {
+	if (!std::filesystem::exists (root / path)) {
+	    throw std::runtime_error ("not in the project");
+	}
+
+	return root / path;
+    };
+
+    const auto payload = WebProperties::build (
+	project ({
+	    { "poster", { { "type", "file" }, { "value", "poster.png" } } },
+	    { "missing", { { "type", "file" }, { "value", "elsewhere.png" } } },
+	    { "absolute", { { "type", "file" }, { "value", "/usr/share/a.png" } } },
+	    { "slides", { { "type", "directory" }, { "value", "images" } } },
+	}),
+	{}, 30, resolve
+    );
+
+    CHECK (payload.user ["poster"]["value"] == (root / "poster.png").string ());
+    CHECK (payload.user ["missing"]["value"] == "elsewhere.png");
+    CHECK (payload.user ["absolute"]["value"] == "/usr/share/a.png");
+    CHECK (payload.user ["slides"]["value"] == (root / "images").string ());
+
+    // only the folder's files, not its subfolders
+    auto files = payload.files ["slides"].get<std::vector<std::string>> ();
+    std::ranges::sort (files);
+    CHECK (files == std::vector<std::string> { (root / "images" / "a.png").string (), (root / "images" / "b.png").string () });
+
+    std::filesystem::remove_all (root);
+}
+
+TEST_CASE ("Web wallpapers without properties still get general properties") {
+    for (const auto& raw : { JSON::object (), JSON { { "general", 5 } }, project ("none") }) {
+	const auto payload = WebProperties::build (raw, {}, 24, noFiles);
+
+	CHECK (payload.general == JSON { { "fps", 24 } });
+	CHECK (payload.user.empty ());
+    }
+}
+
+TEST_CASE ("The web properties script is one call that survives any property text") {
+    WebProperties::Payload payload;
+    payload.general = { { "fps", 30 } };
+    // a line separator ends a JavaScript string literal in older engines; invalid UTF-8
+    // made nlohmann throw and cost the page every property
+    payload.user = { { "title", { { "value", "caf\xc3\xa9 \xe2\x80\xa8 \xff" } } } };
+
+    const auto script = WebProperties::script (payload);
+
+    CHECK (script.starts_with (WebApi::deliverPrefix));
+    // no directory properties: the files argument is empty and closes the call
+    CHECK (script.ends_with (",{});"));
+    CHECK (script.find ("\\u00e9") != std::string::npos);
+    CHECK (script.find ("\\u2028") != std::string::npos);
+    CHECK (script.find ("\\ufffd") != std::string::npos);
+
+    // every byte after the prefix is ASCII, so the page's encoding cannot matter
+    const auto arguments = script.substr (std::string (WebApi::deliverPrefix).size ());
+    CHECK (std::ranges::all_of (arguments, [] (const unsigned char c) { return c < 0x80; }));
+}
