+}
+
+JSValue ScriptableObjectAdapter::findMethod (const std::string& name) const {
+    const auto it = this->m_methods.find (name);
+
+    return it == this->m_methods.end () ? JS_UNDEFINED : JS_DupValue (this->m_engine.getContext (), it->second);
+}
+
+JSValue ScriptableObjectAdapter::textureAnimation (ScriptableObject& object) const {
+    auto* renderable = dynamic_cast<Render::Objects::CRenderable*> (&object);
+
+    if (renderable == nullptr || renderable->getTexture () == nullptr || !renderable->getTexture ()->isAnimated ()) {
+	return JS_UNDEFINED;
+    }
+
+    JSValue result = JS_NewObjectClass (this->m_engine.getContext (), this->m_textureAnimationClassId);
+
+    if (JS_IsException (result)) {
+	return result;
+    }
+
+    JS_SetOpaque (
+	result,
+	new OpaqueTextureAnimation { .magic = TEXTURE_ANIMATION_OPAQUE_MAGIC, .animation = renderable->getTextureAnimation () }
+    );
+
+    return result;
 }
 
 JSValue ScriptableObjectAdapter::instantiate (ScriptableObject& object) {
