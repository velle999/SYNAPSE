+#include <catch2/catch_test_macros.hpp>
+
+#include "WallpaperEngine/Render/TextureAnimation.h"
+
+using WallpaperEngine::Render::TextureAnimation;
+
+namespace {
+// three frames of 0.1 s, 0.2 s and 0.3 s: frame 1 starts at 0.1, frame 2 at 0.3, the loop is 0.6
+TextureAnimation threeFrames () { return TextureAnimation ({ 0.1, 0.2, 0.3 }); }
+} // namespace
+
+TEST_CASE ("A texture animation follows the shared render time until a script takes it over") {
+    const auto animation = threeFrames ();
+
+    CHECK (animation.getFrameCount () == 3);
+    CHECK (animation.getDuration () == 0.1 + 0.2 + 0.3);
+    CHECK (animation.isPlaying ());
+    CHECK (animation.getRate () == 1.0);
+
+    CHECK (animation.getFrame (0.0) == 0);
+    CHECK (animation.getFrame (0.05) == 0);
+    CHECK (animation.getFrame (0.15) == 1);
+    CHECK (animation.getFrame (0.45) == 2);
+    // and loops
+    CHECK (animation.getFrame (0.65) == 0);
+    CHECK (animation.getFrame (100.0 * 0.6 + 0.35) == 2);
+}
+
+TEST_CASE ("setFrame lands on that frame, whatever the time, and keeps playing") {
+    auto animation = threeFrames ();
+
+    // late in a long session, where the shared time is in frame 0
+    animation.setFrame (1000.2, 1);
+    CHECK (animation.getFrame (1000.2) == 1);
+    CHECK (animation.isPlaying ());
+    CHECK (animation.getFrame (1000.2 + 0.25) == 2);
+
+    animation.setFrame (1000.5, 2);
+    CHECK (animation.getFrame (1000.5) == 2);
+
+    // counted around the loop
+    animation.setFrame (1000.5, 4);
+    CHECK (animation.getFrame (1000.5) == 1);
+    animation.setFrame (1000.5, -1);
+    CHECK (animation.getFrame (1000.5) == 2);
+}
+
+TEST_CASE ("A frame set every frame holds, as a clock's AM/PM sprite needs") {
+    auto animation = TextureAnimation ({ 0.05, 0.05 });
+
+    for (int tick = 0; tick < 60; tick++) {
+	const double now = 10.0 + tick / 30.0;
+
+	animation.setFrame (now, 1);
+	CHECK (animation.getFrame (now + 1.0 / 60.0) == 1);
+    }
+}
+
+TEST_CASE ("pause holds the current frame and play continues from it") {
+    auto animation = threeFrames ();
+
+    // 0.1 into the loop, then 0.25 of play: 0.35, in frame 2
+    animation.setFrame (50.0, 1);
+    animation.pause (50.25);
+    CHECK_FALSE (animation.isPlaying ());
+    CHECK (animation.getFrame (50.25) == 2);
+    CHECK (animation.getFrame (80.0) == 2);
+
+    animation.play (80.0);
+    CHECK (animation.isPlaying ());
+    CHECK (animation.getFrame (80.0) == 2);
+    // 0.35 + 0.3 wraps to 0.05
+    CHECK (animation.getFrame (80.0 + 0.3) == 0);
+}
+
+TEST_CASE ("stop goes back to the first frame and play starts from it") {
+    auto animation = threeFrames ();
+
+    animation.stop (7.45);
+    CHECK_FALSE (animation.isPlaying ());
+    CHECK (animation.getFrame (7.45) == 0);
+    CHECK (animation.getFrame (9.0) == 0);
+
+    animation.play (9.0);
+    CHECK (animation.getFrame (9.0 + 0.15) == 1);
+}
+
+TEST_CASE ("rate scales the speed from where the animation is, and may run backwards") {
+    auto animation = threeFrames ();
+
+    animation.setFrame (20.0, 0);
+    animation.setRate (20.0, 2.0);
+    CHECK (animation.getRate () == 2.0);
+    CHECK (animation.getFrame (20.075) == 1);
+    CHECK (animation.getFrame (20.16) == 2);
+
+    animation.setFrame (30.0, 0);
+    animation.setRate (30.0, -1.0);
+    CHECK (animation.getFrame (30.05) == 2);
+    CHECK (animation.getFrame (30.4) == 1);
+}
+
+TEST_CASE ("join hands the animation back to the shared time") {
+    auto animation = threeFrames ();
+
+    animation.stop (3.0);
+    animation.setRate (3.0, 4.0);
+    animation.join ();
+
+    CHECK (animation.isPlaying ());
+    CHECK (animation.getRate () == 1.0);
+    CHECK (animation.getFrame (0.45) == 2);
+}
+
+TEST_CASE ("A texture without frames shows frame 0 and ignores control") {
+    auto animation = TextureAnimation ();
+
+    animation.setFrame (1.0, 3);
+    animation.play (1.0);
+    CHECK (animation.getFrameCount () == 0);
+    CHECK (animation.getFrame (5.0) == 0);
+}
