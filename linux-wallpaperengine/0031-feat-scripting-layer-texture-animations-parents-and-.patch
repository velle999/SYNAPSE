diff --git a/src/WallpaperEngine/Render/TextureAnimation.cpp b/src/WallpaperEngine/Render/TextureAnimation.cpp
new file mode 100644
index 00000000..f93e0717
--- /dev/null
+++ b/src/WallpaperEngine/Render/TextureAnimation.cpp
@@ -0,0 +1,129 @@
+#include "TextureAnimation.h"
+
+#include <cmath>
+#include <numeric>
+#include <utility>
+
+using namespace WallpaperEngine::Render;
+
+TextureAnimation::TextureAnimation (std::vector<double> frameTimes) :
+    m_frameTimes (std::move (frameTimes)),
+    m_duration (std::accumulate (m_frameTimes.begin (), m_frameTimes.end (), 0.0)) { }
+
+size_t TextureAnimation::getFrameCount () const { return this->m_frameTimes.size (); }
+
+double TextureAnimation::getDuration () const { return this->m_duration; }
+
+size_t TextureAnimation::getFrame (double now) const {
+    if (this->m_frameTimes.empty () || this->m_duration <= 0.0) {
+	return 0;
+    }
+
+    double t = std::fmod (this->position (now), this->m_duration);
+
+    // fmod keeps the sign, and a negative rate runs the position below zero
+    if (t < 0.0) {
+	t += this->m_duration;
+    }
+
+    // summed in the same order setFrame sums, so a frame's start lands in that frame and
+    // not, by a rounding error, at the end of the one before
+    double end = 0.0;
+
+    for (size_t frame = 0; frame < this->m_frameTimes.size (); frame++) {
+	end += this->m_frameTimes [frame];
+
+	if (t < end) {
+	    return frame;
+	}
+    }
+
+    // only rounding gets here, at the very end of the loop
+    return this->m_frameTimes.size () - 1;
+}
+
+bool TextureAnimation::isPlaying () const { return !this->m_detached || this->m_playing; }
+
+double TextureAnimation::getRate () const { return this->m_detached ? this->m_rate : 1.0; }
+
+void TextureAnimation::play (double now) {
+    this->detach (now);
+
+    if (!this->m_playing) {
+	this->m_since = now;
+	this->m_playing = true;
+    }
+}
+
+void TextureAnimation::pause (double now) {
+    this->detach (now);
+
+    if (this->m_playing) {
+	this->m_position = this->position (now);
+	this->m_since = now;
+	this->m_playing = false;
+    }
+}
+
+void TextureAnimation::stop (double now) {
+    this->detach (now);
+    this->m_position = 0.0;
+    this->m_since = now;
+    this->m_playing = false;
+}
+
+void TextureAnimation::setFrame (double now, long long frame) {
+    this->detach (now);
+
+    const auto count = static_cast<long long> (this->m_frameTimes.size ());
+
+    if (count == 0) {
+	return;
+    }
+
+    frame %= count;
+
+    if (frame < 0) {
+	frame += count;
+    }
+
+    this->m_position = std::accumulate (this->m_frameTimes.begin (), this->m_frameTimes.begin () + frame, 0.0);
+    this->m_since = now;
+}
+
+void TextureAnimation::setRate (double now, double rate) {
+    this->detach (now);
+    this->m_position = this->position (now);
+    this->m_since = now;
+    this->m_rate = rate;
+}
+
+void TextureAnimation::join () {
+    this->m_detached = false;
+    this->m_playing = true;
+    this->m_rate = 1.0;
+}
+
+double TextureAnimation::position (double now) const {
+    if (!this->m_detached) {
+	return now;
+    }
+
+    if (!this->m_playing) {
+	return this->m_position;
+    }
+
+    return this->m_position + (now - this->m_since) * this->m_rate;
+}
+
+void TextureAnimation::detach (double now) {
+    if (this->m_detached) {
+	return;
+    }
+
+    this->m_position = now;
+    this->m_since = now;
+    this->m_detached = true;
+    this->m_playing = true;
+    this->m_rate = 1.0;
+}
diff --git a/src/WallpaperEngine/Render/TextureAnimation.h b/src/WallpaperEngine/Render/TextureAnimation.h
new file mode 100644
index 00000000..397cf40d
--- /dev/null
+++ b/src/WallpaperEngine/Render/TextureAnimation.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <cstddef>
+#include <vector>
+
+namespace WallpaperEngine::Render {
+/**
+ * Where a sprite sheet or GIF texture is in its loop.
+ *
+ * Every layer follows the shared render time until a script takes its animation over
+ * (ITextureAnimation): from then on it keeps its own position, rate and play state, as
+ * Wallpaper Engine does, until join () hands it back to the shared time.
+ *
+ * Times are the render clock (g_Time) the caller passes in, so nothing here reads a clock.
+ */
+class TextureAnimation {
+public:
+    TextureAnimation () = default;
+    /** @param frameTimes how long each frame shows, in seconds, in play order */
+    explicit TextureAnimation (std::vector<double> frameTimes);
+
+    [[nodiscard]] size_t getFrameCount () const;
+    [[nodiscard]] double getDuration () const;
+
+    /** The frame showing at render time `now`, 0 for a texture without frames */
+    [[nodiscard]] size_t getFrame (double now) const;
+    [[nodiscard]] bool isPlaying () const;
+    [[nodiscard]] double getRate () const;
+
+    /** Continues from where it was paused or stopped */
+    void play (double now);
+    /** Holds the current frame */
+    void pause (double now);
+    /** Holds the first frame */
+    void stop (double now);
+    /** Moves to the start of `frame`, counted around the loop, without changing whether it plays */
+    void setFrame (double now, long long frame);
+    /** Plays at `rate` times the normal speed from here on; negative plays backwards */
+    void setRate (double now, double rate);
+    /** Follows the shared render time again */
+    void join ();
+
+private:
+    /** Seconds into the animation at `now`, before wrapping to the loop */
+    [[nodiscard]] double position (double now) const;
+    /** Takes over from the shared time, at the position it was showing */
+    void detach (double now);
+
+    std::vector<double> m_frameTimes;
+    double m_duration = 0.0;
+    bool m_detached = false;
+    bool m_playing = true;
+    double m_rate = 1.0;
+    /** position at m_since */
+    double m_position = 0.0;
+    double m_since = 0.0;
+};
+} // namespace WallpaperEngine::Render
