+struct OpaqueTextureAnimation {
+    unsigned int magic;
+    WallpaperEngine::Render::TextureAnimation& animation;
+};
+
 void scriptableobject_finalizer (JSRuntime* rt, JSValueConst val);
 
+namespace {
+OpaqueScriptableObjectAdapter* layer_opaque (JSValueConst value) {
+    JSClassID classId = 0;
+    auto* container = static_cast<OpaqueScriptableObjectAdapter*> (JS_GetAnyOpaque (value, &classId));
+
+    return container != nullptr && container->magic == SCRIPTABLE_OPAQUE_MAGIC ? container : nullptr;
+}
+
+/** The scriptable layer with this id, if there is one: groups are not scriptable yet */
+WallpaperEngine::Scripting::ScriptableObject* scriptable_layer (ScriptableObjectAdapter& adapter, int id) {
+    const auto* object = adapter.getEngine ().getScene ().getObject (id);
+
+    if (object == nullptr || !object->is<WallpaperEngine::Scripting::ScriptableObject> ()) {
+	return nullptr;
+    }
+
+    return const_cast<WallpaperEngine::Scripting::ScriptableObject*> (
+	object->as<WallpaperEngine::Scripting::ScriptableObject> ()
+    );
+}
+
+JSValue layer_get_texture_animation (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    auto* container = layer_opaque (this_val);
+
+    if (container == nullptr) {
+	return JS_ThrowTypeError (ctx, "getTextureAnimation called on something that is not a layer");
+    }
+
+    return container->adapter.textureAnimation (container->object);
+}
+
+JSValue layer_get_parent (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    auto* container = layer_opaque (this_val);
+
+    if (container == nullptr) {
+	return JS_ThrowTypeError (ctx, "getParent called on something that is not a layer");
+    }
+
+    const auto& parent = container->object.getObject ().parent;
+    auto* layer = parent.has_value () ? scriptable_layer (container->adapter, parent.value ()) : nullptr;
+
+    return layer == nullptr ? JS_UNDEFINED : container->adapter.instantiate (*layer);
+}
+
+JSValue layer_get_children (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    auto* container = layer_opaque (this_val);
+
+    if (container == nullptr) {
+	return JS_ThrowTypeError (ctx, "getChildren called on something that is not a layer");
+    }
+
+    JSValue result = JS_NewArray (ctx);
+    uint32_t index = 0;
+
+    for (const auto* object : container->adapter.getEngine ().getScene ().getObjectsByRenderOrder ()) {
+	if (object->getObject ().parent != container->object.getId ()) {
+	    continue;
+	}
+
+	if (auto* child = scriptable_layer (container->adapter, object->getId ()); child != nullptr) {
+	    JS_SetPropertyUint32 (ctx, result, index++, container->adapter.instantiate (*child));
+	}
+    }
+
+    return result;
+}
+
+WallpaperEngine::Render::TextureAnimation* animation_opaque (JSValueConst value) {
+    JSClassID classId = 0;
+    auto* container = static_cast<OpaqueTextureAnimation*> (JS_GetAnyOpaque (value, &classId));
+
+    return container != nullptr && container->magic == TEXTURE_ANIMATION_OPAQUE_MAGIC ? &container->animation
+										       : nullptr;
+}
+
+void animation_finalizer (JSRuntime* rt, JSValueConst val) {
+    JSClassID classId = 0;
+    const auto* container = static_cast<OpaqueTextureAnimation*> (JS_GetAnyOpaque (val, &classId));
+
+    if (container != nullptr && container->magic == TEXTURE_ANIMATION_OPAQUE_MAGIC) {
+	delete container;
+    }
+}
+
+#define ANIMATION_OR_THROW(ctx, this_val)                                                                              \
+    auto* animation = animation_opaque (this_val);                                                                    \
+    if (animation == nullptr) {                                                                                        \
+	return JS_ThrowTypeError (ctx, "not a texture animation");                                                     \
+    }
+
+JSValue animation_get_frame_count (JSContext* ctx, JSValueConst this_val) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    return JS_NewInt64 (ctx, static_cast<int64_t> (animation->getFrameCount ()));
+}
+
+JSValue animation_get_duration (JSContext* ctx, JSValueConst this_val) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    return JS_NewFloat64 (ctx, animation->getDuration ());
+}
+
+JSValue animation_get_rate (JSContext* ctx, JSValueConst this_val) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    return JS_NewFloat64 (ctx, animation->getRate ());
+}
+
+JSValue animation_set_rate (JSContext* ctx, JSValueConst this_val, JSValueConst value) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    double rate = 1.0;
+
+    if (JS_ToFloat64 (ctx, &rate, value) < 0) {
+	return JS_EXCEPTION;
+    }
+
+    if (std::isfinite (rate)) {
+	animation->setRate (g_Time, rate);
+    }
+
+    return JS_UNDEFINED;
+}
+
+// the read-only ones: a script assigning one is ignored, as for a layer's unknown properties
+JSValue animation_set_ignored (JSContext* ctx, JSValueConst this_val, JSValueConst value) { return JS_UNDEFINED; }
+
+JSValue animation_play (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    animation->play (g_Time);
+    return JS_UNDEFINED;
+}
+
+JSValue animation_pause (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    animation->pause (g_Time);
+    return JS_UNDEFINED;
+}
+
+JSValue animation_stop (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    animation->stop (g_Time);
+    return JS_UNDEFINED;
+}
+
+JSValue animation_join (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    animation->join ();
+    return JS_UNDEFINED;
+}
+
+JSValue animation_is_playing (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    return JS_NewBool (ctx, animation->isPlaying ());
+}
+
+JSValue animation_get_frame (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    return JS_NewInt64 (ctx, static_cast<int64_t> (animation->getFrame (g_Time)));
+}
+
+JSValue animation_set_frame (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    ANIMATION_OR_THROW (ctx, this_val);
+    double frame = 0.0;
+
+    if (argc > 0 && JS_ToFloat64 (ctx, &frame, argv [0]) < 0) {
+	return JS_EXCEPTION;
+    }
+
+    // `shared.flag * 1` and the like arrive as NaN when the flag is not set yet
+    if (std::isfinite (frame)) {
+	animation->setFrame (g_Time, static_cast<long long> (std::floor (frame)));
+    }
+
+    return JS_UNDEFINED;
+}
+
+const JSCFunctionListEntry animation_functions [] = {
