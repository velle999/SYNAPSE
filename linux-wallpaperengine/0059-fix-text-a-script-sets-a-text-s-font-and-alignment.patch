 src/WallpaperEngine/Render/Objects/CText.h   | 17 ++++-
 2 files changed, 67 insertions(+), 18 deletions(-)

diff --git a/src/WallpaperEngine/Render/Objects/CText.cpp b/src/WallpaperEngine/Render/Objects/CText.cpp
index e86a7629..7f31cd5e 100644
--- a/src/WallpaperEngine/Render/Objects/CText.cpp
+++ b/src/WallpaperEngine/Render/Objects/CText.cpp
@@ -148,6 +148,14 @@ CText::CText (Wallpapers::CScene& scene, const Text& text) :
     this->registerProperty ("pointSize", *text.pointSize->value);
     this->registerProperty ("text", *text.text->value);
     this->registerConstant ("size", DynamicValue (text.size));
+    // not saved as properties a script drives, but a script sets them: a music widget turns its
+    // title around with its container, a clock takes the font and alignment the user picked
+    this->registerConstant ("font", DynamicValue (text.font));
+    this->registerConstant ("horizontalalign", DynamicValue (text.alignment));
+    this->registerConstant ("verticalalign", DynamicValue (text.verticalalign));
+    m_font = &this->getProperty ("font");
+    m_horizontalAlign = &this->getProperty ("horizontalalign");
+    m_verticalAlign = &this->getProperty ("verticalalign");
 
     if (text.composite != nullptr) {
 	// the image draws with the text's values, whatever drives them: a script, a timeline, a user setting
@@ -195,7 +203,7 @@ void CText::setup () {
 	return;
     }
 
