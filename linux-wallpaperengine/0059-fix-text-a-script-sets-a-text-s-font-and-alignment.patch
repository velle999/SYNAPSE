+	FT_Done_Face (m_ftFace);
+	m_ftFace = nullptr;
+    }
+
+    m_fontData.clear ();
+    m_loadedFont = font;
+    return loadEmbeddedFont (font) || loadSystemFont (font);
+}
+
+bool CText::loadEmbeddedFont (const std::string& font) {
     // Wallpapers packed in .pkg don't expose physical paths, so we read the font
     // into memory and use FT_New_Memory_Face. m_fontData must outlive the face.
     // `systemfont_*` references signal "use a system font"; let the fallback handle them.
-    if (m_text.font.empty () || m_text.font.rfind ("systemfont_", 0) == 0) {
+    if (font.empty () || font.rfind ("systemfont_", 0) == 0) {
 	return false;
     }
 
     try {
-	auto stream = getAssetLocator ().read (m_text.font);
+	auto stream = getAssetLocator ().read (font);
 	stream->seekg (0, std::ios::end);
 	const auto size = stream->tellg ();
 	stream->seekg (0, std::ios::beg);
@@ -246,18 +265,18 @@ bool CText::loadEmbeddedFont () {
 	    return true;
 	}
 
-	sLog.error ("CText: FT_New_Memory_Face failed for '", m_text.font, "', falling back to system font");
+	sLog.error ("CText: FT_New_Memory_Face failed for '", font, "', falling back to system font");
     } catch (const std::exception& e) {
-	sLog.error ("CText: cannot read font '", m_text.font, "': ", e.what (), ", falling back to system font");
+	sLog.error ("CText: cannot read font '", font, "': ", e.what (), ", falling back to system font");
     }
 
     m_fontData.clear ();
     return false;
 }
 
-bool CText::loadSystemFont () {
+bool CText::loadSystemFont (const std::string& font) {
     std::string fontPath;
-    for (const auto* candidates : { &systemFontCandidates (m_text.font), &kFontCandidates }) {
+    for (const auto* candidates : { &systemFontCandidates (font), &kFontCandidates }) {
 	for (const auto& candidate : *candidates) {
 	    if (fontPath.empty () && std::filesystem::exists (candidate)) {
 		fontPath = candidate;
@@ -337,9 +356,11 @@ void CText::rebuildTextureFrom (const std::string& text) {
     const int height = std::max (1, maxAscent + maxDescent + lineHeight * (lineCount - 1));
     std::vector<uint8_t> pixels (static_cast<size_t> (width) * height, 0);
 
+    const std::string& alignment = m_horizontalAlign->getString ();
+
     for (int index = 0; index < lineCount; ++index) {
 	const int slack = width - lineWidths [index];
-	int penX = m_text.alignment == "left" ? 0 : m_text.alignment == "right" ? slack : slack / 2;
+	int penX = alignment == "left" ? 0 : alignment == "right" ? slack : slack / 2;
 	const int baseline = maxAscent + lineHeight * index;
 
 	for (const char32_t c : lines [index]) {
@@ -385,6 +406,7 @@ void CText::rebuildTextureFrom (const std::string& text) {
     m_textureSize = { width, height };
     m_quadSize = { static_cast<float> (width), static_cast<float> (height) };
     m_lastRenderedText = text;
+    m_rasterizedAlignment = alignment;
     m_canvasDirty = true;
 
     uploadQuadVertices ();
@@ -480,11 +502,21 @@ void CText::render () {
     const std::string renderedText = current.empty () ? std::string (" ") : current;
 
     const unsigned int pixelSize = computeEffectivePixelSize ();
-    if (pixelSize != m_lastPixelSize) {
+    const bool fontChanged = m_font->getString () != m_loadedFont;
+
+    if (fontChanged && !loadFont (m_font->getString ())) {
+	m_valid = false;
+#if !NDEBUG
+	glPopDebugGroup ();
+#endif /* DEBUG */
+	return;
+    }
+
+    if (fontChanged || pixelSize != m_lastPixelSize) {
 	m_lastPixelSize = pixelSize;
 	FT_Set_Pixel_Sizes (m_ftFace, 0, static_cast<FT_UInt> (m_lastPixelSize));
 	rebuildTextureFrom (renderedText);
-    } else if (renderedText != m_lastRenderedText) {
+    } else if (renderedText != m_lastRenderedText || m_horizontalAlign->getString () != m_rasterizedAlignment) {
 	rebuildTextureFrom (renderedText);
     }
 
@@ -551,9 +583,13 @@ void CText::render () {
 glm::vec3 CText::alignmentPivot () const {
     // the alignment says which point of the text sits on the origin: a left-aligned label starts
     // there and a right-aligned date ends there, whatever the text grows to (the quad's -y is the top)
+    const auto offset = [] (const std::string& alignment, const char* start, const char* end, float extent) {
+	return alignment == start ? extent * 0.5f : alignment == end ? -extent * 0.5f : 0.0f;
+    };
+
     return {
-	m_text.alignment == "left" ? m_quadSize.x * 0.5f : m_text.alignment == "right" ? -m_quadSize.x * 0.5f : 0.0f,
-	m_text.verticalalign == "top" ? m_quadSize.y * 0.5f : m_text.verticalalign == "bottom" ? -m_quadSize.y * 0.5f : 0.0f,
+	offset (m_horizontalAlign->getString (), "left", "right", m_quadSize.x),
+	offset (m_verticalAlign->getString (), "top", "bottom", m_quadSize.y),
 	0.0f,
     };
 }
@@ -562,9 +598,11 @@ glm::ivec2 CText::canvasSize () const {
     const float rasterToScene = scenePixelSize () / static_cast<float> (std::max (m_lastPixelSize, 1u));
     const glm::vec2 size = m_quadSize * rasterToScene;
     // the canvas is centred on the anchor, so a text with an edge on it reaches the whole way to one side
+    const std::string& horizontal = m_horizontalAlign->getString ();
+    const std::string& vertical = m_verticalAlign->getString ();
     const glm::vec2 reach = {
-	m_text.alignment == "left" || m_text.alignment == "right" ? size.x : size.x * 0.5f,
-	m_text.verticalalign == "top" || m_text.verticalalign == "bottom" ? size.y : size.y * 0.5f,
+	horizontal == "left" || horizontal == "right" ? size.x : size.x * 0.5f,
+	vertical == "top" || vertical == "bottom" ? size.y : size.y * 0.5f,
     };
 
     return glm::ivec2 (glm::ceil ((reach + m_text.padding) * 2.0f));
