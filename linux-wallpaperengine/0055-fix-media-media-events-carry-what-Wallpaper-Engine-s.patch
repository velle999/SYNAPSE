-void DBusMediaSource::parseMetadata (DBusMessageIter& variant) {
+namespace {
+/** The first string of an MPRIS string list (xesam:artist and the like), or "" */
+std::string firstString (DBusMessageIter& value) {
+    if (dbus_message_iter_get_arg_type (&value) != DBUS_TYPE_ARRAY) {
+	return "";
+    }
+
+    DBusMessageIter arr;
+    dbus_message_iter_recurse (&value, &arr);
+
+    if (dbus_message_iter_get_arg_type (&arr) != DBUS_TYPE_STRING) {
+	return "";
+    }
+
+    const char* first = nullptr;
+    dbus_message_iter_get_basic (&arr, &first);
+    return first ?: "";
+}
+
+/** Every string of an MPRIS string list, separated by ", " */
+std::string joinedStrings (DBusMessageIter& value) {
+    if (dbus_message_iter_get_arg_type (&value) != DBUS_TYPE_ARRAY) {
+	return "";
+    }
+
+    DBusMessageIter arr;
+    dbus_message_iter_recurse (&value, &arr);
+    std::string result;
+
+    while (dbus_message_iter_get_arg_type (&arr) == DBUS_TYPE_STRING) {
+	const char* item = nullptr;
+	dbus_message_iter_get_basic (&arr, &item);
+
+	if (item != nullptr && *item != '\0') {
+	    if (!result.empty ()) {
+		result += ", ";
+	    }
+	    result += item;
+	}
+
+	dbus_message_iter_next (&arr);
+    }
+
+    return result;
+}
+
+/** Stores `next` into `field`, and says whether that changed it */
+template <typename T> bool assign (T& field, const T& next) {
+    if (field == next) {
+	return false;
+    }
+
+    field = next;
+    return true;
+}
+} // namespace
