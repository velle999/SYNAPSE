index 00000000..612add5a
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/MediaMetadata.cpp
@@ -0,0 +1,150 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <initializer_list>
+#include <string>
+
+#include <dbus/dbus.h>
+
+#include "WallpaperEngine/Media/DBusMediaSource.h"
+
+using WallpaperEngine::Media::DBusMediaSource;
+using WallpaperEngine::Media::MediaSource;
+
+namespace {
+/** A Metadata dictionary as an MPRIS player sends it, built without a bus to send it on */
+class Metadata {
+public:
+    Metadata () :
+	m_message (
+	    dbus_message_new_signal ("/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "PropertiesChanged")
+	) {
+	dbus_message_iter_init_append (this->m_message, &this->m_args);
+	dbus_message_iter_open_container (&this->m_args, DBUS_TYPE_ARRAY, "{sv}", &this->m_dict);
+    }
+
+    Metadata (const Metadata&) = delete;
+    Metadata& operator= (const Metadata&) = delete;
+
+    ~Metadata () { dbus_message_unref (this->m_message); }
+
+    Metadata& string (const char* key, const char* value) {
+	DBusMessageIter entry, variant;
+	this->open (key, "s", entry, variant);
+	dbus_message_iter_append_basic (&variant, DBUS_TYPE_STRING, &value);
+	this->close (entry, variant);
+	return *this;
+    }
+
+    Metadata& strings (const char* key, std::initializer_list<const char*> values) {
+	DBusMessageIter entry, variant, list;
+	this->open (key, "as", entry, variant);
+	dbus_message_iter_open_container (&variant, DBUS_TYPE_ARRAY, "s", &list);
+	for (const char* value : values) {
+	    dbus_message_iter_append_basic (&list, DBUS_TYPE_STRING, &value);
+	}
+	dbus_message_iter_close_container (&variant, &list);
+	this->close (entry, variant);
+	return *this;
+    }
+
+    Metadata& int64 (const char* key, int64_t value) {
+	DBusMessageIter entry, variant;
+	this->open (key, "x", entry, variant);
+	dbus_message_iter_append_basic (&variant, DBUS_TYPE_INT64, &value);
+	this->close (entry, variant);
+	return *this;
+    }
+
+    /** Reads the dictionary into `info`, as a PropertiesChanged signal's Metadata is read */
+    DBusMediaSource::MetadataChanges readInto (MediaSource::MediaInfo& info) {
+	if (!this->m_closed) {
+	    dbus_message_iter_close_container (&this->m_args, &this->m_dict);
+	    this->m_closed = true;
+	}
+
+	DBusMessageIter read;
+	dbus_message_iter_init (this->m_message, &read);
+	return DBusMediaSource::readMetadata (read, info);
+    }
+
+private:
+    void open (const char* key, const char* signature, DBusMessageIter& entry, DBusMessageIter& variant) {
+	dbus_message_iter_open_container (&this->m_dict, DBUS_TYPE_DICT_ENTRY, nullptr, &entry);
+	dbus_message_iter_append_basic (&entry, DBUS_TYPE_STRING, &key);
+	dbus_message_iter_open_container (&entry, DBUS_TYPE_VARIANT, signature, &variant);
+    }
+
+    void close (DBusMessageIter& entry, DBusMessageIter& variant) {
+	dbus_message_iter_close_container (&entry, &variant);
+	dbus_message_iter_close_container (&this->m_dict, &entry);
+    }
+
+    DBusMessage* m_message;
+    DBusMessageIter m_args {};
+    DBusMessageIter m_dict {};
+    bool m_closed = false;
+};
+
+MediaSource::MediaInfo nothingPlaying () {
+    return {
+	.playbackState = MediaSource::Stopped,
+	.duration = 0.0,
+	.position = 0.0,
+	.available = false,
+    };
+}
+} // namespace
+
+TEST_CASE ("A player's times reach scripts in seconds") {
+    auto info = nothingPlaying ();
+
+    // a 3:35.5 track: MPRIS counts microseconds, and a script formats minutes from seconds
+    Metadata ().int64 ("mpris:length", 215500000).readInto (info);
+
+    CHECK (info.duration == 215.5);
+    CHECK (DBusMediaSource::toSeconds (83000000) == 83.0);
+    CHECK (DBusMediaSource::toSeconds (0) == 0.0);
+}
+
+TEST_CASE ("A player's metadata carries its album artist and genres") {
+    auto info = nothingPlaying ();
+
+    Metadata ()
+	.string ("xesam:title", "Harder, Better, Faster, Stronger")
+	.strings ("xesam:artist", { "Daft Punk", "Kanye West" })
+	.strings ("xesam:albumArtist", { "Daft Punk" })
+	.strings ("xesam:genre", { "Electronic", "", "House" })
+	.string ("xesam:album", "Discovery")
+	.readInto (info);
+
+    CHECK (info.title == "Harder, Better, Faster, Stronger");
+    CHECK (info.artist == "Daft Punk");
+    CHECK (info.albumArtist == "Daft Punk");
+    CHECK (info.genres == "Electronic, House");
+    CHECK (info.album == "Discovery");
+}
+
+TEST_CASE ("Reading a player's metadata says what it changed") {
+    auto info = nothingPlaying ();
+
+    auto changes = Metadata ().string ("xesam:title", "One More Time").readInto (info);
+    CHECK (changes.metadata);
+    CHECK_FALSE (changes.albumArt);
+
+    changes = Metadata ().string ("xesam:title", "One More Time").readInto (info);
+    CHECK_FALSE (changes.metadata);
+
+    changes = Metadata ().strings ("xesam:albumArtist", { "Daft Punk" }).readInto (info);
+    CHECK (changes.metadata);
+
+    changes = Metadata ().string ("xesam:album", "Discovery").readInto (info);
+    CHECK_FALSE (changes.metadata);
+    CHECK (changes.albumArt);
+
+    // a track without an artist does not keep the last one's
+    info.artist = "Daft Punk";
+    changes = Metadata ().strings ("xesam:artist", {}).readInto (info);
+    CHECK (changes.metadata);
+    CHECK (info.artist.empty ());
+}
