+JSValue EngineObject::registerAudioBuffers (int resolution) {
+    JSContext* ctx = this->m_engine.getContext ();
+    // the capture keeps 16, 32 and 64 band spectrums
+    AudioBuffers buffers { .resolution = resolution <= 16 ? 16 : resolution <= 32 ? 32 : 64 };
+    JSValue length = JS_NewInt32 (ctx, buffers.resolution);
+    JSValue result = JS_NewObject (ctx);
+
+    const std::pair<const char*, JSValue*> arrays [] = {
+	{ "left", &buffers.left }, { "right", &buffers.right }, { "average", &buffers.average }
+    };
+
+    for (const auto& [name, array] : arrays) {
+	*array = JS_NewTypedArray (ctx, 1, &length, JS_TYPED_ARRAY_FLOAT32);
+
+	if (JS_IsException (*array)) {
+	    JS_FreeValue (ctx, buffers.left);
+	    JS_FreeValue (ctx, buffers.right);
+	    JS_FreeValue (ctx, result);
+	    return JS_EXCEPTION;
+	}
+
+	JS_SetPropertyStr (ctx, result, name, JS_DupValue (ctx, *array));
+    }
+
+    this->fillAudioBuffers (buffers);
+    this->m_audioBuffers.push_back (buffers);
+
+    return result;
+}
+
+void EngineObject::fillAudioBuffers (const AudioBuffers& buffers) const {
+    JSContext* ctx = this->m_engine.getContext ();
+    const auto& recorder = this->m_scene.getAudioContext ().getRecorder ();
+    const float* spectrum = buffers.resolution == 16 ? recorder.audio16
+	: buffers.resolution == 32		     ? recorder.audio32
+						     : recorder.audio64;
+
+    // the capture is mono, so left, right and average are the same, as the shaders get them
+    for (const JSValue array : { buffers.left, buffers.right, buffers.average }) {
+	size_t offset = 0, length = 0, elementSize = 0, size = 0;
+	JSValue buffer = JS_GetTypedArrayBuffer (ctx, array, &offset, &length, &elementSize);
+
+	if (JS_IsException (buffer)) {
+	    JS_FreeValue (ctx, JS_GetException (ctx));
+	    continue;
+	}
+
+	uint8_t* bytes = JS_GetArrayBuffer (ctx, &size, buffer);
+
+	// a script may have detached or resized the array; leave it alone then
+	if (bytes != nullptr && length == buffers.resolution * sizeof (float) && offset + length <= size) {
+	    auto* values = reinterpret_cast<float*> (bytes + offset);
+
+	    for (int i = 0; i < buffers.resolution; i++) {
+		values [i] = std::isfinite (spectrum [i]) ? spectrum [i] : 0.0f;
+	    }
+	}
+
+	JS_FreeValue (ctx, buffer);
+    }
+}
+
 void EngineObject::tick () {
     const auto now = std::chrono::steady_clock::now ();
 
+    for (const auto& buffers : this->m_audioBuffers) {
+	this->fillAudioBuffers (buffers);
+    }
+
     // check any interval and run them if needed
     for (auto& timeout : this->m_intervals | std::views::values) {
 	if (timeout.next > now) {
