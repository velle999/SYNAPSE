+// engine.registerAudioBuffers (engine.AUDIO_RESOLUTION_16): the audio spectrum as arrays
+// the engine refills before every update ()
+JSValue engine_register_audio_buffers (JSContext* ctx, JSValueConst this_val, int argc, JSValueConst* argv) {
+    JSClassID classId = 0;
+    auto* engine = static_cast<EngineObject*> (JS_GetAnyOpaque (this_val, &classId));
+
+    if (engine == nullptr) {
+	return JS_ThrowTypeError (ctx, "registerAudioBuffers called on something that is not the engine");
+    }
+
+    int32_t resolution = 16;
+
+    if (argc > 0 && JS_ToInt32 (ctx, &resolution, argv [0]) < 0) {
+	return JS_EXCEPTION;
+    }
+
+    return engine->registerAudioBuffers (resolution);
+}
