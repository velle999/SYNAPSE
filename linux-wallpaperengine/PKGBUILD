# CEF is a ~1.3 GB unstripped blob fetched by cmake at configure time (it lands
# in build/cef/, NOT in SRCDEST), so a clean build needs the network and about
# 6 GB of scratch. makepkg's default strip takes libcef.so down to ~219 MB.
#
# Everything the renderer loads at runtime has to sit next to the executable —
# CEF resolves icudtl.dat, the .pak files and locales/ relative to the binary —
# so the whole payload goes in /usr/lib/$pkgname and /usr/bin gets a wrapper.
# It is NOT /opt: this distro has no alpm ldconfig hook, so packaged libraries
# belong under /usr/lib.
_libdir=/usr/lib/$pkgname

prepare() {
    cd "$srcdir/$pkgname"

    # makepkg keeps src/ between runs and resets this clone with `git checkout
    # --force`, which restores tracked files and nothing else. A file a patch
    # ADDED is untracked, so it survives, and the next run's `git apply` refuses
    # to create it again ("already exists in working directory"). Submodules are
    # not reset at all, so the glslang patch, already applied, no longer applies.
    # Every build after the first in the same checkout — which is every update
    # through /var/lib/synapse-src — died here. Put the clone and every
    # submodule back to their pinned commits before patching.
    #
    # `-fd`, not `-fdx`: build/ is ignored, and is dealt with below.
    git clean -fdq
    git submodule update --init --recursive --depth 1 --force
    git submodule foreach --recursive --quiet 'git clean -fdq'

    # A build/ kept from the last run is stale in a way make cannot see. Right
    # after prepare(), makepkg stamps every file under $srcdir with
    # SOURCE_DATE_EPOCH (build-all.sh sets it), build/ included, so a patched
    # source and the object compiled from the old one share an mtime and the
    # object is never rebuilt. pkgrel 17 built that way on an update: it kept
    # glslang from pkgrel 14, without its patch, and check() failed. Start
    # build/ fresh every time. Keep build/cef: it holds only the CEF tarball
    # (~370 MB) and its unpacked copy, nothing compiled, and cmake reuses both
    # instead of downloading again.
    if [ -d build ]; then
        find build -mindepth 1 -maxdepth 1 ! -name cef -exec rm -rf {} +
    fi

    # `git apply`, not `git am`: am commits, and so needs a committer identity
    # the ISO's unprivileged build user does not have (see fetch/PKGBUILD). It
    # still fails loudly on a patch that no longer applies, which is the signal
    # to drop one upstream has merged.
    local p
    for p in "$srcdir"/0*.patch; do
        git apply -v "$p"
    done

    # Patches to the glslang fork are commits of that repository, exported from
    # it, so their paths are relative to the submodule and they apply from
    # inside it.
    for p in "$srcdir"/glslang-*.patch; do
        git -C src/External/glslang-WallpaperEngine apply -v "$p"
    done
}

build() {
    cd "$srcdir/$pkgname"

    # CEF's bundled cmake compiles libcef_dll_wrapper with -Werror AND its own
    # "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2". makepkg.conf hardening adds
    # -D_FORTIFY_SOURCE=3 on top, and the redefinition is a warning, which
    # -Werror turns into a hard build failure. Drop ours and let CEF pick.
    CFLAGS="${CFLAGS//-Wp,-D_FORTIFY_SOURCE=[0-9]/}"
    CXXFLAGS="${CXXFLAGS//-Wp,-D_FORTIFY_SOURCE=[0-9]/}"
    CPPFLAGS="${CPPFLAGS//-D_FORTIFY_SOURCE=[0-9]/}"
    CFLAGS="${CFLAGS//-D_FORTIFY_SOURCE=[0-9]/}"
    CXXFLAGS="${CXXFLAGS//-D_FORTIFY_SOURCE=[0-9]/}"
    export CFLAGS CXXFLAGS CPPFLAGS

    # Passed explicitly, not just exported: a build/ left over from a previous
    # makepkg run carries the old flags in CMakeCache.txt, and cmake prefers
    # the cache over the environment — so an env-only fix silently does
    # nothing on a rebuild. -D updates the cache entry itself.
    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_C_FLAGS="$CFLAGS" \
        -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
        -DCEF_NO_SANDBOX=OFF \
        -DBUILD_TESTING=ON
    cmake --build build -j"$(nproc)"
}

# CEF_NO_SANDBOX=OFF turns Chromium's sandbox ON. Through pkgrel 14 the engine
# hard-coded settings.no_sandbox = true, so every web wallpaper, which is
# third-party Workshop content, ran with no sandbox at all. #687 makes that a
# build option and defaults it to no sandbox, for systems without a working
# one; here the user-namespace sandbox works (see chrome-sandbox below): a
# web wallpaper's renderers run under seccomp-bpf, each in a PID namespace of
# its own, and its GPU and utility processes under seccomp-bpf.
#
# The tests cover the color, property, value, JSON, web-property and local-file
# handling the patches change, the texture and timeline animation clocks, and
# the HLSL habits the shader compiler accepts (which exercises the glslang
# patch too), and need no display or GPU. BUILD_TESTING compiles the engine's
# sources a second time for them.
check() {
    cd "$srcdir/$pkgname"
    build/output/tests
}

package() {
    # Stage through upstream's install() rather than copying out of build/output
    # directly. Those two are NOT the same files: build/output holds the linked
    # artifacts with their build-time RUNPATH — absolute $srcdir paths — and
    # install(TARGETS) is where cmake rewrites that to $ORIGIN. Copying from
    # build/output skipped the rewrite entirely, and the result only worked on
    # the machine that built it.
    #
    # It is not a tidiness matter. CEF resolves icudtl.dat, the .pak files and
    # locales/ relative to WHERE libcef.so WAS LOADED FROM, so a binary that
    # finds libcef back in build/cef/.../Release/ — which holds the .so files and
    # none of the data — gets no ICU data. Chromium then tries to LOG that
    # failure, and its logger reenters the sandbox's localtime hook through
    # pthread_once and deadlocks against itself: the engine hangs before drawing
    # a frame, forever, silently. That is half of "web wallpapers are black".
    #
    # The stage also carries the submodule test binaries (qjs, glslang, spirv-*,
    # api-test) and an include/ tree; the curated list below is what ships.
    local stage="$srcdir/_stage"
    rm -rf "$stage"
    cmake --install "$srcdir/$pkgname/build" --prefix "$stage"
    cd "$stage"

    install -d "$pkgdir$_libdir"

    # The executable plus the shared objects and CEF data files it needs. The
    # rest of the stage is submodule test/benchmark binaries (qjs, glslang,
    # spirv-*, api-test) and static archives that nothing at runtime touches.
    install -Dm755 linux-wallpaperengine "$pkgdir$_libdir/linux-wallpaperengine"

    local so
    for so in liblinux-wallpaperengine-lib.so libcef.so libEGL.so libGLESv2.so \
              libvk_swiftshader.so; do
        install -Dm755 "$so" "$pkgdir$_libdir/$so"
    done

    # kissfft (the audio-reactive FFT) is built as a submodule and lands in
    # lib/, not beside the executable. It used to be reachable only because the
    # binary carried a RUNPATH into the build tree — which is exactly the thing
    # that had to go, so it has to actually ship now. lib/ and not flat: the
    # RUNPATH cmake writes is "$ORIGIN:$ORIGIN/lib:$ORIGIN/lib64", so keeping
    # upstream's layout is what makes it resolve. cp -a to keep the SONAME
    # symlink; there is no ldconfig hook here to recreate it.
    install -d "$pkgdir$_libdir/lib"
    cp -a lib/libkissfft-float.so* "$pkgdir$_libdir/lib/"

    local data
    for data in chrome_100_percent.pak chrome_200_percent.pak resources.pak \
                icudtl.dat v8_context_snapshot.bin vk_swiftshader_icd.json; do
        install -Dm644 "$data" "$pkgdir$_libdir/$data"
    done

    cp -a locales "$pkgdir$_libdir/locales"
    find "$pkgdir$_libdir/locales" -type f -exec chmod 644 {} +

    # chrome-sandbox ships NON-setuid deliberately. Chromium's setuid helper is
    # only needed where unprivileged user namespaces are off; they are on here,
    # so the namespace sandbox covers it and the package stays free of setuid
    # root binaries.
    install -Dm755 chrome-sandbox "$pkgdir$_libdir/chrome-sandbox"

    # Wrapper: CEF resolves its siblings relative to the process, so cd first.
    # __GL_THREADED_OPTIMIZATIONS=0 is upstream's documented NVIDIA workaround.
    #
    # LD_PRELOAD of libcef.so is not belt-and-braces, it is load ORDER. Chromium
    # interposes close() (base/files/scoped_file_linux.cc) and recovers the real
    # one with dlsym(RTLD_NEXT, "close"), which only searches objects loaded
    # AFTER libcef. Reached through liblinux-wallpaperengine-lib.so, libcef is a
    # second-level dependency and lands after libc, so the lookup finds nothing
    # and Chromium IMMEDIATE_CRASHes with "close symbol missing" the moment a
    # web wallpaper calls CefInitialize. Preloading puts libcef ahead of libc
    # and CEF starts normally. Harmless for scene/video wallpapers, which never
    # touch CEF at all.
    install -d "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/linux-wallpaperengine" <<EOF
#!/bin/sh
cd "$_libdir" || exit 1
export __GL_THREADED_OPTIMIZATIONS=\${__GL_THREADED_OPTIMIZATIONS:-0}
export LD_PRELOAD="$_libdir/libcef.so\${LD_PRELOAD:+:\$LD_PRELOAD}"
exec "$_libdir/linux-wallpaperengine" "\$@"
EOF
    chmod 755 "$pkgdir/usr/bin/linux-wallpaperengine"


    install -Dm644 "$srcdir/$pkgname/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # CEF's licence, which is a REDISTRIBUTION obligation and not a courtesy.
    #
    # This package ships libcef.so plus Chromium's .pak data, icudtl.dat and the
    # whole locales/ tree — that is a binary redistribution of CEF and Chromium,
    # both BSD-3-Clause, whose second clause requires reproducing the copyright
    # notice and disclaimer "in the documentation and/or other materials
    # provided with the distribution". Upstream's own LICENSE covers Almamu's
    # GPL-3.0 code and says nothing about the blob, so for twelve pkgrels this
    # package shipped ~219 MB of CEF with no notice at all.
    #
    # Located rather than hardcoded: cmake fetches CEF at configure time and the
    # extracted directory carries the CEF version in its name, so a fixed path
    # would silently stop matching on the next bump — which is exactly how the
    # notice would go missing again without anyone noticing.
    local _ceflic
    _ceflic=$(find "$srcdir/$pkgname/build" -maxdepth 4 -name 'LICENSE.txt' \
                   -path '*cef*' -print -quit 2>/dev/null)
    if [ -n "$_ceflic" ]; then
        install -Dm644 "$_ceflic" \
            "$pkgdir/usr/share/licenses/$pkgname/LICENSE.cef"
    else
        # Loud, because the failure this replaces was silent. A package that
        # redistributes CEF without its notice should not build quietly.
        echo "ERROR: shipping libcef.so but found no CEF LICENSE.txt under build/" >&2
        echo "       Redistributing CEF/Chromium requires its notice. Find the" >&2
        echo "       file in the fetched CEF tree and fix the search above." >&2
        return 1
    fi

    # HARD check, not the makepkg warning. A RUNPATH into $srcdir does not fail
    # the build and does not fail on THIS machine — the build tree is still
    # there, so it silently loads the 1.4 GB unstripped libcef out of it and
    # takes the resource directory with it. It only breaks on every other
    # machine, i.e. on the ISO. Fail here instead of shipping that.
    local elf
    for elf in "$pkgdir$_libdir/linux-wallpaperengine" \
               "$pkgdir$_libdir/liblinux-wallpaperengine-lib.so"; do
        local rp
        rp=$(readelf -d "$elf" | sed -n 's/.*R\(UN\)\?PATH.*\[\(.*\)\]/\2/p')
        case "$rp" in
            *"$srcdir"*|*/home/*|*/build/*)
                error "RUNPATH of ${elf#$pkgdir} leaks the build tree: $rp"
                return 1 ;;
        esac

        # And the other half of the same lesson: that build-tree RUNPATH was
        # LOAD-BEARING — it was the only thing resolving libkissfft, which lives
        # in lib/ and was never packaged. Dropping the RUNPATH without noticing
        # turned every wallpaper into "engine exits instantly". A missing
        # library is not a warning here, it is a package that cannot run.
        # `|| true` because package() runs under set -e and grep exits 1 when it
        # finds nothing — i.e. exactly on success.
        local missing
        missing=$(cd "$pkgdir$_libdir" && ldd "$elf" 2>/dev/null | grep 'not found') || true
        if [ -n "$missing" ]; then
            error "${elf#$pkgdir} has unresolved libraries:"$'\n'"$missing"
            return 1
        fi
    done
}
