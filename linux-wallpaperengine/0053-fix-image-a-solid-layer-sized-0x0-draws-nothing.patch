+#include <catch2/catch_test_macros.hpp>
+
+#include <memory>
+
+#include "WallpaperEngine/Assets/AssetLocator.h"
+#include "WallpaperEngine/Data/Model/Object.h"
+#include "WallpaperEngine/Data/Model/Project.h"
+#include "WallpaperEngine/Data/Model/Wallpaper.h"
+#include "WallpaperEngine/Data/Parsers/ObjectParser.h"
+#include "WallpaperEngine/FileSystem/Container.h"
+
+using WallpaperEngine::Assets::AssetLocator;
+using WallpaperEngine::Data::JSON::JSON;
+using WallpaperEngine::Data::Model::Image;
+using WallpaperEngine::Data::Model::Project;
+using WallpaperEngine::Data::Parsers::ObjectParser;
+using WallpaperEngine::FileSystem::Container;
+
+namespace {
+// a project whose assets hold the solid layer model the editor gives a solid color layer
+Project projectWithSolidLayer () {
+    auto container = std::make_unique<Container> ();
+
+    container->getVFS ().add (
+	"models/util/solidlayer.json",
+	JSON { { "material", "materials/util/solidlayer.json" }, { "solidlayer", true } }
+    );
+    container->getVFS ().add (
+	"materials/util/solidlayer.json", JSON { { "passes", JSON::array ({ { { "shader", "genericimage2" } } }) } }
+    );
+
+    Project project {};
+    project.assetLocator = std::make_unique<AssetLocator> (std::move (container));
+    return project;
+}
+
+// the shape of the layer a music player widget keeps its scripts on
+JSON playerOptions () {
+    return {
+	{ "id", 83923 },
+	{ "name", "Player Options" },
+	{ "image", "models/util/solidlayer.json" },
+	{ "origin", "960.00000 540.00000 0.00000" },
+	{ "size", "0.00000 0.00000" },
+	{ "solid", false },
+	{ "visible", { { "script", "export function init (value) { return value; }" }, { "value", true } } },
+    };
+}
+
+const Image& asImage (const std::unique_ptr<WallpaperEngine::Data::Model::Object>& object) {
+    REQUIRE (object != nullptr);
+    REQUIRE (object->is<Image> ());
+    return *object->as<Image> ();
+}
+} // namespace
+
+TEST_CASE ("A solid layer sized 0x0 is told apart from one without a size") {
+    const auto project = projectWithSolidLayer ();
+    const auto sizedObject = ObjectParser::parse (playerOptions (), project);
+    const auto& sized = asImage (sizedObject);
+
+    CHECK (sized.model->solidlayer);
+    CHECK (sized.sized);
+    CHECK (sized.size.x == 0.0f);
+    CHECK (sized.size.y == 0.0f);
+
+    JSON layer = playerOptions ();
+    layer.erase ("size");
+    const auto unsizedObject = ObjectParser::parse (layer, project);
+    const auto& unsized = asImage (unsizedObject);
+
+    CHECK (unsized.model->solidlayer);
+    CHECK_FALSE (unsized.sized);
+    CHECK (unsized.size.x == 0.0f);
+    CHECK (unsized.size.y == 0.0f);
+}
+
+TEST_CASE ("A solid layer keeps the size the scene gives it") {
+    const auto project = projectWithSolidLayer ();
+    JSON layer = playerOptions ();
+    layer ["size"] = "1920.00000 64.00000";
+
+    const auto object = ObjectParser::parse (layer, project);
+    const auto& image = asImage (object);
+
+    CHECK (image.sized);
+    CHECK (image.size.x == 1920.0f);
+    CHECK (image.size.y == 64.0f);
+}
