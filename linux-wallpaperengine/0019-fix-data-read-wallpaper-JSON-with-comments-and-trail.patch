index 2016d393..b31cb75c 100644
--- a/src/WallpaperEngine/Data/JSON.cpp
+++ b/src/WallpaperEngine/Data/JSON.cpp
@@ -2,6 +2,9 @@
 
 #include "WallpaperEngine/Data/Parsers/UserSettingParser.h"
 
+#include <algorithm>
+#include <cctype>
+
 using namespace WallpaperEngine::Data::JSON;
 using namespace WallpaperEngine::Data::Model;
 using namespace WallpaperEngine::Data::Parsers;
@@ -17,3 +20,71 @@ UserSettingUniquePtr JsonExtensions::color (const std::string& key, const Proper
 
