diff --git a/src/WallpaperEngine/Testing/Cases/LenientJson.cpp b/src/WallpaperEngine/Testing/Cases/LenientJson.cpp
new file mode 100644
index 00000000..df64f0bf
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/LenientJson.cpp
@@ -0,0 +1,61 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <string>
+
+#include "WallpaperEngine/Data/JSON.h"
+
+using WallpaperEngine::Data::JSON::JSON;
+using WallpaperEngine::Data::JSON::parseLenient;
+
+TEST_CASE ("Wallpaper JSON accepts trailing commas") {
+    // the shape of Wallpaper Engine's stock effects/fluidsimulation/effect.json
+    const auto parsed = parseLenient (R"({
+	"dependencies" :
+	[
+		"shaders/effects/fluidsimulation_normal.frag",
+		"shaders/effects/fluidsimulation_normal.vert",
+	],
+	"group" : "simulate",
+})");
+
+    CHECK (parsed ["dependencies"].size () == 2);
+    CHECK (parsed ["group"] == "simulate");
+    CHECK (parseLenient ("[1, 2, ]") == JSON::array ({ 1, 2 }));
+    CHECK (parseLenient ("{\"a\": [ { }, ] ,\n}") == JSON { { "a", JSON::array ({ JSON::object () }) } });
+}
+
+TEST_CASE ("Wallpaper JSON accepts comments") {
+    // stock effects carry commented-out keys
+    const auto parsed = parseLenient (R"({
+	"name" : "Tint",
+	//"preview" : "preview/project.json",
+	/* a block, with a comma, ] */ "group" : "colorize", // last one
+})");
+
+    CHECK (parsed == JSON { { "name", "Tint" }, { "group", "colorize" } });
+}
+
+TEST_CASE ("Wallpaper JSON strings are never rewritten") {
+    const std::string text = R"({"url": "http://example.com/a,]", "quote": "\",}", "slashes": "/* // */", "end": "a\\"})";
+    const auto parsed = parseLenient (text);
+
+    CHECK (parsed == JSON::parse (text));
+    CHECK (parsed ["url"] == "http://example.com/a,]");
+    CHECK (parsed ["quote"] == "\",}");
+    CHECK (parsed ["slashes"] == "/* // */");
+    CHECK (parsed ["end"] == "a\\");
+}
+
+TEST_CASE ("Wallpaper JSON that is broken still fails, on the file's own line") {
+    CHECK_THROWS (parseLenient ("{\"a\": }"));
+    CHECK_THROWS (parseLenient ("[1 2]"));
+    CHECK_THROWS (parseLenient ("{\"open\": \"never closed"));
+
+    try {
+	(void) parseLenient ("{\n/* one\n two */\n\"a\": nope\n}");
+	FAIL ("parsed broken JSON");
+    } catch (const JSON::parse_error& e) {
+	INFO (e.what ());
+	CHECK (std::string (e.what ()).find ("line 4") != std::string::npos);
+    }
+}
