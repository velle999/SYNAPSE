+
+namespace {
+/** Where the comment starting at text [i] ends, or i when no comment starts there */
+size_t commentEnd (const std::string_view text, const size_t i) {
+    if (text.compare (i, 2, "//") == 0) {
+	return std::min (text.find ('\n', i), text.size ());
+    }
+
+    if (text.compare (i, 2, "/*") == 0) {
+	const auto end = text.find ("*/", i + 2);
+	return end == std::string_view::npos ? text.size () : end + 2;
+    }
+
+    return i;
+}
+} // namespace
+
+JSON WallpaperEngine::Data::JSON::parseLenient (const std::string_view text) {
+    std::string cleaned;
+    cleaned.reserve (text.size ());
+
+    for (size_t i = 0; i < text.size (); i++) {
+	const char c = text [i];
+
+	if (c == '"') {
+	    // copied whole, escapes included, so a comma or slash inside one is never touched
+	    const size_t start = i;
+
+	    for (i++; i < text.size () && text [i] != '"'; i++) {
+		if (text [i] == '\\') {
+		    i++;
+		}
+	    }
+
+	    cleaned.append (text.substr (start, i - start + 1));
+	    continue;
+	}
+
+	if (const auto end = commentEnd (text, i); end != i) {
+	    // only the newlines are kept, so an error still reports the file's own line
+	    cleaned.append (static_cast<size_t> (std::ranges::count (text.substr (i, end - i), '\n')), '\n');
+	    i = end - 1;
+	    continue;
+	}
+
+	if (c == ',') {
+	    size_t next = i + 1;
+
+	    while (next < text.size ()) {
+		if (std::isspace (static_cast<unsigned char> (text [next]))) {
+		    next++;
+		} else if (const auto end = commentEnd (text, next); end != next) {
+		    next = end;
+		} else {
+		    break;
+		}
+	    }
+
+	    if (next < text.size () && (text [next] == ']' || text [next] == '}')) {
+		continue;
+	    }
+	}
+
+	cleaned += c;
+    }
+
+    return JSON::parse (cleaned);
+}
