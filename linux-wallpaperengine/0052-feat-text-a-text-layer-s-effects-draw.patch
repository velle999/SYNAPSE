+std::optional<JSON> ObjectParser::textComposite (const JSON& it) {
+    const auto effects = it.find ("effects");
+
+    if (effects == it.end () || !effects->is_array () || effects->empty ()) {
+	return std::nullopt;
+    }
+
+    JSON image = it;
+    const auto id = it.require<int> ("id", "Object must have an id");
+
+    image ["image"] = "models/wpenginelinux/text.json";
+    image ["instance"] = { { "textures", JSON::array ({ "_rt_textLayer_" + std::to_string (id) }) } };
+    // the canvas is centred on the point the text's alignment puts on the origin, and sized by it
+    image ["alignment"] = "center";
+    image.erase ("horizontalalign");
+    image.erase ("size");
+
+    for (const auto* key : { "origin", "scale", "angles", "alpha", "color", "visible" }) {
+	const auto value = image.find (key);
+
+	if (value == image.end () || !value->is_object ()) {
+	    continue;
+	}
+
+	if (const auto plain = value->find ("value"); plain != value->end ()) {
+	    *value = JSON (*plain);
+	} else {
+	    image.erase (key);
+	}
+    }
+
+    return image;
+}
+
 TextUniquePtr ObjectParser::parseText (const JSON& it, const Project& project, ObjectData base) {
+    ImageUniquePtr composite = nullptr;
+
+    // a text whose effects don't load still draws, without them
+    try {
+	if (const auto json = textComposite (it); json.has_value ()) {
+	    if (auto object = parse (*json, project); object != nullptr && object->is<Image> ()) {
+		composite.reset (static_cast<Image*> (object.release ()));
+	    }
+	}
+    } catch (const std::exception& e) {
+	sLog.error ("Text ", base.id, " draws without its effects: ", e.what ());
+    }
+
     return std::make_unique<Text> (
 	std::move (base),
 	TextData {
@@ -143,6 +190,7 @@ TextUniquePtr ObjectParser::parseText (const JSON& it, const Project& project, O
 	    .alignment = it.optional ("horizontalalign", it.optional ("alignment", std::string ("center"))),
