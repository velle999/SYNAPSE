+    glm::ivec2 m_canvasSize = { 0, 0 };
+    /** Whether the glyphs changed since they were drawn onto the canvas */
+    bool m_canvasDirty = true;
+    /** The color the glyphs on the canvas were drawn in */
+    glm::vec3 m_canvasColor = { 0.0f, 0.0f, 0.0f };
+
     bool m_valid = false;
 };
 } // namespace WallpaperEngine::Render::Objects
diff --git a/src/WallpaperEngine/Testing/Cases/TextComposite.cpp b/src/WallpaperEngine/Testing/Cases/TextComposite.cpp
new file mode 100644
index 00000000..3c48e70a
--- /dev/null
+++ b/src/WallpaperEngine/Testing/Cases/TextComposite.cpp
@@ -0,0 +1,92 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "WallpaperEngine/Data/Parsers/ObjectParser.h"
+
+using WallpaperEngine::Data::JSON::JSON;
+using WallpaperEngine::Data::Parsers::ObjectParser;
+
+namespace {
+// the shape of a clock in a workshop wallpaper: a script on the text, user settings on its looks
+JSON clockWithEffects () {
+    return {
+	{ "id", 97 },
+	{ "name", "Clock" },
+	{ "parent", 12 },
+	{ "text", { { "script", "export function update () { return '12:34'; }" }, { "value", "00:00" } } },
+	{ "horizontalalign", "left" },
+	{ "verticalalign", "center" },
+	{ "size", "1748.00000 508.00000" },
+	{ "padding", 32 },
+	{ "origin", { { "script", "export function update (value) { return value; }" }, { "value", "100 200 0" } } },
+	{ "scale", "2 2 1" },
+	{ "angles", { { "animation", { { "c0", JSON::array () } } }, { "value", "0 0 0.5" } } },
+	{ "color", { { "user", "colorclock" }, { "value", "0.5 0.25 1" } } },
+	{ "alpha", { { "user", "opacityclock" }, { "value", 0.75 } } },
+	{ "visible", { { "user", "showclock" }, { "value", true } } },
+	{ "brightness", 1.5 },
+	{ "effects",
+	  JSON::array ({ {
+	      { "file", "effects/workshop/2981960200/blurprecise/effect.json" },
+	      { "id", 98 },
+	      { "visible", { { "user", "clockblur" }, { "value", true } } },
+	      { "passes", JSON::array ({ { { "constantshadervalues", { { "scale", "1.28 1.28" } } } } }) },
+	  } }) },
+    };
+}
+} // namespace
+
+TEST_CASE ("A text without effects draws as text") {
+    JSON text = clockWithEffects ();
+
+    text.erase ("effects");
+    CHECK_FALSE (ObjectParser::textComposite (text).has_value ());
+
+    text ["effects"] = JSON::array ();
+    CHECK_FALSE (ObjectParser::textComposite (text).has_value ());
+}
+
+TEST_CASE ("A text with effects draws as an image of its own canvas") {
+    const auto image = ObjectParser::textComposite (clockWithEffects ());
+
+    REQUIRE (image.has_value ());
+    CHECK ((*image) ["image"] == "models/wpenginelinux/text.json");
+    CHECK ((*image) ["instance"] ["textures"] == JSON::array ({ "_rt_textLayer_97" }));
+    CHECK ((*image) ["id"] == 97);
+    CHECK ((*image) ["parent"] == 12);
+    // its effects are the text's, user settings and all
+    CHECK ((*image) ["effects"] == clockWithEffects () ["effects"]);
+}
+
+TEST_CASE ("The canvas sets the image's size and is centred on the text's anchor") {
+    const auto image = ObjectParser::textComposite (clockWithEffects ());
+
+    REQUIRE (image.has_value ());
+    CHECK ((*image) ["alignment"] == "center");
+    CHECK_FALSE (image->contains ("horizontalalign"));
+    CHECK_FALSE (image->contains ("size"));
+}
+
+TEST_CASE ("The values the text drives reach the image without their scripts") {
+    const auto image = ObjectParser::textComposite (clockWithEffects ());
+
+    REQUIRE (image.has_value ());
+    // a script, a timeline or a user setting stays with the text, which runs it once
+    CHECK ((*image) ["origin"] == "100 200 0");
+    CHECK ((*image) ["angles"] == "0 0 0.5");
+    CHECK ((*image) ["color"] == "0.5 0.25 1");
+    CHECK ((*image) ["alpha"] == 0.75);
+    CHECK ((*image) ["visible"] == true);
+    CHECK ((*image) ["scale"] == "2 2 1");
+    // what only an image has is its own
+    CHECK ((*image) ["brightness"] == 1.5);
+}
+
+TEST_CASE ("A text value without a plain value is left to the text") {
+    JSON text = clockWithEffects ();
+    text ["alpha"] = { { "user", "opacityclock" } };
+
+    const auto image = ObjectParser::textComposite (text);
+
+    REQUIRE (image.has_value ());
+    CHECK_FALSE (image->contains ("alpha"));
+}
