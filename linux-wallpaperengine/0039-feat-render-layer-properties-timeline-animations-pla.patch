diff --git a/src/WallpaperEngine/Data/Model/TimelineAnimation.h b/src/WallpaperEngine/Data/Model/TimelineAnimation.h
new file mode 100644
index 00000000..5d7cec3b
--- /dev/null
+++ b/src/WallpaperEngine/Data/Model/TimelineAnimation.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include <glm/vec2.hpp>
+
+namespace WallpaperEngine::Data::Model {
+/** One point on a timeline animation's curve, as the editor saves it */
+struct Keyframe {
+    float frame = 0.0f;
+    float value = 0.0f;
+    /**
+     * The curve's handles either side of the point: x in thirds of the segment they reach
+     * into, y in the property's own units. A handle that is not enabled leaves that end of
+     * the segment a straight line.
+     */
+    glm::vec2 back = {};
+    bool backEnabled = false;
+    glm::vec2 front = {};
+    bool frontEnabled = false;
+};
+
+/**
+ * A property's timeline animation: keyframes the editor stores on the value itself,
+ * `"alpha": { "value": 1, "animation": { "c0": [...], "options": {...} } }`.
+ */
+struct TimelineAnimation {
+    enum class Mode {
+	/** from the start again at the end */
+	Loop,
+	/** back and forth */
+	Mirror,
+	/** once, then holds the last frame */
+	Single,
+    };
+
+    std::string name;
+    float fps = 30.0f;
+    /** in frames; keyframes may lie past it, and are never reached */
+    float length = 0.0f;
+    Mode mode = Mode::Loop;
+    /** waits for a script to play () it */
+    bool startPaused = false;
+    /** the curve adds to the property's own value instead of replacing it */
+    bool relative = false;
+    /** one curve per component (c0, c1, c2, c3), each sorted by frame */
+    std::vector<std::vector<Keyframe>> channels;
+};
+} // namespace WallpaperEngine::Data::Model
