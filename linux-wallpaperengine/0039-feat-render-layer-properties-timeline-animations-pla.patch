diff --git a/src/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp b/src/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp
index 4a7ffb5c..0288cc1b 100644
--- a/src/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp
+++ b/src/WallpaperEngine/Data/Parsers/DynamicValueParser.cpp
@@ -5,6 +5,9 @@
 
 #include "UserSettingParser.h"
 #include "WallpaperEngine/Data/Model/DynamicValue.h"
+#include "WallpaperEngine/Data/Model/TimelineAnimation.h"
+
+#include <algorithm>
 
 using namespace WallpaperEngine::Data::Parsers;
 
@@ -28,6 +31,105 @@ bool isNumberList (const std::string& str) {
 
     return any;
 }
+
+// read by type, so a field the editor wrote some other way falls back instead of throwing
+float numberOr (const json& object, const char* key, float fallback) {
+    const auto it = object.find (key);
+
+    return it != object.end () && it->is_number () ? it->get<float> () : fallback;
+}
+
+bool flagOr (const json& object, const char* key, bool fallback) {
+    const auto it = object.find (key);
+
+    return it != object.end () && it->is_boolean () ? it->get<bool> () : fallback;
+}
+
+std::string textOr (const json& object, const char* key, const std::string& fallback) {
+    const auto it = object.find (key);
+
+    return it != object.end () && it->is_string () ? it->get<std::string> () : fallback;
+}
+
+/** One handle of a keyframe, its direction and whether the curve uses it */
+std::pair<glm::vec2, bool> parseHandle (const json& keyframe, const char* key) {
+    const auto it = keyframe.find (key);
+
+    if (it == keyframe.end () || !it->is_object ()) {
+	return { glm::vec2 (0.0f), false };
+    }
+
+    return { glm::vec2 (numberOr (*it, "x", 0.0f), numberOr (*it, "y", 0.0f)), flagOr (*it, "enabled", false) };
+}
+
+/** The timeline animation saved on a value, or nullptr when it has none that can play */
+std::shared_ptr<const TimelineAnimation> parseAnimation (const json& data) {
+    const auto animationIt = data.find ("animation");
+
+    if (animationIt == data.end () || !animationIt->is_object ()) {
+	return nullptr;
+    }
+
+    const auto& animation = *animationIt;
+    auto result = std::make_shared<TimelineAnimation> ();
+
+    if (const auto options = animation.find ("options"); options != animation.end () && options->is_object ()) {
+	const auto mode = textOr (*options, "mode", "loop");
+
+	result->name = textOr (*options, "name", "");
+	result->fps = numberOr (*options, "fps", 30.0f);
+	result->length = numberOr (*options, "length", 0.0f);
+	result->startPaused = flagOr (*options, "startpaused", false);
+	result->mode = mode == "mirror"	    ? TimelineAnimation::Mode::Mirror
+	    : mode == "single" ? TimelineAnimation::Mode::Single
+			       : TimelineAnimation::Mode::Loop;
+    }
+
+    result->relative = flagOr (animation, "relative", false);
+
+    // c0, c1, c2 and c3: one curve per component of the value
+    for (int channel = 0; channel < 4; channel++) {
+	const auto curve = animation.find ("c" + std::to_string (channel));
+
+	if (curve == animation.end () || !curve->is_array ()) {
+	    break;
+	}
+
+	auto& keyframes = result->channels.emplace_back ();
+
+	for (const auto& point : *curve) {
+	    if (!point.is_object ()) {
+		continue;
+	    }
+
+	    const auto [back, backEnabled] = parseHandle (point, "back");
+	    const auto [front, frontEnabled] = parseHandle (point, "front");
+
+	    keyframes.push_back (
+		Keyframe {
+		    .frame = numberOr (point, "frame", 0.0f),
+		    .value = numberOr (point, "value", 0.0f),
+		    .back = back,
+		    .backEnabled = backEnabled,
+		    .front = front,
+		    .frontEnabled = frontEnabled,
+		}
+	    );
+	}
+
+	std::ranges::stable_sort (keyframes, {}, &Keyframe::frame);
+    }
+
+    const bool anyKeyframes = std::ranges::any_of (result->channels, [] (const auto& keyframes) {
+	return !keyframes.empty ();
+    });
+
+    if (!anyKeyframes || result->fps <= 0.0f || result->length <= 0.0f) {
+	return nullptr;
+    }
+
+    return result;
+}
 } // namespace
 
 DynamicValueUniquePtr DynamicValueParser::parse (const json& data, const Properties& properties, bool expectColor) {
@@ -105,5 +207,9 @@ DynamicValueUniquePtr DynamicValueParser::parse (const json& data, const Propert
 	value->setScriptSource (scriptSource.value ());
     }
 
+    if (data.is_object ()) {
+	value->setAnimation (parseAnimation (data));
+    }
+
     return value;
 }
