diff --git a/src/WallpaperEngine/Render/PropertyAnimation.cpp b/src/WallpaperEngine/Render/PropertyAnimation.cpp
new file mode 100644
index 00000000..0087d226
--- /dev/null
+++ b/src/WallpaperEngine/Render/PropertyAnimation.cpp
@@ -0,0 +1,255 @@
+#include "PropertyAnimation.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+#include <utility>
+
+using namespace WallpaperEngine::Data::Model;
+using namespace WallpaperEngine::Render;
+
+namespace {
+float bezier (float p0, float p1, float p2, float p3, float t) {
+    const float u = 1.0f - t;
+
+    return u * u * u * p0 + 3.0f * u * u * t * p1 + 3.0f * u * t * t * p2 + t * t * t * p3;
+}
+} // namespace
+
+PropertyAnimation::PropertyAnimation (std::shared_ptr<const TimelineAnimation> timeline, DynamicValue& value) :
+    m_timeline (std::move (timeline)), m_value (value), m_base (value) { }
+
+void PropertyAnimation::apply (double now) {
+    this->start (now);
+
+    // a single animation stops on its last frame (or its first, played backwards)
+    if (this->m_playing && this->atEnd (this->position (now))) {
+	this->m_position = this->m_rate >= 0.0 ? this->m_timeline->length : 0.0;
+	this->m_since = now;
+	this->m_playing = false;
+    }
+
+    const auto frame = static_cast<float> (this->getFrame (now));
+    const auto& channels = this->m_timeline->channels;
+    const auto component = [&] (size_t index, float base) {
+	if (index >= channels.size () || channels [index].empty ()) {
+	    return base;
+	}
+
+	const float curve = evaluate (channels [index], frame);
+
+	return this->m_timeline->relative ? base + curve : curve;
+    };
+
+    switch (this->m_base.getType ()) {
+	case DynamicValue::Vec4: {
+	    const auto& base = this->m_base.getVec4 ();
+	    this->m_value.update (
+		glm::vec4 (component (0, base.x), component (1, base.y), component (2, base.z), component (3, base.w)),
+		DynamicValue::UpdateSource::Script
+	    );
+	    break;
+	}
+	case DynamicValue::Vec3: {
+	    const auto& base = this->m_base.getVec3 ();
+	    this->m_value.update (
+		glm::vec3 (component (0, base.x), component (1, base.y), component (2, base.z)),
+		DynamicValue::UpdateSource::Script
+	    );
+	    break;
+	}
+	case DynamicValue::Vec2: {
+	    const auto& base = this->m_base.getVec2 ();
+	    this->m_value.update (
+		glm::vec2 (component (0, base.x), component (1, base.y)), DynamicValue::UpdateSource::Script
+	    );
+	    break;
+	}
+	case DynamicValue::Float:
+	    this->m_value.update (component (0, this->m_base.getFloat ()), DynamicValue::UpdateSource::Script);
+	    break;
+	case DynamicValue::Int:
+	    this->m_value.update (
+		static_cast<int> (std::lround (component (0, static_cast<float> (this->m_base.getInt ())))),
+		DynamicValue::UpdateSource::Script
+	    );
+	    break;
+	case DynamicValue::Boolean:
+	    this->m_value.update (
+		component (0, this->m_base.getBool () ? 1.0f : 0.0f) >= 0.5f, DynamicValue::UpdateSource::Script
+	    );
+	    break;
+	default:
+	    // text has nothing a curve can drive
+	    break;
+    }
+}
+
+const std::string& PropertyAnimation::getName () const { return this->m_timeline->name; }
+
+double PropertyAnimation::getFps () const { return this->m_timeline->fps; }
+
+size_t PropertyAnimation::getFrameCount () const { return static_cast<size_t> (this->m_timeline->length); }
+
+double PropertyAnimation::getDuration () const { return this->m_timeline->length / this->m_timeline->fps; }
+
+double PropertyAnimation::getFrame (double now) const {
+    const double length = this->m_timeline->length;
+    const double played = this->position (now);
+
+    switch (this->m_timeline->mode) {
+	case TimelineAnimation::Mode::Single:
+	    return std::clamp (played, 0.0, length);
+	case TimelineAnimation::Mode::Mirror: {
+	    // fmod keeps the sign, and a negative rate runs the position below zero
+	    double cycle = std::fmod (played, 2.0 * length);
+
+	    if (cycle < 0.0) {
+		cycle += 2.0 * length;
+	    }
+
+	    return cycle <= length ? cycle : 2.0 * length - cycle;
+	}
+	case TimelineAnimation::Mode::Loop:
+	default: {
+	    double cycle = std::fmod (played, length);
+
+	    if (cycle < 0.0) {
+		cycle += length;
+	    }
+
+	    return cycle;
+	}
+    }
+}
+
+bool PropertyAnimation::isPlaying () const { return this->m_playing; }
+
+double PropertyAnimation::getRate () const { return this->m_rate; }
+
+void PropertyAnimation::play (double now) {
+    this->start (now);
+
+    if (this->m_playing) {
+	return;
+    }
+
+    // a transition a media widget runs on every track change plays again from its start
+    if (this->atEnd (this->m_position)) {
+	this->m_position = this->m_rate >= 0.0 ? 0.0 : this->m_timeline->length;
+    }
+
+    this->m_since = now;
+    this->m_playing = true;
+}
+
+void PropertyAnimation::pause (double now) {
+    this->start (now);
+
+    if (this->m_playing) {
+	this->m_position = this->position (now);
+	this->m_since = now;
+	this->m_playing = false;
+    }
+}
+
+void PropertyAnimation::stop (double now) {
+    this->start (now);
+    this->m_position = 0.0;
+    this->m_since = now;
+    this->m_playing = false;
+}
+
+void PropertyAnimation::setFrame (double now, double frame) {
+    this->start (now);
+    this->m_position = this->m_timeline->mode == TimelineAnimation::Mode::Single
+	? std::clamp (frame, 0.0, static_cast<double> (this->m_timeline->length))
+	: frame;
+    this->m_since = now;
+}
+
+void PropertyAnimation::setRate (double now, double rate) {
+    this->start (now);
+    this->m_position = this->position (now);
+    this->m_since = now;
+    this->m_rate = rate;
+}
+
+float PropertyAnimation::evaluate (const std::vector<Keyframe>& curve, float frame) {
+    if (curve.empty ()) {
+	return 0.0f;
+    }
+
+    if (frame <= curve.front ().frame) {
+	return curve.front ().value;
+    }
+
+    if (frame >= curve.back ().frame) {
+	return curve.back ().value;
+    }
+
+    const auto next = std::ranges::upper_bound (curve, frame, {}, &Keyframe::frame);
+    const auto& to = *next;
+    const auto& from = *std::prev (next);
+    const float span = to.frame - from.frame;
+
+    if (span <= 0.0f) {
+	return to.value;
+    }
+
+    // a handle's x is in thirds of the segment, so the editor's default handles (flat, x 1)
+    // ease in and out, and a disabled one sits a third of the way along the straight line
+    // between the keyframes: a segment with neither is linear
+    const glm::vec2 p0 (from.frame, from.value);
+    const glm::vec2 p3 (to.frame, to.value);
+    const glm::vec2 straight = (p3 - p0) / 3.0f;
+    glm::vec2 p1 = from.frontEnabled ? p0 + glm::vec2 (from.front.x * span / 3.0f, from.front.y) : p0 + straight;
+    glm::vec2 p2 = to.backEnabled ? p3 + glm::vec2 (to.back.x * span / 3.0f, to.back.y) : p3 - straight;
+
+    // handles kept inside the segment keep x moving forward, so every frame has one value
+    p1.x = std::clamp (p1.x, p0.x, p3.x);
+    p2.x = std::clamp (p2.x, p0.x, p3.x);
+
+    float low = 0.0f;
+    float high = 1.0f;
+    float t = 0.5f;
+
+    for (int step = 0; step < 32; step++) {
+	t = (low + high) / 2.0f;
+
+	if (bezier (p0.x, p1.x, p2.x, p3.x, t) < frame) {
+	    low = t;
+	} else {
+	    high = t;
+	}
+    }
+
+    return bezier (p0.y, p1.y, p2.y, p3.y, t);
+}
+
+double PropertyAnimation::position (double now) const {
+    if (!this->m_playing) {
+	return this->m_position;
+    }
+
+    return this->m_position + (now - this->m_since) * this->m_timeline->fps * this->m_rate;
+}
+
+void PropertyAnimation::start (double now) {
+    if (this->m_started) {
+	return;
+    }
+
+    this->m_started = true;
+    this->m_playing = !this->m_timeline->startPaused;
+    this->m_position = 0.0;
+    this->m_since = now;
+}
+
+bool PropertyAnimation::atEnd (double position) const {
+    if (this->m_timeline->mode != TimelineAnimation::Mode::Single) {
+	return false;
+    }
+
+    return this->m_rate >= 0.0 ? position >= this->m_timeline->length : position <= 0.0;
+}
