+// the editor's default handles: enabled, flat, one unit long
+constexpr const char* fadeOut = R"({
+    "value": 1.0,
+    "animation": {
+        "c0": [
+            { "frame": 120, "value": 0,
+              "back": { "enabled": true, "x": -1, "y": 0 }, "front": { "enabled": true, "x": 1, "y": 0 } },
+            { "frame": 0, "value": 1,
+              "back": { "enabled": true, "x": -1, "y": 0 }, "front": { "enabled": true, "x": 1, "y": 0 } }
+        ],
+        "options": { "fps": 30, "length": 120, "mode": "single", "wraploop": null }
+    }
+})";
+
+Keyframe point (float frame, float value) { return Keyframe { .frame = frame, .value = value }; }
+
+Keyframe smoothPoint (float frame, float value) {
+    return Keyframe {
+	.frame = frame,
+	.value = value,
+	.back = glm::vec2 (-1.0f, 0.0f),
+	.backEnabled = true,
+	.front = glm::vec2 (1.0f, 0.0f),
+	.frontEnabled = true,
+    };
+}
+
+std::shared_ptr<TimelineAnimation> timeline (TimelineAnimation::Mode mode, float fps, float length) {
+    auto result = std::make_shared<TimelineAnimation> ();
+
+    result->mode = mode;
+    result->fps = fps;
+    result->length = length;
+
+    return result;
+}
+} // namespace
+
+TEST_CASE ("A value's timeline animation is read off the value, sorted by frame") {
+    const auto value = parse (fadeOut);
+    const auto& animation = value->getAnimation ();
+
+    REQUIRE (animation != nullptr);
+    CHECK (value->getFloat () == 1.0f);
+    CHECK (animation->mode == TimelineAnimation::Mode::Single);
+    CHECK (animation->fps == 30.0f);
+    CHECK (animation->length == 120.0f);
+    CHECK_FALSE (animation->startPaused);
+    CHECK_FALSE (animation->relative);
+    REQUIRE (animation->channels.size () == 1);
+    REQUIRE (animation->channels [0].size () == 2);
+    CHECK (animation->channels [0][0].frame == 0.0f);
+    CHECK (animation->channels [0][0].value == 1.0f);
+    CHECK (animation->channels [0][0].frontEnabled);
+    CHECK (animation->channels [0][1].frame == 120.0f);
+}
+
+TEST_CASE ("A value without keyframes, or with nothing to play, has no animation") {
+    CHECK (parse (R"({ "value": 1.0 })")->getAnimation () == nullptr);
+    CHECK (parse (R"("1 2 3")")->getAnimation () == nullptr);
+    CHECK (parse (R"({ "value": 1.0, "animation": { "c0": [], "options": { "fps": 30, "length": 60 } } })")
+	       ->getAnimation ()
+	   == nullptr);
+    // fields written some other way fall back instead of aborting the wallpaper
+    const auto odd = parse (
+	R"({ "value": 1.0, "animation": { "c0": [ { "frame": "x", "value": 2 } ], "options": { "fps": "fast", "length": 60, "name": 5 } } })"
+    );
+
+    REQUIRE (odd->getAnimation () != nullptr);
+    CHECK (odd->getAnimation ()->fps == 30.0f);
+    CHECK (odd->getAnimation ()->name.empty ());
+}
+
+TEST_CASE ("The curve holds outside its keyframes and is straight without handles") {
+    const std::vector<Keyframe> curve = { point (10.0f, 2.0f), point (20.0f, 4.0f) };
+
+    CHECK (PropertyAnimation::evaluate (curve, 0.0f) == 2.0f);
+    CHECK (PropertyAnimation::evaluate (curve, 10.0f) == 2.0f);
+    CHECK (PropertyAnimation::evaluate (curve, 15.0f) == Approx (3.0f).margin (1e-4));
+    CHECK (PropertyAnimation::evaluate (curve, 12.5f) == Approx (2.5f).margin (1e-4));
+    CHECK (PropertyAnimation::evaluate (curve, 20.0f) == 4.0f);
+    CHECK (PropertyAnimation::evaluate (curve, 99.0f) == 4.0f);
+}
+
+TEST_CASE ("The editor's default handles ease in and out") {
+    const std::vector<Keyframe> curve = { smoothPoint (0.0f, 0.0f), smoothPoint (100.0f, 1.0f) };
+
+    // flat handles a third of the segment long: the smoothstep curve, 3t² - 2t³
+    CHECK (PropertyAnimation::evaluate (curve, 25.0f) == Approx (0.15625f).margin (1e-4));
+    CHECK (PropertyAnimation::evaluate (curve, 50.0f) == Approx (0.5f).margin (1e-4));
+    CHECK (PropertyAnimation::evaluate (curve, 75.0f) == Approx (0.84375f).margin (1e-4));
+    // and it never leaves the range the keyframes span
+    for (int frame = 0; frame <= 100; frame++) {
+	const float value = PropertyAnimation::evaluate (curve, static_cast<float> (frame));
+
+	CHECK (value >= 0.0f);
+	CHECK (value <= 1.0f);
+    }
+}
+
+TEST_CASE ("A single animation plays once from the first time it is applied, then holds") {
+    const auto value = parse (fadeOut);
+    PropertyAnimation animation (value->getAnimation (), *value);
+
+    // late in a session: the clock starts here, not at the render clock's zero
+    animation.apply (1000.0);
+    CHECK (value->getFloat () == Approx (1.0f));
+    CHECK (animation.isPlaying ());
+
+    animation.apply (1002.0);
+    CHECK (animation.getFrame (1002.0) == Approx (60.0));
+    CHECK (value->getFloat () == Approx (0.5f).margin (1e-4));
+
+    animation.apply (1010.0);
+    CHECK (value->getFloat () == Approx (0.0f).margin (1e-6));
+    CHECK_FALSE (animation.isPlaying ());
+    CHECK (animation.getFrame (1010.0) == Approx (120.0));
+
+    // play () on one that ended runs it again from the start
+    animation.play (1020.0);
+    animation.apply (1020.0);
+    CHECK (value->getFloat () == Approx (1.0f));
+    CHECK (animation.isPlaying ());
+}
+
+TEST_CASE ("A mirrored animation goes back and forth, a looping one starts over") {
+    DynamicValue mirrored (0.66f);
+    auto pulse = timeline (TimelineAnimation::Mode::Mirror, 30.0f, 60.0f);
+    pulse->channels = { { point (0.0f, 0.0f), point (60.0f, 1.8f) } };
+    PropertyAnimation mirror (pulse, mirrored);
+
+    mirror.apply (0.0);
+    CHECK (mirrored.getFloat () == 0.0f);
+    mirror.apply (1.0);
+    CHECK (mirrored.getFloat () == Approx (0.9f).margin (1e-4));
+    mirror.apply (2.0);
+    CHECK (mirrored.getFloat () == Approx (1.8f).margin (1e-4));
+    mirror.apply (3.0);
+    CHECK (mirrored.getFloat () == Approx (0.9f).margin (1e-4));
+    mirror.apply (4.0);
+    CHECK (mirrored.getFloat () == Approx (0.0f).margin (1e-4));
+    CHECK (mirror.isPlaying ());
+
+    DynamicValue looped (0.0f);
+    auto ramp = timeline (TimelineAnimation::Mode::Loop, 30.0f, 60.0f);
+    ramp->channels = { { point (0.0f, 0.0f), point (60.0f, 1.8f) } };
+    PropertyAnimation loop (ramp, looped);
+
+    loop.apply (0.0);
+    loop.apply (2.5);
+    CHECK (loop.getFrame (2.5) == Approx (15.0));
+    CHECK (looped.getFloat () == Approx (0.45f).margin (1e-4));
+}
+
+TEST_CASE ("A relative animation moves the value from where the editor put it") {
+    // an origin keyframed by offsets, with no curve for z (workshop 2590512455)
+    DynamicValue origin (glm::vec3 (1475.0f, 819.0f, 7.0f));
+    auto drift = timeline (TimelineAnimation::Mode::Mirror, 2.0f, 16.0f);
+    drift->relative = true;
+    drift->channels = { { point (0.0f, 0.0f), point (16.0f, -127.0f) }, { point (0.0f, 0.0f), point (16.0f, 117.0f) } };
+    PropertyAnimation animation (drift, origin);
+
+    animation.apply (0.0);
+    CHECK (origin.getVec3 () == glm::vec3 (1475.0f, 819.0f, 7.0f));
+
+    animation.apply (8.0);
+    CHECK (origin.getVec3 ().x == Approx (1348.0f).margin (1e-2));
+    CHECK (origin.getVec3 ().y == Approx (936.0f).margin (1e-2));
+    CHECK (origin.getVec3 ().z == 7.0f);
+}
+
+TEST_CASE ("A paused animation waits for a script, which can pause, stop and move it") {
+    // a transition a media widget plays on every track change (workshop 3441873795)
+    DynamicValue alpha (0.0f);
+    auto transition = timeline (TimelineAnimation::Mode::Single, 30.0f, 30.0f);
+    transition->startPaused = true;
+    transition->channels = { { point (0.0f, 0.0f), point (30.0f, 1.0f) } };
+    PropertyAnimation animation (transition, alpha);
+
+    animation.apply (5.0);
+    animation.apply (50.0);
+    CHECK_FALSE (animation.isPlaying ());
+    CHECK (alpha.getFloat () == 0.0f);
+
+    animation.play (50.0);
+    animation.apply (50.5);
+    CHECK (alpha.getFloat () == Approx (0.5f).margin (1e-4));
+
+    animation.pause (50.5);
+    animation.apply (60.0);
+    CHECK (alpha.getFloat () == Approx (0.5f).margin (1e-4));
+
+    animation.setFrame (60.0, 6.0);
+    animation.apply (60.0);
+    CHECK (alpha.getFloat () == Approx (0.2f).margin (1e-4));
+    // past either end of a single animation lands on that end
+    animation.setFrame (60.0, 99.0);
+    CHECK (animation.getFrame (60.0) == Approx (30.0));
+
+    animation.stop (61.0);
+    animation.apply (70.0);
+    CHECK (alpha.getFloat () == 0.0f);
+    CHECK_FALSE (animation.isPlaying ());
+
+    CHECK (animation.getFrameCount () == 30);
+    CHECK (animation.getDuration () == Approx (1.0));
+}
