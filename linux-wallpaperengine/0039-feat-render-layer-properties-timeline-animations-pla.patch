index 00000000..1418ac2f
--- /dev/null
+++ b/src/WallpaperEngine/Render/PropertyAnimation.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <cstddef>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "WallpaperEngine/Data/Model/DynamicValue.h"
+#include "WallpaperEngine/Data/Model/TimelineAnimation.h"
+
+namespace WallpaperEngine::Render {
+/**
+ * Plays a property's timeline animation into the property: a layer fading in, sliding into
+ * place or pulsing, as the editor keyframed it.
+ *
+ * Its clock starts the first time it is applied or a script touches it, so an intro plays
+ * from its start whenever the wallpaper loads. A script takes it over through IAnimation
+ * (play, pause, stop, setFrame), as the media widgets do to run a transition per track.
+ *
+ * Times are the render clock (g_Time) the caller passes in, so nothing here reads a clock.
+ */
+class PropertyAnimation {
+public:
+    PropertyAnimation (
+	std::shared_ptr<const Data::Model::TimelineAnimation> timeline, Data::Model::DynamicValue& value
+    );
+
+    /** Writes the curve's value at render time `now` into the property */
+    void apply (double now);
+
+    [[nodiscard]] const std::string& getName () const;
+    [[nodiscard]] double getFps () const;
+    [[nodiscard]] size_t getFrameCount () const;
+    /** Seconds the animation runs for, once through */
+    [[nodiscard]] double getDuration () const;
+    /** The frame showing at `now`, fractional between whole frames */
