 namespace {
 using WallpaperEngine::Data::JSON::JSON;
 
+// written while a web wallpaper is set up, read from CEF's IO thread
+std::mutex localFilesMutex;
+std::map<std::string, std::set<std::filesystem::path>> localFiles;
+
+/**
+ * Adds path to files, canonical, if it is a regular file and, when within is given,
+ * really inside that folder: a symlink in a folder must not reach outside it
+ */
+void addLocalFile (
+    std::set<std::filesystem::path>& files, const std::filesystem::path& path,
+    const std::filesystem::path& within = {}
+) {
+    std::error_code ec;
+    const auto canonical = std::filesystem::canonical (path, ec);
+
+    if (ec || !std::filesystem::is_regular_file (canonical, ec)) {
+	return;
+    }
+
+    if (!within.empty ()) {
+	const auto [end, rest] = std::ranges::mismatch (within, canonical);
+
+	if (end != within.end ()) {
+	    return;
+	}
+    }
+
+    files.insert (canonical);
+}
+
 /**
  * --set-property values are always strings; hand the page the type project.json gives
  * the property. A combo keeps a number when the project wrote one, since pages compare
@@ -101,14 +132,21 @@ WebProperties::Payload WebProperties::build (
 	    if (type == "directory") {
 		std::error_code ec;
 		JSON list = JSON::array ();
+		const auto folder = std::filesystem::canonical (path, ec);
 
 		for (const auto& entry : std::filesystem::directory_iterator (path, ec)) {
 		    if (entry.is_regular_file (ec)) {
 			list.push_back (entry.path ().string ());
+
+			if (!folder.empty ()) {
+			    addLocalFile (payload.localFiles, entry.path (), folder);
+			}
 		    }
 		}
 
 		payload.files [name] = list;
+	    } else if (path.is_absolute ()) {
+		addLocalFile (payload.localFiles, path);
 	    }
 	}
 
@@ -118,6 +156,25 @@ WebProperties::Payload WebProperties::build (
     return payload;
 }
 
+void WebProperties::allowLocalFiles (const std::string& workshopId, const std::set<std::filesystem::path>& files) {
+    std::scoped_lock lock (localFilesMutex);
+    localFiles [workshopId].insert (files.begin (), files.end ());
+}
+
+bool WebProperties::isLocalFileAllowed (const std::string& workshopId, const std::filesystem::path& file) {
+    std::error_code ec;
+    const auto canonical = std::filesystem::canonical (file, ec);
+
+    if (ec) {
+	return false;
+    }
+
+    std::scoped_lock lock (localFilesMutex);
+    const auto it = localFiles.find (workshopId);
+
+    return it != localFiles.end () && it->second.contains (canonical);
+}
