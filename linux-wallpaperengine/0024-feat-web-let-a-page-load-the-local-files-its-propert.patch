-	this->m_contents = this->m_assetLoader.read (file);
+	if (file.starts_with (WebProperties::LOCAL_PREFIX)) {
+	    this->m_contents = openLocal (this->m_project.workshopId, file.substr (WebProperties::LOCAL_PREFIX.size ()));
+	} else {
+	    this->m_contents = this->m_assetLoader.read (file);
+	}
+
+	if (!this->m_contents) {
+	    handle_request = true;
+	    return true;
+	}
 
 	// the length is what lets CEF answer Range requests (it skips and trims itself);
 	// without one a <video> source is refused outright (MEDIA_ERR_SRC_NOT_SUPPORTED,
diff --git a/src/WallpaperEngine/WebBrowser/CEF/WebApi.h b/src/WallpaperEngine/WebBrowser/CEF/WebApi.h
index 6e91431c..5d3838ed 100644
--- a/src/WallpaperEngine/WebBrowser/CEF/WebApi.h
+++ b/src/WallpaperEngine/WebBrowser/CEF/WebApi.h
@@ -102,6 +102,100 @@ inline constexpr const char* shim = R"JS(
     ['Properties', 'Thumbnail', 'Playback', 'Timeline'].forEach (function (kind) {
         window['wallpaperRegisterMedia' + kind + 'Listener'] = function () {};
     });
+
+    // Pages load the files their properties name as "file:///" + value, which Chromium
+    // refuses to a page of this scheme. Those URLs are mapped onto the page's own
+    // origin, where the engine serves the files the properties name and nothing else.
+    // Kept to the places pages put such a URL: element sources, styles, fetch and XHR.
+    var local = '/__wpe_local__/';
+
+    function mapUrl (url) {
+        if (typeof url !== 'string' || url.slice (0, 8).toLowerCase () !== 'file:///') {
+            return url;
+        }
+        return location.protocol + '//' + location.host + local + url.slice (8);
+    }
+
+    function mapCss (text) {
+        if (typeof text !== 'string') {
+            return text;
+        }
+        return text.replace (/url\(\s*(['"]?)file:\/\/\//gi, function (match, quote) {
+            return 'url(' + quote + location.protocol + '//' + location.host + local;
+        });
+    }
+
+    function wrapSetter (proto, name, map) {
+        var descriptor = proto && Object.getOwnPropertyDescriptor (proto, name);
+        if (!descriptor || !descriptor.set) {
+            return;
+        }
+        Object.defineProperty (proto, name, {
+            configurable: true,
+            enumerable: descriptor.enumerable,
+            get: descriptor.get,
+            set: function (value) { descriptor.set.call (this, map (value)); }
+        });
+    }
+
+    wrapSetter (window.HTMLImageElement && HTMLImageElement.prototype, 'src', mapUrl);
+    wrapSetter (window.HTMLMediaElement && HTMLMediaElement.prototype, 'src', mapUrl);
+    wrapSetter (window.HTMLSourceElement && HTMLSourceElement.prototype, 'src', mapUrl);
+    wrapSetter (window.HTMLVideoElement && HTMLVideoElement.prototype, 'poster', mapUrl);
+    wrapSetter (window.Element && Element.prototype, 'innerHTML', function (html) {
+        return typeof html === 'string' ? html.replace (/(["'(])file:\/\/\//gi, function (match, open) {
+            return open + location.protocol + '//' + location.host + local;
+        }) : html;
+    });
+    ['background', 'backgroundImage', 'cssText', 'content', 'listStyleImage', 'borderImage',
+     'borderImageSource', 'maskImage', 'webkitMaskImage'].forEach (function (name) {
+        wrapSetter (window.CSSStyleDeclaration && CSSStyleDeclaration.prototype, name, mapCss);
+    });
+
+    if (window.CSSStyleDeclaration) {
+        var setProperty = CSSStyleDeclaration.prototype.setProperty;
+        CSSStyleDeclaration.prototype.setProperty = function (name, value, priority) {
+            return setProperty.call (this, name, mapCss (value), priority);
+        };
+    }
+
+    if (window.Element) {
+        var setAttribute = Element.prototype.setAttribute;
+        Element.prototype.setAttribute = function (name, value) {
+            var attribute = String (name).toLowerCase ();
+            if (attribute === 'src' || attribute === 'poster' || attribute === 'href') {
+                value = mapUrl (typeof value === 'string' ? value : String (value));
+            } else if (attribute === 'style') {
+                value = mapCss (typeof value === 'string' ? value : String (value));
+            }
+            return setAttribute.call (this, name, value);
+        };
+    }
+
+    if (window.fetch) {
+        var fetch = window.fetch;
+        window.fetch = function (input, init) {
+            return fetch.call (this, typeof input === 'string' ? mapUrl (input) : input, init);
+        };
+    }
+
+    if (window.XMLHttpRequest) {
+        var open = XMLHttpRequest.prototype.open;
+        XMLHttpRequest.prototype.open = function (method, url) {
+            var args = Array.prototype.slice.call (arguments);
+            args[1] = mapUrl (typeof url === 'string' ? url : String (url));
+            return open.apply (this, args);
+        };
+    }
+
+    if (window.Audio) {
+        var NativeAudio = window.Audio;
+        var Audio = function Audio (src) {
+            return arguments.length ? new NativeAudio (mapUrl (src)) : new NativeAudio ();
+        };
+        Audio.prototype = NativeAudio.prototype;
+        window.Audio = Audio;
+    }
 }) ();
 )JS";
 
