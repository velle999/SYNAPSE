@@ -3,6 +3,7 @@
 #include <algorithm>
 #include <filesystem>
 #include <fstream>
+#include <set>
 #include <stdexcept>
 #include <string>
 #include <unistd.h>
@@ -166,3 +167,46 @@ TEST_CASE ("The web properties script is one call that survives any property tex
     const auto arguments = script.substr (std::string (WebApi::deliverPrefix).size ());
     CHECK (std::ranges::all_of (arguments, [] (const unsigned char c) { return c < 0x80; }));
 }
+
+TEST_CASE ("A web page may load only the local files its properties name") {
+    const auto root = std::filesystem::temp_directory_path () / ("lwe-weblocal-" + std::to_string (getpid ()));
+    std::filesystem::remove_all (root);
+    std::filesystem::create_directories (root / "preset" / "files");
+    std::filesystem::create_directories (root / "slides");
+    std::ofstream (root / "preset" / "files" / "picture.jpg") << "p";
+    std::ofstream (root / "preset" / "secret.txt") << "s";
+    std::ofstream (root / "slides" / "one.png") << "1";
+    std::filesystem::create_symlink (root / "preset" / "secret.txt", root / "slides" / "link.png");
+
+    const auto payload = WebProperties::build (
+	project ({
+	    { "background", { { "type", "file" }, { "value", "" } } },
+	    { "slides", { { "type", "directory" }, { "value", "" } } },
+	    { "missing", { { "type", "file" }, { "value", "" } } },
+	}),
+	{
+	    { "background", (root / "preset" / "files" / "picture.jpg").string () },
+	    { "slides", (root / "slides").string () },
+	    { "missing", (root / "preset" / "gone.jpg").string () },
+	},
+	30, noFiles
+    );
+
+    // the symlink in the named folder points outside it, so it reaches nothing
+    CHECK (payload.localFiles == std::set<std::filesystem::path> {
+	std::filesystem::canonical (root / "preset" / "files" / "picture.jpg"),
+	std::filesystem::canonical (root / "slides" / "one.png"),
+    });
+
+    const std::string id = "lwe-test-" + std::to_string (getpid ());
+    WebProperties::allowLocalFiles (id, { std::filesystem::canonical (root / "preset" / "files" / "picture.jpg") });
+
+    CHECK (WebProperties::isLocalFileAllowed (id, root / "preset" / "files" / "picture.jpg"));
+    CHECK (WebProperties::isLocalFileAllowed (id, root / "preset" / "files" / ".." / "files" / "picture.jpg"));
+    CHECK_FALSE (WebProperties::isLocalFileAllowed (id, root / "preset" / "secret.txt"));
+    CHECK_FALSE (WebProperties::isLocalFileAllowed (id, root / "preset" / "files"));
+    CHECK_FALSE (WebProperties::isLocalFileAllowed (id, root / "preset" / "gone.jpg"));
+    CHECK_FALSE (WebProperties::isLocalFileAllowed ("another-wallpaper", root / "preset" / "files" / "picture.jpg"));
+
+    std::filesystem::remove_all (root);
+}
