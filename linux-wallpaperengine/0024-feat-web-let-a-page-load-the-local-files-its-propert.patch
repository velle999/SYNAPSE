+/**
+ * Where a page reaches the local files its properties name, under its own scheme's
+ * root. Pages load them as "file:///" + value, which Chromium refuses to a page of
+ * another scheme, so the web API shim maps those URLs here. It stays on the page's
+ * own origin so a canvas the file is drawn into can still be read back.
+ */
+inline constexpr std::string_view LOCAL_PREFIX = "__wpe_local__/";
+
+/** Lets the pages of a wallpaper load these local files too */
+void allowLocalFiles (const std::string& workshopId, const std::set<std::filesystem::path>& files);
+
+/**
+ * Whether a page of the wallpaper may load this local file: only if one of its
+ * properties names it, or names the folder it is in. The path is made canonical
+ * first, so neither ".." nor a symlink reaches anything else.
+ */
+[[nodiscard]] bool isLocalFileAllowed (const std::string& workshopId, const std::filesystem::path& file);
+
 /** Turns a path inside the project into one on disk; throws when the project has no such file */
 using Resolver = std::function<std::filesystem::path (const std::filesystem::path&)>;
 
