 using namespace WallpaperEngine::WebBrowser::CEF;
 
+namespace {
+/**
+ * Opens a local file a page asked for through WebProperties::LOCAL_PREFIX, if one of
+ * its properties names it; anything else is not found.
+ */
+ReadStreamSharedPtr openLocal (const std::string& workshopId, std::string path) {
+    // "file:///" + "/home/..." arrives with its slashes doubled; the path is absolute either way
+    path.erase (0, path.find_first_not_of ('/'));
+    const std::filesystem::path local = "/" + path;
+
+    if (!WebProperties::isLocalFileAllowed (workshopId, local)) {
+	sLog.error ("web: refused a local file no property names: ", local.string ());
+	return nullptr;
+    }
+
+    auto stream = std::make_shared<std::ifstream> (local, std::ios::binary);
+
+    if (!*stream) {
+	return nullptr;
+    }
+
+    return stream;
+}
+} // namespace
+
 WPSchemeHandler::WPSchemeHandler (const Project& project) :
     m_project (project), m_assetLoader (*this->m_project.assetLocator) { }
 
@@ -59,7 +87,16 @@ bool WPSchemeHandler::Open (CefRefPtr<CefRequest> request, bool& handle_request,
