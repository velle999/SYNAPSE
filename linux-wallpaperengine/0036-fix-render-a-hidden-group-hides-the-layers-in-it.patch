index 849c566b..c563b8cb 100644
--- a/src/WallpaperEngine/Render/Objects/CText.cpp
+++ b/src/WallpaperEngine/Render/Objects/CText.cpp
@@ -385,7 +385,7 @@ void CText::render () {
     if (!m_valid) {
 	return;
     }
-    if (!m_text.visible->value->getBool ()) {
+    if (!m_text.visible->value->getBool () || this->isHiddenByParent ()) {
 	return;
     }
 
