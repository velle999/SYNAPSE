msgstr "gpu выгружает каждый слой · cpu считает на процессоре · off маскирует службу, так что запустить её снова нельзя"

msgid "needs synui-ai-backend(1), shipped by the synui package"
msgstr "требуется synui-ai-backend(1) из пакета synui"

msgid "llama.cpp API port"
msgstr "Порт API llama.cpp"

