msgstr "программная блокировка"

msgid "software; clearing it needs root (rfkill)"
msgstr "программная; чтобы снять её, нужен root (rfkill)"

msgid "hard-block"
msgstr "аппаратная блокировка"

msgid "a physical switch; software cannot clear it"
msgstr "физический переключатель; программно его не снять"

