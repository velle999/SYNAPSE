msgstr "터미널"

msgid "what synui launches for a terminal — synuirc, not mimeapps.list"
msgstr "synui가 터미널로 실행하는 것 — mimeapps.list가 아니라 synuirc"

msgid "synui's built-in fallback — nothing set"
msgstr "synui의 기본 대체 — 설정되지 않음"

msgid "nothing installed handles this"
msgstr "설치된 것 중 이것을 처리하는 프로그램이 없습니다"

msgid "Claude (Anthropic) API key"
msgstr "Claude (Anthropic) API 키"

