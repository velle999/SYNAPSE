msgstr "مشغّل"

msgid "discoverable"
msgstr "مرئي"

msgid "visible to anything scanning"
msgstr "مرئي لكل ما يبحث"

msgid "pairable"
msgstr "قابل للاقتران"

msgid "accepts new pairings"
msgstr "يقبل عمليات اقتران جديدة"

msgid "nothing has been paired with this adapter"
msgstr "لم يُقترن شيء بهذا المهايئ بعد"

