msgstr "brak adaptera albo bluetoothd nie działa"

msgid "powered"
msgstr "włączony"

msgid "discoverable"
msgstr "widoczny"

msgid "visible to anything scanning"
msgstr "widoczny dla wszystkiego, co skanuje"

msgid "pairable"
msgstr "parowalny"

msgid "accepts new pairings"
msgstr "przyjmuje nowe parowania"

msgid "nothing has been paired with this adapter"
msgstr "z tym adapterem nic jeszcze nie zostało sparowane"

