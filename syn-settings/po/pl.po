msgstr "backend"

msgid "which service the assistant sends your messages to"
msgstr "do której usługi asystent wysyła Twoje wiadomości"

msgid "no key stored; set one before switching to this backend"
msgstr "nie zapisano klucza; ustaw go przed przełączeniem na ten backend"

