msgstr "Terminal"

msgid "what synui launches for a terminal — synuirc, not mimeapps.list"
msgstr "co synui uruchamia jako terminal — synuirc, nie mimeapps.list"

msgid "nothing installed handles this"
msgstr "nic zainstalowanego tego nie obsługuje"

msgid "vibe"
msgstr "vibe"

msgid "the assistant is not on this machine, so there is no backend to choose"
msgstr "asystenta nie ma na tym komputerze, więc nie ma czego wybierać"

