[Desktop Entry]
Type=Application
Name=SYNAPSE Settings
GenericName=System Settings
Comment=Display, keyboard, date and time, power and where this system's configuration lives
Exec=syn-settings gui
# Its own icon, not the theme's generic preferences-system — which on Breeze is
# the same grey gear every settings-ish app in the menu already wears. A stock
# icon name is whatever the icon theme decides; synfiles shipped
# system-file-manager once and got Dolphin's face for it. See data/syn-settings.svg.
Icon=syn-settings
Terminal=false
StartupWMClass=syn-settings
# ONE main category. Two makes the entry appear twice in the scanned start-menu
# pages on top of the fixed entry — the same hint desktop-file-validate gives
# about syn-update's and synpkg's launchers.
Categories=Settings;
Keywords=settings;system;display;monitor;keyboard;layout;locale;timezone;power;suspend;
StartupNotify=true
