[Unit]
Description=SynapseOS AI Network Policy Daemon
After=synapd.service
# Wants=, deliberately not Requires=: synui's game mode stops synapd to free the
# GPU, and Requires= propagated that stop to us — so launching a game silently
# killed the network policy daemon, and starting synapd again did not bring it
# back (the dependency only points one way). synnet does not need synapd to run:
# it reconnects to it in the poll loop, and with no connection it degrades to
# monitor-only, keeping the firewall and the blocklist up.
Wants=synapd.service

[Service]
Type=simple
ExecStart=/usr/bin/synnet --foreground
Restart=on-failure
RestartSec=5

# ── Hardening ────────────────────────────────────────────
# No User= was set, so this was running as root with nothing fenced off at all.
# It needs exactly two things: NETLINK_CONNECTOR (monitor.c) to watch processes,
# and CAP_NET_ADMIN to manage its nftables set. Everything else is deniable.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectHostname=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
