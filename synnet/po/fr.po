#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet : %s nécessite root (sudo synnet %s %s)\n"

#, c-format
msgid ""
"synnet: no saved connection is called '%s' — `nmcli connection show` lists "
"them\n"
msgstr ""
"synnet : aucune connexion enregistrée ne s'appelle '%s' — `nmcli connection "
"show` les liste\n"

#, c-format
msgid ""
"synnet: more than one connection is called '%s' — give its UUID instead\n"
msgstr ""
"synnet : plusieurs connexions s'appellent '%s' — indiquez plutôt son UUID\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet : impossible de mettre à jour %s\n"

#, c-format
msgid ""
"synnet: %s recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet : %s enregistré, mais le pare-feu n'a pas pu être rechargé — cette "
"machine n'est PAS filtrée en entrée en ce moment\n"

#, c-format
msgid ""
"synnet: trusting “%s” — devices on it can reach this machine's services\n"
msgstr ""
"synnet : « %s » est maintenant de confiance — les appareils qui s'y trouvent "
"peuvent joindre les services de cette machine\n"

#, c-format
msgid ""
"synnet: no longer trusting “%s” — only replies, ping, DHCP and open ports "
"get in from it\n"
msgstr ""
"synnet : « %s » n'est plus de confiance — seuls les réponses, le ping, le "
"DHCP et les ports ouverts en passent\n"

msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet : --firewall nécessite root (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet : impossible d'écrire %s\n"

msgid ""
"synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall "
"on` puts it back.\n"
msgstr ""
"synnet : pare-feu d'entrée DÉSACTIVÉ — rien en entrée n'est filtré. `synnet "
"--firewall on` le remet.\n"

#, c-format
msgid ""
"synnet: the firewall is switched off in %s — `synnet --firewall on` to turn "
"it back on\n"
msgstr ""
"synnet : le pare-feu est désactivé dans %s — `synnet --firewall on` pour le "
"réactiver\n"

msgid ""
"synnet: could not apply the input firewall — this box is NOT ingress-"
"filtered\n"
msgstr ""
"synnet : impossible d'appliquer le pare-feu d'entrée — cette machine n'est "
"PAS filtrée en entrée\n"

msgid ""
"synnet: input firewall applied (default-drop input; loopback, established, "
"ICMP and DHCP accepted, and private-range sources on trusted networks)\n"
msgstr ""
"synnet : pare-feu d'entrée appliqué (rejet par défaut en entrée ; loopback, "
"connexions établies, ICMP et DHCP acceptés, et sources en plage privée sur "
"les réseaux de confiance)\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, "
"'_', '.', '-')\n"
msgstr ""
"synnet : « %s » n'est pas un nom d'interface valide (1 à 15 caractères : "
"lettres, chiffres, « _ », « . », « - »)\n"

#, c-format
msgid ""
"synnet: trusted %s in %s — the firewall is switched off, so nothing changed "
"in the kernel.\n"
msgstr ""
"synnet : %s marqué comme fiable dans %s — le pare-feu est désactivé, donc "
"rien n'a changé dans le noyau.\n"

#, c-format
msgid ""
"synnet: untrusted %s in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet : %s retiré des fiables dans %s — le pare-feu est désactivé, donc "
"rien n'a changé dans le noyau.\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr ""
"synnet : %s est désormais fiable — DHCP et DNS depuis ce lien sont acceptés\n"

#, c-format
msgid ""
"synnet: no longer trusting %s — DHCP and DNS from that link are no longer "
"accepted\n"
msgstr ""
"synnet : %s n'est plus fiable — DHCP et DNS depuis ce lien ne sont plus "
"acceptés\n"

#, c-format
msgid ""
"synnet: %s does not exist yet — the rule matches by name and takes effect "
"when it appears.\n"
msgstr ""
"synnet : %s n'existe pas encore — la règle correspond par nom et prend effet "
"dès son apparition.\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal rule. Write it as <tcp|udp>/<port> and a source, "
"e.g. 'tcp/5900 100.64.0.0/10' or 'tcp/5900 any'\n"
msgstr ""
"synnet : « %s » n'est pas une règle valide. Écrivez-la comme <tcp|udp>/"
"<port> suivi d'une source, par ex. « tcp/5900 100.64.0.0/10 » ou « tcp/5900 "
"any »\n"

#, c-format
msgid ""
"synnet: recorded '%s' in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet : « %s » enregistré dans %s — le pare-feu est désactivé, rien n'a "
"donc changé dans le noyau.\n"

#, c-format
msgid ""
"synnet: removed '%s' from %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet : « %s » retiré de %s — le pare-feu est désactivé, rien n'a donc "
"changé dans le noyau.\n"

#, c-format
msgid ""
"synnet: '%s' recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet : « %s » enregistré, mais le pare-feu n'a pas pu être rechargé — "
"cette machine n'est PAS filtrée en entrée actuellement\n"

#, c-format
msgid "synnet: %s is open\n"
msgstr "synnet : %s est ouvert\n"

msgid ""
"synnet: ⚠ that is open to ANY source, including the internet if this machine "
"is reachable from it. Name a CIDR to narrow it.\n"
msgstr ""
"synnet : ⚠ c'est ouvert à N'IMPORTE QUELLE source, y compris Internet si "
"cette machine y est joignable. Indiquez un CIDR pour restreindre.\n"

#, c-format
msgid "synnet: %s is closed\n"
msgstr "synnet : %s est fermé\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet : option inconnue « %s »\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet : adresse IPv4 invalide : %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr ""
"synnet %s — état d'application nftables\n"
"\n"

msgid "  Input firewall\n"
msgstr "  Pare-feu d'entrée\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    DÉSACTIVÉ — désactivé dans %s.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr ""
"    Rien en entrée n'est filtré. Réactivez-le avec\n"
"    `sudo synnet --firewall on`, ou dans Réglages ▸ Réseau.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    non appliqué — pas de %s.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr ""
"    Le démon publie ce fichier au démarrage ; si synnet tourne et\n"
"    qu'il est absent, le démon est antérieur à ceci ou n'a pas pu\n"
"    écrire dans /run/synnet.\n"

msgid ""
"    ACTIVE — default-drop input; established traffic, and the\n"
"    local network on trusted networks, let through. Asserted by\n"
"    synnet at boot and re-checked every minute.\n"
msgstr ""
"    ACTIF — rejet par défaut en entrée ; connexions établies et, sur\n"
"    les réseaux de confiance, réseau local acceptés. Appliqué par\n"
"    synnet au démarrage et vérifié chaque minute.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr ""
"    ⚠ reconstruit %s fois pendant cette exécution — quelque chose sur\n"
"      cette machine vide nftables.\n"

msgid ""
"    NetworkManager did not answer: private-range sources are accepted on "
"every interface.\n"
msgstr ""
"    NetworkManager n'a pas répondu : les sources en plage privée sont "
"acceptées sur toutes les interfaces.\n"

#, c-format
msgid "    %s: “%s” — trusted\n"
msgstr "    %s : « %s » — de confiance\n"

#, c-format
msgid ""
"    %s: “%s” — NOT trusted; only replies, ping, DHCP and open ports get in\n"
msgstr ""
"    %s : « %s » — PAS de confiance ; seuls les réponses, le ping, le DHCP et "
"les ports ouverts passent\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr ""
"    ÉCHEC de l'application — cette machine n'est PAS filtrée en entrée.\n"
"    Voir `journalctl -u synnet` pour ce qu'a dit nft.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  Liens conteneur / VM (DHCP + DNS y sont acceptés)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    aucun — %s est vide ou absent.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr ""
"    Un pont de conteneur en a besoin : le premier paquet DHCP de son\n"
"    invité vient de 0.0.0.0, et la règle de rejet l'avale.\n"
"    `sudo synnet --trust-if waydroid0` en ajoute un.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (actif)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (pas encore présent — correspondance par nom)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr ""
"    ⚠ synnet en a appliqué %s la dernière fois. Lancez\n"
"      `sudo synnet --firewall` pour charger la liste actuelle.\n"

msgid "  Live ruleset\n"
msgstr "  Jeu de règles en vigueur\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr ""
"    (non affiché — lister nftables nécessite root : sudo synnet --status)\n"
"\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr ""
"    (non affiché — nft n'est pas installé)\n"
"\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr ""
"    la chaîne d'entrée n'est PAS chargée dans le noyau.\n"
"\n"

msgid "  Ports opened to sources this box would otherwise drop\n"
msgstr "  Ports ouverts à des sources que cette machine rejetterait sinon\n"

msgid ""
"    none — only loopback, replies, ICMP and private-range\n"
"    sources reach this machine.\n"
msgstr ""
"    aucun — seuls la boucle locale, les réponses, ICMP et les sources\n"
"    d'adresses privées atteignent cette machine.\n"

#, c-format
msgid "    %s/%ld  from ANYWHERE, including the internet\n"
msgstr "    %s/%ld  depuis N'IMPORTE OÙ, y compris Internet\n"

#, c-format
msgid "    %s/%ld  from %s\n"
msgstr "    %s/%ld  depuis %s\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  Destinations bloquées (sortie)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (non affiché — nécessite root)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    aucune — la table synnet n'est pas chargée.\n"

msgid ""
"NetworkManager did not answer, so no network is known: private-range sources "
"are accepted on every interface.\n"
msgstr ""
"NetworkManager n'a pas répondu, aucun réseau n'est donc connu : les sources "
"en plage privée sont acceptées sur toutes les interfaces.\n"

msgid "On now:\n"
msgstr "Connecté en ce moment :\n"

#, c-format
msgid "  %-10s %s — trusted\n"
msgstr "  %-10s %s — de confiance\n"

#, c-format
msgid ""
"  %-10s %s — NOT trusted: only replies, ping, DHCP and open ports get in\n"
msgstr ""
"  %-10s %s — PAS de confiance : seuls les réponses, le ping, le DHCP et les "
"ports ouverts passent\n"

msgid "Not connected to any network.\n"
msgstr "Connecté à aucun réseau.\n"

msgid "Trusted networks:\n"
msgstr "Réseaux de confiance :\n"

msgid "No network is trusted yet.\n"
msgstr "Aucun réseau n'est encore de confiance.\n"

msgid "synnet: --ask asks the desktop user; run it as them\n"
msgstr ""
"synnet : --ask interroge l'utilisateur du bureau ; lancez-le en son nom\n"

#, c-format
msgid ""
"Trust the network “%s”?\n"
"\n"
"On a trusted network, other devices on it can reach this computer's shared "
"services — file sharing, media servers, remote desktop. Trust your own "
"networks, such as home or work. Don't trust public Wi-Fi."
msgstr ""
"Faire confiance au réseau « %s » ?\n"
"\n"
"Sur un réseau de confiance, les autres appareils qui s'y trouvent peuvent "
"joindre les services partagés de cet ordinateur — partage de fichiers, "
"serveurs multimédias, bureau à distance. Faites confiance à vos propres "
"réseaux, comme à la maison ou au travail. Pas au Wi-Fi public."

msgid "New network"
msgstr "Nouveau réseau"

msgid "Trust"
msgstr "Faire confiance"

msgid "Don't trust"
msgstr "Ne pas faire confiance"
