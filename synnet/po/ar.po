#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: يحتاج %s إلى root (sudo synnet %s %s)\n"

#, c-format
msgid ""
"synnet: no saved connection is called '%s' — `nmcli connection show` lists "
"them\n"
msgstr ""
"synnet: لا يوجد اتصال محفوظ باسم '%s' — يعرضها `nmcli connection show`\n"

#, c-format
msgid ""
"synnet: more than one connection is called '%s' — give its UUID instead\n"
msgstr "synnet: يوجد أكثر من اتصال باسم '%s' — أعطِ معرّفه UUID بدلاً من ذلك\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: تعذّر تحديث %s\n"

#, c-format
msgid ""
"synnet: %s recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: سُجِّل %s، لكن تعذّر إعادة تحميل الجدار — هذا الجهاز غير مُرشَّح عند الدخول "
"الآن\n"

#, c-format
msgid ""
"synnet: trusting “%s” — devices on it can reach this machine's services\n"
msgstr ""
"synnet: صارت “%s” موثوقة — يمكن للأجهزة عليها الوصول إلى خدمات هذا الجهاز\n"

#, c-format
msgid ""
"synnet: no longer trusting “%s” — only replies, ping, DHCP and open ports "
"get in from it\n"
msgstr ""
"synnet: لم تعد “%s” موثوقة — لا يدخل منها إلا الردود وping وDHCP والمنافذ "
"المفتوحة\n"

msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: يحتاج --firewall إلى root (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: تعذّرت الكتابة إلى %s\n"

msgid ""
"synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall "
"on` puts it back.\n"
msgstr ""
"synnet: جدار الدخول مُعطَّل — لا يُرشَّح شيء وارد. و`synnet --firewall on` يعيده.\n"

#, c-format
msgid ""
"synnet: the firewall is switched off in %s — `synnet --firewall on` to turn "
"it back on\n"
msgstr "synnet: الجدار مُعطَّل في %s — و`synnet --firewall on` يعيد تفعيله\n"

msgid ""
"synnet: could not apply the input firewall — this box is NOT ingress-"
"filtered\n"
msgstr "synnet: تعذّر تطبيق جدار الدخول — هذا الجهاز غير مُرشَّح عند الدخول\n"

msgid ""
"synnet: input firewall applied (default-drop input; loopback, established, "
"ICMP and DHCP accepted, and private-range sources on trusted networks)\n"
msgstr ""
"synnet: طُبِّق جدار الدخول (الإسقاط الافتراضي للوارد؛ ويُقبل loopback والاتصالات "
"القائمة وICMP وDHCP، والمصادر في النطاقات الخاصة على الشبكات الموثوقة)\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, "
"'_', '.', '-')\n"
msgstr ""
"synnet: '%s' ليس اسم واجهة صالحاً (1-15 محرفاً: حروف وأرقام و'_' و'.' و'-')\n"

#, c-format
msgid ""
"synnet: trusted %s in %s — the firewall is switched off, so nothing changed "
"in the kernel.\n"
msgstr "synnet: سُجِّل %s موثوقاً في %s — الجدار مُعطَّل، فلم يتغيّر شيء في النواة.\n"

#, c-format
msgid ""
"synnet: untrusted %s in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: أُزيل %s من الموثوقين في %s — الجدار مُعطَّل، فلم يتغيّر شيء في النواة.\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr "synnet: صار %s موثوقاً — ويُقبل DHCP وDNS من تلك الوصلة\n"

#, c-format
msgid ""
"synnet: no longer trusting %s — DHCP and DNS from that link are no longer "
"accepted\n"
msgstr "synnet: لم يعد %s موثوقاً — ولم يعد DHCP وDNS من تلك الوصلة مقبولين\n"

#, c-format
msgid ""
"synnet: %s does not exist yet — the rule matches by name and takes effect "
"when it appears.\n"
msgstr "synnet: %s غير موجود بعد — والقاعدة تطابق بالاسم وتسري فور ظهوره.\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal rule. Write it as <tcp|udp>/<port> and a source, "
"e.g. 'tcp/5900 100.64.0.0/10' or 'tcp/5900 any'\n"
msgstr ""
"synnet: '%s' ليست قاعدة صالحة. اكتبها على الشكل <tcp|udp>/<port> مع مصدر، "
"مثل 'tcp/5900 100.64.0.0/10' أو 'tcp/5900 any'\n"

#, c-format
msgid ""
"synnet: recorded '%s' in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: سُجّل '%s' في %s — الجدار الناري مُطفأ، لذا لم يتغيّر شيء في النواة.\n"

#, c-format
msgid ""
"synnet: removed '%s' from %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: أُزيل '%s' من %s — الجدار الناري مُطفأ، لذا لم يتغيّر شيء في النواة.\n"

#, c-format
msgid ""
"synnet: '%s' recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: سُجّل '%s'، لكن تعذّر إعادة تحميل الجدار الناري — هذا الجهاز غير مُرشَّح "
"على المدخل حاليًا\n"

#, c-format
msgid "synnet: %s is open\n"
msgstr "synnet: %s مفتوح\n"

msgid ""
"synnet: ⚠ that is open to ANY source, including the internet if this machine "
"is reachable from it. Name a CIDR to narrow it.\n"
msgstr ""
"synnet: ⚠ هذا مفتوح لأي مصدر، بما في ذلك الإنترنت إذا كان الوصول إلى هذا "
"الجهاز ممكنًا منه. حدّد CIDR لتضييقه.\n"

#, c-format
msgid "synnet: %s is closed\n"
msgstr "synnet: %s مغلق\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: خيار غير معروف '%s'\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: عنوان IPv4 غير صالح: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr ""
"synnet %s — حالة إنفاذ nftables\n"
"\n"

msgid "  Input firewall\n"
msgstr "  جدار الدخول\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    مُعطَّل — عُطِّل في %s.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr ""
"    لا يُرشَّح شيء وارد. أعد تفعيله بـ\n"
"    `sudo synnet --firewall on` أو من الإعدادات ▸ الشبكة.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    غير مُطبَّق — لا يوجد %s.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr ""
"    تنشر الخدمة ذلك الملف عند البدء؛ فإن كان synnet يعمل وهو\n"
"    مفقود، فالخدمة أقدم من هذا أو لم تستطع الكتابة في\n"
"    /run/synnet.\n"

msgid ""
"    ACTIVE — default-drop input; established traffic, and the\n"
"    local network on trusted networks, let through. Asserted by\n"
"    synnet at boot and re-checked every minute.\n"
msgstr ""
"    نشط — الإسقاط الافتراضي للوارد؛ ويُسمح بالاتصالات القائمة،\n"
"    وبالشبكة المحلية على الشبكات الموثوقة. يطبّقه synnet عند\n"
"    الإقلاع ويعيد التحقق منه كل دقيقة.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr ""
"    ⚠ أُعيد بناؤه %s مرة في هذا التشغيل — شيء على هذا الجهاز\n"
"      يُفرغ nftables.\n"

msgid ""
"    NetworkManager did not answer: private-range sources are accepted on "
"every interface.\n"
msgstr ""
"    لم يستجب NetworkManager: تُقبل المصادر في النطاقات الخاصة على كل "
"الواجهات.\n"

#, c-format
msgid "    %s: “%s” — trusted\n"
msgstr "    %s: “%s” — موثوقة\n"

#, c-format
msgid ""
"    %s: “%s” — NOT trusted; only replies, ping, DHCP and open ports get in\n"
msgstr ""
"    %s: “%s” — غير موثوقة؛ لا يدخل إلا الردود وping وDHCP والمنافذ المفتوحة\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr ""
"    فشل التطبيق — هذا الجهاز غير مُرشَّح عند الدخول.\n"
"    وما قاله nft موجود في `journalctl -u synnet`.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  وصلات الحاويات / الأجهزة الافتراضية (يُقبل عليها DHCP وDNS)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    لا شيء — %s فارغ أو غير موجود.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr ""
"    جسر الحاوية يحتاج إلى واحد: أول رزمة DHCP من ضيفه تأتي من\n"
"    0.0.0.0، وسياسة الإسقاط تبتلعها.\n"
"    و`sudo synnet --trust-if waydroid0` يضيف واحداً.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (نشِط)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (غير موجود بعد — يُطابَق بالاسم)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr ""
"    ⚠ طبّق synnet في المرة الأخيرة %s منها. نفِّذ\n"
"      `sudo synnet --firewall` لتحميل القائمة الحالية.\n"

msgid "  Live ruleset\n"
msgstr "  مجموعة القواعد الحالية\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr ""
"    (غير معروض — سرد nftables يحتاج root: sudo synnet --status)\n"
"\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr ""
"    (غير معروض — nft غير مثبَّت)\n"
"\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr ""
"    سلسلة الدخول غير مُحمَّلة في النواة.\n"
"\n"

msgid "  Ports opened to sources this box would otherwise drop\n"
msgstr "  المنافذ المفتوحة لمصادر كان هذا الجهاز ليُسقطها\n"

msgid ""
"    none — only loopback, replies, ICMP and private-range\n"
"    sources reach this machine.\n"
msgstr ""
"    لا شيء — لا يصل إلى هذا الجهاز سوى الاسترجاع المحلي والردود\n"
"    وICMP والمصادر من النطاقات الخاصة.\n"

#, c-format
msgid "    %s/%ld  from ANYWHERE, including the internet\n"
msgstr "    %s/%ld  من أي مكان، بما في ذلك الإنترنت\n"

#, c-format
msgid "    %s/%ld  from %s\n"
msgstr "    %s/%ld  من %s\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  الوجهات المحجوبة (الصادر)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (غير معروض — يحتاج root)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    لا شيء — جدول synnet غير مُحمَّل.\n"

msgid ""
"NetworkManager did not answer, so no network is known: private-range sources "
"are accepted on every interface.\n"
msgstr ""
"لم يستجب NetworkManager، لذا لا تُعرف أي شبكة: تُقبل المصادر في النطاقات "
"الخاصة على كل الواجهات.\n"

msgid "On now:\n"
msgstr "المتصل الآن:\n"

#, c-format
msgid "  %-10s %s — trusted\n"
msgstr "  %-10s %s — موثوقة\n"

#, c-format
msgid ""
"  %-10s %s — NOT trusted: only replies, ping, DHCP and open ports get in\n"
msgstr ""
"  %-10s %s — غير موثوقة: لا يدخل إلا الردود وping وDHCP والمنافذ المفتوحة\n"

msgid "Not connected to any network.\n"
msgstr "غير متصل بأي شبكة.\n"

msgid "Trusted networks:\n"
msgstr "الشبكات الموثوقة:\n"

msgid "No network is trusted yet.\n"
msgstr "لا توجد شبكة موثوقة بعد.\n"

msgid "synnet: --ask asks the desktop user; run it as them\n"
msgstr "synnet: يسأل --ask مستخدمَ سطح المكتب؛ شغّله بصفته\n"

#, c-format
msgid ""
"Trust the network “%s”?\n"
"\n"
"On a trusted network, other devices on it can reach this computer's shared "
"services — file sharing, media servers, remote desktop. Trust your own "
"networks, such as home or work. Don't trust public Wi-Fi."
msgstr ""
"هل تثق بالشبكة “%s”؟\n"
"\n"
"على الشبكة الموثوقة، يمكن للأجهزة الأخرى عليها الوصول إلى الخدمات المشتركة "
"لهذا الحاسوب — مشاركة الملفات وخوادم الوسائط وسطح المكتب البعيد. ثق بشبكاتك "
"أنت، مثل شبكة المنزل أو العمل. لا تثق بشبكات Wi-Fi العامة."

msgid "New network"
msgstr "شبكة جديدة"

msgid "Trust"
msgstr "ثق بها"

msgid "Don't trust"
msgstr "لا تثق بها"
