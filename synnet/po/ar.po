msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: يحتاج --firewall إلى root (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: تعذّرت الكتابة إلى %s\n"

msgid "synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall on` puts it back.\n"
msgstr "synnet: جدار الدخول مُعطَّل — لا يُرشَّح شيء وارد. و`synnet --firewall on` يعيده.\n"

#, c-format
msgid "synnet: the firewall is switched off in %s — `synnet --firewall on` to turn it back on\n"
msgstr "synnet: الجدار مُعطَّل في %s — و`synnet --firewall on` يعيد تفعيله\n"

msgid "synnet: could not apply the input firewall — this box is NOT ingress-filtered\n"
msgstr "synnet: تعذّر تطبيق جدار الدخول — هذا الجهاز غير مُرشَّح عند الدخول\n"

msgid "synnet: input firewall applied (default-drop input; loopback, established, ICMP, private-range sources and DHCP accepted)\n"
msgstr "synnet: طُبِّق جدار الدخول (الإسقاط الافتراضي للوارد؛ ويُقبل loopback والاتصالات القائمة وICMP والمصادر في النطاقات الخاصة وDHCP)\n"

#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: يحتاج %s إلى root (sudo synnet %s %s)\n"

#, c-format
msgid "synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, '_', '.', '-')\n"
msgstr "synnet: '%s' ليس اسم واجهة صالحاً (1-15 محرفاً: حروف وأرقام و'_' و'.' و'-')\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: تعذّر تحديث %s\n"

#, c-format
msgid "synnet: trusted %s in %s — the firewall is switched off, so nothing changed in the kernel.\n"
msgstr "synnet: سُجِّل %s موثوقاً في %s — الجدار مُعطَّل، فلم يتغيّر شيء في النواة.\n"

#, c-format
msgid "synnet: untrusted %s in %s — the firewall is switched off, so nothing changed in the kernel.\n"
msgstr "synnet: أُزيل %s من الموثوقين في %s — الجدار مُعطَّل، فلم يتغيّر شيء في النواة.\n"

#, c-format
msgid "synnet: %s recorded, but the firewall could not be reloaded — this box is NOT ingress-filtered right now\n"
msgstr "synnet: سُجِّل %s، لكن تعذّر إعادة تحميل الجدار — هذا الجهاز غير مُرشَّح عند الدخول الآن\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr "synnet: صار %s موثوقاً — ويُقبل DHCP وDNS من تلك الوصلة\n"

#, c-format
msgid "synnet: no longer trusting %s — DHCP and DNS from that link are no longer accepted\n"
msgstr "synnet: لم يعد %s موثوقاً — ولم يعد DHCP وDNS من تلك الوصلة مقبولين\n"

#, c-format
msgid "synnet: %s does not exist yet — the rule matches by name and takes effect when it appears.\n"
msgstr "synnet: %s غير موجود بعد — والقاعدة تطابق بالاسم وتسري فور ظهوره.\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: خيار غير معروف '%s'\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: عنوان IPv4 غير صالح: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr "synnet %s — حالة إنفاذ nftables\n\n"

msgid "  Input firewall\n"
msgstr "  جدار الدخول\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    مُعطَّل — عُطِّل في %s.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr "    لا يُرشَّح شيء وارد. أعد تفعيله بـ\n    `sudo synnet --firewall on` أو من الإعدادات ▸ الشبكة.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    غير مُطبَّق — لا يوجد %s.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr "    تنشر الخدمة ذلك الملف عند البدء؛ فإن كان synnet يعمل وهو\n    مفقود، فالخدمة أقدم من هذا أو لم تستطع الكتابة في\n    /run/synnet.\n"

msgid ""
"    ACTIVE — default-drop input, LAN and established traffic\n"
"    trusted. Asserted by synnet at boot and re-checked every minute.\n"
msgstr "    فعّال — إسقاط افتراضي للوارد، مع السماح للشبكة المحلية\n    وللاتصالات القائمة. يطبّقه synnet عند الإقلاع ويعيد فحصه كل دقيقة.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr "    ⚠ أُعيد بناؤه %s مرة في هذا التشغيل — شيء على هذا الجهاز\n      يُفرغ nftables.\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr "    فشل التطبيق — هذا الجهاز غير مُرشَّح عند الدخول.\n    وما قاله nft موجود في `journalctl -u synnet`.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  وصلات الحاويات / الأجهزة الافتراضية (يُقبل عليها DHCP وDNS)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    لا شيء — %s فارغ أو غير موجود.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr "    جسر الحاوية يحتاج إلى واحد: أول رزمة DHCP من ضيفه تأتي من\n    0.0.0.0، وسياسة الإسقاط تبتلعها.\n    و`sudo synnet --trust-if waydroid0` يضيف واحداً.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (نشِط)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (غير موجود بعد — يُطابَق بالاسم)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr "    ⚠ طبّق synnet في المرة الأخيرة %s منها. نفِّذ\n      `sudo synnet --firewall` لتحميل القائمة الحالية.\n"

msgid "  Live ruleset\n"
msgstr "  مجموعة القواعد الحالية\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr "    (غير معروض — سرد nftables يحتاج root: sudo synnet --status)\n\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr "    (غير معروض — nft غير مثبَّت)\n\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr "    سلسلة الدخول غير مُحمَّلة في النواة.\n\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  الوجهات المحجوبة (الصادر)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (غير معروض — يحتاج root)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    لا شيء — جدول synnet غير مُحمَّل.\n"
