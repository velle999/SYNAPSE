#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: %s necesita root (sudo synnet %s %s)\n"

#, c-format
msgid ""
"synnet: no saved connection is called '%s' — `nmcli connection show` lists "
"them\n"
msgstr ""
"synnet: ninguna conexión guardada se llama '%s' — `nmcli connection show` "
"las enumera\n"

#, c-format
msgid ""
"synnet: more than one connection is called '%s' — give its UUID instead\n"
msgstr ""
"synnet: hay más de una conexión llamada '%s' — indica su UUID en su lugar\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: no se pudo actualizar %s\n"

#, c-format
msgid ""
"synnet: %s recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: %s registrada, pero no se pudo recargar el cortafuegos — esta "
"máquina NO está filtrada en entrada ahora mismo\n"

#, c-format
msgid ""
"synnet: trusting “%s” — devices on it can reach this machine's services\n"
msgstr ""
"synnet: ahora se confía en «%s» — los dispositivos de esa red pueden acceder "
"a los servicios de este equipo\n"

#, c-format
msgid ""
"synnet: no longer trusting “%s” — only replies, ping, DHCP and open ports "
"get in from it\n"
msgstr ""
"synnet: ya no se confía en «%s» — desde esa red solo entran respuestas, "
"ping, DHCP y puertos abiertos\n"

msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: --firewall necesita root (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: no se pudo escribir %s\n"

msgid ""
"synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall "
"on` puts it back.\n"
msgstr ""
"synnet: cortafuegos de entrada APAGADO — no se filtra nada entrante. `synnet "
"--firewall on` lo devuelve.\n"

#, c-format
msgid ""
"synnet: the firewall is switched off in %s — `synnet --firewall on` to turn "
"it back on\n"
msgstr ""
"synnet: el cortafuegos está apagado en %s — `synnet --firewall on` para "
"volver a encenderlo\n"

msgid ""
"synnet: could not apply the input firewall — this box is NOT ingress-"
"filtered\n"
msgstr ""
"synnet: no se pudo aplicar el cortafuegos de entrada — esta máquina NO está "
"filtrada en entrada\n"

msgid ""
"synnet: input firewall applied (default-drop input; loopback, established, "
"ICMP and DHCP accepted, and private-range sources on trusted networks)\n"
msgstr ""
"synnet: cortafuegos de entrada aplicado (descarte por defecto en entrada; se "
"aceptan loopback, conexiones establecidas, ICMP y DHCP, y orígenes de rango "
"privado en redes de confianza)\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, "
"'_', '.', '-')\n"
msgstr ""
"synnet: '%s' no es un nombre de interfaz válido (1-15 caracteres: letras, "
"dígitos, '_', '.', '-')\n"

#, c-format
msgid ""
"synnet: trusted %s in %s — the firewall is switched off, so nothing changed "
"in the kernel.\n"
msgstr ""
"synnet: %s marcada como de confianza en %s — el cortafuegos está apagado, "
"así que nada cambió en el núcleo.\n"

#, c-format
msgid ""
"synnet: untrusted %s in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: %s retirada de las de confianza en %s — el cortafuegos está apagado, "
"así que nada cambió en el núcleo.\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr "synnet: se confía en %s — DHCP y DNS desde ese enlace se aceptan\n"

#, c-format
msgid ""
"synnet: no longer trusting %s — DHCP and DNS from that link are no longer "
"accepted\n"
msgstr ""
"synnet: ya no se confía en %s — DHCP y DNS desde ese enlace ya no se "
"aceptan\n"

#, c-format
msgid ""
"synnet: %s does not exist yet — the rule matches by name and takes effect "
"when it appears.\n"
msgstr ""
"synnet: %s todavía no existe — la regla coincide por nombre y surte efecto "
"cuando aparezca.\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal rule. Write it as <tcp|udp>/<port> and a source, "
"e.g. 'tcp/5900 100.64.0.0/10' or 'tcp/5900 any'\n"
msgstr ""
"synnet: «%s» no es una regla válida. Escríbala como <tcp|udp>/<puerto> y un "
"origen, p. ej. «tcp/5900 100.64.0.0/10» o «tcp/5900 any»\n"

#, c-format
msgid ""
"synnet: recorded '%s' in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: «%s» registrado en %s — el cortafuegos está desactivado, así que "
"nada cambió en el núcleo.\n"

#, c-format
msgid ""
"synnet: removed '%s' from %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: «%s» eliminado de %s — el cortafuegos está desactivado, así que nada "
"cambió en el núcleo.\n"

#, c-format
msgid ""
"synnet: '%s' recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: «%s» registrado, pero no se pudo recargar el cortafuegos — esta "
"máquina NO está filtrada en entrada ahora mismo\n"

#, c-format
msgid "synnet: %s is open\n"
msgstr "synnet: %s está abierto\n"

msgid ""
"synnet: ⚠ that is open to ANY source, including the internet if this machine "
"is reachable from it. Name a CIDR to narrow it.\n"
msgstr ""
"synnet: ⚠ eso está abierto a CUALQUIER origen, incluido Internet si esta "
"máquina es accesible desde allí. Indique un CIDR para acotarlo.\n"

#, c-format
msgid "synnet: %s is closed\n"
msgstr "synnet: %s está cerrado\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: opción desconocida '%s'\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: dirección IPv4 no válida: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr ""
"synnet %s — estado de aplicación de nftables\n"
"\n"

msgid "  Input firewall\n"
msgstr "  Cortafuegos de entrada\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    APAGADO — apagado en %s.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr ""
"    No se filtra nada entrante. Vuelve a encenderlo con\n"
"    `sudo synnet --firewall on`, o en Ajustes ▸ Red.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    no aplicado — no hay %s.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr ""
"    El demonio publica ese archivo al arrancar; si synnet está en\n"
"    marcha y falta, el demonio es anterior a esto o no pudo\n"
"    escribir en /run/synnet.\n"

msgid ""
"    ACTIVE — default-drop input; established traffic, and the\n"
"    local network on trusted networks, let through. Asserted by\n"
"    synnet at boot and re-checked every minute.\n"
msgstr ""
"    ACTIVO — descarte por defecto en entrada; se permiten las\n"
"    conexiones establecidas y, en redes de confianza, la red local.\n"
"    synnet lo aplica al arrancar y lo comprueba cada minuto.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr ""
"    ⚠ reconstruido %s veces en esta ejecución — algo en esta máquina\n"
"      está vaciando nftables.\n"

msgid ""
"    NetworkManager did not answer: private-range sources are accepted on "
"every interface.\n"
msgstr ""
"    NetworkManager no respondió: se aceptan orígenes de rango privado en "
"todas las interfaces.\n"

#, c-format
msgid "    %s: “%s” — trusted\n"
msgstr "    %s: «%s» — de confianza\n"

#, c-format
msgid ""
"    %s: “%s” — NOT trusted; only replies, ping, DHCP and open ports get in\n"
msgstr ""
"    %s: «%s» — NO es de confianza; solo entran respuestas, ping, DHCP y "
"puertos abiertos\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr ""
"    FALLÓ al aplicarse — esta máquina NO está filtrada en entrada.\n"
"    Mira `journalctl -u synnet` para ver qué dijo nft.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  Enlaces de contenedor / VM (se aceptan DHCP + DNS en ellos)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    ninguno — %s está vacío o no existe.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr ""
"    Un puente de contenedor necesita uno: el primer paquete DHCP de su\n"
"    huésped viene de 0.0.0.0, y la regla de descarte se lo come.\n"
"    `sudo synnet --trust-if waydroid0` añade uno.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (activo)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (todavía no existe — coincide por nombre)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr ""
"    ⚠ synnet aplicó por última vez %s de estos. Ejecuta\n"
"      `sudo synnet --firewall` para cargar la lista actual.\n"

msgid "  Live ruleset\n"
msgstr "  Conjunto de reglas activo\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr ""
"    (no se muestra — listar nftables necesita root: sudo synnet --status)\n"
"\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr ""
"    (no se muestra — nft no está instalado)\n"
"\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr ""
"    la cadena de entrada NO está cargada en el núcleo.\n"
"\n"

msgid "  Ports opened to sources this box would otherwise drop\n"
msgstr "  Puertos abiertos a orígenes que esta máquina descartaría\n"

msgid ""
"    none — only loopback, replies, ICMP and private-range\n"
"    sources reach this machine.\n"
msgstr ""
"    ninguno — solo el bucle local, las respuestas, ICMP y los orígenes\n"
"    de rangos privados llegan a esta máquina.\n"

#, c-format
msgid "    %s/%ld  from ANYWHERE, including the internet\n"
msgstr "    %s/%ld  desde CUALQUIER LUGAR, incluido Internet\n"

#, c-format
msgid "    %s/%ld  from %s\n"
msgstr "    %s/%ld  desde %s\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  Destinos bloqueados (salida)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (no se muestra — necesita root)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    ninguno — la tabla synnet no está cargada.\n"

msgid ""
"NetworkManager did not answer, so no network is known: private-range sources "
"are accepted on every interface.\n"
msgstr ""
"NetworkManager no respondió, así que no se conoce ninguna red: se aceptan "
"orígenes de rango privado en todas las interfaces.\n"

msgid "On now:\n"
msgstr "Conectado ahora:\n"

#, c-format
msgid "  %-10s %s — trusted\n"
msgstr "  %-10s %s — de confianza\n"

#, c-format
msgid ""
"  %-10s %s — NOT trusted: only replies, ping, DHCP and open ports get in\n"
msgstr ""
"  %-10s %s — NO es de confianza: solo entran respuestas, ping, DHCP y "
"puertos abiertos\n"

msgid "Not connected to any network.\n"
msgstr "No conectado a ninguna red.\n"

msgid "Trusted networks:\n"
msgstr "Redes de confianza:\n"

msgid "No network is trusted yet.\n"
msgstr "Todavía no se confía en ninguna red.\n"

msgid "synnet: --ask asks the desktop user; run it as them\n"
msgstr ""
"synnet: --ask pregunta a quien usa el escritorio; ejecútalo como esa "
"persona\n"

#, c-format
msgid ""
"Trust the network “%s”?\n"
"\n"
"On a trusted network, other devices on it can reach this computer's shared "
"services — file sharing, media servers, remote desktop. Trust your own "
"networks, such as home or work. Don't trust public Wi-Fi."
msgstr ""
"¿Confiar en la red «%s»?\n"
"\n"
"En una red de confianza, los demás dispositivos de esa red pueden acceder a "
"los servicios compartidos de este equipo: carpetas compartidas, servidores "
"multimedia, escritorio remoto. Confía en tus propias redes, como la de casa "
"o la del trabajo. No confíes en redes Wi-Fi públicas."

msgid "New network"
msgstr "Red nueva"

msgid "Trust"
msgstr "Confiar"

msgid "Don't trust"
msgstr "No confiar"
