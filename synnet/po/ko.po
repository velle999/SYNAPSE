#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: %s에는 root가 필요합니다 (sudo synnet %s %s)\n"

#, c-format
msgid ""
"synnet: no saved connection is called '%s' — `nmcli connection show` lists "
"them\n"
msgstr ""
"synnet: '%s'(이)라는 저장된 연결이 없습니다 — `nmcli connection show`로 목록"
"을 볼 수 있습니다\n"

#, c-format
msgid ""
"synnet: more than one connection is called '%s' — give its UUID instead\n"
msgstr "synnet: '%s'(이)라는 연결이 여러 개입니다 — 대신 UUID를 지정하세요\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: %s을(를) 갱신하지 못했습니다\n"

#, c-format
msgid ""
"synnet: %s recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: %s을(를) 기록했지만 방화벽을 다시 불러오지 못했습니다 — 이 컴퓨터는 "
"지금 인바운드 필터링이 되지 않습니다\n"

#, c-format
msgid ""
"synnet: trusting “%s” — devices on it can reach this machine's services\n"
msgstr ""
"synnet: “%s”을(를) 신뢰합니다 — 이 네트워크의 기기가 이 컴퓨터의 서비스에 접"
"속할 수 있습니다\n"

#, c-format
msgid ""
"synnet: no longer trusting “%s” — only replies, ping, DHCP and open ports "
"get in from it\n"
msgstr ""
"synnet: 더 이상 “%s”을(를) 신뢰하지 않습니다 — 이 네트워크에서는 응답, ping, "
"DHCP, 열린 포트만 들어옵니다\n"

msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: --firewall에는 root가 필요합니다 (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: %s에 쓰지 못했습니다\n"

msgid ""
"synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall "
"on` puts it back.\n"
msgstr ""
"synnet: 인바운드 방화벽이 꺼져 있습니다 — 들어오는 것은 아무것도 걸러지지 않"
"습니다. `synnet --firewall on`으로 되돌립니다.\n"

#, c-format
msgid ""
"synnet: the firewall is switched off in %s — `synnet --firewall on` to turn "
"it back on\n"
msgstr ""
"synnet: %s에서 방화벽이 꺼져 있습니다 — 다시 켜려면 `synnet --firewall on`\n"

msgid ""
"synnet: could not apply the input firewall — this box is NOT ingress-"
"filtered\n"
msgstr ""
"synnet: 인바운드 방화벽을 적용하지 못했습니다 — 이 컴퓨터는 인바운드 필터링"
"이 되지 않습니다\n"

msgid ""
"synnet: input firewall applied (default-drop input; loopback, established, "
"ICMP and DHCP accepted, and private-range sources on trusted networks)\n"
msgstr ""
"synnet: 인바운드 방화벽을 적용했습니다 (인바운드 기본 차단, 루프백"
"·established·ICMP·DHCP는 허용, 사설 대역 출발지는 신뢰하는 네트워크에서만 허"
"용)\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, "
"'_', '.', '-')\n"
msgstr ""
"synnet: '%s'은(는) 올바른 인터페이스 이름이 아닙니다 (1~15자: 문자, 숫자, "
"'_', '.', '-')\n"

#, c-format
msgid ""
"synnet: trusted %s in %s — the firewall is switched off, so nothing changed "
"in the kernel.\n"
msgstr ""
"synnet: %s을(를) %s에 신뢰 대상으로 기록했습니다 — 방화벽이 꺼져 있어 커널에"
"서는 아무것도 바뀌지 않았습니다.\n"

#, c-format
msgid ""
"synnet: untrusted %s in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: %s을(를) %s의 신뢰 목록에서 제거했습니다 — 방화벽이 꺼져 있어 커널에"
"서는 아무것도 바뀌지 않았습니다.\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr "synnet: %s을(를) 신뢰합니다 — 그 링크의 DHCP와 DNS는 허용됩니다\n"

#, c-format
msgid ""
"synnet: no longer trusting %s — DHCP and DNS from that link are no longer "
"accepted\n"
msgstr ""
"synnet: 더 이상 %s을(를) 신뢰하지 않습니다 — 그 링크의 DHCP와 DNS는 더 이상 "
"허용되지 않습니다\n"

#, c-format
msgid ""
"synnet: %s does not exist yet — the rule matches by name and takes effect "
"when it appears.\n"
msgstr ""
"synnet: %s은(는) 아직 없습니다 — 규칙은 이름으로 일치시키므로 나타나면 바로 "
"적용됩니다.\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal rule. Write it as <tcp|udp>/<port> and a source, "
"e.g. 'tcp/5900 100.64.0.0/10' or 'tcp/5900 any'\n"
msgstr ""
"synnet: '%s' 은(는) 올바른 규칙이 아닙니다. <tcp|udp>/<포트> 와 출발지 형식으"
"로 쓰세요. 예: 'tcp/5900 100.64.0.0/10' 또는 'tcp/5900 any'\n"

#, c-format
msgid ""
"synnet: recorded '%s' in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: '%s' 을(를) %s 에 기록했습니다 — 방화벽이 꺼져 있으므로 커널에서는 아"
"무것도 바뀌지 않았습니다.\n"

#, c-format
msgid ""
"synnet: removed '%s' from %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: '%s' 을(를) %s 에서 제거했습니다 — 방화벽이 꺼져 있으므로 커널에서는 "
"아무것도 바뀌지 않았습니다.\n"

#, c-format
msgid ""
"synnet: '%s' recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: '%s' 을(를) 기록했지만 방화벽을 다시 불러올 수 없었습니다 — 이 컴퓨터"
"는 현재 인그레스 필터링되지 않습니다\n"

#, c-format
msgid "synnet: %s is open\n"
msgstr "synnet: %s 이(가) 열렸습니다\n"

msgid ""
"synnet: ⚠ that is open to ANY source, including the internet if this machine "
"is reachable from it. Name a CIDR to narrow it.\n"
msgstr ""
"synnet: ⚠ 이는 모든 출발지에 열려 있으며, 이 컴퓨터에 접근할 수 있다면 인터넷"
"에서도 열려 있습니다. CIDR 을 지정해 범위를 좁히세요.\n"

#, c-format
msgid "synnet: %s is closed\n"
msgstr "synnet: %s 이(가) 닫혔습니다\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: 알 수 없는 옵션 '%s'\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: 잘못된 IPv4 주소: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr ""
"synnet %s — nftables 적용 상태\n"
"\n"

msgid "  Input firewall\n"
msgstr "  인바운드 방화벽\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    꺼짐 — %s에서 꺼져 있습니다.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr ""
"    들어오는 것은 아무것도 걸러지지 않습니다. 다시 켜려면\n"
"    `sudo synnet --firewall on` 또는 설정 ▸ 네트워크 에서.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    적용되지 않음 — %s이(가) 없습니다.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr ""
"    데몬은 시작할 때 그 파일을 씁니다. synnet이 실행 중인데도\n"
"    없다면 데몬이 이보다 오래되었거나 /run/synnet에 쓰지 못한\n"
"    것입니다.\n"

msgid ""
"    ACTIVE — default-drop input; established traffic, and the\n"
"    local network on trusted networks, let through. Asserted by\n"
"    synnet at boot and re-checked every minute.\n"
msgstr ""
"    활성 — 인바운드 기본 차단. 기존 연결과, 신뢰하는 네트워크에서는\n"
"    로컬 네트워크를 허용합니다. synnet이 부팅 시 적용하고\n"
"    매분 다시 확인합니다.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr ""
"    ⚠ 이번 실행에서 %s번 다시 만들어졌습니다 — 이 컴퓨터의 무언가가\n"
"      nftables를 비우고 있습니다.\n"

msgid ""
"    NetworkManager did not answer: private-range sources are accepted on "
"every interface.\n"
msgstr ""
"    NetworkManager가 응답하지 않았습니다: 사설 대역 출발지가 모든 인터페이스"
"에서 허용됩니다.\n"

#, c-format
msgid "    %s: “%s” — trusted\n"
msgstr "    %s: “%s” — 신뢰함\n"

#, c-format
msgid ""
"    %s: “%s” — NOT trusted; only replies, ping, DHCP and open ports get in\n"
msgstr ""
"    %s: “%s” — 신뢰하지 않음. 응답, ping, DHCP, 열린 포트만 들어옵니다\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr ""
"    적용에 실패했습니다 — 이 컴퓨터는 인바운드 필터링이 되지 않습니다.\n"
"    nft가 무엇이라고 했는지는 `journalctl -u synnet`에 있습니다.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  컨테이너 / VM 링크 (여기서는 DHCP + DNS를 허용)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    없음 — %s이(가) 비어 있거나 없습니다.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr ""
"    컨테이너 브리지에는 하나가 필요합니다. 게스트의 첫 DHCP 패킷은\n"
"    0.0.0.0에서 오는데, 차단 정책이 이를 삼켜 버립니다.\n"
"    `sudo synnet --trust-if waydroid0`으로 하나 추가하십시오.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (활성)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (아직 없음 — 이름으로 일치)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr ""
"    ⚠ synnet이 마지막으로 적용한 것은 %s개였습니다. 현재 목록을 불러오려면\n"
"      `sudo synnet --firewall`을 실행하십시오.\n"

msgid "  Live ruleset\n"
msgstr "  현재 규칙 집합\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr ""
"    (표시되지 않음 — nftables를 나열하려면 root가 필요합니다: sudo synnet --"
"status)\n"
"\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr ""
"    (표시되지 않음 — nft가 설치되어 있지 않습니다)\n"
"\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr ""
"    인바운드 체인이 커널에 로드되어 있지 않습니다.\n"
"\n"

msgid "  Ports opened to sources this box would otherwise drop\n"
msgstr "  원래는 버려질 출발지에 열어 둔 포트\n"

msgid ""
"    none — only loopback, replies, ICMP and private-range\n"
"    sources reach this machine.\n"
msgstr ""
"    없음 — 이 컴퓨터에는 루프백, 응답, ICMP, 사설 대역\n"
"    출발지만 도달합니다.\n"

#, c-format
msgid "    %s/%ld  from ANYWHERE, including the internet\n"
msgstr "    %s/%ld  인터넷을 포함한 모든 곳에서\n"

#, c-format
msgid "    %s/%ld  from %s\n"
msgstr "    %s/%ld  %s 에서\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  차단된 대상 (아웃바운드)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (표시되지 않음 — root가 필요합니다)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    없음 — synnet 테이블이 로드되어 있지 않습니다.\n"

msgid ""
"NetworkManager did not answer, so no network is known: private-range sources "
"are accepted on every interface.\n"
msgstr ""
"NetworkManager가 응답하지 않아 알려진 네트워크가 없습니다: 사설 대역 출발지"
"가 모든 인터페이스에서 허용됩니다.\n"

msgid "On now:\n"
msgstr "현재 연결:\n"

#, c-format
msgid "  %-10s %s — trusted\n"
msgstr "  %-10s %s — 신뢰함\n"

#, c-format
msgid ""
"  %-10s %s — NOT trusted: only replies, ping, DHCP and open ports get in\n"
msgstr "  %-10s %s — 신뢰하지 않음: 응답, ping, DHCP, 열린 포트만 들어옵니다\n"

msgid "Not connected to any network.\n"
msgstr "연결된 네트워크가 없습니다.\n"

msgid "Trusted networks:\n"
msgstr "신뢰하는 네트워크:\n"

msgid "No network is trusted yet.\n"
msgstr "아직 신뢰하는 네트워크가 없습니다.\n"

msgid "synnet: --ask asks the desktop user; run it as them\n"
msgstr ""
"synnet: --ask는 데스크톱 사용자에게 묻습니다. 해당 사용자로 실행하세요\n"

#, c-format
msgid ""
"Trust the network “%s”?\n"
"\n"
"On a trusted network, other devices on it can reach this computer's shared "
"services — file sharing, media servers, remote desktop. Trust your own "
"networks, such as home or work. Don't trust public Wi-Fi."
msgstr ""
"“%s” 네트워크를 신뢰할까요?\n"
"\n"
"신뢰하는 네트워크에서는 같은 네트워크의 다른 기기가 이 컴퓨터의 공유 서비스"
"(파일 공유, 미디어 서버, 원격 데스크톱)에 접속할 수 있습니다. 집이나 직장처"
"럼 자신의 네트워크만 신뢰하세요. 공용 Wi-Fi는 신뢰하지 마세요."

msgid "New network"
msgstr "새 네트워크"

msgid "Trust"
msgstr "신뢰"

msgid "Don't trust"
msgstr "신뢰 안 함"
