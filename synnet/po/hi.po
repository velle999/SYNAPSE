#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: %s को root चाहिए (sudo synnet %s %s)\n"

#, c-format
msgid ""
"synnet: no saved connection is called '%s' — `nmcli connection show` lists "
"them\n"
msgstr ""
"synnet: '%s' नाम का कोई सहेजा गया कनेक्शन नहीं है — `nmcli connection show` उनकी "
"सूची दिखाता है\n"

#, c-format
msgid ""
"synnet: more than one connection is called '%s' — give its UUID instead\n"
msgstr "synnet: '%s' नाम के एक से अधिक कनेक्शन हैं — इसके बजाय उसका UUID दें\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: %s अद्यतन नहीं हो सका\n"

#, c-format
msgid ""
"synnet: %s recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: %s दर्ज हो गया, पर फ़ायरवॉल फिर से लोड नहीं हो सका — यह मशीन अभी इनग्रेस-"
"फ़िल्टर्ड नहीं है\n"

#, c-format
msgid ""
"synnet: trusting “%s” — devices on it can reach this machine's services\n"
msgstr ""
"synnet: “%s” पर भरोसा किया जा रहा है — उस पर मौजूद डिवाइस इस मशीन की सेवाओं तक "
"पहुँच सकते हैं\n"

#, c-format
msgid ""
"synnet: no longer trusting “%s” — only replies, ping, DHCP and open ports "
"get in from it\n"
msgstr ""
"synnet: अब “%s” पर भरोसा नहीं — वहाँ से केवल जवाब, ping, DHCP और खुले पोर्ट ही अंदर "
"आते हैं\n"

msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: --firewall को root चाहिए (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: %s लिखा नहीं जा सका\n"

msgid ""
"synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall "
"on` puts it back.\n"
msgstr ""
"synnet: इनपुट फ़ायरवॉल बंद — आने वाला कुछ भी फ़िल्टर नहीं होता। `synnet --firewall "
"on` इसे वापस लाता है।\n"

#, c-format
msgid ""
"synnet: the firewall is switched off in %s — `synnet --firewall on` to turn "
"it back on\n"
msgstr ""
"synnet: फ़ायरवॉल %s में बंद है — फिर से चालू करने के लिए `synnet --firewall on`\n"

msgid ""
"synnet: could not apply the input firewall — this box is NOT ingress-"
"filtered\n"
msgstr "synnet: इनपुट फ़ायरवॉल लागू नहीं हो सका — यह मशीन इनग्रेस-फ़िल्टर्ड नहीं है\n"

msgid ""
"synnet: input firewall applied (default-drop input; loopback, established, "
"ICMP and DHCP accepted, and private-range sources on trusted networks)\n"
msgstr ""
"synnet: इनपुट फ़ायरवॉल लागू (इनपुट डिफ़ॉल्ट-ड्रॉप; लूपबैक, स्थापित कनेक्शन, ICMP और DHCP "
"स्वीकृत, और विश्वसनीय नेटवर्क पर निजी रेंज के स्रोत)\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, "
"'_', '.', '-')\n"
msgstr ""
"synnet: '%s' मान्य इंटरफ़ेस नाम नहीं है (1-15 अक्षर: अक्षर, अंक, '_', '.', '-')\n"

#, c-format
msgid ""
"synnet: trusted %s in %s — the firewall is switched off, so nothing changed "
"in the kernel.\n"
msgstr ""
"synnet: %s को %s में विश्वसनीय दर्ज किया — फ़ायरवॉल बंद है, इसलिए कर्नेल में कुछ नहीं "
"बदला।\n"

#, c-format
msgid ""
"synnet: untrusted %s in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: %s को %s से अविश्वसनीय दर्ज किया — फ़ायरवॉल बंद है, इसलिए कर्नेल में कुछ नहीं "
"बदला।\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr "synnet: %s पर भरोसा — उस लिंक से DHCP और DNS स्वीकार किए जाते हैं\n"

#, c-format
msgid ""
"synnet: no longer trusting %s — DHCP and DNS from that link are no longer "
"accepted\n"
msgstr ""
"synnet: अब %s पर भरोसा नहीं — उस लिंक से DHCP और DNS अब स्वीकार नहीं किए जाते\n"

#, c-format
msgid ""
"synnet: %s does not exist yet — the rule matches by name and takes effect "
"when it appears.\n"
msgstr ""
"synnet: %s अभी मौजूद नहीं — नियम नाम से मेल खाता है और उसके आते ही लागू होगा।\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal rule. Write it as <tcp|udp>/<port> and a source, "
"e.g. 'tcp/5900 100.64.0.0/10' or 'tcp/5900 any'\n"
msgstr ""
"synnet: '%s' एक वैध नियम नहीं है। इसे <tcp|udp>/<पोर्ट> और एक स्रोत के रूप में लिखें, जैसे "
"'tcp/5900 100.64.0.0/10' या 'tcp/5900 any'\n"

#, c-format
msgid ""
"synnet: recorded '%s' in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: '%s' को %s में दर्ज किया — फ़ायरवॉल बंद है, इसलिए कर्नेल में कुछ नहीं बदला।\n"

#, c-format
msgid ""
"synnet: removed '%s' from %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr "synnet: '%s' को %s से हटाया — फ़ायरवॉल बंद है, इसलिए कर्नेल में कुछ नहीं बदला।\n"

#, c-format
msgid ""
"synnet: '%s' recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: '%s' दर्ज हो गया, पर फ़ायरवॉल पुनः लोड नहीं हो सका — यह मशीन अभी इनग्रेस-"
"फ़िल्टर्ड नहीं है\n"

#, c-format
msgid "synnet: %s is open\n"
msgstr "synnet: %s खुला है\n"

msgid ""
"synnet: ⚠ that is open to ANY source, including the internet if this machine "
"is reachable from it. Name a CIDR to narrow it.\n"
msgstr ""
"synnet: ⚠ यह किसी भी स्रोत के लिए खुला है, और यदि यह मशीन इंटरनेट से पहुँच योग्य है तो "
"इंटरनेट के लिए भी। इसे सीमित करने के लिए CIDR दें।\n"

#, c-format
msgid "synnet: %s is closed\n"
msgstr "synnet: %s बंद है\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: अज्ञात विकल्प '%s'\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: अमान्य IPv4 पता: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr ""
"synnet %s — nftables प्रवर्तन स्थिति\n"
"\n"

msgid "  Input firewall\n"
msgstr "  इनपुट फ़ायरवॉल\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    बंद — %s में बंद किया गया।\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr ""
"    आने वाला कुछ भी फ़िल्टर नहीं होता। फिर से चालू करें\n"
"    `sudo synnet --firewall on` से, या सेटिंग्स ▸ नेटवर्क में।\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    लागू नहीं — कोई %s नहीं।\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr ""
"    डेमॉन शुरू होते ही वह फ़ाइल लिखता है; अगर synnet चल रहा है और\n"
"    वह नहीं है, तो डेमॉन इससे पुराना है या /run/synnet में लिख\n"
"    नहीं सका।\n"

msgid ""
"    ACTIVE — default-drop input; established traffic, and the\n"
"    local network on trusted networks, let through. Asserted by\n"
"    synnet at boot and re-checked every minute.\n"
msgstr ""
"    सक्रिय — इनपुट डिफ़ॉल्ट-ड्रॉप; स्थापित कनेक्शन और विश्वसनीय\n"
"    नेटवर्क पर स्थानीय नेटवर्क की अनुमति। synnet इसे बूट पर\n"
"    लागू करता है और हर मिनट जाँचता है।\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr ""
"    ⚠ इस रन में %s बार फिर से बना — इस मशीन पर कुछ nftables को\n"
"      खाली कर रहा है।\n"

msgid ""
"    NetworkManager did not answer: private-range sources are accepted on "
"every interface.\n"
msgstr ""
"    NetworkManager ने जवाब नहीं दिया: हर इंटरफ़ेस पर निजी रेंज के स्रोत स्वीकार किए "
"जाते हैं।\n"

#, c-format
msgid "    %s: “%s” — trusted\n"
msgstr "    %s: “%s” — विश्वसनीय\n"

#, c-format
msgid ""
"    %s: “%s” — NOT trusted; only replies, ping, DHCP and open ports get in\n"
msgstr ""
"    %s: “%s” — विश्वसनीय नहीं; केवल जवाब, ping, DHCP और खुले पोर्ट ही अंदर आते हैं\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr ""
"    लागू करने में विफल — यह मशीन इनग्रेस-फ़िल्टर्ड नहीं है।\n"
"    nft ने क्या कहा, यह `journalctl -u synnet` में है।\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  कंटेनर / VM लिंक (इन पर DHCP + DNS स्वीकार्य)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    कोई नहीं — %s खाली है या मौजूद नहीं।\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr ""
"    कंटेनर ब्रिज को एक चाहिए: उसके अतिथि का पहला DHCP पैकेट\n"
"    0.0.0.0 से आता है, और ड्रॉप नीति उसे निगल जाती है।\n"
"    `sudo synnet --trust-if waydroid0` एक जोड़ता है।\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (चालू)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (अभी मौजूद नहीं — नाम से मेल)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr ""
"    ⚠ synnet ने पिछली बार इनमें से %s लागू किए थे। वर्तमान सूची लोड करने के लिए\n"
"      `sudo synnet --firewall` चलाएँ।\n"

msgid "  Live ruleset\n"
msgstr "  वर्तमान नियम-समूह\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr ""
"    (नहीं दिखाया — nftables सूचीबद्ध करने को root चाहिए: sudo synnet --status)\n"
"\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr ""
"    (नहीं दिखाया — nft संस्थापित नहीं है)\n"
"\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr ""
"    इनपुट चेन कर्नेल में लोड नहीं है।\n"
"\n"

msgid "  Ports opened to sources this box would otherwise drop\n"
msgstr "  उन स्रोतों के लिए खुले पोर्ट जिन्हें यह मशीन अन्यथा गिरा देती\n"

msgid ""
"    none — only loopback, replies, ICMP and private-range\n"
"    sources reach this machine.\n"
msgstr ""
"    कोई नहीं — इस मशीन तक केवल लूपबैक, उत्तर, ICMP और निजी\n"
"    श्रेणियों के स्रोत पहुँचते हैं।\n"

#, c-format
msgid "    %s/%ld  from ANYWHERE, including the internet\n"
msgstr "    %s/%ld  कहीं से भी, इंटरनेट सहित\n"

#, c-format
msgid "    %s/%ld  from %s\n"
msgstr "    %s/%ld  %s से\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  अवरुद्ध गंतव्य (आउटगोइंग)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (नहीं दिखाया — root चाहिए)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    कोई नहीं — synnet तालिका लोड नहीं है।\n"

msgid ""
"NetworkManager did not answer, so no network is known: private-range sources "
"are accepted on every interface.\n"
msgstr ""
"NetworkManager ने जवाब नहीं दिया, इसलिए कोई नेटवर्क ज्ञात नहीं है: हर इंटरफ़ेस पर निजी "
"रेंज के स्रोत स्वीकार किए जाते हैं।\n"

msgid "On now:\n"
msgstr "अभी जुड़ा हुआ:\n"

#, c-format
msgid "  %-10s %s — trusted\n"
msgstr "  %-10s %s — विश्वसनीय\n"

#, c-format
msgid ""
"  %-10s %s — NOT trusted: only replies, ping, DHCP and open ports get in\n"
msgstr ""
"  %-10s %s — विश्वसनीय नहीं: केवल जवाब, ping, DHCP और खुले पोर्ट ही अंदर आते हैं\n"

msgid "Not connected to any network.\n"
msgstr "किसी नेटवर्क से नहीं जुड़ा।\n"

msgid "Trusted networks:\n"
msgstr "विश्वसनीय नेटवर्क:\n"

msgid "No network is trusted yet.\n"
msgstr "अभी तक किसी नेटवर्क पर भरोसा नहीं किया गया है।\n"

msgid "synnet: --ask asks the desktop user; run it as them\n"
msgstr ""
"synnet: --ask डेस्कटॉप उपयोगकर्ता से पूछता है; इसे उसी उपयोगकर्ता के रूप में चलाएँ\n"

#, c-format
msgid ""
"Trust the network “%s”?\n"
"\n"
"On a trusted network, other devices on it can reach this computer's shared "
"services — file sharing, media servers, remote desktop. Trust your own "
"networks, such as home or work. Don't trust public Wi-Fi."
msgstr ""
"नेटवर्क “%s” पर भरोसा करें?\n"
"\n"
"विश्वसनीय नेटवर्क पर उस नेटवर्क के दूसरे डिवाइस इस कंप्यूटर की साझा सेवाओं तक पहुँच सकते हैं — "
"फ़ाइल शेयरिंग, मीडिया सर्वर, रिमोट डेस्कटॉप। अपने खुद के नेटवर्क पर भरोसा करें, जैसे घर या "
"दफ़्तर का। सार्वजनिक Wi-Fi पर भरोसा न करें।"

msgid "New network"
msgstr "नया नेटवर्क"

msgid "Trust"
msgstr "भरोसा करें"

msgid "Don't trust"
msgstr "भरोसा न करें"
