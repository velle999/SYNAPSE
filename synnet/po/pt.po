#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: %s precisa de root (sudo synnet %s %s)\n"

#, c-format
msgid ""
"synnet: no saved connection is called '%s' — `nmcli connection show` lists "
"them\n"
msgstr ""
"synnet: nenhuma ligação guardada se chama '%s' — `nmcli connection show` "
"lista-as\n"

#, c-format
msgid ""
"synnet: more than one connection is called '%s' — give its UUID instead\n"
msgstr ""
"synnet: há mais de uma ligação chamada '%s' — indique antes o seu UUID\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: não foi possível atualizar %s\n"

#, c-format
msgid ""
"synnet: %s recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: %s registada, mas não foi possível recarregar a firewall — esta "
"máquina NÃO está filtrada à entrada neste momento\n"

#, c-format
msgid ""
"synnet: trusting “%s” — devices on it can reach this machine's services\n"
msgstr ""
"synnet: a confiar em “%s” — os dispositivos nessa rede podem aceder aos "
"serviços desta máquina\n"

#, c-format
msgid ""
"synnet: no longer trusting “%s” — only replies, ping, DHCP and open ports "
"get in from it\n"
msgstr ""
"synnet: deixou de confiar em “%s” — dessa rede só entram respostas, ping, "
"DHCP e portas abertas\n"

msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: --firewall precisa de root (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: não foi possível escrever %s\n"

msgid ""
"synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall "
"on` puts it back.\n"
msgstr ""
"synnet: firewall de entrada DESLIGADA — nada de entrada é filtrado. `synnet "
"--firewall on` repõe-na.\n"

#, c-format
msgid ""
"synnet: the firewall is switched off in %s — `synnet --firewall on` to turn "
"it back on\n"
msgstr ""
"synnet: a firewall está desligada em %s — `synnet --firewall on` para a "
"voltar a ligar\n"

msgid ""
"synnet: could not apply the input firewall — this box is NOT ingress-"
"filtered\n"
msgstr ""
"synnet: não foi possível aplicar a firewall de entrada — esta máquina NÃO "
"está filtrada à entrada\n"

msgid ""
"synnet: input firewall applied (default-drop input; loopback, established, "
"ICMP and DHCP accepted, and private-range sources on trusted networks)\n"
msgstr ""
"synnet: firewall de entrada aplicada (descarte por omissão à entrada; "
"aceitam-se loopback, ligações estabelecidas, ICMP e DHCP, e origens de gama "
"privada em redes de confiança)\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, "
"'_', '.', '-')\n"
msgstr ""
"synnet: '%s' não é um nome de interface válido (1-15 caracteres: letras, "
"dígitos, '_', '.', '-')\n"

#, c-format
msgid ""
"synnet: trusted %s in %s — the firewall is switched off, so nothing changed "
"in the kernel.\n"
msgstr ""
"synnet: %s marcada como de confiança em %s — a firewall está desligada, por "
"isso nada mudou no núcleo.\n"

#, c-format
msgid ""
"synnet: untrusted %s in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: %s retirada das de confiança em %s — a firewall está desligada, por "
"isso nada mudou no núcleo.\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr ""
"synnet: %s passa a ser de confiança — DHCP e DNS a partir dessa ligação são "
"aceites\n"

#, c-format
msgid ""
"synnet: no longer trusting %s — DHCP and DNS from that link are no longer "
"accepted\n"
msgstr ""
"synnet: %s deixa de ser de confiança — DHCP e DNS a partir dessa ligação já "
"não são aceites\n"

#, c-format
msgid ""
"synnet: %s does not exist yet — the rule matches by name and takes effect "
"when it appears.\n"
msgstr ""
"synnet: %s ainda não existe — a regra corresponde por nome e faz efeito "
"quando ela aparecer.\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal rule. Write it as <tcp|udp>/<port> and a source, "
"e.g. 'tcp/5900 100.64.0.0/10' or 'tcp/5900 any'\n"
msgstr ""
"synnet: «%s» não é uma regra válida. Escreva-a como <tcp|udp>/<porta> e uma "
"origem, p. ex. «tcp/5900 100.64.0.0/10» ou «tcp/5900 any»\n"

#, c-format
msgid ""
"synnet: recorded '%s' in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: «%s» registado em %s — a firewall está desligada, portanto nada "
"mudou no núcleo.\n"

#, c-format
msgid ""
"synnet: removed '%s' from %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: «%s» removido de %s — a firewall está desligada, portanto nada mudou "
"no núcleo.\n"

#, c-format
msgid ""
"synnet: '%s' recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: «%s» registado, mas não foi possível recarregar a firewall — esta "
"máquina NÃO está filtrada na entrada neste momento\n"

#, c-format
msgid "synnet: %s is open\n"
msgstr "synnet: %s está aberto\n"

msgid ""
"synnet: ⚠ that is open to ANY source, including the internet if this machine "
"is reachable from it. Name a CIDR to narrow it.\n"
msgstr ""
"synnet: ⚠ isso está aberto a QUALQUER origem, incluindo a Internet se esta "
"máquina for alcançável a partir dela. Indique um CIDR para restringir.\n"

#, c-format
msgid "synnet: %s is closed\n"
msgstr "synnet: %s está fechado\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: opção desconhecida '%s'\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: endereço IPv4 inválido: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr ""
"synnet %s — estado de aplicação do nftables\n"
"\n"

msgid "  Input firewall\n"
msgstr "  Firewall de entrada\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    DESLIGADA — desligada em %s.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr ""
"    Nada de entrada é filtrado. Volte a ligá-la com\n"
"    `sudo synnet --firewall on`, ou em Definições ▸ Rede.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    não aplicada — não há %s.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr ""
"    O serviço publica esse ficheiro ao arrancar; se o synnet está\n"
"    a correr e ele falta, o serviço é anterior a isto ou não\n"
"    conseguiu escrever em /run/synnet.\n"

msgid ""
"    ACTIVE — default-drop input; established traffic, and the\n"
"    local network on trusted networks, let through. Asserted by\n"
"    synnet at boot and re-checked every minute.\n"
msgstr ""
"    ATIVA — descarte por omissão à entrada; aceitam-se as ligações\n"
"    estabelecidas e, em redes de confiança, a rede local. Aplicada\n"
"    pelo synnet no arranque e verificada a cada minuto.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr ""
"    ⚠ reconstruída %s vezes nesta execução — algo nesta máquina está\n"
"      a esvaziar o nftables.\n"

msgid ""
"    NetworkManager did not answer: private-range sources are accepted on "
"every interface.\n"
msgstr ""
"    O NetworkManager não respondeu: aceitam-se origens de gama privada em "
"todas as interfaces.\n"

#, c-format
msgid "    %s: “%s” — trusted\n"
msgstr "    %s: “%s” — de confiança\n"

#, c-format
msgid ""
"    %s: “%s” — NOT trusted; only replies, ping, DHCP and open ports get in\n"
msgstr ""
"    %s: “%s” — NÃO é de confiança; só entram respostas, ping, DHCP e portas "
"abertas\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr ""
"    FALHOU ao aplicar — esta máquina NÃO está filtrada à entrada.\n"
"    Veja `journalctl -u synnet` para o que o nft disse.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  Ligações de contentor / VM (aceitam-se DHCP + DNS nelas)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    nenhuma — %s está vazio ou não existe.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr ""
"    Uma ponte de contentor precisa de uma: o primeiro pacote DHCP do\n"
"    convidado vem de 0.0.0.0, e a regra de descarte come-o.\n"
"    `sudo synnet --trust-if waydroid0` adiciona uma.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (ativo)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (ainda não existe — corresponde por nome)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr ""
"    ⚠ o synnet aplicou da última vez %s destes. Execute\n"
"      `sudo synnet --firewall` para carregar a lista atual.\n"

msgid "  Live ruleset\n"
msgstr "  Conjunto de regras em vigor\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr ""
"    (não mostrado — listar o nftables precisa de root: sudo synnet --"
"status)\n"
"\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr ""
"    (não mostrado — o nft não está instalado)\n"
"\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr ""
"    a cadeia de entrada NÃO está carregada no núcleo.\n"
"\n"

msgid "  Ports opened to sources this box would otherwise drop\n"
msgstr "  Portas abertas a origens que esta máquina descartaria\n"

msgid ""
"    none — only loopback, replies, ICMP and private-range\n"
"    sources reach this machine.\n"
msgstr ""
"    nenhuma — apenas o loopback, as respostas, ICMP e as origens\n"
"    de intervalos privados chegam a esta máquina.\n"

#, c-format
msgid "    %s/%ld  from ANYWHERE, including the internet\n"
msgstr "    %s/%ld  de QUALQUER LUGAR, incluindo a Internet\n"

#, c-format
msgid "    %s/%ld  from %s\n"
msgstr "    %s/%ld  de %s\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  Destinos bloqueados (saída)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (não mostrado — precisa de root)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    nenhum — a tabela synnet não está carregada.\n"

msgid ""
"NetworkManager did not answer, so no network is known: private-range sources "
"are accepted on every interface.\n"
msgstr ""
"O NetworkManager não respondeu, por isso nenhuma rede é conhecida: aceitam-"
"se origens de gama privada em todas as interfaces.\n"

msgid "On now:\n"
msgstr "Ligado agora:\n"

#, c-format
msgid "  %-10s %s — trusted\n"
msgstr "  %-10s %s — de confiança\n"

#, c-format
msgid ""
"  %-10s %s — NOT trusted: only replies, ping, DHCP and open ports get in\n"
msgstr ""
"  %-10s %s — NÃO é de confiança: só entram respostas, ping, DHCP e portas "
"abertas\n"

msgid "Not connected to any network.\n"
msgstr "Sem ligação a nenhuma rede.\n"

msgid "Trusted networks:\n"
msgstr "Redes de confiança:\n"

msgid "No network is trusted yet.\n"
msgstr "Ainda não há nenhuma rede de confiança.\n"

msgid "synnet: --ask asks the desktop user; run it as them\n"
msgstr ""
"synnet: --ask pergunta a quem usa o ambiente de trabalho; execute-o como "
"essa pessoa\n"

#, c-format
msgid ""
"Trust the network “%s”?\n"
"\n"
"On a trusted network, other devices on it can reach this computer's shared "
"services — file sharing, media servers, remote desktop. Trust your own "
"networks, such as home or work. Don't trust public Wi-Fi."
msgstr ""
"Confiar na rede “%s”?\n"
"\n"
"Numa rede de confiança, os outros dispositivos nessa rede podem aceder aos "
"serviços partilhados deste computador — partilha de ficheiros, servidores "
"multimédia, ambiente de trabalho remoto. Confie nas suas próprias redes, "
"como em casa ou no trabalho. Não confie em Wi-Fi público."

msgid "New network"
msgstr "Nova rede"

msgid "Trust"
msgstr "Confiar"

msgid "Don't trust"
msgstr "Não confiar"
