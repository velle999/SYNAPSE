msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: --firewall heeft root nodig (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: kon %s niet schrijven\n"

msgid "synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall on` puts it back.\n"
msgstr "synnet: inkomende firewall UIT — er wordt niets binnenkomends gefilterd. `synnet --firewall on` zet hem terug.\n"

#, c-format
msgid "synnet: the firewall is switched off in %s — `synnet --firewall on` to turn it back on\n"
msgstr "synnet: de firewall staat uit in %s — `synnet --firewall on` zet hem weer aan\n"

msgid "synnet: could not apply the input firewall — this box is NOT ingress-filtered\n"
msgstr "synnet: kon de inkomende firewall niet toepassen — deze machine is NIET ingangsgefilterd\n"

msgid "synnet: input firewall applied (default-drop input; loopback, established, ICMP, private-range sources and DHCP accepted)\n"
msgstr "synnet: inkomende firewall toegepast (standaard weigeren op inkomend; loopback, bestaande verbindingen, ICMP, bronnen uit privébereik en DHCP toegestaan)\n"

#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: %s heeft root nodig (sudo synnet %s %s)\n"

#, c-format
msgid "synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, '_', '.', '-')\n"
msgstr "synnet: '%s' is geen geldige interfacenaam (1-15 tekens: letters, cijfers, '_', '.', '-')\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: kon %s niet bijwerken\n"

#, c-format
msgid "synnet: trusted %s in %s — the firewall is switched off, so nothing changed in the kernel.\n"
msgstr "synnet: %s als vertrouwd genoteerd in %s — de firewall staat uit, dus in de kernel is niets veranderd.\n"

#, c-format
msgid "synnet: untrusted %s in %s — the firewall is switched off, so nothing changed in the kernel.\n"
msgstr "synnet: %s uit de vertrouwde lijst gehaald in %s — de firewall staat uit, dus in de kernel is niets veranderd.\n"

#, c-format
msgid "synnet: %s recorded, but the firewall could not be reloaded — this box is NOT ingress-filtered right now\n"
msgstr "synnet: %s genoteerd, maar de firewall kon niet herladen worden — deze machine is op dit moment NIET ingangsgefilterd\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr "synnet: %s wordt vertrouwd — DHCP en DNS van die link worden geaccepteerd\n"

#, c-format
msgid "synnet: no longer trusting %s — DHCP and DNS from that link are no longer accepted\n"
msgstr "synnet: %s wordt niet meer vertrouwd — DHCP en DNS van die link worden niet meer geaccepteerd\n"

#, c-format
msgid "synnet: %s does not exist yet — the rule matches by name and takes effect when it appears.\n"
msgstr "synnet: %s bestaat nog niet — de regel matcht op naam en werkt zodra hij verschijnt.\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: onbekende optie '%s'\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: ongeldig IPv4-adres: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr "synnet %s — nftables-handhavingsstatus\n\n"

msgid "  Input firewall\n"
msgstr "  Inkomende firewall\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    UIT — uitgezet in %s.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr "    Er wordt niets binnenkomends gefilterd. Zet hem weer aan met\n    `sudo synnet --firewall on`, of in Instellingen ▸ Netwerk.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    niet toegepast — geen %s.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr "    De daemon publiceert dat bestand bij het starten; als synnet\n    draait en het ontbreekt, is de daemon ouder dan dit of kon hij\n    niet naar /run/synnet schrijven.\n"

msgid ""
"    ACTIVE — default-drop input, LAN and established traffic\n"
"    trusted. Asserted by synnet at boot and re-checked every minute.\n"
msgstr "    ACTIEF — standaard weigeren op inkomend, LAN en bestaand\n    verkeer toegestaan. Toegepast door synnet bij het opstarten en elke minuut herzien.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr "    ⚠ %s keer herbouwd tijdens deze run — iets op deze machine leegt\n      nftables.\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr "    Toepassen MISLUKT — deze machine is NIET ingangsgefilterd.\n    Zie `journalctl -u synnet` voor wat nft zei.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr "  Container-/VM-links (DHCP + DNS worden hierop geaccepteerd)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    geen — %s is leeg of afwezig.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr "    Een containerbridge heeft er een nodig: het eerste DHCP-pakket van\n    de gast komt van 0.0.0.0, en de drop-regel eet het op.\n    `sudo synnet --trust-if waydroid0` voegt er een toe.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (actief)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (nog niet aanwezig — matcht op naam)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr "    ⚠ synnet paste er de vorige keer %s toe. Voer\n      `sudo synnet --firewall` uit om de huidige lijst te laden.\n"

msgid "  Live ruleset\n"
msgstr "  Actieve regelset\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr "    (niet getoond — nftables opsommen vereist root: sudo synnet --status)\n\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr "    (niet getoond — nft is niet geïnstalleerd)\n\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr "    de invoerketen is NIET in de kernel geladen.\n\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  Geblokkeerde bestemmingen (uitgaand)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (niet getoond — vereist root)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    geen — de synnet-tabel is niet geladen.\n"
