#, c-format
msgid "synnet: %s needs root (sudo synnet %s %s)\n"
msgstr "synnet: для %s нужен root (sudo synnet %s %s)\n"

#, c-format
msgid ""
"synnet: no saved connection is called '%s' — `nmcli connection show` lists "
"them\n"
msgstr ""
"synnet: нет сохранённого подключения с именем '%s' — список показывает "
"`nmcli connection show`\n"

#, c-format
msgid ""
"synnet: more than one connection is called '%s' — give its UUID instead\n"
msgstr ""
"synnet: подключений с именем '%s' больше одного — укажите вместо имени UUID\n"

#, c-format
msgid "synnet: could not update %s\n"
msgstr "synnet: не удалось обновить %s\n"

#, c-format
msgid ""
"synnet: %s recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: %s записан, но брандмауэр не удалось перезагрузить — эта машина "
"сейчас НЕ фильтруется на входе\n"

#, c-format
msgid ""
"synnet: trusting “%s” — devices on it can reach this machine's services\n"
msgstr ""
"synnet: сеть «%s» теперь доверенная — устройства в ней могут обращаться к "
"службам этого компьютера\n"

#, c-format
msgid ""
"synnet: no longer trusting “%s” — only replies, ping, DHCP and open ports "
"get in from it\n"
msgstr ""
"synnet: сеть «%s» больше не доверенная — из неё проходят только ответы, "
"ping, DHCP и открытые порты\n"

msgid "synnet: --firewall needs root (sudo synnet --firewall)\n"
msgstr "synnet: для --firewall нужен root (sudo synnet --firewall)\n"

#, c-format
msgid "synnet: could not write %s\n"
msgstr "synnet: не удалось записать %s\n"

msgid ""
"synnet: input firewall OFF — nothing inbound is filtered. `synnet --firewall "
"on` puts it back.\n"
msgstr ""
"synnet: входной брандмауэр ВЫКЛЮЧЕН — входящее не фильтруется. `synnet --"
"firewall on` вернёт его.\n"

#, c-format
msgid ""
"synnet: the firewall is switched off in %s — `synnet --firewall on` to turn "
"it back on\n"
msgstr ""
"synnet: брандмауэр выключен в %s — `synnet --firewall on` включит его снова\n"

msgid ""
"synnet: could not apply the input firewall — this box is NOT ingress-"
"filtered\n"
msgstr ""
"synnet: не удалось применить входной брандмауэр — эта машина НЕ фильтруется "
"на входе\n"

msgid ""
"synnet: input firewall applied (default-drop input; loopback, established, "
"ICMP and DHCP accepted, and private-range sources on trusted networks)\n"
msgstr ""
"synnet: входной брандмауэр применён (по умолчанию вход отбрасывается; "
"пропускаются loopback, установленные соединения, ICMP и DHCP, а в доверенных "
"сетях — источники из частных диапазонов)\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal interface name (1-15 chars: letters, digits, "
"'_', '.', '-')\n"
msgstr ""
"synnet: «%s» — недопустимое имя интерфейса (1-15 символов: буквы, цифры, "
"«_», «.», «-»)\n"

#, c-format
msgid ""
"synnet: trusted %s in %s — the firewall is switched off, so nothing changed "
"in the kernel.\n"
msgstr ""
"synnet: %s помечен доверенным в %s — брандмауэр выключен, поэтому в ядре "
"ничего не изменилось.\n"

#, c-format
msgid ""
"synnet: untrusted %s in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: %s снят с доверенных в %s — брандмауэр выключен, поэтому в ядре "
"ничего не изменилось.\n"

#, c-format
msgid "synnet: trusting %s — DHCP and DNS from that link are accepted\n"
msgstr "synnet: %s теперь доверенный — DHCP и DNS с этого канала принимаются\n"

#, c-format
msgid ""
"synnet: no longer trusting %s — DHCP and DNS from that link are no longer "
"accepted\n"
msgstr ""
"synnet: %s больше не доверенный — DHCP и DNS с этого канала больше не "
"принимаются\n"

#, c-format
msgid ""
"synnet: %s does not exist yet — the rule matches by name and takes effect "
"when it appears.\n"
msgstr ""
"synnet: %s ещё не существует — правило сопоставляется по имени и заработает, "
"когда он появится.\n"

#, c-format
msgid ""
"synnet: '%s' is not a legal rule. Write it as <tcp|udp>/<port> and a source, "
"e.g. 'tcp/5900 100.64.0.0/10' or 'tcp/5900 any'\n"
msgstr ""
"synnet: «%s» — недопустимое правило. Запишите его как <tcp|udp>/<порт> и "
"источник, например «tcp/5900 100.64.0.0/10» или «tcp/5900 any»\n"

#, c-format
msgid ""
"synnet: recorded '%s' in %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: «%s» записано в %s — брандмауэр выключен, поэтому в ядре ничего не "
"изменилось.\n"

#, c-format
msgid ""
"synnet: removed '%s' from %s — the firewall is switched off, so nothing "
"changed in the kernel.\n"
msgstr ""
"synnet: «%s» удалено из %s — брандмауэр выключен, поэтому в ядре ничего не "
"изменилось.\n"

#, c-format
msgid ""
"synnet: '%s' recorded, but the firewall could not be reloaded — this box is "
"NOT ingress-filtered right now\n"
msgstr ""
"synnet: «%s» записано, но брандмауэр не удалось перезагрузить — эта машина "
"сейчас НЕ фильтруется на входе\n"

#, c-format
msgid "synnet: %s is open\n"
msgstr "synnet: %s открыт\n"

msgid ""
"synnet: ⚠ that is open to ANY source, including the internet if this machine "
"is reachable from it. Name a CIDR to narrow it.\n"
msgstr ""
"synnet: ⚠ это открыто для ЛЮБОГО источника, включая интернет, если эта "
"машина доступна оттуда. Укажите CIDR, чтобы сузить.\n"

#, c-format
msgid "synnet: %s is closed\n"
msgstr "synnet: %s закрыт\n"

#, c-format
msgid "synnet: unknown option '%s'\n"
msgstr "synnet: неизвестный параметр «%s»\n"

#, c-format
msgid "synnet: invalid IPv4 address: %s\n"
msgstr "synnet: неверный адрес IPv4: %s\n"

#, c-format
msgid ""
"synnet %s — nftables enforcement status\n"
"\n"
msgstr ""
"synnet %s — состояние применения nftables\n"
"\n"

msgid "  Input firewall\n"
msgstr "  Входной брандмауэр\n"

#, c-format
msgid "    OFF — switched off in %s.\n"
msgstr "    ВЫКЛ — выключен в %s.\n"

msgid ""
"    Nothing inbound is filtered. Turn it back on with\n"
"    `sudo synnet --firewall on`, or in Settings ▸ Network.\n"
msgstr ""
"    Входящее не фильтруется. Включите обратно командой\n"
"    `sudo synnet --firewall on` или в Настройках ▸ Сеть.\n"

#, c-format
msgid "    not asserted — no %s.\n"
msgstr "    не применён — нет %s.\n"

msgid ""
"    The daemon publishes that file at start; if synnet is\n"
"    running and it is missing, the daemon predates this or\n"
"    could not write to /run/synnet.\n"
msgstr ""
"    Демон публикует этот файл при старте; если synnet работает,\n"
"    а файла нет, демон старше этого или не смог записать в\n"
"    /run/synnet.\n"

msgid ""
"    ACTIVE — default-drop input; established traffic, and the\n"
"    local network on trusted networks, let through. Asserted by\n"
"    synnet at boot and re-checked every minute.\n"
msgstr ""
"    АКТИВЕН — по умолчанию вход отбрасывается; пропускаются\n"
"    установленные соединения, а в доверенных сетях — локальная сеть.\n"
"    synnet применяет его при запуске и проверяет каждую минуту.\n"

#, c-format
msgid ""
"    ⚠ rebuilt %s time(s) this run — something on this box\n"
"      is flushing nftables.\n"
msgstr ""
"    ⚠ пересобран %s раз(а) за этот запуск — что-то на этой машине\n"
"      очищает nftables.\n"

msgid ""
"    NetworkManager did not answer: private-range sources are accepted on "
"every interface.\n"
msgstr ""
"    NetworkManager не ответил: источники из частных диапазонов пропускаются "
"на всех интерфейсах.\n"

#, c-format
msgid "    %s: “%s” — trusted\n"
msgstr "    %s: «%s» — доверенная\n"

#, c-format
msgid ""
"    %s: “%s” — NOT trusted; only replies, ping, DHCP and open ports get in\n"
msgstr ""
"    %s: «%s» — НЕ доверенная; проходят только ответы, ping, DHCP и открытые "
"порты\n"

msgid ""
"    FAILED to apply — this box is NOT ingress-filtered.\n"
"    See `journalctl -u synnet` for what nft said.\n"
msgstr ""
"    НЕ УДАЛОСЬ применить — эта машина НЕ фильтруется на входе.\n"
"    Что сказал nft — в `journalctl -u synnet`.\n"

msgid "  Container / VM links (DHCP + DNS accepted on these)\n"
msgstr ""
"  Каналы контейнеров и виртуальных машин (на них принимаются DHCP + DNS)\n"

#, c-format
msgid "    none — %s is empty or absent.\n"
msgstr "    нет — %s пуст или отсутствует.\n"

msgid ""
"    A container bridge needs one: its guest's first DHCP\n"
"    packet comes from 0.0.0.0 and the drop policy eats it.\n"
"    `sudo synnet --trust-if waydroid0` adds one.\n"
msgstr ""
"    Мосту контейнера он нужен: первый DHCP-пакет его гостя приходит\n"
"    с 0.0.0.0, и правило отбрасывания его съедает.\n"
"    `sudo synnet --trust-if waydroid0` добавит один.\n"

#, c-format
msgid "    %-15s (up)\n"
msgstr "    %-15s (поднят)\n"

#, c-format
msgid "    %-15s (not present yet — matched by name)\n"
msgstr "    %-15s (ещё нет — сопоставляется по имени)\n"

#, c-format
msgid ""
"    ⚠ synnet last applied %s of these. Run\n"
"      `sudo synnet --firewall` to load the current list.\n"
msgstr ""
"    ⚠ в прошлый раз synnet применил %s из них. Выполните\n"
"      `sudo synnet --firewall`, чтобы загрузить текущий список.\n"

msgid "  Live ruleset\n"
msgstr "  Действующий набор правил\n"

msgid ""
"    (not shown — listing nftables needs root: sudo synnet --status)\n"
"\n"
msgstr ""
"    (не показано — для вывода nftables нужен root: sudo synnet --status)\n"
"\n"

msgid ""
"    (not shown — nft is not installed)\n"
"\n"
msgstr ""
"    (не показано — nft не установлен)\n"
"\n"

msgid ""
"    the input chain is NOT loaded in the kernel.\n"
"\n"
msgstr ""
"    входная цепочка НЕ загружена в ядро.\n"
"\n"

msgid "  Ports opened to sources this box would otherwise drop\n"
msgstr "  Порты, открытые для источников, которые иначе были бы отброшены\n"

msgid ""
"    none — only loopback, replies, ICMP and private-range\n"
"    sources reach this machine.\n"
msgstr ""
"    нет — этой машины достигают только петля, ответы, ICMP\n"
"    и источники из частных диапазонов.\n"

#, c-format
msgid "    %s/%ld  from ANYWHERE, including the internet\n"
msgstr "    %s/%ld  ОТОВСЮДУ, включая интернет\n"

#, c-format
msgid "    %s/%ld  from %s\n"
msgstr "    %s/%ld  от %s\n"

msgid "  Blocked destinations (egress)\n"
msgstr "  Заблокированные назначения (исходящие)\n"

msgid "    (not shown — needs root)\n"
msgstr "    (не показано — нужен root)\n"

msgid "    none — the synnet table is not loaded.\n"
msgstr "    нет — таблица synnet не загружена.\n"

msgid ""
"NetworkManager did not answer, so no network is known: private-range sources "
"are accepted on every interface.\n"
msgstr ""
"NetworkManager не ответил, поэтому ни одна сеть не известна: источники из "
"частных диапазонов пропускаются на всех интерфейсах.\n"

msgid "On now:\n"
msgstr "Подключено сейчас:\n"

#, c-format
msgid "  %-10s %s — trusted\n"
msgstr "  %-10s %s — доверенная\n"

#, c-format
msgid ""
"  %-10s %s — NOT trusted: only replies, ping, DHCP and open ports get in\n"
msgstr ""
"  %-10s %s — НЕ доверенная: проходят только ответы, ping, DHCP и открытые "
"порты\n"

msgid "Not connected to any network.\n"
msgstr "Нет подключения ни к одной сети.\n"

msgid "Trusted networks:\n"
msgstr "Доверенные сети:\n"

msgid "No network is trusted yet.\n"
msgstr "Доверенных сетей пока нет.\n"

msgid "synnet: --ask asks the desktop user; run it as them\n"
msgstr ""
"synnet: --ask спрашивает пользователя рабочего стола; запускайте его от "
"этого пользователя\n"

#, c-format
msgid ""
"Trust the network “%s”?\n"
"\n"
"On a trusted network, other devices on it can reach this computer's shared "
"services — file sharing, media servers, remote desktop. Trust your own "
"networks, such as home or work. Don't trust public Wi-Fi."
msgstr ""
"Доверять сети «%s»?\n"
"\n"
"В доверенной сети другие устройства в ней могут обращаться к общим службам "
"этого компьютера — общим папкам, медиасерверам, удалённому рабочему столу. "
"Доверяйте своим сетям, например домашней или рабочей. Не доверяйте "
"общественному Wi-Fi."

msgid "New network"
msgstr "Новая сеть"

msgid "Trust"
msgstr "Доверять"

msgid "Don't trust"
msgstr "Не доверять"
