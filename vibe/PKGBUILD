# Maintainer: Velle Sinclair <brncomputerhelp@gmail.com>
pkgname=vibe
pkgver=0.1.0
pkgrel=32
pkgdesc="Vibe — local AI coding assistant (agentic read/write/edit/bash loop) wired to SynapseOS's synapd"
arch=('any')
url="https://github.com/velle999/vibe"
# Upstream ships no LICENSE file, so there is nothing to install and nothing to
# truthfully claim. Add one upstream and set this properly.
license=('GPL-2.0-or-later')

# Pure-Python runtime deps come from the Arch repos — no venv, no vendoring.
# llama-cpp-python is NOT pulled: the synapd backend (the default here) reuses
# the model already resident on the GPU, so Vibe needs no model runtime of its
# own. The two direct deps are what the app actually imports.
depends=(
    'python'
    'python-rich'            # streaming TUI output
    'python-prompt_toolkit'  # REPL input
    'synapd'                 # default backend — the resident model on SynapseOS
    # ⚠ HARD dependency, not optional. The bash tool runs model-proposed
    # commands through syn-confine's Landlock sandbox and REFUSES to run them
    # at all if it is missing — fail closed, because a shell that quietly
    # degrades to unconfined is worse than one that does not run.
    'syn-confine'
)
optdepends=(
    'ollama: alternative backend (run with VIBE_BACKEND=ollama)'
    'python-llama-cpp: direct-GGUF backend (run with VIBE_BACKEND=llama_cpp)'
    'quickshell: the chat window (vibe gui), and the bar button that opens it'
    'libsecret: store cloud API keys in the keyring instead of a file'
    # ⚠ NOT a dependency. It is where the voice stack lives — piper and
    # faster-whisper with their models — and vibe imports it rather than
    # shipping a second copy. Without it, speech falls back to espeak-ng and
    # dictation says what is missing.
    'chibi: the voice — reads answers aloud, and takes dictation'
    'espeak-ng: the fallback voice, where chibi is not installed'
    'synsh: answers everyday requests itself, classifies a line as a command,\n            and runs the ones you confirm'
    # ⚠ The OFFICIAL SDK, and an optdepend because it is not in the repos. A
    # desktop whose backend is the local one must not carry it, and Claude is
    # not reachable through an OpenAI-compatible shim without losing adaptive
    # thinking, the tool-use blocks and the refusal stop reason.
    'python-anthropic: the Claude cloud backend (vibe provider anthropic)'
)

# Built from the local working tree (the synapd backend is not upstream yet) via
# packaging/build.sh, which tars main.py + the vibe/ package + the launcher.
# ⚠ A LOCAL TARBALL, AND IT STAYS ONE. This cannot carry a release URL like
# the published components do: github.com/velle999/vibe is already vibe's OWN
# upstream repository — main.py, its own README, its own history — and a
# packaging export pushed there would overwrite a real project. Publishing this
# needs a repository under a different name, which is a decision and not a
# detail. See NOT_EXTERNAL in tools/publish-sources.sh.
source=("vibe-0.1.0.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/vibe-0.1.0"

    install -d "$pkgdir/usr/lib/vibe/app"
    # The app: entry point + the vibe package. requirements.txt/setup.sh/.venv
    # and the upstream dev launcher are dev-only and deliberately not shipped.
    cp -a main.py vibe "$pkgdir/usr/lib/vibe/app/"

    # Never bake a build-host __pycache__ or a project-local .vibe/ (runtime
    # session memory) into the package.
    rm -rf "$pkgdir/usr/lib/vibe/app/vibe/__pycache__" \
           "$pkgdir/usr/lib/vibe/app/.vibe"

    # Pure Python, but the app dir is read-only at runtime so .pyc can't be
    # written on import — precompile now to save the cold-start parse cost.
    # -s/-p rewrite the embedded source path from the build $pkgdir to the real
    # installed /usr/... path, so tracebacks are right and no $pkgdir leaks into
    # the shipped files. (A python minor bump just recompiles in memory; no break.)
    python -m compileall -q -s "$pkgdir" -p / "$pkgdir/usr/lib/vibe/app" || true

    # The chat window's QML, and the .desktop that puts it in the start menu
    # and gives the dock an icon to resolve. ⚠ The app_id `vibe` in main.py's
    # gui verb and the file name here have to agree — the dock keys on app_id,
    # and on a miss it runs the app_id AS A COMMAND.
    install -Dm644 data/vibe.qml     "$pkgdir/usr/share/vibe/vibe.qml"
    install -Dm644 data/vibe.desktop "$pkgdir/usr/share/applications/vibe.desktop"

    # ⛔ AND THE ICON THE ENTRY ABOVE HAS ALWAYS NAMED. vibe.desktop has said
    # `Icon=vibe` since the assistant got a window and nothing ever shipped a
    # `vibe` icon, so the dock, the start menu and the GNOME app grid all drew
    # whatever they use for an application that has none.
    install -Dm644 data/vibe.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/vibe.svg"

    # The hands-free listener, as a user unit. ⛔ Shipped, never enabled: it
    # holds a microphone open, and an update that started it would be the worst
    # possible version of this feature. `vibe wake on` is the opt-in.
    install -Dm644 systemd/vibe-wake.service \
        "$pkgdir/usr/lib/systemd/user/vibe-wake.service"

    # Launcher → /usr/bin/vibe. Defaults VIBE_BACKEND=synapd and puts the app on
    # PYTHONPATH. Installed to /usr/bin (NOT ~/.local/bin) so the synui session
    # PATH actually sees it.
    install -Dm755 packaging/vibe-launcher.sh "$pkgdir/usr/bin/vibe"
}
