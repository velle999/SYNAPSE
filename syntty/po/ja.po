msgid "FreeType would not initialise"
msgstr "FreeType を初期化できませんでした"

#, c-format
msgid "no font matched '%s'"
msgstr "'%s' に一致するフォントがありません"

#, c-format
msgid "%s: cannot read"
msgstr "%s: 読み込めません"

msgid "--resize wants COLSxROWS"
msgstr "--resize には COLSxROWS が必要です"

msgid "--click wants COL,ROW[,word|line]"
msgstr "--click には COL,ROW[,word|line] が必要です"

msgid "--drag wants COL,ROW"
msgstr "--drag には COL,ROW が必要です"

msgid "--select wants C0,R0,C1,R1"
msgstr "--select には C0,R0,C1,R1 が必要です"

msgid "run: need a command"
msgstr "run: コマンドが必要です"

msgid "run: cannot allocate a pty"
msgstr "run: pty を確保できません"

msgid "bench: nothing to parse"
msgstr "bench: 解析するものがありません"

#, c-format
