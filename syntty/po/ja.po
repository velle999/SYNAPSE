msgstr "mouse: '%s' はボタンではありません"

#, c-format
msgid "mouse: '%s' is not press, release, move or wheel"
msgstr "mouse: '%s' は press、release、move、wheel のいずれでもありません"

#, c-format
msgid "key: unknown option '%s'"
msgstr "key: 不明なオプション '%s'"

#, c-format
