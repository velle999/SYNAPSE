msgstr "key: '%s' はキーとしては長すぎます"

#, c-format
msgid "key: '%s' is not shift, alt, ctrl or super"
msgstr "key: '%s' は shift、alt、ctrl、super のいずれでもありません"

#, c-format
msgid "key: '%s' names no key"
msgstr "key: '%s' はどのキーも指していません"

#, c-format
