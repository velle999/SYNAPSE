msgstr "font: %s"

msgid "font: every glyph rasterised blank — the face loaded but drew nothing"
msgstr "font: すべてのグリフが空でラスタライズされました — フォントは読み込まれましたが何も描画しませんでした"

#, c-format
msgid "render: %s"
msgstr "render: %s"

