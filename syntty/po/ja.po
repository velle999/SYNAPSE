msgid_plural "%s: %d problems, first at %s"
msgstr[0] "%s: 問題が %d 件、最初は %s です"

#, c-format
msgid "unknown command '%s' (try --help; to RUN it: syntty -e %s)"
msgstr "不明なコマンド '%s' です (--help を参照。実行するには: syntty -e %s)"

