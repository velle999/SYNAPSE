msgstr "key: '%s' は keysym 名ではありません"

#, c-format
msgid "paste: unknown option '%s'"
msgstr "paste: 不明なオプション '%s'"

msgid "paste: one text at a time"
msgstr "paste: テキストは一度に一つだけです"

#, c-format
msgid "config: unknown option '%s'"
msgstr "config: 不明なオプション '%s'"

msgid "--resize: too many"
msgstr "--resize: 多すぎます"

#, c-format
msgid "unknown option '%s'"
msgstr "不明なオプション '%s'"

#, c-format
