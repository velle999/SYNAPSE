#!/usr/bin/nft -f
#
# Restrict the ollama API (tcp/11434) to loopback and chibi's Raspberry Pi.
#
# ollama has no authentication and this host runs no general firewall
# (/etc/nftables.conf exists, but nftables.service is disabled), so serving
# OLLAMA_HOST=0.0.0.0 would otherwise hand the model server to every host on
# 192.168.40.0/24.
#
# This lives in its own table so it cannot disturb synguard's `inet synnet`
# table or /etc/nftables.conf. The chain policy is accept and every drop rule
# is qualified by `tcp dport 11434`, so nothing else can be affected: UDP and
# ICMP never match a rule here and fall through to the policy.

destroy table inet ollama_guard

table inet ollama_guard {
    chain input {
        type filter hook input priority filter; policy accept;

        iif lo accept
        tcp dport 11434 ip saddr 192.168.40.248 counter accept   # chibi @ raspberrypi.lan
        tcp dport 11434 counter drop                             # everyone else; also IPv6,
                                                                 # which cannot match ip saddr
    }
}
