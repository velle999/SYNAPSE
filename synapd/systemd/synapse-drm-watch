#!/usr/bin/env bash
#
# synapse-drm-watch — record when a display connector changes state.
#
# WHY THIS EXISTS
#
# DP-3 went missing across the 2026-08-09 resume, and the journal could not say
# when it left. Between the 08-07 resume that recovered it and the 08-09 suspend
# there is not one DP-3 line anywhere: no hotplug, no link-training failure, no
# modeset error. The connector simply reads `disconnected` with a zero-byte EDID
# and nothing recorded the transition.
#
# That gap is what makes this bug unfixable rather than merely broken. Every
# question worth asking — did it drop while awake or across the suspend, did the
# kernel notice, was the compositor told — is answerable from a timestamp, and
# there was no timestamp. Guessing from a symptom seen hours later is how the
# last two attempts at this went.
#
# WHAT IT DOES
#
# Two sources, because they fail differently:
#
#   1. udev events (passive). If the driver raises a hotplug uevent, this
#      catches it with a timestamp and costs nothing. If a connector drops and
#      NO event appears here, that is itself the finding — it means the
#      compositor was never told either, which explains why nothing recovers.
#
#   2. A cached-status poll (active, cheap). sysfs `status` reads return the
#      value the driver already has; only WRITING "detect" forces a probe. So
#      this observes without disturbing the link — which matters, because a
#      watcher that re-probed every 30s would be changing the thing it is
#      supposed to be measuring.
#
# IT ALSO RECOVERS, and that is a reversal worth explaining.
#
# synapse-gpu-sleep checks ONCE, in the same second the machine resumes — the
# journal shows the 08-07 probe firing at 11:38:49 against a resume at 11:38:49.
# That is the moment connector state is least settled, and it is a one-shot: if
# the connector still reads `connected` when the hook looks and the driver drops
# it two seconds later, the hook has already looked and left, and nothing
# notices. velle confirmed DP-3 was on when the machine suspended on 08-09,
# which means it WAS in the pre-suspend snapshot, which means the hook should
# have reported it missing and did not. A race against the driver's own
# re-detection fits every piece of that.
#
# A hook that only runs at resume cannot cover a drop that happens at any other
# time either. This watcher is the only thing present whenever the link goes, so
# recovery belongs here: it re-probes on the TRANSITION rather than at a fixed
# moment, which is the whole difference.
#
# It probes only a connector the kernel still has a mode on (`enabled=enabled`)
# that has just lost its sink — the same narrow signature the sleep hook uses. A
# port with nothing plugged in reads `enabled=disabled` and is never touched.
#
# SynapseOS Project
# SPDX-License-Identifier: GPL-2.0-or-later

set -u

INTERVAL=${SYNAPSE_DRM_WATCH_INTERVAL:-20}

log() { logger -t synapse-drm-watch "$@"; }

_snapshot() {
    local c name
    for c in /sys/class/drm/card*-*; do
        [ -r "$c/status" ] || continue
        name=$(basename "$c")
        printf '%s=%s/%s/%s\n' "$name" \
            "$(cat "$c/status" 2>/dev/null)" \
            "$(cat "$c/enabled" 2>/dev/null)" \
            "$(stat -c%s "$c/edid" 2>/dev/null || echo '?')"
    done
}

# ── recovery ────────────────────────────────────────────────────────────────
#
# Fires on the TRANSITION, which is the point. A sink that has just gone is the
# best possible moment to ask for it back — the link is still settling, and the
# existing evidence is that a probe run hours later recovers nothing.
_maybe_recover() {
    local name=$1 was=$2 now=$3
    local dir=/sys/class/drm/$name tries

    # Only a head that was live and has just lost its sink. Splitting on "/"
    # rather than matching the whole string so an EDID size change alone never
    # triggers this.
    case "$was" in connected/*) ;; *) return 0 ;; esac
    case "$now" in disconnected/enabled/*) ;; *) return 0 ;; esac

    [ -w "$dir/status" ] || { log "$name: no write access to probe it back"; return 0; }

    log "$name: lost its sink while still driven — re-probing"
    for tries in 1 2 3 4 5 6; do
        # Braced: a redirection that fails reports before `||` can catch it, so
        # without this an unwritable connector spews one line per attempt.
        { echo detect > "$dir/status"; } 2>/dev/null || true
        sleep 1
        if [ "$(cat "$dir/status" 2>/dev/null)" = connected ]; then
            log "$name: came back after $tries probe(s)"
            return 0
        fi
    done

    log "$name: still no sink after 6 probes (EDID $(stat -c%s "$dir/edid" 2>/dev/null || echo ?) bytes)"
}

# ── udev half ───────────────────────────────────────────────────────────────
# Backgrounded and left to run. --udev (not --kernel) so we see what userspace
# actually got, which is the same view the compositor has.
if command -v udevadm >/dev/null 2>&1; then
    (
        udevadm monitor --udev --subsystem-match=drm 2>/dev/null |
        while read -r line; do
            case "$line" in
                *change*|*add*|*remove*) log "udev: $line" ;;
            esac
        done
    ) &
fi

# ── poll half ───────────────────────────────────────────────────────────────
prev=$(_snapshot)
log "watching: $(echo "$prev" | tr '\n' ' ')"

while :; do
    sleep "$INTERVAL"
    cur=$(_snapshot)
    [ "$cur" = "$prev" ] && continue

    # Report only what MOVED. A watcher that reprints the whole tree on every
    # change buries the one line somebody will be grepping for.
    while IFS= read -r line; do
        name=${line%%=*}
        case "$prev" in
            *"$name="*)
                was=$(printf '%s\n' "$prev" | grep "^$name=" | cut -d= -f2-)
                now=${line#*=}
                [ "$was" = "$now" ] && continue
                log "$name: $was -> $now   (status/enabled/edid-bytes)"
                _maybe_recover "$name" "$was" "$now"
                ;;
            *) log "$name: appeared as ${line#*=}" ;;
        esac
    done <<< "$cur"

    # Re-read AFTER any recovery, so a connector that came back is not reported
    # as still missing on the next pass — and so a successful probe does not
    # look like a second transition.
    prev=$(_snapshot)
done
