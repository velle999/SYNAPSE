# SynapseOS AI Daemon — privileged setup
#
# Everything synapd used to need root for, done once, up front, by a process
# that exits immediately and never touches the network or a client.
#
# synapd itself then runs as User=synapd with an empty CapabilityBoundingSet.
# That matters because synapd parses every byte that arrives on its socket, and
# that socket is reachable from the LAN on hosts running a synapd bridge. The
# parser is the last thing in the tree that should hold privilege.

[Unit]
Description=SynapseOS AI Daemon privileged setup (synapd)
Documentation=https://github.com/velle999/SYNAPSE
# Order before the DAEMON only, never the socket. A socket unit is part of
# sockets.target and starts early (right after tmpfiles makes /run/synapd);
# ordering this normal service — which runs after basic.target — before the
# socket closes a cycle: synapd.socket → synapd-setup → basic.target →
# sockets.target → synapd.socket. systemd broke it by deleting a job at random,
# and when it picked synapd.socket the daemon never socket-activated at boot
# (had to be kicked by hand, e.g. game-mode off). The socket needs nothing from
# this unit — only the daemon does (Requires=synapd-setup.service). Do NOT add
# synapd.socket back here.
Before=synapd.service
# ⛔ BEFORE persistenced, NOT AFTER — this reversed on 2026-08-28. The old
# ordering waited on nvidia-persistenced to create /dev/nvidia*, and on
# 2026-08-10 synapd started shipping a hardening drop-in for that unit whose
# NoNewPrivileges=true voids the setuid nvidia-modprobe it creates them WITH.
# It has failed on every boot since ("Failed to query NVIDIA devices"), a
# Wants= failure is not an error, and synapd fell to CPU for the whole session.
# We create the nodes ourselves now (see ExecStart below), so persistenced runs
# AFTER us and finds them already there — which is what its drop-in claims.
Before=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root

# /dev/nvidia0 + /dev/nvidiactl must exist before synapd probes for CUDA, or it
# silently falls back to CPU for the whole boot (~100x slower).
#
# They do not exist on their own. nvidia-utils ships modules-load.d/nvidia-utils.conf,
# which inserts nvidia_uvm early and so creates /dev/nvidia-uvm; that trips the
# TEST!=/dev/nvidia-uvm guard in its own 60-nvidia.rules, and udev then never
# creates the real nodes. They normally appear only when the first CUDA client
# initializes, because libcuda shells out to setuid nvidia-modprobe. synapd
# starts before any other CUDA client and NoNewPrivileges=true voids that setuid,
# so it lost the race on every boot.
#
# ⛔ THIS USED TO SAY nvidia-persistenced CREATES THEM, AND IT NO LONGER DOES.
# That was verified by hand — stop it, delete both nodes, start it, they come
# back — and it was true at the time. It creates them by dlopen()ing
# libnvidia-cfg, which execs the SETUID nvidia-modprobe. On 2026-08-10 synapd
# began shipping a hardening drop-in for that unit setting NoNewPrivileges=true,
# which voids setuid. persistenced has failed on every boot since. The check
# that passed was run on a live desktop, where the nodes existed because the
# GREETER had made them minutes earlier — a working fallback hiding the broken
# lookup, and the reason this went a fortnight without a symptom anyone traced.
#
# So it is no longer anybody else's job: synapse-nvidia-nodes below does the
# mknod itself, and persistenced is ordered AFTER us so it benefits too.
#
# nvidia-modprobe below is NOT what creates them and cannot be. When the module is
# already loaded it does `access("/sys/module/nvidia/initstate")` and exits 0 —
# a complete no-op, whatever arguments you pass. It is kept only for the case
# where the module is not loaded at all, where it does load it. Do not mistake
# its exit status for success at making device nodes.
ExecStart=-/usr/bin/nvidia-modprobe -c0 -u

# ⛔ AND THIS IS WHAT ACTUALLY CREATES THEM. Everything above is a no-op or a
# unit that cannot help; measured on the 2026-08-28 boot, /dev/nvidia0 and
# /dev/nvidiactl did not exist until 12:32:31.29 — 1.7s AFTER synapd had
# already probed for CUDA, found nothing, and loaded 7 GiB of weights into
# system RAM for the rest of the session. The script does the mknod the driver
# documents in /proc/driver/nvidia/params, and says in the journal whether it
# worked. Not `-` prefixed: it handles its own failures and always exits 0, so
# a non-zero here would be a real bug worth failing on.
ExecStart=/usr/lib/synapd/synapse-nvidia-nodes

# scheduler.c would otherwise modprobe this itself, which is what CAP_SYS_MODULE
# was for. Losing it is non-fatal: scheduler_init() falls back to userspace-only.
ExecStart=-/usr/bin/modprobe synapse_kmod

# Hand the two sysfs files synapd writes to the synapd user. Needing these as
# root is the only reason main.c ever insisted on geteuid()==0:
#   ai_hints — scheduler_update_hints(), created 0200 root:root by the kmod
#   status   — scheduler_write_status(), created 0644 root:root
# Both are opened O_WRONLY, so root ownership means EACCES for the daemon and
# the scheduler drops to "lost connection to synapse_kmod" on every write.
# Modes are preserved: status stays world-readable, ai_hints stays write-only.
#
# NOTE: the kmod recreates both on every load, so ownership resets if
# synapse_kmod is reloaded without re-running this unit.
#
# Deliberately chowned to the synapd USER, not the synapse group: the group
# holds real login users, and these steer kernel scheduling.
ExecStart=-/bin/sh -c 'for f in ai_hints status; do [ -e "/sys/kernel/synapse/$f" ] && chown synapd "/sys/kernel/synapse/$f"; done; exit 0'

[Install]
WantedBy=multi-user.target
