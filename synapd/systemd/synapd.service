# SynapseOS AI Daemon — systemd service unit
#
# Core OS service. Starts before display manager and all
# synapse-aware services. Kernel-native inference always on.
#
# This daemon holds NO privilege. Everything that needs it happens in
# synapd-setup.service (modprobe, /dev/nvidia*, ai_hints ownership) and
# synapd.socket (creating the socket as :synapse 0660) before we start.

[Unit]
Description=SynapseOS AI Daemon (synapd)
Documentation=https://github.com/velle999/SYNAPSE
After=local-fs.target network.target
Before=display-manager.service synguard.service synnet.service
Wants=local-fs.target
Requires=synapd-setup.service
After=synapd-setup.service
Requires=synapd.socket
After=synapd.socket

[Service]
Type=simple
User=synapd
Group=synapd

ExecStart=/usr/bin/synapd \
    --foreground \
    --model /var/lib/synapd/models/synapse.gguf \
    --socket /run/synapd/synapd.sock \
    --threads 4 \
    --context 4096 \
    --gpu-layers -1 \
    --auto-offload on \
    --offload-floor 1024 \
    --offload-game 4096 \
    --offload-dwell 120 \
    --offload-poll 20
# --gpu-layers -1 = auto-detect and offload to the GPU when one is present
# (synapd falls back to CPU when it isn't). The welcome menu's AI Backend
# toggle drops a synapd.service.d override here to force GPU or CPU.
#
# ── --auto-offload: give the VRAM back when something else needs it ──
#
# synapd holds the largest single allocation on the card — 7300 MiB with it up
# against 2655 MiB without, measured for the suspend hook — and until now it
# held that for the whole session no matter what else the desktop was doing.
# With this on it watches free VRAM and re-fits the model to what is left,
# running the shed layers on the CPU instead, then takes them back when the
# pressure goes.
#
# ⛔ EVERY MOVE IS A MODEL RELOAD. llama.cpp fixes n_gpu_layers when the model
# is created and cannot migrate a layer, so a change costs tens of seconds and
# the conversation's KV cache. That is why the poll is 20s and the dwell 120s
# rather than anything that would react instantly: the numbers are chosen so
# the daemon yields, not so it yields fast.
#
# --offload-floor  MiB to keep free for everyone else (not an amount to use).
# --offload-game   the same, while a client declares high demand — synui's game
#                  mode sends SYN_MSG_DEMAND when a game takes the screen. It
#                  used to run `systemctl stop synapd` instead, which took the
#                  retrieval embedder down with it for the length of the game.
# --offload-dwell  the minimum seconds between two moves.
#
# `--auto-offload off` restores the old behaviour exactly: the layer count is
# decided once, at load, and never revisited.

ExecReload=/bin/kill -HUP $MAINPID

# Always restart — synapd is a core OS service
Restart=always
RestartSec=2s
# model loading can take a moment
TimeoutStartSec=120s
TimeoutStopSec=30s

# Resource limits
LimitNOFILE=65536
# needed for model mmap and CUDA pinned host memory. This is an rlimit, not a
# capability — CAP_IPC_LOCK would only be needed to raise it past a lower cap.
LimitMEMLOCK=infinity

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synapd

# ── Hardening ────────────────────────────────────────────
# synapd parses everything that comes in over its socket, and on a box running
# the synapd bridge that socket is reachable from the LAN. So it gets no user
# privilege and no capabilities at all: the empty CapabilityBoundingSet below
# is the whole point of splitting the privileged work out into
# synapd-setup.service and synapd.socket.
#
# Deliberately NOT set, because each of these would break it:
#   PrivateDevices        — needs /dev/nvidia* for CUDA offload
#   MemoryDenyWriteExecute— CUDA generates code at runtime
#   ProtectSystem=strict  — would make /run and /var read-only; `full` gives us
#                           read-only /usr + /etc without that fallout
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectHostname=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The daemon's own state. ReadWritePaths is what it may touch under a
# ProtectSystem=full root; the model dir stays read-only.
ReadWritePaths=/var/lib/synapd/context /var/log/synapd /run/synapd
ReadOnlyPaths=/var/lib/synapd/models

[Install]
WantedBy=multi-user.target
