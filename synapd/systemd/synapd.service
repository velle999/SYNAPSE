# /etc/systemd/system/synapd.service
# SynapseOS AI Daemon — systemd service unit
#
# Core OS service. Starts before display manager and all
# synapse-aware services. Kernel-native inference always on.

[Unit]
Description=SynapseOS AI Daemon (synapd)
Documentation=https://github.com/velle999/SYNAPSE
After=local-fs.target network.target
Before=display-manager.service synguard.service synnet.service
Wants=local-fs.target
# nvidia-persistenced keeps the driver initialized and the device nodes
# present. Wants= (not Requires=) so we still start on non-NVIDIA hardware,
# where this unit does not exist.
Wants=nvidia-persistenced.service
After=nvidia-persistenced.service

[Service]
Type=simple
User=root

ExecStartPre=/bin/mkdir -p /run/synapd /var/lib/synapd /var/log/synapd
ExecStartPre=/bin/chmod 0755 /run/synapd
# Create /dev/nvidia0 + /dev/nvidiactl before we probe for CUDA.
#
# nvidia-utils ships modules-load.d/nvidia-utils.conf, which inserts nvidia_uvm
# at boot and so creates /dev/nvidia-uvm early. That trips the TEST!=/dev/nvidia-uvm
# guard in 60-nvidia.rules, and udev then never creates the real nodes. They
# normally appear only when some process calls setuid nvidia-modprobe on demand
# — which NoNewPrivileges=true forbids us from doing. synapd starts before any
# other CUDA client, so without this it finds no nodes, cannot make them, and
# silently falls back to CPU on every boot (~100x slower).
#
# Leading '-' so a machine with no NVIDIA GPU still starts. Needs CAP_MKNOD.
ExecStartPre=-/usr/bin/nvidia-modprobe -c 0 -u
ExecStart=/usr/bin/synapd \
    --foreground \
    --model /var/lib/synapd/models/synapse.gguf \
    --socket /run/synapd/synapd.sock \
    --threads 4 \
    --context 4096 \
    --gpu-layers -1
# --gpu-layers -1 = auto-detect and offload to the GPU when one is present
# (synapd falls back to CPU when it isn't). The welcome menu's AI Backend
# toggle drops a synapd.service.d override here to force GPU or CPU.

ExecReload=/bin/kill -HUP $MAINPID

# Always restart — synapd is a core OS service
Restart=always
RestartSec=2s
# model loading can take a moment
TimeoutStartSec=120s
TimeoutStopSec=30s

# Resource limits
LimitNOFILE=65536
# needed for model mmap
LimitMEMLOCK=infinity
LimitNICE=-20

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synapd

# ── Hardening ────────────────────────────────────────────
# synapd runs as root and parses everything that comes in over its socket, so
# it is the most valuable thing in the tree to fence in.
#
# Deliberately NOT set, because each of these would break it:
#   PrivateDevices        — needs /dev/nvidia* for CUDA offload
#   ProtectKernelModules  — it modprobes synapse_kmod (scheduler.c)
#   MemoryDenyWriteExecute— CUDA generates code at runtime
#   ProtectSystem=strict  — would make /run and /var read-only; `full` gives us
#                           read-only /usr + /etc without that fallout
#
# NoNewPrivileges=true stays ON. It does neuter the setuid bit on
# nvidia-modprobe, but we run as User=root and so need no escalation to run it —
# only CAP_MKNOD, which is why that capability is in the bounding set below.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectHostname=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# CAP_MKNOD lets the nvidia-modprobe ExecStartPre create /dev/nvidia*.
CapabilityBoundingSet=CAP_SYS_MODULE CAP_IPC_LOCK CAP_CHOWN CAP_DAC_OVERRIDE CAP_SYS_NICE CAP_MKNOD

[Install]
WantedBy=multi-user.target
