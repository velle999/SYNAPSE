[Unit]
Description=Record display connector state changes
Documentation=man:drm(7)
# Deliberately NOT ordered against the compositor or the sleep hooks. This must
# be running BEFORE and AFTER anything interesting happens, including across a
# suspend that a hook mishandles, or it will miss the event it exists to catch.
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/lib/synapd/synapse-drm-watch
Restart=always
RestartSec=5

# Reads sysfs, runs udevadm, and re-probes a connector that has just lost its
# sink. ProtectSystem=strict leaves /sys writable (it exempts /dev, /proc and
# /sys), which the probe needs; ProtectKernelTunables is deliberately NOT set
# for the same reason.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=
MemoryMax=32M

# Second pass, 2026-08-10: `systemd-analyze security` scored this 5.5 MEDIUM.
# It is a bash loop over sysfs plus `udevadm monitor` and `logger`; none of the
# below is anywhere near what it touches.
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

# PrivateDevices is safe here specifically because the recovery path re-probes
# through SYSFS (`echo detect > /sys/class/drm/*/status`), never through
# /dev/dri. If this script is ever changed to open a DRM node directly, this
# line has to go with it — the failure would be a silent loss of recovery,
# which is exactly the blind spot this watcher was written to close.
#
# ProtectKernelTunables stays off for the same reason the header already gives:
# it would remount /sys read-only and the probe write is the point.
# ProtectKernelLogs is fine — `logger` goes to /dev/log, not /dev/kmsg.

[Install]
WantedBy=multi-user.target
