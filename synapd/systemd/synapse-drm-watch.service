[Unit]
Description=Record display connector state changes
Documentation=man:drm(7)
# Deliberately NOT ordered against the compositor or the sleep hooks. This must
# be running BEFORE and AFTER anything interesting happens, including across a
# suspend that a hook mishandles, or it will miss the event it exists to catch.
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/lib/synapd/synapse-drm-watch
Restart=always
RestartSec=5

# Reads sysfs, runs udevadm, and re-probes a connector that has just lost its
# sink. ProtectSystem=strict leaves /sys writable (it exempts /dev, /proc and
# /sys), which the probe needs; ProtectKernelTunables is deliberately NOT set
# for the same reason.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=
MemoryMax=32M

[Install]
WantedBy=multi-user.target
