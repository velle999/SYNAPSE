#!/bin/bash
#
# synapse-gpu-sleep — release GPU contexts before the machine suspends.
#
# A process holding an NVIDIA CUDA/UVM context can be caught exiting inside
# nvidia_uvm's teardown, where it is UNFREEZABLE. When that happens the kernel
# waits 20 seconds and then gives up:
#
#   Freezing user space processes failed after 20.004 seconds
#     (1 tasks refusing to freeze, wq_busy=0):
#   task:module-rt  state:D  ... uvm_va_space_mm_shutdown [nvidia_uvm]
#
# The suspend is then ABORTED half-completed, and the NVIDIA driver comes back
# with inconsistent state. On 2026-07-28 that produced
#
#   nvidia-modeset: ERROR: Invalid request parameters, planePitch or
#                          rmObjectSizeInBytes, passed during surface registration
#
# and left DP-3 — the primary 2560x1440 display — scanning out a frozen console
# for a day, its connector reading `disconnected` with a 0-byte EDID. Only a
# reboot recovered it.
#
# THIS HOOK USED TO KILL THINGS. IT NO LONGER DOES — 2026-08-06.
#
# It SIGTERMed Plex Transcoder before every suspend, waited 3s, SIGKILLed, waited
# 0.3s, and let the suspend proceed. Two things were wrong with that.
#
# 1. The driver handles it now. systemd 256 began freezing user sessions on
#    sleep and it does not work with the NVIDIA drivers; systemd's guidance is
#    that NVIDIA packagers ship a drop-in setting
#    SYSTEMD_SLEEP_FREEZE_USER_SESSIONS=false, and nvidia-utils does, in
#    /usr/lib/systemd/system/systemd-suspend.service.d/10-nvidia-no-freeze-session.conf.
#    That landed 2026-07-28 — the day BEFORE this hook was written, against a
#    driver package that did not have it yet. Since it arrived: 6 suspends on
#    this box, zero freeze failures, including one with both Plex Media Server
#    and synapd holding CUDA contexts that froze in 0.001 seconds.
#
# 2. Killing a CUDA holder immediately before suspend is HOW YOU CREATE the
#    failure above. Read the 2026-07-28 stack again: the unfreezable task was
#    caught EXITING inside uvm_va_space_mm_shutdown. A process that is not being
#    killed is not in teardown. Bounding the wait at 3.3s and then suspending
#    anyway means releasing the machine into sleep with a process possibly still
#    in the driver — precisely the state the hook existed to avoid.
#
# The honest caveat, so nobody over-reads point 1: that drop-in governs
# systemd's session-cgroup freeze, while the 2026-07-28 abort was the KERNEL PM
# freezer ("Freezing user space processes failed"). Different mechanism. They
# interact, and the evidence since is clean, but this is not a proof.
#
# Nobody else does this. Plex runs across suspend on every other distro; that
# observation from velle is what prompted the review.
#
# WHAT IS LEFT
#
# The report, which was always the more valuable half. It never fails the
# suspend — a hook that exits non-zero does not stop systemd sleeping — so if
# something holds the GPU the only useful thing to do is NAME it. That line is
# the difference between diagnosing this from a kernel stack trace the next day
# and reading who did it.
#
# IF SUSPEND REGRESSES: the kill is in git, one revert away (synapd 0.1.0-35).
# But get the freeze failure in the journal FIRST — "Freezing user space
# processes failed ... refusing to freeze" naming the task. Without that line
# this hook is not the thing to change.
#
# SynapseOS Project
# SPDX-License-Identifier: GPL-2.0-or-later

set -u

log() { logger -t synapse-gpu-sleep "$@"; echo "synapse-gpu-sleep: $*" >&2; }

# ── Connectors that do not come back ────────────────────────────────────────
#
# Separate failure from the freezer one above, same end state. On 2026-08-06
# this box resumed CLEANLY — freeze 0.001s, nothing refusing, no modeset errors
# anywhere in the window — and DP-3, the primary 2560x1440 144Hz panel, was
# simply not there: `status=disconnected`, `enabled=enabled`, dpms On, empty
# modes, and a ZERO-BYTE EDID. A zero-byte EDID is the tell that separates this
# from the freezer bug: there is no sink answering on the AUX channel at all,
# rather than a head scanning out a stale framebuffer. The other two outputs
# came back fine, and the same panel misbehaves the same way on stock Arch, so
# the monitor (a G-Sync module panel) is not re-enumerating after the source
# drops the DP link.
#
# What we can do about it from here is ask the connector to probe again, at
# resume, while the link is still settling. HONEST LIMIT: a forced probe run by
# hand HOURS later found no sink, and only a reboot recovered that head. This
# has not yet been shown to rescue a panel that is already fully wedged — the
# bet is that a prompt retry catches the window where the sink is still coming
# back, which a human at a terminal never can. It costs a few seconds of resume
# on a machine that lost a display, and nothing at all on one that did not.
#
# A successful probe needs no further help: the sink appearing raises a hotplug
# uevent and the compositor picks the output up on its own.
STATE=/run/synapse-gpu-sleep.connected

_record_connected() {
    : > "$STATE" 2>/dev/null || return 0
    local c
    for c in /sys/class/drm/card*-*/status; do
        [ -r "$c" ] || continue
        [ "$(cat "$c" 2>/dev/null)" = connected ] || continue
        dirname "$c" >> "$STATE"
    done
}

_reprobe_missing() {
    local d missing="" tries

    # 1. Connectors that were connected when we went to sleep and are not now.
    if [ -r "$STATE" ]; then
        while read -r d; do
            [ -n "$d" ] && [ -r "$d/status" ] || continue
            [ "$(cat "$d/status" 2>/dev/null)" = connected ] && continue
            missing="$missing $d"
        done < "$STATE"
    fi
    rm -f "$STATE"

    # 2. Connectors the KERNEL still has a mode on, whose sink is gone.
    #
    # The snapshot alone is not enough, and 2026-08-09 is why. DP-3 dropped its
    # link some time overnight — the monitor powers the link down when IT goes
    # to standby, which is ordinary DisplayPort behaviour and, on this panel,
    # not something it recovers from. By the time the machine suspended at
    # 05:07 the connector already read `disconnected`, so it was never in the
    # snapshot, so this hook re-probed nothing at 12:35 and logged nothing
    # either. The display was missing and the one mechanism meant to notice had
    # correctly decided there was nothing to notice.
    #
    # `enabled=enabled` with `status=disconnected` is the exact signature and a
    # narrow one: it means a CRTC is still assigned to a connector with no sink
    # answering. A head that was never in use reads `enabled=disabled` — DP-1
    # on this box does — so this cannot start probing ports that have nothing
    # plugged into them.
    for d in /sys/class/drm/card*-*; do
        [ -r "$d/status" ] && [ -r "$d/enabled" ] || continue
        [ "$(cat "$d/status" 2>/dev/null)" = disconnected ] || continue
        [ "$(cat "$d/enabled" 2>/dev/null)" = enabled ] || continue
        case " $missing " in *" $d "*) continue ;; esac
        missing="$missing $d"
    done

    [ -n "$missing" ] || return 0

    for d in $missing; do
        log "$(basename "$d") was connected before suspend and is not now — re-probing"
        # Five attempts a second apart. Bounded deliberately: this runs inside
        # systemd-sleep's post hook, which resume waits on.
        for tries in 1 2 3 4 5; do
            # Braced: a redirection that fails reports before `||` can catch
            # it, so without this a non-writable connector spews one line per
            # attempt into the resume log.
            { echo detect > "$d/status"; } 2>/dev/null || true
            sleep 1
            if [ "$(cat "$d/status" 2>/dev/null)" = connected ]; then
                log "$(basename "$d") came back after $tries probe(s)"
                break
            fi
        done
        if [ "$(cat "$d/status" 2>/dev/null)" != connected ]; then
            log "$(basename "$d") still has no sink after 5 probes (EDID $(stat -c%s "$d/edid" 2>/dev/null || echo ?) bytes) — the panel is not re-enumerating; a power cycle of the monitor, or a reboot, is the only recovery"
        fi
    done
}

case "${1:-}" in
    pre)  _record_connected ;;
    post) _reprobe_missing; exit 0 ;;
    *)    exit 0 ;;
esac

# ── Report who holds the GPU ────────────────────────────────────────────────
#
# Not fatal, and deliberately not a kill list: synapd holds a context on
# purpose and has its own hook (synapd-sleep-hook) that releases the model
# first, and Plex holds one for transcoding and is expected to. This exists so
# that the NEXT time a suspend fails to freeze, the journal already says which
# process was holding the driver, by name.
#
# /proc/PID/comm is truncated to 15 characters, so what lands here is
# "Plex Media Serv" rather than "Plex Media Server". Do not go looking for the
# untruncated name in this output.
[ -e /dev/nvidia-uvm ] || exit 0

holders=""
for p in /proc/[0-9]*; do
    [ -r "$p/comm" ] || continue
    if ls -l "$p/fd" 2>/dev/null | grep -q nvidia-uvm; then
        holders="$holders $(cat "$p/comm" 2>/dev/null)($(basename "$p"))"
    fi
done

[ -n "$holders" ] && log "GPU contexts still open at suspend:$holders"

exit 0
