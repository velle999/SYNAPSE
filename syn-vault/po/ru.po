msgstr "не удалось закрыть «%s» — им ещё что-то пользуется.\n  Закройте всё открытое в %s и повторите."

#, c-format
msgid "'%s' is locked.\n"
msgstr "«%s» заперт.\n"

#, c-format
msgid "There is no vault called '%s'.\n"
msgstr "Сейфа с именем «%s» нет.\n"

#, c-format
msgid "'%s' is open.\n"
msgstr "«%s» открыт.\n"

#, c-format
msgid ""
"\n"
"⚠ %s has files in it while the vault is closed.\n"
"  They are NOT encrypted — they are on the ordinary disk.\n"
msgstr "\n⚠ в %s есть файлы, хотя сейф закрыт.\n  Они НЕ зашифрованы — они на обычном диске.\n"

