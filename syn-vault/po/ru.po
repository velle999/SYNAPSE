msgstr "gocryptfs не установлен."

msgid ""
"gocryptfs is not installed, and it is what does the encrypting.\n"
"  synpkg install gocryptfs"
msgstr "gocryptfs не установлен, а именно он и шифрует.\n  synpkg install gocryptfs"

msgid "that is not a usable vault name"
msgstr "это неподходящее имя для сейфа"

