msgid "gocryptfs could not create the vault (exit %d)"
msgstr "gocryptfs не смог создать сейф (код %d)"

#, c-format
msgid ""
"Made the vault '%s'.\n"
"\n"
"  syn-vault open %s   unlocks it at %s\n"
"  syn-vault close %s  locks it again\n"
"\n"
"⚠ There is no way back in without the password. Nothing else has a copy.\n"
msgstr "Сейф «%s» создан.\n\n  syn-vault open %s   отпирает его в %s\n  syn-vault close %s  запирает снова\n\n⚠ Без пароля обратно внутрь не попасть. Больше ни у чего нет копии.\n"

#, c-format
msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "сейфа с именем «%s» нет — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "«%s» уже открыт.\n"

#, c-format
msgid "could not make %s: %s"
msgstr "не удалось создать %s: %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "в %s уже есть файлы, и они НЕ в сейфе — их сохранили, пока он был закрыт,\n  поэтому они лежат на обычном диске. Уберите их в сторону, откройте сейф и\n  перенесите внутрь."

msgid "Password: "
msgstr "Пароль: "

msgid "no password given"
msgstr "пароль не введён"

