msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "non c'è nessuna cassaforte di nome '%s' — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "'%s' è già aperta.\n"

#, c-format
msgid "could not make %s: %s"
msgstr "impossibile creare %s: %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "%s contiene già file, e NON sono nella cassaforte — sono stati salvati mentre\n  era chiusa, quindi stanno sul disco normale. Spostali da parte, apri la\n  cassaforte e mettili dentro."

