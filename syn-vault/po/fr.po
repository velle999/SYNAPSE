msgid "unknown command '%s'"
msgstr "commande inconnue « %s »"

msgid "out of memory"
msgstr "mémoire épuisée"

msgid "no HOME, so there is nowhere to keep a vault"
msgstr "pas de HOME, donc nulle part où garder un coffre"

msgid "That password is not right."
msgstr "Ce mot de passe n'est pas le bon."

msgid "This vault's settings file is missing or unreadable."
msgstr "Le fichier de réglages de ce coffre est absent ou illisible."

msgid "There are already files where this vault opens, so it was left shut."
msgstr "Il y a déjà des fichiers là où ce coffre s'ouvre, il est donc resté fermé."

msgid "This vault's encrypted files are missing."
msgstr "Les fichiers chiffrés de ce coffre sont absents."

msgid "gocryptfs is not installed."
msgstr "gocryptfs n'est pas installé."

msgid ""
"gocryptfs is not installed, and it is what does the encrypting.\n"
"  synpkg install gocryptfs"
msgstr "gocryptfs n'est pas installé, et c'est lui qui chiffre.\n  synpkg install gocryptfs"

msgid "that is not a usable vault name"
msgstr "ce n'est pas un nom de coffre utilisable"

#, c-format
msgid "'%s' already exists — syn-vault open %s"
msgstr "« %s » existe déjà — syn-vault open %s"

#, c-format
msgid "could not make the vault's directories: %s"
msgstr "impossible de créer les dossiers du coffre : %s"

msgid "A password for this vault: "
msgstr "Un mot de passe pour ce coffre : "

msgid "no password, so nothing was created"
msgstr "pas de mot de passe, donc rien n'a été créé"

msgid "And again: "
msgstr "Et encore : "

msgid "those did not match, so nothing was created"
msgstr "ils ne correspondaient pas, donc rien n'a été créé"

#, c-format
msgid "gocryptfs could not create the vault (exit %d)"
msgstr "gocryptfs n'a pas pu créer le coffre (code %d)"

#, c-format
msgid ""
"Made the vault '%s'.\n"
"\n"
"  syn-vault open %s   unlocks it at %s\n"
"  syn-vault close %s  locks it again\n"
"\n"
"⚠ There is no way back in without the password. Nothing else has a copy.\n"
msgstr "Le coffre « %s » a été créé.\n\n  syn-vault open %s   le déverrouille dans %s\n  syn-vault close %s  le reverrouille\n\n⚠ Sans le mot de passe il n'y a aucun moyen d'y revenir. Rien d'autre n'en a une copie.\n"

#, c-format
msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "il n'y a pas de coffre nommé « %s » — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "« %s » est déjà ouvert.\n"

#, c-format
msgid "could not make %s: %s"
msgstr "impossible de créer %s : %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "%s contient déjà des fichiers, et ils ne sont PAS dans le coffre — ils ont été\n  enregistrés pendant qu'il était fermé, donc ils sont sur le disque ordinaire.\n  Mettez-les de côté, ouvrez le coffre, puis déplacez-les dedans."

msgid "Password: "
msgstr "Mot de passe : "

msgid "no password given"
msgstr "aucun mot de passe donné"

#, c-format
msgid "could not open '%s' (exit %d)"
msgstr "impossible d'ouvrir « %s » (code %d)"

#, c-format
msgid "'%s' is open at %s\n"
msgstr "« %s » est ouvert dans %s\n"

#, c-format
msgid "'%s' is not open.\n"
msgstr "« %s » n'est pas ouvert.\n"

#, c-format
msgid ""
"could not close '%s' — something is still using it.\n"
"  Close anything open in %s and try again."
msgstr "impossible de fermer « %s » — quelque chose l'utilise encore.\n  Fermez tout ce qui est ouvert dans %s et réessayez."

#, c-format
msgid "'%s' is locked.\n"
msgstr "« %s » est verrouillé.\n"

#, c-format
msgid "There is no vault called '%s'.\n"
msgstr "Il n'y a pas de coffre nommé « %s ».\n"

#, c-format
msgid "'%s' is open.\n"
msgstr "« %s » est ouvert.\n"

#, c-format
msgid ""
"\n"
"⚠ %s has files in it while the vault is closed.\n"
"  They are NOT encrypted — they are on the ordinary disk.\n"
msgstr "\n⚠ %s contient des fichiers alors que le coffre est fermé.\n  Ils ne sont PAS chiffrés — ils sont sur le disque ordinaire.\n"

msgid "open"
msgstr "ouvert"

#, c-format
msgid "  [%s%*s] %-24s %s   ⚠ unencrypted files here\n"
msgstr "  [%s%*s] %-24s %s   ⚠ des fichiers non chiffrés ici\n"

#, c-format
msgid "  [%s%*s] %-24s %s\n"
msgstr "  [%s%*s] %-24s %s\n"

msgid ""
"No vaults yet.\n"
"\n"
"  syn-vault create <name>\n"
msgstr "Aucun coffre pour l'instant.\n\n  syn-vault create <nom>\n"
