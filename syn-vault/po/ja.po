msgstr "gocryptfs は金庫を作成できませんでした (終了コード %d)"

#, c-format
msgid ""
"Made the vault '%s'.\n"
"\n"
"  syn-vault open %s   unlocks it at %s\n"
"  syn-vault close %s  locks it again\n"
"\n"
"⚠ There is no way back in without the password. Nothing else has a copy.\n"
msgstr "金庫 '%s' を作成しました。\n\n  syn-vault open %s   %s で解錠します\n  syn-vault close %s  再び施錠します\n\n⚠ パスワードなしで中に戻る方法はありません。控えはどこにもありません。\n"

#, c-format
msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "'%s' という金庫はありません — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "'%s' は既に開いています。\n"

#, c-format
msgid "could not make %s: %s"
msgstr "%s を作成できませんでした: %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "%s には既にファイルがあり、それらは金庫の中にありません — 閉じている間に\n  保存されたものなので、通常のディスク上にあります。いったん別の場所へ移し、\n  金庫を開けてから中へ移してください。"

msgid "Password: "
msgstr "パスワード: "

msgid "no password given"
msgstr "パスワードが入力されていません"

#, c-format
msgid "could not open '%s' (exit %d)"
msgstr "'%s' を開けませんでした (終了コード %d)"

#, c-format
msgid "'%s' is open at %s\n"
msgstr "'%s' は %s で開いています\n"

#, c-format
msgid "'%s' is not open.\n"
msgstr "'%s' は開いていません。\n"

#, c-format
msgid ""
"could not close '%s' — something is still using it.\n"
"  Close anything open in %s and try again."
msgstr "'%s' を閉じられませんでした — まだ何かが使っています。\n  %s の中で開いているものをすべて閉じてから、もう一度お試しください。"

#, c-format
msgid "'%s' is locked.\n"
msgstr "'%s' はロックされました。\n"

#, c-format
msgid "There is no vault called '%s'.\n"
msgstr "'%s' という金庫はありません。\n"

#, c-format
msgid "'%s' is open.\n"
msgstr "'%s' は開いています。\n"

#, c-format
msgid ""
"\n"
"⚠ %s has files in it while the vault is closed.\n"
"  They are NOT encrypted — they are on the ordinary disk.\n"
msgstr "\n⚠ 金庫が閉じているのに %s にファイルがあります。\n  それらは暗号化されていません — 通常のディスク上にあります。\n"

msgid "open"
msgstr "解錠中"

