msgstr "no coincidieron, así que no se creó nada"

#, c-format
msgid "gocryptfs could not create the vault (exit %d)"
msgstr "gocryptfs no pudo crear la caja fuerte (salida %d)"

#, c-format
msgid ""
"Made the vault '%s'.\n"
"\n"
"  syn-vault open %s   unlocks it at %s\n"
"  syn-vault close %s  locks it again\n"
"\n"
"⚠ There is no way back in without the password. Nothing else has a copy.\n"
msgstr "Se creó la caja fuerte '%s'.\n\n  syn-vault open %s   la desbloquea en %s\n  syn-vault close %s  la vuelve a bloquear\n\n⚠ Sin la contraseña no hay forma de volver a entrar. Nada más tiene una copia.\n"

#, c-format
msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "no hay ninguna caja fuerte llamada '%s' — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "'%s' ya está abierta.\n"

#, c-format
msgid "could not make %s: %s"
msgstr "no se pudo crear %s: %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "%s ya tiene archivos, y NO están en la caja fuerte — se guardaron mientras\n  estaba cerrada, así que están en el disco corriente. Apártalos, abre la caja\n  fuerte y muévelos dentro."

