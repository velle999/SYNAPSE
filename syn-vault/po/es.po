msgstr "No hay ninguna caja fuerte llamada '%s'.\n"

#, c-format
msgid "'%s' is open.\n"
msgstr "'%s' está abierta.\n"

#, c-format
msgid ""
"\n"
"⚠ %s has files in it while the vault is closed.\n"
