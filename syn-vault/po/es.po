"gocryptfs is not installed, and it is what does the encrypting.\n"
"  synpkg install gocryptfs"
msgstr "gocryptfs no está instalado, y es lo que hace el cifrado.\n  synpkg install gocryptfs"

msgid "that is not a usable vault name"
msgstr "ese no es un nombre de caja fuerte utilizable"

#, c-format
msgid "'%s' already exists — syn-vault open %s"
msgstr "'%s' ya existe — syn-vault open %s"

#, c-format
msgid "could not make the vault's directories: %s"
msgstr "no se pudieron crear los directorios de la caja fuerte: %s"

