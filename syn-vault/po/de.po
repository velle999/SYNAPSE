msgstr "unbekannter Befehl '%s'"

msgid "out of memory"
msgstr "Speicher erschöpft"

msgid "no HOME, so there is nowhere to keep a vault"
msgstr "kein HOME, also gibt es nirgends einen Platz für einen Tresor"

msgid "That password is not right."
msgstr "Dieses Passwort stimmt nicht."

msgid "This vault's settings file is missing or unreadable."
msgstr "Die Einstellungsdatei dieses Tresors fehlt oder ist unlesbar."

msgid "There are already files where this vault opens, so it was left shut."
msgstr "Dort, wo dieser Tresor sich öffnet, liegen bereits Dateien, also blieb er zu."

msgid "This vault's encrypted files are missing."
msgstr "Die verschlüsselten Dateien dieses Tresors fehlen."

msgid "gocryptfs is not installed."
msgstr "gocryptfs ist nicht installiert."

msgid ""
"gocryptfs is not installed, and it is what does the encrypting.\n"
"  synpkg install gocryptfs"
msgstr "gocryptfs ist nicht installiert, und es ist das, was verschlüsselt.\n  synpkg install gocryptfs"

msgid "that is not a usable vault name"
msgstr "das ist kein brauchbarer Tresorname"

#, c-format
msgid "'%s' already exists — syn-vault open %s"
msgstr "'%s' gibt es bereits — syn-vault open %s"

#, c-format
msgid "could not make the vault's directories: %s"
msgstr "die Verzeichnisse des Tresors konnten nicht angelegt werden: %s"

msgid "A password for this vault: "
msgstr "Ein Passwort für diesen Tresor: "

msgid "no password, so nothing was created"
msgstr "kein Passwort, also wurde nichts angelegt"

msgid "And again: "
msgstr "Und noch einmal: "

msgid "those did not match, so nothing was created"
msgstr "die stimmten nicht überein, also wurde nichts angelegt"

#, c-format
msgid "gocryptfs could not create the vault (exit %d)"
msgstr "gocryptfs konnte den Tresor nicht anlegen (Exit %d)"

#, c-format
msgid ""
"Made the vault '%s'.\n"
"\n"
"  syn-vault open %s   unlocks it at %s\n"
"  syn-vault close %s  locks it again\n"
"\n"
"⚠ There is no way back in without the password. Nothing else has a copy.\n"
msgstr "Der Tresor '%s' wurde angelegt.\n\n  syn-vault open %s   entsperrt ihn unter %s\n  syn-vault close %s  sperrt ihn wieder\n\n⚠ Ohne das Passwort gibt es keinen Weg zurück hinein. Nichts sonst hat eine Kopie.\n"

#, c-format
msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "es gibt keinen Tresor namens '%s' — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "'%s' ist bereits offen.\n"

#, c-format
msgid "could not make %s: %s"
msgstr "%s konnte nicht angelegt werden: %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "%s enthält bereits Dateien, und sie sind NICHT im Tresor — sie wurden\n  gespeichert, während er zu war, also liegen sie auf der gewöhnlichen Platte.\n  Schaffe sie beiseite, öffne den Tresor und verschiebe sie hinein."

msgid "Password: "
msgstr "Passwort: "

msgid "no password given"
msgstr "kein Passwort angegeben"

#, c-format
msgid "could not open '%s' (exit %d)"
msgstr "'%s' konnte nicht geöffnet werden (Exit %d)"

#, c-format
msgid "'%s' is open at %s\n"
msgstr "'%s' ist offen unter %s\n"

#, c-format
msgid "'%s' is not open.\n"
msgstr "'%s' ist nicht offen.\n"

#, c-format
msgid ""
"could not close '%s' — something is still using it.\n"
"  Close anything open in %s and try again."
msgstr "'%s' konnte nicht geschlossen werden — etwas benutzt ihn noch.\n  Schließe alles, was in %s offen ist, und versuche es erneut."

#, c-format
msgid "'%s' is locked.\n"
msgstr "'%s' ist gesperrt.\n"

#, c-format
msgid "There is no vault called '%s'.\n"
msgstr "Es gibt keinen Tresor namens '%s'.\n"

#, c-format
msgid "'%s' is open.\n"
msgstr "'%s' ist offen.\n"

#, c-format
msgid ""
"\n"
"⚠ %s has files in it while the vault is closed.\n"
"  They are NOT encrypted — they are on the ordinary disk.\n"
msgstr "\n⚠ %s enthält Dateien, während der Tresor zu ist.\n  Sie sind NICHT verschlüsselt — sie liegen auf der gewöhnlichen Platte.\n"

msgid "open"
msgstr "offen"

#, c-format
msgid "  [%s%*s] %-24s %s   ⚠ unencrypted files here\n"
msgstr "  [%s%*s] %-24s %s   ⚠ unverschlüsselte Dateien hier\n"

#, c-format
msgid "  [%s%*s] %-24s %s\n"
msgstr "  [%s%*s] %-24s %s\n"

msgid ""
"No vaults yet.\n"
"\n"
"  syn-vault create <name>\n"
msgstr "Noch keine Tresore.\n\n  syn-vault create <Name>\n"
