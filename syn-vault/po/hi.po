msgid "And again"
msgstr "और एक बार"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Create"
msgstr "बनाएँ"

msgid "File Vault"
msgstr "फ़ाइल तिजोरी"

msgid "It needs a password."
msgstr "इसे एक पासवर्ड चाहिए।"

msgid "Lock"
msgstr "लॉक करें"

msgid "New vault"
msgstr "नई तिजोरी"

msgid ""
"No vaults yet. A vault is a folder whose contents are encrypted with a "
"password — it lives in ~/Vaults while it is open, and is unreadable when it "
"is not."
msgstr "अभी कोई तिजोरी नहीं। तिजोरी एक ऐसा फ़ोल्डर है जिसकी सामग्री पासवर्ड से एन्क्रिप्ट होती है — खुली रहने पर वह ~/Vaults में रहती है, और बंद होने पर पढ़ी नहीं जा सकती।"

msgid ""
"Nothing keeps a second copy of this password. A vault whose password is lost "
"is lost with it."
msgstr "इस पासवर्ड की दूसरी प्रति कहीं नहीं रखी जाती। जिस तिजोरी का पासवर्ड खो गया, वह भी खो गई।"

msgid "Open"
msgstr "खोलें"

msgid "Password"
msgstr "पासवर्ड"

msgid "Those two do not match."
msgstr "ये दोनों मेल नहीं खाते।"

msgid "Unlock"
msgstr "अनलॉक करें"

msgid "Unlock %1"
msgstr "%1 को अनलॉक करें"

msgid "Vaults"
msgstr "तिजोरियाँ"

msgid "What to call it"
msgstr "इसे क्या नाम दें"

msgid "Working…"
msgstr "काम चल रहा…"

msgid "could not close it"
msgstr "इसे बंद नहीं किया जा सका"

msgid "locked"
msgstr "लॉक"

msgid "locked · files in %1 are NOT encrypted"
msgstr "लॉक · %1 में मौजूद फ़ाइलें एन्क्रिप्टेड नहीं हैं"

msgid "open · %1"
msgstr "खुली · %1"

msgid "that did not work"
msgstr "वह काम नहीं आया"

msgid "no display — syn-vault gui needs a graphical session"
msgstr "कोई डिस्प्ले नहीं — syn-vault gui को ग्राफ़िकल सत्र चाहिए"

msgid "quickshell is not installed — synpkg install quickshell"
msgstr "quickshell संस्थापित नहीं है — synpkg install quickshell"

msgid "could not start quickshell"
msgstr "quickshell शुरू नहीं किया जा सका"

#, c-format
msgid "unknown option '%s'"
msgstr "अज्ञात विकल्प '%s'"

#, c-format
msgid "%s needs the name of a vault"
msgstr "%s को एक तिजोरी का नाम चाहिए"

#, c-format
msgid "unknown command '%s'"
msgstr "अज्ञात कमांड '%s'"

msgid "out of memory"
msgstr "स्मृति समाप्त"

msgid "no HOME, so there is nowhere to keep a vault"
msgstr "कोई HOME नहीं, इसलिए तिजोरी रखने की जगह नहीं है"

msgid "That password is not right."
msgstr "वह पासवर्ड सही नहीं है।"

msgid "This vault's settings file is missing or unreadable."
msgstr "इस तिजोरी की सेटिंग फ़ाइल अनुपस्थित है या पढ़ी नहीं जा सकती।"

msgid "There are already files where this vault opens, so it was left shut."
msgstr "जहाँ यह तिजोरी खुलती है वहाँ पहले से फ़ाइलें हैं, इसलिए यह बंद ही रही।"

msgid "This vault's encrypted files are missing."
msgstr "इस तिजोरी की एन्क्रिप्टेड फ़ाइलें अनुपस्थित हैं।"

msgid "gocryptfs is not installed."
msgstr "gocryptfs संस्थापित नहीं है।"

msgid ""
"gocryptfs is not installed, and it is what does the encrypting.\n"
"  synpkg install gocryptfs"
msgstr "gocryptfs संस्थापित नहीं है, और एन्क्रिप्शन यही करता है।\n  synpkg install gocryptfs"

msgid "that is not a usable vault name"
msgstr "यह तिजोरी का उपयोगी नाम नहीं है"

#, c-format
msgid "'%s' already exists — syn-vault open %s"
msgstr "'%s' पहले से मौजूद है — syn-vault open %s"

#, c-format
msgid "could not make the vault's directories: %s"
msgstr "तिजोरी की निर्देशिकाएँ नहीं बनाई जा सकीं: %s"

msgid "A password for this vault: "
msgstr "इस तिजोरी के लिए एक पासवर्ड: "

msgid "no password, so nothing was created"
msgstr "कोई पासवर्ड नहीं, इसलिए कुछ नहीं बनाया गया"

msgid "And again: "
msgstr "और एक बार: "

msgid "those did not match, so nothing was created"
msgstr "वे मेल नहीं खाए, इसलिए कुछ नहीं बनाया गया"

#, c-format
msgid "gocryptfs could not create the vault (exit %d)"
msgstr "gocryptfs तिजोरी नहीं बना सका (निकास %d)"

#, c-format
msgid ""
"Made the vault '%s'.\n"
"\n"
"  syn-vault open %s   unlocks it at %s\n"
"  syn-vault close %s  locks it again\n"
"\n"
"⚠ There is no way back in without the password. Nothing else has a copy.\n"
msgstr "तिजोरी '%s' बना दी गई।\n\n  syn-vault open %s   इसे %s पर खोलता है\n  syn-vault close %s  इसे फिर से लॉक करता है\n\n⚠ पासवर्ड के बिना वापस अंदर जाने का कोई रास्ता नहीं। और कहीं कोई प्रति नहीं है।\n"

#, c-format
msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "'%s' नाम की कोई तिजोरी नहीं — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "'%s' पहले से खुली है।\n"

#, c-format
msgid "could not make %s: %s"
msgstr "%s नहीं बनाया जा सका: %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "%s में पहले से फ़ाइलें हैं, और वे तिजोरी में नहीं हैं — वे तब सहेजी गईं जब वह\n  बंद थी, इसलिए वे साधारण डिस्क पर हैं। उन्हें एक ओर हटाएँ, तिजोरी खोलें, फिर\n  उन्हें अंदर ले जाएँ।"

msgid "Password: "
msgstr "पासवर्ड: "

msgid "no password given"
msgstr "कोई पासवर्ड नहीं दिया गया"

#, c-format
msgid "could not open '%s' (exit %d)"
msgstr "'%s' नहीं खोली जा सकी (निकास %d)"

#, c-format
msgid "'%s' is open at %s\n"
msgstr "'%s' %s पर खुली है\n"

#, c-format
msgid "'%s' is not open.\n"
msgstr "'%s' खुली नहीं है।\n"

#, c-format
msgid ""
"could not close '%s' — something is still using it.\n"
"  Close anything open in %s and try again."
msgstr "'%s' बंद नहीं की जा सकी — कुछ अब भी इसका उपयोग कर रहा है।\n  %s में खुली हर चीज़ बंद करें और फिर कोशिश करें।"

#, c-format
msgid "'%s' is locked.\n"
msgstr "'%s' लॉक है।\n"

#, c-format
msgid "There is no vault called '%s'.\n"
msgstr "'%s' नाम की कोई तिजोरी नहीं है।\n"

#, c-format
msgid "'%s' is open.\n"
msgstr "'%s' खुली है।\n"

#, c-format
msgid ""
"\n"
"⚠ %s has files in it while the vault is closed.\n"
"  They are NOT encrypted — they are on the ordinary disk.\n"
msgstr "\n⚠ तिजोरी बंद है फिर भी %s में फ़ाइलें हैं।\n  वे एन्क्रिप्टेड नहीं हैं — वे साधारण डिस्क पर हैं।\n"

msgid "open"
msgstr "खुली"

#, c-format
msgid "  [%s%*s] %-24s %s   ⚠ unencrypted files here\n"
msgstr "  [%s%*s] %-24s %s   ⚠ यहाँ बिना एन्क्रिप्शन की फ़ाइलें\n"

#, c-format
msgid "  [%s%*s] %-24s %s\n"
msgstr "  [%s%*s] %-24s %s\n"

msgid ""
"No vaults yet.\n"
"\n"
"  syn-vault create <name>\n"
msgstr "अभी कोई तिजोरी नहीं।\n\n  syn-vault create <नाम>\n"
