msgstr "o gocryptfs não conseguiu criar o cofre (saída %d)"

#, c-format
msgid ""
"Made the vault '%s'.\n"
"\n"
"  syn-vault open %s   unlocks it at %s\n"
"  syn-vault close %s  locks it again\n"
"\n"
"⚠ There is no way back in without the password. Nothing else has a copy.\n"
msgstr "O cofre '%s' foi criado.\n\n  syn-vault open %s   desbloqueia-o em %s\n  syn-vault close %s  volta a bloqueá-lo\n\n⚠ Sem a palavra-passe não há como voltar a entrar. Mais nada tem uma cópia.\n"

#, c-format
msgid "there is no vault called '%s' — syn-vault create %s"
msgstr "não há nenhum cofre chamado '%s' — syn-vault create %s"

#, c-format
msgid "'%s' is already open.\n"
msgstr "'%s' já está aberto.\n"

#, c-format
msgid "could not make %s: %s"
msgstr "não foi possível criar %s: %s"

#, c-format
msgid ""
"%s already has files in it, and they are NOT in the vault — they were\n"
"  saved while it was closed, so they are on the ordinary disk. Move them\n"
"  aside, open the vault, then move them in."
msgstr "%s já tem ficheiros, e NÃO estão no cofre — foram guardados enquanto ele\n  estava fechado, por isso estão no disco vulgar. Ponha-os de parte, abra o\n  cofre e mova-os para lá dentro."

