msgstr "'%s' está aberto.\n"

#, c-format
msgid ""
"\n"
"⚠ %s has files in it while the vault is closed.\n"
"  They are NOT encrypted — they are on the ordinary disk.\n"
msgstr "\n⚠ %s tem ficheiros enquanto o cofre está fechado.\n  NÃO estão cifrados — estão no disco vulgar.\n"

