 }
 
+// Read `key<sep>value` out of a plain config file, the way read_gtk_setting
+// does for GTK's settings.ini but with the separator and the path given.
+//
+// Wayland compositors that are not a full desktop environment tend to keep
+// their own state in a file like this rather than in GTK's settings.ini or in
+// gsettings, so the toolkit config only ever knows the light/dark theme the
+// compositor pushed OUT to it -- never which compositor theme is actually
+// selected. Same for the cursor and the wallpaper. This is how those get read
+// at the source.
+//
+// `path` is relative to $HOME. Leading whitespace and whitespace around the
+// separator are skipped; a '#' comment line is not a key. Returns 1 on a hit.
+static int read_home_setting(const char *path, const char *key, char sep,
+                             char *out, int maxlen) {
+  const char *home = getenv("HOME");
+  if (!home)
+    return 0;
+  char full[512];
+  snprintf(full, sizeof(full), "%s/%s", home, path);
+  FILE *fp = fopen(full, "r");
+  if (!fp)
+    return 0;
+
+  int found = 0;
+  char buf[512];
+  int keylen = strlen(key);
+  while (fgets(buf, sizeof(buf), fp)) {
+    char *p = buf;
+    while (*p == ' ' || *p == '\t')
+      p++;
+    if (*p == '#' || strncmp(p, key, keylen) != 0)
+      continue;
+    p += keylen;
+    while (*p == ' ' || *p == '\t')
+      p++;
+    if (*p != sep)
+      continue;
+    p++;
+    while (*p == ' ' || *p == '\t')
+      p++;
+    int len = strlen(p);
+    while (len > 0 && (p[len - 1] == '\n' || p[len - 1] == '\r' ||
+                       p[len - 1] == ' ' || p[len - 1] == '\t'))
+      p[--len] = '\0';
+    if (len > 0 && len < maxlen) {
+      memcpy(out, p, len + 1);
+      found = 1;
+    }
+    break;
+  }
+  fclose(fp);
+  return found;
+}
+
+// Compositor-native theme state, tried before the GTK settings.
+//
+// The value here is the name of the theme the user actually picked; the GTK
+// theme is whatever generic light/dark stand-in the compositor pushed out to
+// the toolkit afterwards, so on these desktops it is the less informative of
+// the two ("Adwaita-dark" where the desktop is on "dracula").
+static const struct {
+  const char *path; // relative to $HOME
+  const char *key;
+  char sep;
+  const char *tag; // what to credit in the value
+} desktop_theme_sources[] = {
+    {".config/synui/theme.state", "theme", '=', "synui"},
+    {NULL, NULL, 0, NULL},
+};
+
 static void gather_theme(void) {
 #ifdef __APPLE__
   char style[64] = "";
@@ -2994,6 +3066,14 @@ static void gather_theme(void) {
     add_info("Theme", "Light");
 #else
   char theme[64] = "";
+  for (int i = 0; desktop_theme_sources[i].path; i++) {
+    if (read_home_setting(desktop_theme_sources[i].path,
+                          desktop_theme_sources[i].key,
+                          desktop_theme_sources[i].sep, theme, sizeof(theme))) {
+      add_info("Theme", "%s [%s]", theme, desktop_theme_sources[i].tag);
+      return;
+    }
+  }
   read_gtk_setting("gtk-theme-name", theme, sizeof(theme));
   if (theme[0])
     add_info("Theme", "%s [GTK3]", theme);
@@ -3035,10 +3115,26 @@ static void gather_font(void) {
 static void gather_cursor(void) {
 #ifndef __APPLE__
   char cursor[64] = "";
-  read_gtk_setting("gtk-cursor-theme-name", cursor, sizeof(cursor));
+  char size[16] = "";
+
+  // XCURSOR_THEME/XCURSOR_SIZE first. These are what libwayland-cursor and
+  // every toolkit's Wayland backend actually load the pointer from, so on a
+  // session that sets them they are the truth and gtk-cursor-theme-name is at
+  // best a copy -- and usually absent, since a compositor that is not a full
+  // desktop environment has no reason to write GTK's settings.ini at all.
+  const char *env_theme = getenv("XCURSOR_THEME");
+  const char *env_size = getenv("XCURSOR_SIZE");
+  if (env_theme && env_theme[0]) {
+    snprintf(cursor, sizeof(cursor), "%s", env_theme);
+    if (env_size && env_size[0])
+      snprintf(size, sizeof(size), "%s", env_size);
+  } else {
+    read_gtk_setting("gtk-cursor-theme-name", cursor, sizeof(cursor));
+    if (cursor[0])
+      read_gtk_setting("gtk-cursor-theme-size", size, sizeof(size));
+  }
+
   if (cursor[0]) {
-    char size[16] = "";
-    read_gtk_setting("gtk-cursor-theme-size", size, sizeof(size));
     if (size[0])
       add_info("Cursor", "%s (%spx)", cursor, size);
     else
@@ -3047,6 +3143,92 @@ static void gather_cursor(void) {
 #endif
 }
 
+// --- Wallpaper ---
+//
+// There is no standard for this. Each wallpaper setter records its own choice
+// in its own file, so the only thing to do is probe the ones that exist, most
+// specific first, and stop at the first hit. Every probe is a plain file read
+// -- nothing here shells out, so a desktop that is not running costs one
+// failed fopen().
+
+// The `key sep value` files. hyprpaper writes `wallpaper = <output>,<path>`,
+// which needs the output name stripped afterwards; the rest are plain paths.
+static const struct {
+  const char *path;
+  const char *key;
+  char sep;
+} wallpaper_kv_sources[] = {
+    {".config/hypr/hyprpaper.conf", "wallpaper", '='},
+    {".config/nitrogen/bg-saved.cfg", "file", '='},
+    {".config/gtk-3.0/settings.ini", "gtk-wallpaper", '='},
+    {NULL, NULL, 0},
+};
+
+// Files whose ENTIRE first line is the path. synui's picker writes the chosen
+// image on line 1 and its scaling mode on line 2.
+static const char *const wallpaper_line_sources[] = {
+    ".config/synui/wallpaper.state",
+    ".cache/swww/wallpaper",
+    NULL,
+};
+
+// A file:// URI, a quoted value or a `<output>,<path>` pair, reduced to the
+// path itself. Edits in place.
+static void wallpaper_unwrap(char *s) {
+  // hyprpaper's leading output name, up to the first comma. A comma cannot
+  // appear before the path in any of the other formats.
+  char *comma = strchr(s, ',');
+  if (comma && strncmp(s, "file://", 7) != 0)
+    memmove(s, comma + 1, strlen(comma + 1) + 1);
+
+  int len = strlen(s);
+  if (len >= 2 && (s[0] == '\'' || s[0] == '"') && s[len - 1] == s[0]) {
+    s[len - 1] = '\0';
+    memmove(s, s + 1, len - 1);
+  }
+  if (strncmp(s, "file://", 7) == 0)
+    memmove(s, s + 7, strlen(s + 7) + 1);
+}
+
+static void gather_wallpaper(void) {
+#ifndef __APPLE__
+  char wp[512] = "";
+
+  for (int i = 0; !wp[0] && wallpaper_kv_sources[i].path; i++)
+    read_home_setting(wallpaper_kv_sources[i].path, wallpaper_kv_sources[i].key,
+                      wallpaper_kv_sources[i].sep, wp, sizeof(wp));
+
+  for (int i = 0; !wp[0] && wallpaper_line_sources[i]; i++) {
+    const char *home = getenv("HOME");
+    if (!home)
+      break;
+    char full[512];
+    snprintf(full, sizeof(full), "%s/%s", home, wallpaper_line_sources[i]);
+    FILE *fp = fopen(full, "r");
+    if (!fp)
+      continue;
+    if (fgets(wp, sizeof(wp), fp)) {
+      int len = strlen(wp);
+      while (len > 0 && (wp[len - 1] == '\n' || wp[len - 1] == '\r'))
+        wp[--len] = '\0';
+    }
+    fclose(fp);
+  }
+
+  if (!wp[0])
+    return;
+  wallpaper_unwrap(wp);
+  if (!wp[0])
+    return;
+
+  // The basename only. These are absolute paths several directories deep, and
+  // a line that runs off the terminal would push the logo off with it -- the
+  // info block and the spinning logo share the width.
+  const char *base = strrchr(wp, '/');
+  add_info("Wallpaper", "%s", base ? base + 1 : wp);
+#endif
+}
+
 // Render buffers, one entry per sub-cell: z-buffer (0 = empty), luminance, color
 #define SUB_H (MAX_HEIGHT * MAX_SUB_ROWS)
 #define SUB_W (ANIM_WIDTH * MAX_SUB_COLS)
@@ -3507,8 +3689,8 @@ int main(int argc, char **argv) {
           "  Comment out or remove fields to hide them.\n"
           "  Available fields:\n"
           "    os, host, kernel, uptime, packages, shell, display, wm,\n"
-          "    theme, icons, font, cursor, terminal, cpu, gpu, memory, swap,\n"
-          "    disk, ip, battery, locale, colors\n\n"
+          "    theme, icons, font, cursor, wallpaper, terminal, cpu, gpu,\n"
+          "    memory, swap, disk, ip, battery, locale, colors\n\n"
           "  Extra disks:\n"
           "    disk=/home               Show additional mount point\n"
           "    disk=/data               (repeat for multiple mounts)\n\n"
@@ -3700,6 +3882,7 @@ int main(int argc, char **argv) {
       [F_ICONS] = gather_icons,
       [F_FONT] = gather_font,
       [F_CURSOR] = gather_cursor,
+      [F_WALLPAPER] = gather_wallpaper,
       [F_TERMINAL] = gather_terminal,
       [F_CPU] = gather_cpu,
       [F_GPU] = gather_gpu,
