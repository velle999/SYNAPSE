# synstudio effect
name    sepia
label   Sepia
group   Colour
about   The old photographic tone, mixed back over the original by amount
param   amount  1.0  0  1  Amount
filter  [$in]split[p0][p1];
filter  [p1]colorchannelmixer=rr=0.393:rg=0.769:rb=0.189:gr=0.349:gg=0.686:
filter  gb=0.168:br=0.272:bg=0.534:bb=0.131[p2];
filter  [p0][p2]blend=all_mode=normal:all_opacity=$amount[$out]
