# Maintainer: Velle Sinclair <brncomputerhelp@gmail.com>
#
# SYNAPSE Arsenal — BlackArch category/app browser (GUI + TUI).
#
# The repository itself is NOT a dependency: the app is useful on a machine
# where BlackArch is not enabled yet, because telling you it is missing and
# handing you `syn arsenal --enable-repo` is most of what a first run is for.
pkgname=syn-arsenal
pkgver=0.1.0
pkgrel=12
pkgdesc="SYNAPSE Arsenal: browse and install BlackArch security tooling by category"
arch=('any')
url="https://github.com/velle999/SYNAPSE"
license=('GPL-2.0-or-later')
# pacman drives every query and both mutations; curl fetches the bootstrap.
depends=('pacman' 'bash' 'curl')
# quickshell renders the GUI, polkit escalates the install. Neither is needed
# for `syn arsenal`, which is the whole point of shipping the TUI alongside —
# so they are optdepends and the launcher degrades to the terminal without them.
optdepends=('quickshell: the graphical browser (syn-arsenal without --tui)'
            'polkit: install/remove from the GUI without a terminal')
# ⛔ ONE TARBALL, NOT A LIST OF LOOSE FILES.
#
# Every file this package installs used to be named here individually, which
# builds perfectly from a checkout and cannot be published: there is nothing to
# attach to a release and nothing for an outsider's makepkg to fetch. The
# tarball collect-source.sh assembles is that one thing, and the URL after `::`
# is where everybody who is not us gets it. The filename BEFORE `::` is what
# makepkg looks for on disk first, so a build from this tree still uses the
# tarball build-all.sh just collected and never downloads.
#
# ⚠ AND package() NOW WORKS INSIDE THE EXTRACTED DIRECTORY. The files arrive at
# $srcdir/$pkgname-$pkgver/ rather than loose in $srcdir.
#
# ⛔ sha256sums STAYS 'SKIP' — a real checksum breaks every local build the
# moment the tree changes, which is every build that matters here.
source=("$pkgname-$pkgver.tar.gz::https://github.com/velle999/$pkgname/releases/download/$pkgver-$pkgrel/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm755 syn-arsenal.sh          "$pkgdir/usr/bin/syn-arsenal"

    # Backend and the two non-GUI front-ends live under /usr/lib: they are
    # implementation, not commands a user is meant to find on PATH. `syn
    # arsenal` and syn-arsenal are the entry points.
    install -Dm755 arsenal-query.sh        "$pkgdir/usr/lib/syn-arsenal/arsenal-query"
    install -Dm755 arsenal-tui.sh          "$pkgdir/usr/lib/syn-arsenal/arsenal-tui"
    install -Dm755 arsenal-enable-repo.sh  "$pkgdir/usr/lib/syn-arsenal/arsenal-enable-repo"

    install -Dm644 arsenal.qml             "$pkgdir/usr/share/syn-arsenal/arsenal.qml"
    install -Dm644 syn-arsenal.desktop     "$pkgdir/usr/share/applications/syn-arsenal.desktop"

    # Scalable only: Qt renders the SVG at whatever size the dock or the menu
    # asks for, and a set of PNGs would be five more files to keep in step with
    # one drawing. hicolor is the theme every icon theme inherits from, so the
    # mark survives a theme switch.
    install -Dm644 syn-arsenal.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/syn-arsenal.svg"
}
