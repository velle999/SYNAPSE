pkgname=syn-update
pkgver=0.1.0
# 39: an apply no longer installs what you did not pick. Every SynapseOS
#   package is a checkbox in the installer, so "not installed" is an ANSWER —
#   and scan() filed every such component under NEW and installed it, handing
#   the whole suite back to anyone who took part of it. It now reads
#   /etc/synapseos/components.conf: named there and absent = your answer, kept;
#   absent from the file entirely = the tree gained it since, still installed.
#   `syn-update apply <name>` is the opt-in and it is remembered.
# 36: cliamp joins COMPONENTS. ⚠ Adopting a COMPONENTS change takes TWO
#   applies — the running process keeps the list it started with — so the first
#   `syn-update apply` updates this script and the second one sees cliamp.
# 40: "the updater is just listing it, not trying to install". It was right and
#   it did not say so. COMMITS AND PACKAGES ARE NOT THE SAME THING: `check`
#   listed everything that had landed upstream, then reported "already
#   current", so a run showing two commits and installing nothing read as an
#   updater refusing to work. Most commits change nothing an installed machine
#   installs — documentation, the ISO profile, a repo tool that is in no
#   package, or a component this box does not have. Both paths say which now.
#   ⚠ And `apply` moved $SRC even with nothing to build (checkout_remote runs
#   before the early return) and never mentioned it — so the one thing that run
#   DID do was invisible, and the repository's own tools/ scripts live only
#   there. It now prints the revision the tree landed on. Only when it actually
#   moved: a paragraph on every no-op run is the noise that stops people
#   reading the output.
# 41: the sweep and its arrowhead are the house ink, not a near-white. The disc
#   under them follows the theme accent and only its HUE moves — it is as light
#   as the violet it was drawn from on every theme — so a near-white arc on it
#   was never carrying much contrast and washed out entirely on the pale ones.

# 42: synstudio joins COMPONENTS. ⚠ This tool runs COMPONENTS from the
#   INSTALLED copy, so adopting a COMPONENTS change takes two applies: the
#   first installs this list, the second acts on it.
# 43: HOLDING A COMPONENT BACK. `syn-update ignore <component>` stops it being
#   rebuilt, `unignore` releases it, `ignored` lists what is held, and every
#   check keeps reporting the version it is refusing rather than going quiet.
#   `syn-update apply <component>` still takes that one update without
#   releasing the hold, because an explicit request is a newer answer than a
#   stored one.
#
#   `held` is a THIRD manifest state beside selected and declined, because it
#   is the same kind of fact: an answer this machine has given. ⚠ It is NOT
#   pacman's IgnorePkg — a component is BUILT here and installed with
#   `pacman -U`, which IgnorePkg does not gate, so an entry there would look
#   set and do nothing.
# 45: AN UPDATE NOTIFIER. `syn-update ping` is `check` with the report replaced
#   by a small file the bar's new Updates indicator reads; a systemd USER timer
#   runs it, and `ping --every 6h` / `--on` / `--off` are the controls.
#   ⚠ USER units, not system ones. The check reads /var/lib/synapse-src, which
#   syn-update keeps owned by the person who runs it, and writes into their
#   cache. A system timer would run as root against a tree it does not own —
#   which is precisely how that tree ends up root-owned and the next
#   interactive `check` has to ask for a password to take it back.
#   ⛔ AND IT MUST NEVER ASK FOR ANYTHING. There is no terminal under a timer:
#   a sudo prompt does not fail there, it HANGS, holding the service active —
#   and systemd skips a trigger whose service is still running, so the
#   indicator silently stops updating and nothing anywhere says why. setup_src()
#   is the one path that can reach for sudo, so ping refuses up front when the
#   tree is not already ours, and the unit sets SUDO_ASKPASS=/bin/false and a
#   TimeoutStartSec as the second and third halves of that.
#   ⚠ A REFUSAL IS WRITTEN TO THE STATE FILE, as status=error with a reason.
#   A checker that fails silently is worse than one switched off: the bar goes
#   on showing a stale count and implying the machine is up to date.
#   ⛔ scan() ON ITS OWN ANSWERS THE WRONG QUESTION, and ping shipped that bug
#   for one run: it reads $SRC/<c>/PKGBUILD, which in a checked-out tree is the
#   revision this machine is ALREADY on, so every component compares equal and
#   a machine six releases behind reports "0 updates" with no error anywhere.
#   cmd_check had always pointed SRC at a temp dir of PKGBUILDs extracted at the
#   REMOTE revision first; that is `scan_remote()` now, and it is the only way
#   to ask.
#   ⛔ AND `trap … RETURN` IS NOT SCOPED TO A FUNCTION without `set -T`. Moving
#   that extraction out of cmd_check took its cleanup trap with it, where it
#   stayed armed and fired again on the NEXT function return — `tmp` out of
#   scope, `set -u`, dead script, after the work was done and the answer
#   printed. It survived in cmd_check only because that returns at the very end
#   of a run. Explicit cleanup instead.
#   ⚠ THE INTERVAL LIVES IN A DROP-IN under ~/.config/systemd/user, never in
#   the shipped unit: /usr/lib belongs to the package and every upgrade
#   replaces it — and this package is the updater, so it upgrades often. An
#   interval written there silently reverts to 6h. The drop-in also RESETS
#   OnUnitActiveSec before setting it, because systemd's list-valued settings
#   accumulate across drop-ins and both intervals would otherwise be live.
#   ⚠ ON BY DEFAULT via a timers.target.wants symlink in /usr/lib, which is the
#   only way a package can enable a USER unit: there is no session at install
#   time and no way to enumerate the accounts there will be. `ping --off`
#   masks it per user and an upgrade cannot undo that.
#   The unit validates under systemd-analyze. ⚠ No Documentation= line: this
#   distribution ships no man pages, and pointing at one is a dead reference
#   that systemd-analyze reports and `systemctl help` fails on.
#   tests/ping_test.sh covers the refusals, the state file, the drop-in and its
#   reset. It deliberately does NOT fetch: a test that reached GitHub is one
#   that fails on a train and passes for the wrong reason behind a proxy.
# 46: THE BADGE DID NOT CLEAR AFTER AN UPDATE.
#   The bar reads the ping state file and nothing else — deliberately, so that
#   no bar ever does a git fetch — and `apply` never wrote it. So a machine
#   that had just been updated by hand went on showing "3 updates" until the
#   six-hourly timer next fired, which reads exactly like an updater that did
#   not update anything. Reported as the notifier "not dismissing".
#   `apply` now refreshes it on both of its ending paths: after a successful
#   build, and on "nothing to build" (where the tree still moved, and what the
#   badge was counting was the tree being behind).
#   ⛔ QUIET AND NEVER FATAL. It runs after packages are installed and the
#   manifest is saved; a failure to rewrite an indicator's cache turning a
#   completed update into a red error would be far worse than a stale badge,
#   which the next timer tick corrects anyway.
#   The compute-and-write half of `ping` is now ping_scan_and_write() and is
#   called from both, rather than copied — the scan/scan_remote distinction is
#   invisible in the output and wrong only on a machine that is behind, which
#   is precisely the machine nobody tests on.
#   ping_test.sh gains a phase that runs a REAL `apply` against a local git
#   repository standing in for GitHub: an empty tree takes the "nothing to
#   build" path, which is before the sudo keep-alive and before build-all.sh,
#   so it needs no network, no password and no build and still reaches this.
pkgrel=51
pkgdesc="Update an installed SynapseOS from git — rebuilds changed components from source"
arch=('any')
license=('GPL-2.0-or-later')
# git fetches the tree; base-devel supplies makepkg and a compiler, which is the
# whole premise of updating from source. vercmp and repo-add both ship in pacman
# itself. sudo is used only for the pacman and repo-add steps — syn-update
# refuses to run as root, because makepkg does.
#
# cmake and meson are deliberately NOT here: makepkg -s installs each
# component's own makedepends when it builds it, so a system only pays for the
# toolchain it actually uses. Hard-depending on cmake would add ~150 MiB
# (cmake + boost-libs) for the benefit of one component that this tool does not
# update anyway.
depends=('bash' 'git' 'base-devel' 'pacman' 'sudo')
# The GUI is optional on purpose. Every SynapseOS install has quickshell
# already (synui's bar is built on it), so in practice the window is always
# there — but a headless or minimal install should not be made to pull Qt in
# order to get a command-line updater. syn-update-gui says so itself rather
# than failing silently when quickshell is absent.
optdepends=('quickshell: graphical updater (syn-update-gui, "SynapseOS Updates" in the menu)'
            'qt6-declarative: QtQuick runtime for the graphical updater'
            # ⚠ syntty, and it needs 0.1.0-27 or newer — that is the release
            # where --hold landed. An older syntty dies at parse with "unknown
            # option '--hold'", so the Install button would open a window that
            # closes immediately and never runs the build. An optdepend cannot
            # express a version, which is why it is written here: the depends
            # line stays as it is because a headless install must still get a
            # command-line updater without pulling a terminal in.
            'syntty>=0.1.0-27: terminal the GUI hands the privileged build off to'
            'zenity: dialog used to report a missing quickshell')
source=("syn-update.sh" "syn-update-gui.sh" "shell.qml" "syn-update.desktop"
        "syn-update.svg" "syn-update-ping.service" "syn-update-ping.timer")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "$srcdir/syn-update.sh"     "$pkgdir/usr/bin/syn-update"
    install -Dm755 "$srcdir/syn-update-gui.sh" "$pkgdir/usr/bin/syn-update-gui"

    install -Dm644 "$srcdir/shell.qml" "$pkgdir/usr/share/syn-update/shell.qml"

    # The background check, and the timer that runs it. USER units, not system
    # ones: the check reads /var/lib/synapse-src, which syn-update keeps owned
    # by the person who runs it, and writes into their cache. A system timer
    # would be running as root against a tree it does not own — which is how
    # that tree ends up root-owned and the next interactive `syn-update check`
    # has to ask for a password to take it back.
    install -Dm644 "$srcdir/syn-update-ping.service" \
        "$pkgdir/usr/lib/systemd/user/syn-update-ping.service"
    install -Dm644 "$srcdir/syn-update-ping.timer" \
        "$pkgdir/usr/lib/systemd/user/syn-update-ping.timer"
    # ⚠ ON BY DEFAULT, AND THIS SYMLINK IS THE ONLY WAY TO SAY SO FOR A USER
    # UNIT. A package cannot `systemctl --user enable` anything: there is no
    # user session at install time and no way to enumerate the users there will
    # be. Dropping the link in /usr/lib/.../timers.target.wants enables it for
    # every account, which is what `systemctl --global enable` writes and what
    # every distro package that ships a user timer does.
    #
    # `syn-update ping --off` then masks it per user in the ordinary way, and a
    # package upgrade cannot undo that — a disable writes a null link under
    # ~/.config/systemd/user, which wins over this one.
    install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
    ln -sf ../syn-update-ping.timer \
        "$pkgdir/usr/lib/systemd/user/timers.target.wants/syn-update-ping.timer"

    # The menu is a freedesktop .desktop scan (quickshell's DesktopEntries), so
    # dropping the file here is all that is needed for the entry to appear.
    #
    # ⚠ THE BASENAME MUST EQUAL THE WINDOW'S app_id, which is "syn-update".
    #
    # synui's dock resolves a pinned app to its launch command by a direct
    # "<app_id>.desktop" lookup — see the header of synui/src/icons.c, which
    # states the limitation. This file was "syn-update-gui.desktop", so the
    # lookup for "syn-update" found nothing, the entry's Exec came back empty,
    # and clicking the dock icon did NOTHING AT ALL. The icon still drew,
    # because icon resolution falls back to the theme and syn-update.svg is
    # there — so the shortcut looked completely normal and was dead.
    #
    # Every other pinned app in the suite already matched (synfiles, synpkg,
    # syn-disks, syn-arsenal, syn-settings); this was the only one that did not.
    # It is also what xdg-desktop-portal looks up: with the old name it logged
    # "Could not register app ID: App info not found for 'syn-update'".
    install -Dm644 "$srcdir/syn-update.desktop" \
        "$pkgdir/usr/share/applications/syn-update.desktop"

    # Scalable only, in hicolor — the theme every icon theme inherits from, so
    # the mark survives a theme switch. One drawing instead of a set of PNGs to
    # keep in step.
    install -Dm644 "$srcdir/syn-update.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/syn-update.svg"
}
