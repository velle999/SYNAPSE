[Unit]
Description=SynapseOS Wayland Compositor
After=synapd.service seatd.service
# NOT synui-foot.service: it runs `foot synsh`, which would put the fullscreen
# terminal straight back — Wants= pulls it in whenever this unit starts,
# regardless of whether it is enabled. The live session is a desktop now.
Wants=synapd.service
Requires=seatd.service
Conflicts=getty@tty1.service
# ⚠ ORDERED, and the ordering is the whole point. Conflicts= does NOT imply one
# — systemd.unit(5) says so in as many words — so without this the getty's STOP
# job and this unit's START job race.
#
# What is being raced for is /run/user/0. agetty autologins root on tty1 through
# login(1), so pam_systemd opens a logind SESSION and /run/user/0 becomes a
# logind-managed tmpfs. The live wizard then runs `systemctl start synui.service`
# from inside that session; Conflicts= stops the getty, root's last session ends,
# and logind tears the runtime directory down.
#
# Lose the race and the failure is silent and total, because BOTH of synui's
# sockets live in there — the Wayland display and the synctl IPC socket. synui
# creates them, the bar connects, and THEN the directory goes away underneath.
# The compositor and the bar keep running on the fds they already hold, so the
# desktop looks completely healthy, and nothing new can ever connect again:
# Super+Return opens no terminal, foot and syntty both exit "no Wayland display",
# Super+I and the bar's network module launch a terminal that dies the same way,
# and the control panel does not answer the menu because synctl cannot find the
# IPC socket either. Every one of those reads as a separate broken feature.
#
# Belt and braces: /var/lib/systemd/linger/root on this image stops logind from
# removing the directory at all. This line makes the ordering deterministic; the
# linger file makes the teardown not happen. Neither alone is worth relying on —
# ordering still leaves logind's cleanup running asynchronously after the stop
# job completes.
After=getty@tty1.service
# If synui fails 3 times in 30s, stop trying and let getty take over
# (StartLimit* live in [Unit]; systemd ignores them in [Service])
StartLimitBurst=3
StartLimitIntervalSec=30

[Service]
Type=simple
User=root
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=synui
# Qt matches XDG_CURRENT_DESKTOP against the desktops it knows to pick a platform
# theme; "synui" matches none, so it loaded none and Qt apps ran on the built-in
# light palette (Text #000000) — which is what painted Dolphin's file names black
# on every dark theme. See /etc/profile.d/synapseos.sh for the full account.
Environment=QT_QPA_PLATFORMTHEME=xdgdesktopportal
Environment=LIBSEAT_BACKEND=seatd
ExecStartPre=/bin/sh -c 'mkdir -p /run/user/0 && chmod 700 /run/user/0'
ExecStartPre=/bin/sh -c 'mkdir -p /run/synui && /usr/local/bin/synui-gfx-env > /run/synui/env'
EnvironmentFile=-/run/synui/env
ExecStart=/usr/bin/synui
Restart=on-failure
RestartSec=3
ExecStopPost=-/usr/bin/systemctl start getty@tty1.service

[Install]
WantedBy=multi-user.target
