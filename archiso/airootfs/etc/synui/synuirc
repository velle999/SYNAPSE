# SynapseOS compositor configuration
# See synui(1) for all options

terminal = foot

# Programs to launch on compositor start.
# The live ISO execs synui from root's .bash_profile (no synui-foot.service),
# so this is the only thing that opens a terminal there. Installed systems
# run the service instead and shadow this file with a per-user synuirc that
# has no autostart — keep both, or boots open zero or two terminals.
autostart = foot

# Window appearance
border_width = 2
gap = 8
master_factor = 0.60

# AI features
ai_layout = on
ai_ctx_decor = on
