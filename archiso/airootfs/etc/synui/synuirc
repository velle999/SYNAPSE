# SynapseOS compositor configuration
# See synui(1) for all options

terminal = syntty

# Programs to launch on compositor start.
#
# Deliberately NO terminal. The live session used to open one and synui tiles a
# lone window fullscreen, so it covered the wallpaper and the ISO looked like a
# bare terminal rather than a desktop — which is exactly what "the live doesn't
# boot right" turned out to be. The compositor was working the whole time.
# Super+Return, or the start menu, opens a terminal when one is wanted.
# The bar. The live ISO had none at all — the bar was not even in
# packages.x86_64 — so the ISO booted with no clock, no tray and no network
# indicator, looking far less finished than an installed system for no reason.
# The bar is quickshell as of 2026-07-24; its QML tree comes from
# /usr/share/synui/quickshell (shipped by synui), so the root session here needs
# nothing in its home.
autostart = synui-bar

# KDE Connect. The indicator rather than kdeconnectd, because starting it does
# both jobs: it D-Bus-activates the daemon (org.kde.kdeconnect.service) and
# puts the tray icon in the bar, and starting the daemon alone would leave the
# session with no way to see or pair a device.
#
# It has to be named here at all because the package's own
# /etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop never runs: nothing in a
# synui session implements the XDG autostart spec. Without this line the daemon
# only ever starts when something first talks to it, so a phone could not reach
# the desktop until the user had manually opened the app — which reads as "KDE
# Connect doesn't work" rather than "it isn't running".
autostart = kdeconnect-indicator

# The graphical installer, and ONLY when it was asked for.
#
# --if-requested exits silently unless /run/synapseos/install-gui exists, and
# the one thing that writes that flag is answering "Install graphically" at the
# live image's menu (syn-install --live). So a live session someone wanted to
# look around in never gets an installer window, and the one where they asked
# for it does not make them find an icon after waiting for the compositor.
#
# Live-image-only by construction: this file is the ISO's synuirc, an installed
# system's is written by syn-install and has no such line.
autostart = syn-install-gui --if-requested

# ── Theme ─────────────────────────────────────────────────
# SYNAPSE Prism, which is what a fresh install boots into: syn-install writes
# `theme = prism` into the new user's synuirc (syn-install.sh, the SYNUIRC
# heredoc). Without this line the live session did NOT match — synui's compiled
# default is SYN_THEME_SYNAPSE (config.c), so the ISO booted into the neon
# theme and the desktop someone tries before installing was not the desktop
# they got afterwards.
#
# It also fixes what read as "the new themes are missing". The Super+T panel
# windows its list to the rows that fit the screen and centres that window on
# the ACTIVE theme (render.c). Active = SYNAPSE is index 0, so on the ISO's
# 1280x800 the panel opened on rows 0-9 and stopped at Bubblegum — macOS 26,
# Aqua, Platinum and Prism were all below the fold behind one small grey ▼.
# Active = Prism is the last index, so the window clamps to the END of the list
# and the four newest themes are the ones on screen.
theme = prism

# ── The rest of the house look, and it has to be spelt out HERE ──────────────
#
# ⚠ EVERY LINE BELOW IS ALSO IN syn-install.sh's SYNUIRC HEREDOC, AND THE TWO
# HAVE TO SAY THE SAME THING. This file is the live session's whole config; that
# heredoc is a fresh install's. A desktop somebody tries before installing that
# does not look like the desktop they get afterwards is the same failure the
# `theme = prism` line above exists to fix — it was the neon theme on the ISO
# and Prism on disk for a whole release. Change one of these files and change
# the other, or the ISO drifts back.
#
# The rationale for each number is written out once, in the installer's heredoc,
# and deliberately not copied here — two copies of an argument drift the way two
# copies of a config do. What follows is the summary.

# Glass on AUTO, which is the house look now. It said 100 for one release, and
# that was a workaround for a bug rather than a decision: `auto` was not auto —
# a glass theme's panels fell through to a tuned ladder where an explicit level
# returned an absolute, and the dock had no way to ask its theme at all. Both
# are fixed in synui 467, so auto and 100 produce the same desktop on Prism and
# every other theme keeps its own answer through a switch.
glass_level = auto
glass_sync  = on

# ⚠ FOR QUICKSHELL, NOT FOR THE COMPOSITOR. The bar and the desktop widgets are
# a separate process and read these out of theme.state → settings.state → this
# file; the live session has none of the first two, so without them the strip
# comes up at its built-in 0.85 over a dock synui has already drawn at 0.05.
# Same gap widget_glass below works around, same way out.
bar_opacity  = 0.05
dock_opacity = 0.05

# See-through application windows. No number with it: both Prisms carry
# 0.90/0.84 in their own preset and that is what a window draws at with no glass
# level set — which is the whole point of being on auto.
transparency = on

# Menus and panels ink themselves off the window behind them, not the wallpaper
# it covers. synui's compiled default; said here because this is the desktop
# see-through enough for it to show.
scene_ink = on

# The accent off the wallpaper on every theme, not just the two Prisms. `auto`
# is the same answer while Prism is on screen.
wallpaper_accent = on

# The bar as a floating capsule rather than a strip welded to the screen edge —
# a full-width bar at 0.05 has no edge anywhere to say where the surface stops.
# A no-op with `corner_radius` at 0 or a retro chrome: this is what shape the
# bar is WHEN it is rounded, not a second switch.
bar_shape = floating-pill

dock_style  = auto
# As round as the dock goes. The draw caps it at half the dock's thickness (32
# at the stock 64px), so this is a capsule rather than a literal 64px arc.
dock_radius = 64

# ⚠ `on` AND NOT `auto`, and this one is not cosmetic. `auto` means "follow the
# theme", and the desktop widgets cannot ask what the theme is: they are
# quickshell and they read theme.state, a file synui-apply-theme writes only
# when somebody PICKS a theme. The live session names a theme in this file and
# has never picked one, so theme.state does not exist and `auto` leaves the
# widgets with nothing to follow — solid cards on a glass desktop. Same reason,
# same answer, as the installer's heredoc.
widget_glass = on

# Window appearance
border_width = 2
gap = 8
master_factor = 0.60

# The floating desktop's own tiler: windows you have not placed yourself are
# arranged into a grid that deliberately does NOT fill the screen. float_inset
# is the percentage of the screen kept clear at each edge and float_gap the
# space between the tiles, so the wallpaper shows through — that is the point
# of the layout, not a gap in it. Separate from `gap` above, which wants to be
# a hairline. Super+Shift+G re-arranges after you have dragged things about.
float_inset = 8
float_gap = 24

# St. Louis at night — Daniel Schwen's Gateway Arch photograph, which synui
# ships to /usr/share/backgrounds. Nothing autostarts a wallpaper daemon here
# and the live session has no home to keep a picture in, so without this line
# the ISO booted onto a flat colour and looked like a compositor that had failed
# to finish starting.
#
# ⚠ THE COLOUR CUT, NOT THE NOIR ONE. Prism has no accent of its own worth the
# name — it measures the wallpaper and wears what it finds — and the noir cut of
# the same photograph is greyscale, so it has no hue to give. The ISO would boot
# onto the theme's fallback cyan and the first thing anybody saw of SynapseOS
# would be the one case Prism is designed around failing. Same file, same mode,
# as syn-install.sh writes for a fresh install.
wallpaper = /usr/share/backgrounds/commons-st-louis-night.jpg
wallpaper_mode = fill

# CRT post-process off. The first thing anyone sees of SynapseOS is this
# session, and scanlines + curvature + chromatic aberration over the whole
# screen read as a broken display rather than a style choice. Super+E turns
# them on live for anyone who wants a look at them.
effects = off

# AI features
ai_layout = on
ai_ctx_decor = on

# ── Lock screen (Super+L) ──────────────────────────────────
# Offer the fingerprint reader beside the password. Both ways in are live at
# once, so you can type your password over a reader that is still waiting, and
# whichever answers first unlocks. A machine WITHOUT a reader pays nothing: the
# helper is told there is no device and the lock stops asking.
#
# Needs the fprintd package (an optdepend) and at least one ENROLLED finger.
# Enroll as yourself, not root — prints are stored per account:
#   sudo pacman -S fprintd
#   fprintd-enroll        # swipe until it says enroll-completed
#   fprintd-list "$USER"  # confirm it took
# On the live session that means enrolling every boot, since nothing persists;
# on an installed system it is once. Your password always works regardless.
lock_fingerprint = on

# ── The live session must NEVER idle-lock ──────────────────
# The live image autologins root, and root here has a password (it is
# "synapse", set in airootfs/etc/shadow so an installer that needs sudo works).
# NOBODY IS TOLD THAT PASSWORD. So when synui's default idle-lock fired after
# fifteen minutes (power_lock_timeout = 900 in config.c), the person trying the
# OS out was shown a password prompt for a password they never chose and had no
# way to guess — a hard lockout of a session that exists to be looked at.
#
# 0 = never. This turns off ONLY the idle timer; a deliberate Super+L still
# locks, and still wants "synapse", but that is a thing someone did on purpose
# rather than a surprise the desktop sprang on an idle machine. It also stops
# the pre-suspend lock (power.c only locks before sleep when power_lock > 0), so
# closing the lid on the live session does not strand it behind the same prompt.
#
# ⚠ THE LIVE IMAGE ONLY. This is the ISO's own synuirc; an installed system's is
# written by syn-install for a user who set their OWN password, and that system
# SHOULD lock. Nothing here reaches an installed machine.
power_lock_timeout = 0
