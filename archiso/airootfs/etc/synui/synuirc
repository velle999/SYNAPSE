# SynapseOS compositor configuration
# See synui(1) for all options

terminal = kitty

# Programs to launch on compositor start.
#
# Deliberately NO terminal. The live session used to open one and synui tiles a
# lone window fullscreen, so it covered the wallpaper and the ISO looked like a
# bare terminal rather than a desktop — which is exactly what "the live doesn't
# boot right" turned out to be. The compositor was working the whole time.
# Super+Return, or the start menu, opens a terminal when one is wanted.
# The bar. The live ISO had none at all — the bar was not even in
# packages.x86_64 — so the ISO booted with no clock, no tray and no network
# indicator, looking far less finished than an installed system for no reason.
# The bar is quickshell as of 2026-07-24; its QML tree comes from
# /usr/share/synui/quickshell (shipped by synui), so the root session here needs
# nothing in its home.
autostart = synui-bar

# KDE Connect. The indicator rather than kdeconnectd, because starting it does
# both jobs: it D-Bus-activates the daemon (org.kde.kdeconnect.service) and
# puts the tray icon in the bar, and starting the daemon alone would leave the
# session with no way to see or pair a device.
#
# It has to be named here at all because the package's own
# /etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop never runs: nothing in a
# synui session implements the XDG autostart spec. Without this line the daemon
# only ever starts when something first talks to it, so a phone could not reach
# the desktop until the user had manually opened the app — which reads as "KDE
# Connect doesn't work" rather than "it isn't running".
autostart = kdeconnect-indicator

# Window appearance
border_width = 2
gap = 8
master_factor = 0.60

# The floating desktop's own tiler: windows you have not placed yourself are
# arranged into a grid that deliberately does NOT fill the screen. float_inset
# is the percentage of the screen kept clear at each edge and float_gap the
# space between the tiles, so the wallpaper shows through — that is the point
# of the layout, not a gap in it. Separate from `gap` above, which wants to be
# a hairline. Super+Shift+G re-arranges after you have dragged things about.
float_inset = 8
float_gap = 24

# The SYNAPSE wallpaper, from /usr/share/synui (shipped by synui). The live
# session has no home directory to put one in and nothing autostarts a
# wallpaper daemon, so without this the ISO booted onto a flat colour and
# looked like a compositor that had failed to finish starting.
wallpaper = default
wallpaper_mode = fill

# CRT post-process off. The first thing anyone sees of SynapseOS is this
# session, and scanlines + curvature + chromatic aberration over the whole
# screen read as a broken display rather than a style choice. Super+E turns
# them on live for anyone who wants a look at them.
effects = off

# AI features
ai_layout = on
ai_ctx_decor = on

# ── Lock screen (Super+L) ──────────────────────────────────
# Offer the fingerprint reader beside the password. Both ways in are live at
# once, so you can type your password over a reader that is still waiting, and
# whichever answers first unlocks. A machine WITHOUT a reader pays nothing: the
# helper is told there is no device and the lock stops asking.
#
# Needs the fprintd package (an optdepend) and at least one ENROLLED finger.
# Enroll as yourself, not root — prints are stored per account:
#   sudo pacman -S fprintd
#   fprintd-enroll        # swipe until it says enroll-completed
#   fprintd-list "$USER"  # confirm it took
# On the live session that means enrolling every boot, since nothing persists;
# on an installed system it is once. Your password always works regardless.
lock_fingerprint = on
