# SynapseOS Plymouth splash — the dendrite logo centred on the theme's
# near-black background (#0a0a12). Kept deliberately static: the script
# language is limited and a boot splash must never be the thing that breaks,
# so no animation/Math calls that could error out mid-boot.

Window.SetBackgroundTopColor(0.039, 0.039, 0.070);
Window.SetBackgroundBottomColor(0.039, 0.039, 0.070);

logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetZ(100);

# Show typed characters as bullets if a password is ever prompted (encrypted
# install case); harmless on the live ISO where it never fires.
fun display_password_callback(prompt, bullets) {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
