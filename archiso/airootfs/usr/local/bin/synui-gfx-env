#!/bin/sh
# synui-gfx-env — prepare the graphics environment synui starts in.
# Prints KEY=VALUE lines (systemd EnvironmentFile format; eval-able).
#
# THIS SCRIPT NO LONGER PICKS THE RENDERER, and that is the point.
#
# It used to force software rendering whenever it saw a hypervisor or a nouveau
# card. Forcing it in a VM was wrong twice over: any hypervisor with 3D enabled
# — virtio-gpu+virgl, VirtualBox 3D, VMware 3D — exposes a working render node,
# and llvmpipe is precisely where synui's layer surfaces come out corrupted, so
# the guess threw away working acceleration and bought a rendering bug with the
# proceeds. Measured in a virgl guest: forced llvmpipe corrupts the bar on
# pointer motion, the same guest on its GPU changes zero pixels.
#
# It was also unreliable in the other direction. `WLR_RENDERER=pixman` has done
# nothing since the scenefx migration (fx_renderer is GLES2-only and never reads
# it), so the nouveau branch that looked like a software fallback had not been
# one for months.
#
# synui decides for itself now: it tries hardware GLES2 and falls back to
# software if fx_renderer_create() cannot come up. That is a test of what
# actually works rather than a guess from a device name, it lives in one place
# instead of four, and it covers cards nobody thought to special-case.
#
# What is left here is the part synui cannot do for itself: loading a driver so
# there is a card at all, and the cursor policy.

# nvidia-utils blacklists nouveau, and nvidia-open only binds Turing and newer.
# On older NVIDIA cards that leaves no DRM device at all — load nouveau by hand
# (a blacklist only stops autoloading) so there is something to render on. If
# its GL turns out to be unusable, synui's fallback catches it.
if ! ls /dev/dri/card* >/dev/null 2>&1; then
    modprobe nouveau 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || sleep 1
fi

# VMs: no hardware cursor plane worth trusting (vmwgfx in particular cannot do
# it), and the DRM backend is the one to use. Neither of these is a renderer
# choice, so both are safe to state up front.
if [ -f /sys/class/dmi/id/sys_vendor ] && \
   grep -qiE 'VirtualBox|VMware|QEMU|KVM|Xen|innotek' /sys/class/dmi/id/sys_vendor 2>/dev/null; then
    printf 'WLR_BACKENDS=drm,libinput\nWLR_NO_HARDWARE_CURSORS=1\n'
fi

exit 0
