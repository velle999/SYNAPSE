# Maintainer: Velle Sinclair <brncomputerhelp@gmail.com>
pkgname=chibi
pkgver=0.1.0
pkgrel=6
pkgdesc="Chibi — voice-interactive AI companion, with a sentinel aspect over synguard's security feed"
arch=('x86_64')   # binary wheels (ctranslate2, onnxruntime, opencv) are arch-specific
url="https://github.com/velle999/chibi-llm"
# chibi-llm ships no LICENSE file, so there is nothing to install and nothing
# to truthfully claim here. Add one upstream and set this properly.
license=('GPL-2.0-or-later' 'MIT' 'Apache-2.0')

# Pinned upstream commit — bump alongside pkgrel when rolling the app.
_commit=4a322ef7ad94d98f8ed7044f408c62051a738c91

# Runtime deps.
#
# NOTE: pipewire-alsa is NOT optional and NOT redundant with pipewire-audio.
# It is the package that ships /etc/alsa/conf.d/99-pipewire-default.conf, the
# symlink that points ALSA's `default` PCM at PipeWire. Without it `default`
# falls back to dmix on card 0 — and on a machine whose card 0 is an HDMI-only
# GPU there is no device 0 at all, so every aplay/arecord dies with "unable to
# open slave" and Chibi comes up mute and deaf with no error. This bit us on a
# live box; do not drop it.
#
# The base ISO ships no audio stack at all, so chibi is what pulls the whole
# thing in (pipewire + wireplumber + alsa-utils).
#
# NOTE: sdl2 alone is NOT enough, and the reason is easy to miss. There is no
# manylinux cp314 wheel for pygame yet, so pip *compiles it from source* here
# and links each submodule against whatever SDL2 satellite libs the build host
# happens to have. The result is a pygame whose font/imageext/mixer/pypm
# extensions carry DT_NEEDED entries no declared dep provides:
#
#     font.so       -> libSDL2_ttf-2.0.so.0     (sdl2_ttf)
#     imageext.so   -> libSDL2_image-2.0.so.0   (sdl2_image)
#     mixer*.so     -> libSDL2_mixer-2.0.so.0   (sdl2_mixer)
#     pypm.so       -> libportmidi.so.2         (portmidi)
#
# pygame swallows those ImportErrors and installs a MissingModule placeholder,
# so nothing fails at import — it fails on first use. On the 0.2.1 ISO that was
# main.py's very first status-bar draw calling pygame.font.SysFont, i.e. Chibi
# crashed on launch with "NotImplementedError: font module not available" on
# both the live ISO and a fresh install. Verified by chroot into the built
# airootfs: without these four, pygame.font is a MissingModule; with them, font,
# image, mixer and midi all load. Do not drop them because "sdl2 is already
# there" — sdl2 (via sdl2-compat) only provides libSDL2 itself.
depends=(
    'python'
    'pipewire'
    'pipewire-audio'
    'pipewire-alsa'
    'pipewire-pulse'
    'wireplumber'
    'alsa-utils'          # aplay / arecord — Chibi's playback + capture path
    'sox'                 # TTS pitch shift (the "cute" voice)
    'espeak-ng'           # last-resort TTS fallback if piper fails
    'sdl2'                # pygame's backend
    'sdl2_ttf'            # pygame.font — REQUIRED, see note above
    'sdl2_image'          # pygame.imageext
    'sdl2_mixer'          # pygame.mixer — voice_output's playback fallback
    'portmidi'            # pygame.midi (pypm)
    'synapd'              # default LLM backend on SynapseOS (no Ollama needed)
    'synguard'            # security mode subscribes to its verdict feed
)
makedepends=('git' 'python-pip')
optdepends=('ollama: alternative LLM backend (set CHIBI_LLM_BACKEND=ollama)')

# Python deps are vendored into /usr/lib/chibi/pydeps with `pip --target`
# rather than a venv: a venv bakes its own build-time absolute path into
# pyvenv.cfg and console-script shebangs, which is exactly the kind of thing
# that breaks when the tree is built in /var/tmp and installed elsewhere.
# --target produces a plain, relocatable directory that the launcher puts on
# PYTHONPATH.
#
# openwakeword is deliberately NOT vendored: oww_enabled is False by default,
# and it drags in a tflite runtime for a feature nothing turns on.
_pydeps=(
    'pygame'
    'numpy'
    'requests'
    'faster-whisper'          # STT
    'piper-tts'               # TTS
    'yfinance'                # market ticker
    'opencv-python-headless'  # webcam vision
    'psutil'                  # soul: system monitoring
    'Pillow'                  # soul: screen awareness
)

# Voice model (Piper). voice_output.py searches /usr/share/piper-voices.
_voice=en_GB-cori-medium
_piperrev=v1.0.0

# STT model (faster-whisper tiny), pinned to an upstream HF revision.
# Shipping it is what lets a freshly imaged machine hear you with NO network:
# faster-whisper given a bare model name ("tiny") downloads ~75MB from
# HuggingFace on first run, so without this the ISO would boot up deaf.
_whisperrev=d90ca5fe260221311c53c58e660288d3deb8d356
_hf=https://huggingface.co

source=(
    "git+$url.git#commit=$_commit"
    "$_hf/rhasspy/piper-voices/resolve/$_piperrev/en/en_GB/cori/medium/$_voice.onnx"
    "$_hf/rhasspy/piper-voices/resolve/$_piperrev/en/en_GB/cori/medium/$_voice.onnx.json"
    "whisper-model.bin::$_hf/Systran/faster-whisper-tiny/resolve/$_whisperrev/model.bin"
    "whisper-config.json::$_hf/Systran/faster-whisper-tiny/resolve/$_whisperrev/config.json"
    "whisper-tokenizer.json::$_hf/Systran/faster-whisper-tiny/resolve/$_whisperrev/tokenizer.json"
    "whisper-vocabulary.txt::$_hf/Systran/faster-whisper-tiny/resolve/$_whisperrev/vocabulary.txt"
    "chibi.sh"
    "chibi.desktop"
    "chibi-64.png"
    "chibi-128.png"
)
