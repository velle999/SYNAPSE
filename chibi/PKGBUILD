# Walks the declared `depends` closure with plain pacman (no pacman-contrib /
# pactree makedepend) and reports every soname a vendored extension needs that
# neither pydeps itself nor that closure provides. See the call site.
_check_vendored_sonames() {
    local pydir="$1"
    local -A provided=() seen=()
    local queue=("${depends[@]}") p real f d soname sofile owner rc=0

    while read -r f; do
        [[ -n $f ]] && provided["$f"]=1
    done < <(find "$pydir" -name '*.so*' -printf '%f\n')

    while ((${#queue[@]})); do
        p="${queue[0]%%[<>=]*}"; queue=("${queue[@]:1}")
        [[ -z $p ]] && continue
        # `sdl2` and friends are virtuals; ask pacman what really provides them.
        real="$(pacman -Qq "$p" 2>/dev/null)" || real=""
        if [[ -z $real ]]; then
            warning "dep '$p' is not installed on the build host — its libraries can't be checked"
            continue
        fi
        [[ -n ${seen[$real]:-} ]] && continue
        seen["$real"]=1
        while read -r f; do
            f="${f%/}"; [[ -n ${f##*/} ]] && provided["${f##*/}"]=1
        done < <(pacman -Qlq "$real" 2>/dev/null | grep '\.so')
        while read -r d; do
            [[ -n $d && $d != None ]] && queue+=("$d")
        done < <(pacman -Qi "$real" 2>/dev/null |
                 awk '/^Depends On/{sub(/^[^:]*: /,""); print}' | tr ' ' '\n')
    done

    while read -r soname sofile; do
        [[ -n ${provided[$soname]:-} ]] && continue
        owner="$(pacman -Qoq "/usr/lib/$soname" 2>/dev/null)" || owner=""
        error "vendored ${sofile##*/} needs $soname, which no declared dependency provides — add '${owner:-the owning package}' to depends"
        rc=1
    done < <(find "$pydir" \( -name '*.so' -o -name '*.so.*' \) -print0 |
             xargs -0 -r -n1 sh -c 'objdump -p "$1" 2>/dev/null |
                 awk -v F="$1" "/NEEDED/{print \$2\" \"F}"' _ | sort -u)

    return $rc
}

build() {
    # Vendored wheels are built against the ABI of the python this runs under,
    # so the package is tied to that python minor version. Record it, and let
    # package() bake the same version into the launcher's PYTHONPATH — a python
    # upgrade then produces a loud "no module named pygame" instead of a subtly
    # half-working Chibi.
    _pyver="$(python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
    msg2 "Vendoring python deps for python $_pyver"

    pip install \
        --target="$srcdir/pydeps" \
        --no-cache-dir \
        --no-compile \
        --upgrade \
        "${_pydeps[@]}"
}

package() {
    _pyver="$(python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"

    # ── The app ──────────────────────────────────────────────────────────
    # 1080x1920-linux is the self-contained Linux app (all modules + the Thoth
    # corpus/index); it is the directory the upstream launcher runs from.
    cd "$srcdir/chibi-llm/1080x1920-linux"

    install -d "$pkgdir/usr/lib/chibi/app"
    cp -a ./*.py thoth_corpus thoth_index.json thoth_index.npz thoth_lexicon.json \
        "$pkgdir/usr/lib/chibi/app/"

    # A gitignored config.local.py must never be packaged — it carries the
    # building machine's identity (name, city, LAN peers). Belt and braces: the
    # clone shouldn't have one, but fail loudly rather than ship someone's
    # personal config to every user of the ISO.
    if [[ -e "$pkgdir/usr/lib/chibi/app/config.local.py" ]]; then
        error "config.local.py leaked into the package — refusing to ship it"
        return 1
    fi

    # NB: the backend is NOT patched here. chibi.sh already exports
    # CHIBI_LLM_BACKEND=synapd (and CHIBI_SYNAPD_SOCKET), and env wins over
    # config.py, so the launcher is the single place that decides. Upstream's
    # config.py keeps its neutral ollama default for plain chibi-llm installs.
    #
    # Until 21bb716 that env var pointed at a backend the packaged
    # llm_client.py did not implement, and stream_chat quietly spoke llama.cpp
    # instead. The fix belongs upstream (and in tools/check-shared.sh), not in a
    # second copy of the default here.

    # The app dir is read-only at runtime, so .pyc can't be written on import.
    # Precompile now, or every start pays full parse cost.
    python -m compileall -q "$pkgdir/usr/lib/chibi/app" || true

    # ── Vendored python deps ─────────────────────────────────────────────
    install -d "$pkgdir/usr/lib/chibi"
    cp -a "$srcdir/pydeps" "$pkgdir/usr/lib/chibi/pydeps"
    python -m compileall -q "$pkgdir/usr/lib/chibi/pydeps" || true

    # ── Guard: no vendored .so may need a lib we don't depend on ─────────
    # These wheels are compiled against the BUILD host, which has far more
    # installed than a fresh SynapseOS does, so a missing runtime lib is
    # invisible here and only shows up on the ISO. pygame makes that worse by
    # failing *soft*: an ImportError becomes a MissingModule placeholder, so
    # nothing breaks until the app first touches it. That is how 0.1.0-5
    # shipped a Chibi that crashed on launch with "font module not available".
    #
    # So resolve every DT_NEEDED soname of every vendored extension against
    # the libs vendored alongside it plus the file list of our own declared
    # dependency closure, and hard-fail on anything left over. Missing tools or
    # an uninstalled dep only warn — this must never fail the build for a
    # reason that isn't a real unsatisfied library.
    _check_vendored_sonames "$pkgdir/usr/lib/chibi/pydeps" || return 1

    # ── Models ───────────────────────────────────────────────────────────
    install -Dm644 "$srcdir/$_voice.onnx" \
        "$pkgdir/usr/share/piper-voices/$_voice.onnx"
    install -Dm644 "$srcdir/$_voice.onnx.json" \
        "$pkgdir/usr/share/piper-voices/$_voice.onnx.json"

    install -Dm644 "$srcdir/whisper-model.bin" \
        "$pkgdir/usr/share/faster-whisper/tiny/model.bin"
    install -Dm644 "$srcdir/whisper-config.json" \
        "$pkgdir/usr/share/faster-whisper/tiny/config.json"
    install -Dm644 "$srcdir/whisper-tokenizer.json" \
        "$pkgdir/usr/share/faster-whisper/tiny/tokenizer.json"
    install -Dm644 "$srcdir/whisper-vocabulary.txt" \
        "$pkgdir/usr/share/faster-whisper/tiny/vocabulary.txt"

    # ── Launcher, desktop entry, icons ───────────────────────────────────
    install -Dm755 "$srcdir/chibi.sh" "$pkgdir/usr/bin/chibi"
    sed -i "s|@PYVER@|$_pyver|g" "$pkgdir/usr/bin/chibi"

    install -Dm644 "$srcdir/chibi.desktop" \
        "$pkgdir/usr/share/applications/chibi.desktop"
    install -Dm644 "$srcdir/chibi-64.png" \
        "$pkgdir/usr/share/icons/hicolor/64x64/apps/chibi.png"
    install -Dm644 "$srcdir/chibi-128.png" \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/chibi.png"

    install -Dm644 "$srcdir/chibi-llm/docs/security-overview.md" \
        "$pkgdir/usr/share/doc/$pkgname/security-overview.md"
}
