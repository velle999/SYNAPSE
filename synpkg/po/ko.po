msgstr ""
"Arch 뉴스 피드를 읽지 못했습니다 — 이 확인 없이 계속합니다 (https://"
"archlinux.org/news/)"

msgid "the Arch news feed did not parse — continuing without the check"
msgstr "Arch 뉴스 피드를 해석하지 못했습니다 — 이 확인 없이 계속합니다"

#, c-format
msgid "news: unknown argument '%s'"
msgstr "news: 알 수 없는 인자 '%s'"

