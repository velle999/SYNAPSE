msgstr "%s 옆에 쓸 수 없습니다: %s"

#, c-format
msgid "could not set the mode on the new %s"
msgstr "새 %s의 권한을 설정하지 못했습니다"

#, c-format
msgid "cannot flush the new %s"
msgstr "새 %s을(를) 디스크에 기록하지 못했습니다"

