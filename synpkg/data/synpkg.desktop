[Desktop Entry]
Type=Application
Name=SYNAPSE Software
GenericName=Package Manager
Comment=Install and remove software, security tooling, and SynapseOS updates
Exec=synpkg gui
# Our own, not the theme's generic system-software-install — which on a
# Breeze desktop is whatever Discover uses, leaving the dock with two
# applications wearing one face.
Icon=synpkg
Terminal=false
StartupWMClass=synpkg
# ONE main category. Two makes the entry appear twice in the scanned start-menu
# pages, on top of the fixed entry — the same hint desktop-file-validate gives
# about syn-update's launcher.
Categories=System;
Keywords=package;software;install;update;pacman;aur;flatpak;blackarch;
StartupNotify=true
